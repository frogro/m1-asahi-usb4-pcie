diff --git a/cmd/apple_cd321x.c b/cmd/apple_cd321x.c
new file mode 100644
index 0000000..41c6515
--- /dev/null
+++ b/cmd/apple_cd321x.c
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <apple_cd321x.h>
+#include <command.h>
+#include <dm.h>
+#include <i2c.h>
+#include <linux/bitops.h>
+
+static int cd321x_read(void *ctx, u8 reg, u8 *buf, size_t size)
+{
+	return dm_i2c_read(ctx, reg, buf, size);
+}
+
+static int do_cd321x(struct cmd_tbl *cmdtp, int flag, int argc,
+		     char *const argv[])
+{
+	struct apple_cd321x_status s;
+	struct udevice *bus, *chip;
+	unsigned long busnum, addr;
+	int ret;
+
+	if (argc != 3 || strict_strtoul(argv[1], 10, &busnum) ||
+	    strict_strtoul(argv[2], 16, &addr) || busnum > 255 ||
+	    (addr != 0x38 && addr != 0x3f))
+		return CMD_RET_USAGE;
+	/* Explicit J274 controller selection; never scan unrelated I2C devices. */
+	ret = uclass_get_device_by_seq(UCLASS_I2C, busnum, &bus);
+	if (!ret)
+		ret = i2c_get_chip(bus, addr, 1, &chip);
+	if (!ret)
+		ret = i2c_set_chip_offset_len(chip, 1);
+	if (!ret)
+		ret = apple_cd321x_snapshot(cd321x_read, chip, &s);
+	if (ret) {
+		printf("CD321x status unavailable: %d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+	printf("CD321x bus=%lu addr=%02lx status=%08x data=%08x\n",
+	       busnum, addr, s.status, s.data_status);
+	printf("USB4=%u TBT=%u USB3=%u orientation=%u active_cable=%u\n",
+	       !!(s.data_status & BIT(23)), !!(s.data_status & BIT(16)),
+	       !!(s.data_status & BIT(5)), !!(s.data_status & BIT(1)),
+	       !!(s.data_status & BIT(22)));
+	if (s.data_status & BIT(23))
+		printf("USB4 mode=%02x EUDO=%08x\n", s.usb4_mode, s.eudo);
+	puts("Status only: no PHY setup, tunnel or disk access performed.\n");
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(cd321x, 3, 0, do_cd321x,
+	   "read selected M1 CD321x status without changing its mode",
+	   "<bus decimal> <chip hex: 38 or 3f>");
diff --git a/include/apple_cd321x.h b/include/apple_cd321x.h
new file mode 100644
index 0000000..9c39bdb
--- /dev/null
+++ b/include/apple_cd321x.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __APPLE_CD321X_H
+#define __APPLE_CD321X_H
+#include <linux/types.h>
+
+struct apple_cd321x_status {
+	u32 status, data_status, eudo;
+	u8 usb4_mode;
+};
+
+/* Callback performs one complete register read, including its length byte. */
+typedef int (*apple_cd321x_read)(void *ctx, u8 reg, u8 *buf, size_t size);
+/* Read-only snapshot. Output is unchanged on any error; no automatic retries. */
+int apple_cd321x_snapshot(apple_cd321x_read read, void *ctx,
+			  struct apple_cd321x_status *status);
+#endif
