diff --git a/lib/apple_cd321x.c b/lib/apple_cd321x.c
new file mode 100644
index 0000000..d69760a
--- /dev/null
+++ b/lib/apple_cd321x.c
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only CD321x status for boot-time Apple USB4 bring-up.
+ * Register definitions follow Linux drivers/usb/typec/tipd/tps6598x.h
+ * and core.c (TI and The Asahi Linux Contributors). No mode commands.
+ */
+#include <apple_cd321x.h>
+#include <linux/bitops.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <asm/unaligned.h>
+
+static int read_block(apple_cd321x_read read, void *ctx, u8 reg,
+		      u8 *data, size_t size)
+{
+	u8 buf[10];
+	int ret;
+
+	if (size + 1 > sizeof(buf))
+		return -EINVAL;
+	ret = read(ctx, reg, buf, size + 1);
+	if (ret)
+		return ret;
+	/* Unknown layouts must not become lane or cable configuration. */
+	if (buf[0] != size)
+		return -EPROTO;
+	memcpy(data, buf + 1, size);
+	return 0;
+}
+
+int apple_cd321x_snapshot(apple_cd321x_read read, void *ctx,
+			  struct apple_cd321x_status *status)
+{
+	struct apple_cd321x_status result = {};
+	u8 buf[9];
+	u8 first_data[5];
+	int ret;
+
+	if (!read || !status)
+		return -EINVAL;
+	ret = read_block(read, ctx, 0x00, buf, 4);
+	if (ret)
+		return ret;
+	if (get_unaligned_le32(buf) != 0x28)
+		return -ENODEV;
+	ret = read_block(read, ctx, 0x03, buf, 4);
+	if (ret)
+		return ret;
+	if (memcmp(buf, "APP ", 4))
+		return -EAGAIN;
+	ret = read_block(read, ctx, 0x1a, buf, 4);
+	if (ret)
+		return ret;
+	result.status = get_unaligned_le32(buf);
+	ret = read_block(read, ctx, 0x5f, first_data, 5);
+	if (ret)
+		return ret;
+	result.data_status = get_unaligned_le32(first_data);
+	if (result.data_status & BIT(23)) {
+		ret = read_block(read, ctx, 0x24, buf, 9);
+		if (ret)
+			return ret;
+		result.usb4_mode = buf[0];
+		result.eudo = get_unaligned_le32(buf + 1);
+	}
+	ret = read_block(read, ctx, 0x5f, buf, 5);
+	if (ret)
+		return ret;
+	if (memcmp(first_data, buf, 5))
+		return -EAGAIN;
+	/* Sequential samples, not an atomic guarantee against cable changes. */
+	*status = result;
+	return 0;
+}
