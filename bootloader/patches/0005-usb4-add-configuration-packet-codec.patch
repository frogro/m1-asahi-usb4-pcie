+/* Fixed wire vectors generated independently of the codec under test. */
+static const u8 read_request[] = {
+	0x00, 0x00, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05,
+	0x0c, 0x18, 0x41, 0x23, 0x85, 0x4f, 0x38, 0x6b,
+};
+static const u8 write_request[] = {
+	0x00, 0x00, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05,
+	0x0c, 0x18, 0x41, 0x23, 0x12, 0x34, 0x56, 0x78,
+	0xab, 0xcd, 0xef, 0x01, 0x50, 0xc6, 0x38, 0x78,
+};
+static const u8 read_reply[] = {
+	0x80, 0x00, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05,
+	0x0c, 0x48, 0x41, 0x23, 0x12, 0x34, 0x56, 0x78,
+	0xab, 0xcd, 0xef, 0x01, 0xa0, 0x93, 0x9b, 0x4f,
+};
+static const u8 write_reply[] = {
+	0x80, 0x00, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05,
+	0x0c, 0x48, 0x41, 0x23, 0xfb, 0xc6, 0x05, 0xa0,
+};
