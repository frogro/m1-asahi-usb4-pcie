diff --git a/test/dm/usb4_cfg.c b/test/dm/usb4_cfg.c
new file mode 100644
index 00000000..e59b3765
--- /dev/null
+++ b/test/dm/usb4_cfg.c
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <dm.h>
+#include <dm/test.h>
+#include <usb4_cfg.h>
+#include <asm/unaligned.h>
+#include <u-boot/crc.h>
+#include <test/test.h>
+#include <test/ut.h>
+#include "usb4_cfg_vectors.h"
+
+static const struct usb4_cfg_request sample = {
+	.route = 0x0102030405ULL, .offset = 0x123, .port = 3,
+	.space = 2, .seq = 1, .words = 2, .type = USB4_CFG_READ,
+};
+
+/* Separate, existing table-based CRC implementation for reply fault injection. */
+static void reseal(u8 *bytes, size_t size)
+{
+	u32 table[256], crc;
+
+	crc32c_init(table, 0x82f63b78);
+	crc = ~crc32c_cal(~0U, (const char *)bytes, size - 4, table);
+	put_unaligned_be32(crc, bytes + size - 4);
+}
+
+static int dm_test_usb4_cfg_vectors(struct unit_test_state *uts)
+{
+	struct usb4_cfg_request req = sample;
+	u32 data[] = { 0x12345678, 0xabcdef01 };
+	u8 buf[USB4_CFG_FRAME_BYTES];
+
+	ut_asserteq(sizeof(read_request), usb4_cfg_encode(&req, NULL, buf, sizeof(buf)));
+	ut_assertok(memcmp(buf, read_request, sizeof(read_request)));
+	req.type = USB4_CFG_WRITE;
+	ut_asserteq(sizeof(write_request), usb4_cfg_encode(&req, data, buf, sizeof(buf)));
+	ut_assertok(memcmp(buf, write_request, sizeof(write_request)));
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_vectors, 0);
+
+static int dm_test_usb4_cfg_reply(struct unit_test_state *uts)
+{
+	struct usb4_cfg_request req = sample;
+	u32 data[2] = {};
+	unsigned int port = 0;
+
+	ut_assertok(usb4_cfg_decode(&req, read_reply, sizeof(read_reply), 0,
+				   USB4_CFG_READ, data, &port));
+	ut_asserteq(0x12345678, data[0]);
+	ut_asserteq(0xabcdef01, data[1]);
+	ut_asserteq(9, port);
+	req.type = USB4_CFG_WRITE;
+	ut_assertok(usb4_cfg_decode(&req, write_reply, sizeof(write_reply), 0,
+				   USB4_CFG_WRITE, NULL, &port));
+	ut_asserteq(9, port);
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_reply, 0);
+
+static int dm_test_usb4_cfg_input_bounds(struct unit_test_state *uts)
+{
+	struct usb4_cfg_request req;
+	u8 buf[USB4_CFG_FRAME_BYTES], expected[USB4_CFG_FRAME_BYTES];
+	unsigned int i;
+
+	memset(expected, 0xa5, sizeof(expected));
+	for (i = 0; i < 9; i++) {
+		req = sample;
+		switch (i) {
+		case 0:
+			req.route = 1ULL << 54;
+			break;
+		case 1:
+			req.port = 64;
+			break;
+		case 2:
+			req.space = 4;
+			break;
+		case 3:
+			req.seq = 4;
+			break;
+		case 4:
+			req.words = 0;
+			break;
+		case 5:
+			req.words = 61;
+			break;
+		case 6:
+			req.offset = 0x2000;
+			break;
+		case 7:
+			req.offset = 0x1fff;
+			break;
+		case 8:
+			req.type = 9;
+			break;
+		}
+		memcpy(buf, expected, sizeof(buf));
+		ut_asserteq(-EINVAL, usb4_cfg_encode(&req, NULL, buf, sizeof(buf)));
+		ut_assertok(memcmp(buf, expected, sizeof(buf)));
+	}
+	ut_asserteq(-ENOSPC, usb4_cfg_encode(&sample, NULL, buf, 15));
+	ut_assertok(memcmp(buf, expected, sizeof(buf)));
+	ut_asserteq(-EINVAL, usb4_cfg_encode(NULL, NULL, buf, sizeof(buf)));
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_input_bounds, 0);
+
+static int dm_test_usb4_cfg_corrupt(struct unit_test_state *uts)
+{
+	u8 buf[sizeof(read_reply)];
+	u32 data[2];
+	unsigned int i, port;
+
+	for (i = 0; i < sizeof(buf); i++) {
+		memcpy(buf, read_reply, sizeof(buf));
+		buf[i] ^= 0x80;
+		data[0] = data[1] = 0xa5a5a5a5;
+		port = 0xdead;
+		ut_asserteq(-EBADMSG, usb4_cfg_decode(&sample, buf, sizeof(buf), 0,
+						   USB4_CFG_READ, data, &port));
+		ut_asserteq(0xa5a5a5a5, data[0]);
+		ut_asserteq(0xa5a5a5a5, data[1]);
+		ut_asserteq(0xdead, port);
+	}
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_corrupt, 0);
+
+static int dm_test_usb4_cfg_mismatch(struct unit_test_state *uts)
+{
+	u8 buf[sizeof(read_reply)];
+	u32 data[2];
+	unsigned int port, i;
+	/* Valid CRC, but wrong reply flag, reserved bits, address, or transaction. */
+	static const struct { unsigned int word; u32 bit; int error; } faults[] = {
+		{ 0, BIT(31), -EPROTO }, { 0, BIT(30), -EPROTO },
+		{ 1, BIT(0), -EAGAIN }, { 2, BIT(27), -EAGAIN },
+		{ 2, BIT(29), -EPROTO }, { 2, BIT(25), -EPROTO },
+		{ 2, BIT(0), -EPROTO }, { 2, BIT(13), -EPROTO },
+	};
+
+	for (i = 0; i < ARRAY_SIZE(faults); i++) {
+		memcpy(buf, read_reply, sizeof(buf));
+		put_unaligned_be32(get_unaligned_be32(buf + 4 * faults[i].word) ^
+				   faults[i].bit, buf + 4 * faults[i].word);
+		reseal(buf, sizeof(buf));
+		port = 0xdead;
+		data[0] = data[1] = 0xa5a5a5a5;
+		ut_asserteq(faults[i].error, usb4_cfg_decode(&sample, buf, sizeof(buf),
+							  0, USB4_CFG_READ, data, &port));
+		ut_asserteq(0xa5a5a5a5, data[0]);
+		ut_asserteq(0xa5a5a5a5, data[1]);
+		ut_asserteq(0xdead, port);
+	}
+	for (i = 0; i < 16; i++)
+		ut_asserteq(-EPROTO, usb4_cfg_decode(&sample, buf, i, 0,
+						  USB4_CFG_READ, data, &port));
+	ut_asserteq(-EPROTO, usb4_cfg_decode(&sample, read_reply, sizeof(read_reply),
+					  1, USB4_CFG_READ, data, &port));
+	ut_asserteq(-EAGAIN, usb4_cfg_decode(&sample, read_reply, sizeof(read_reply),
+					  0, USB4_CFG_WRITE, data, &port));
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_mismatch, 0);
+
+static int dm_test_usb4_cfg_full_frame(struct unit_test_state *uts)
+{
+	struct usb4_cfg_request req = sample;
+	u8 buf[USB4_CFG_FRAME_BYTES];
+	u32 input[USB4_CFG_MAX_WORDS], output[USB4_CFG_MAX_WORDS];
+	unsigned int i, port;
+
+	for (i = 0; i < ARRAY_SIZE(input); i++)
+		input[i] = 0x12340000 + i;
+	req.type = USB4_CFG_WRITE;
+	req.words = USB4_CFG_MAX_WORDS;
+	ut_asserteq(sizeof(buf), usb4_cfg_encode(&req, input, buf, sizeof(buf)));
+	/* Turn this independently CRC-checked payload into a normal read reply. */
+	put_unaligned_be32(get_unaligned_be32(buf) | BIT(31), buf);
+	reseal(buf, sizeof(buf));
+	req.type = USB4_CFG_READ;
+	ut_assertok(usb4_cfg_decode(&req, buf, sizeof(buf), 0, USB4_CFG_READ,
+				   output, &port));
+	ut_assertok(memcmp(input, output, sizeof(input)));
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_full_frame, 0);
