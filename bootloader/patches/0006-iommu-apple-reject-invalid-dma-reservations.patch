+		return -ENOMEM;
+	}
 	memset(priv->l1, 0, nl1 * DART_PAGE_SIZE);
 	l2 = (phys_addr_t)priv->l2;
 	for (i = 0; i < nl2; i++) {
diff --git a/test/dm/apple_dart.c b/test/dm/apple_dart.c
index 0ad6cb1c..f0b5f441 100644
--- a/test/dm/apple_dart.c
+++ b/test/dm/apple_dart.c
@@ -2,6 +2,7 @@
 /* Register-level tests; no ACIO firmware or actual DMA is emulated. */
 
 #include <dm.h>
+#include <iommu.h>
 #include <dm/device-internal.h>
 #include <dm/test.h>
 #include <dm/uclass.h>
@@ -76,3 +77,89 @@ static int dm_test_apple_dart_t8103_bypass(struct unit_test_state *uts)
 }
 
 DM_TEST(dm_test_apple_dart_t8103_bypass, UTF_SCAN_FDT);
+
+/* These mappings program tables only: no peripheral performs actual DMA. */
+static int dm_test_apple_dart_map_reject(struct unit_test_state *uts)
+{
+	struct udevice *dev;
+	const struct iommu_ops *ops;
+	u32 *regs = map_sysmem(0x05004000, 0x4000);
+
+	sandbox_set_enable_memio(true);
+	memset(regs, 0, 0x4000);
+	ut_assertok(uclass_get_device_by_name(UCLASS_IOMMU,
+					    "apple-dart@5004000", &dev));
+	ops = device_get_ops(dev);
+	writel(0, &regs[0x20 / 4]);
+	ut_asserteq(0, ops->map(dev, (void *)0x100000, 0));
+	ut_asserteq(0, readl(&regs[0x20 / 4]));
+	ut_asserteq(0, ops->map(dev, (void *)0x100000, (size_t)-1));
+	ut_asserteq(0, ops->map(dev, (void *)(uintptr_t)-16, 32));
+	ut_asserteq(0, ops->map(dev, (void *)0x100000, 1ULL << 32));
+	ut_asserteq(0, readl(&regs[0x20 / 4]));
+	ut_assertok(device_remove(dev, DM_REMOVE_NORMAL));
+	unmap_sysmem(regs);
+	return 0;
+}
+DM_TEST(dm_test_apple_dart_map_reject, UTF_SCAN_FDT);
+
+static int dm_test_apple_dart_map_exhaust(struct unit_test_state *uts)
+{
+	struct udevice *dev;
+	const struct iommu_ops *ops;
+	u32 *regs = map_sysmem(0x05004000, 0x4000);
+	/* The entire supported IOVA aperture, excluding the two guard pages. */
+	size_t aperture = (1ULL << 32) - 2 * 16384;
+	dma_addr_t first, again;
+
+	sandbox_set_enable_memio(true);
+	memset(regs, 0, 0x4000);
+	ut_assertok(uclass_get_device_by_name(UCLASS_IOMMU,
+					    "apple-dart@5004000", &dev));
+	ops = device_get_ops(dev);
+	first = ops->map(dev, (void *)0x4000, aperture);
+	ut_asserteq(16384, first);
+	writel(0, &regs[0x20 / 4]);
+	ut_asserteq(0, ops->map(dev, (void *)0x100000, 16384));
+	/* Exhaustion must not install a mapping at reserved IOVA zero. */
+	ut_asserteq(0, readl(&regs[0x20 / 4]));
+	ops->unmap(dev, first, aperture);
+	again = ops->map(dev, (void *)0x4000, aperture);
+	ut_asserteq(first, again);
+	ops->unmap(dev, again, aperture);
+	ut_assertok(device_remove(dev, DM_REMOVE_NORMAL));
+	unmap_sysmem(regs);
+	return 0;
+}
+DM_TEST(dm_test_apple_dart_map_exhaust, UTF_SCAN_FDT);
+
+static int dm_test_apple_dart_unmap_bounds(struct unit_test_state *uts)
+{
+	struct udevice *dev;
+	const struct iommu_ops *ops;
+	u32 *regs = map_sysmem(0x05004000, 0x4000);
+	dma_addr_t addr, again;
+
+	sandbox_set_enable_memio(true);
+	memset(regs, 0, 0x4000);
+	ut_assertok(uclass_get_device_by_name(UCLASS_IOMMU,
+					    "apple-dart@5004000", &dev));
+	ops = device_get_ops(dev);
+	addr = ops->map(dev, (void *)0x100123, 17000);
+	ut_assert(addr != 0);
+	ut_asserteq(0x123, addr & 0x3fff);
+	writel(0, &regs[0x20 / 4]);
+	ops->unmap(dev, 0, 16384);
+	ops->unmap(dev, (dma_addr_t)-16, 32);
+	ops->unmap(dev, addr, (size_t)-1);
+	ops->unmap(dev, addr, 0);
+	ut_asserteq(0, readl(&regs[0x20 / 4]));
+	ops->unmap(dev, addr, 17000);
+	again = ops->map(dev, (void *)0x100123, 17000);
+	ut_asserteq(addr, again);
+	ops->unmap(dev, again, 17000);
+	ut_assertok(device_remove(dev, DM_REMOVE_NORMAL));
+	unmap_sysmem(regs);
+	return 0;
+}
+DM_TEST(dm_test_apple_dart_unmap_bounds, UTF_SCAN_FDT);
