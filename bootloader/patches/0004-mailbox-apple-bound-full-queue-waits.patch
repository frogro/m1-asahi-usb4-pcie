+/* Bound a stalled IOP so other boot targets remain reachable. */
+#define APPLE_MBOX_SEND_TIMEOUT_US 1000000
 
 #define REG_A2I_STAT	0x110
 #define  REG_A2I_STAT_EMPTY	BIT(17)
@@ -37,13 +40,21 @@ static int apple_mbox_send(struct mbox_chan *chan, const void *data)
 {
 	struct apple_mbox_priv *priv = dev_get_priv(chan->dev);
 	const struct apple_mbox_msg *msg = data;
+	u32 stat;
+	int ret;
+
+	/* Never overwrite a message while the hardware queue is full. */
+	ret = readl_poll_sleep_timeout(priv->base + REG_A2I_STAT, stat,
+				      !(stat & REG_A2I_STAT_FULL), 1,
+				      APPLE_MBOX_SEND_TIMEOUT_US);
+	if (ret)
+		return ret;
 
 	writeq(msg->msg0, priv->base + REG_A2I_MSG0);
 	writeq(msg->msg1, priv->base + REG_A2I_MSG1);
-	while (readl(priv->base + REG_A2I_STAT) & REG_A2I_STAT_FULL)
