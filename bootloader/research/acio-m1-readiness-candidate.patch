--- /dev/null
+++ b/lib/apple_acio_prereq.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Derived from Asahi Linux reset-apple-cio.c and thunderbolt/apple.c.
+ * Copyright The Asahi Linux Contributors
+ * Copyright (c) Sven Peter <sven@kernel.org>
+ * Original reset driver author: Sven Peter <sven@kernel.org>
+ * Research helpers only; no device binding, power management or firmware boot.
+ */
+#include "apple_acio_prereq.h"
+#include <linux/errno.h>
+
+int acio_m1_deassert(const struct acio_reset_io *io, void *ctx,
+                    unsigned int port, u64 resource_size, u32 *last_status)
+{
+ u32 offset, value;
+ unsigned int elapsed;
+ int ret;
+
+ if (!io || !io->write || !io->read || !io->delay || !last_status || port > 1)
+  return -EINVAL;
+ offset = port * 0x4000;
+ if (resource_size < 4 || offset > resource_size - 4)
+  return -ERANGE;
+ ret = io->write(ctx, offset, 1);
+ if (ret)
+  return ret;
+ for (elapsed = 0; elapsed <= 100000; elapsed += 100) {
+  ret = io->read(ctx, offset, &value);
+  if (ret)
+   return ret;
+  *last_status = value;
+  /* Exact INIT_DONE, not merely a set bit alongside a pending request. */
+  if (value == 4)
+   return 0;
+  if (elapsed < 100000)
+   io->delay(ctx, 100);
+ }
+ return -ETIMEDOUT;
+}
+
+int acio_sram_translate(u64 physical_base, u64 window_size, u64 iova,
+                       u64 bytes, u64 *physical_address)
+{
+ u64 offset;
+
+ if (!physical_address || !bytes || !window_size || iova < 0x10000000ULL)
+  return -EINVAL;
+ offset = iova - 0x10000000ULL;
+ if (offset >= window_size || bytes > window_size - offset)
+  return -ERANGE;
+ if (physical_base > (~(u64)0) - offset ||
+     bytes - 1 > (~(u64)0) - (physical_base + offset))
+  return -EOVERFLOW;
+ *physical_address = physical_base + offset;
+ return 0;
+}
