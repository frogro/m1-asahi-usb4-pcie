+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef APPLE_ACIO_PREREQ_H
+#define APPLE_ACIO_PREREQ_H
+#include <linux/types.h>
+struct acio_reset_io {
+ int (*write)(void *ctx, u32 offset, u32 value);
+ int (*read)(void *ctx, u32 offset, u32 *value);
+ void (*delay)(void *ctx, unsigned int us);
+};
+/* Caller owns/holds all required power domains; this does not acquire them.
+ * M1 deassert has no inverse register write: recovery needs a power cycle.
+ */
+int acio_m1_deassert(const struct acio_reset_io *io, void *ctx,
+                    unsigned int port, u64 resource_size, u32 *last_status);
+/* Firmware-supplied addresses only. No allocation and no MMIO access. */
+int acio_sram_translate(u64 physical_base, u64 window_size, u64 iova,
+                       u64 bytes, u64 *physical_address);
+#endif
