+/* USB4 v1, single-hop router setup following Linux switch.c and usb4.c.
+ * Linux original authors: Andreas Noever, Mika Westerberg, Intel and Asahi
+ * contributors. No NVM operations, PCIe adapter enable, paths or disk I/O.
+ */
+int apple_nhi_m1_usb4_router_setup(apple_nhi_read_fn host_read,
+ apple_nhi_read_fn read, apple_nhi_router_write_fn write,
+ void (*wait)(void *), void *context, unsigned int upstream)
+{
+ const u32 pto = 1U << 24, uto = 1U << 25, hco = 1U << 26;
+ const u32 cns = 1U << 23, cv = 1U << 31;
+ u32 h[5], host[5], p[4], cfg[4], check[4], cs5, cs6, value;
+ unsigned int maxport, i, poll;
+ bool pcie = false, usb3 = false;
+ int ret;
+ if (!host_read || !read || !write || !wait || !upstream || upstream > 16)
+  return -EINVAL;
+ ret = read(context, 0, 2, 0, 5, h);
+ if (ret) return ret;
+ maxport = (h[1] >> 14) & 63;
+ if (!h[0] || h[0] == ~0U || ((h[4] >> 29) & 7) != 1 ||
+     !maxport || maxport > 16 || upstream > maxport)
+  return -EPROTONOSUPPORT;
+ if (h[2] || h[3] || ((h[1] >> 20) & 7)) return -EBUSY;
+ ret = host_read(context, 0, 2, 0, 5, host);
+ if (ret) return ret;
+ maxport = (host[1] >> 14) & 63;
+ if (((host[4] >> 29) & 7) != 1 || !maxport || maxport > 16 ||
+     host[2] || host[3] != (1U << 31) || ((host[1] >> 20) & 7))
+  return -EPROTO;
+ for (i = 1; i <= maxport; i++) {
+  ret = host_read(context, i, 1, 0, 4, p);
+  if (ret) return ret;
+  if ((p[2] & 0xffffff) && ((p[3] >> 20) & 63) != i) return -EPROTO;
+  if ((p[2] & 0xffffff) == 0x100101) pcie = true;
+  if ((p[2] & 0xffffff) == 0x200101) usb3 = true;
+ }
+ if (!pcie) return -EOPNOTSUPP;
+ cfg[0] = (h[1] & ~((63U << 8) | (7U << 20))) | (upstream << 8) | (1U << 20);
+ cfg[1] = 1;
+ cfg[2] = 1U << 31;
+ cfg[3] = (h[4] & 0xffff0000U) | 0x10ff;
+ ret = write(context, 1, 4, cfg);
+ if (ret) return ret;
+ ret = read(context, 0, 2, 1, 4, check);
+ if (ret) return ret;
+ for (i = 0; i < 4; i++) if (check[i] != cfg[i]) return -EIO;
+ printf("USB4-ROUTER enumerated upstream=%u route=1 CMUV=0x10 parent-pcie=%u parent-usb3=%u\n", upstream, pcie, usb3);
+ ret = read(context, 0, 2, 6, 1, &cs6);
+ if (ret) return ret;
+ ret = read(context, 0, 2, 5, 1, &cs5);
+ if (ret) return ret;
+ printf("USB4-ROUTER before CS5=%08x CS6=%08x\n", cs5, cs6);
+ if (cs5 & (cv | 1U)) return -EBUSY;
+ value = (cs5 | pto) & ~cns;
+ if (usb3) value |= uto;
+ else if (cs6 & (1U << 18)) value |= hco;
+ ret = write(context, 5, 1, &value);
+ if (ret) return ret;
+ ret = read(context, 0, 2, 5, 1, &cs5);
+ if (ret) return ret;
+ if ((cs5 & (pto | uto | hco | cns | cv)) != (value & (pto | uto | hco | cns | cv))) return -EIO;
+ for (poll = 0; poll <= 50; poll++) {
+  ret = read(context, 0, 2, 6, 1, &cs6);
+  if (ret) return ret;
+  if (cs6 & (1U << 24)) break;
+  if (poll < 50) wait(context);
+ }
+ if (!(cs6 & (1U << 24))) return -ETIMEDOUT;
+ printf("USB4-ROUTER ready CS6=%08x polls=%u\n", cs6, poll + 1);
+ ret = read(context, 0, 2, 5, 1, &cs5);
+ if (ret) return ret;
+ value = cs5 | cv;
+ ret = write(context, 5, 1, &value);
+ if (ret) return ret;
+ for (poll = 0; poll <= 50; poll++) {
+  ret = read(context, 0, 2, 6, 1, &cs6);
+  if (ret) return ret;
+  if (cs6 & (1U << 25)) break;
+  if (poll < 50) wait(context);
+ }
+ if (!(cs6 & (1U << 25))) return -ETIMEDOUT;
+ ret = read(context, 0, 2, 5, 1, &cs5);
+ if (ret) return ret;
+ if (!(cs5 & cv)) return -EIO;
+ printf("USB4-ROUTER-SETUP PASS route=1 CS5=%08x CS6=%08x polls=%u; no paths\n",cs5,cs6,poll+1);
+ return 0;
+}
