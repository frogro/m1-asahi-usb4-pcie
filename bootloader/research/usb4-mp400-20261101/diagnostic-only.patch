+/* Read-only single-hop USB4 path discovery. No assumed PCIe port number. */
+int apple_nhi_m1_usb4_preflight(apple_nhi_read_fn host, apple_nhi_read_fn remote,
+                               void *context, struct apple_usb4_snapshot *snapshot)
+{
+ apple_nhi_read_fn reads[2] = {host, remote};
+ u32 headers[2][5], p[8], cap, path[2], control[2];
+ unsigned int endpoints[2] = {0,0}, lane[2] = {1,0};
+ unsigned int r, i, max, off, wanted, seen[16], n, j;
+ int ret;
+ if (!host || !remote || !snapshot) return -EINVAL;
+ *snapshot = (struct apple_usb4_snapshot){0};
+ for (r = 0; r < 2; r++) {
+  ret = reads[r](context,0,2,0,5,headers[r]);
+  if (ret) return ret;
+  max = (headers[r][1] >> 14) & 63;
+  if (!max || max > 16 || ((headers[r][4] >> 29)&7)!=1 ||
+      headers[r][2] != r || headers[r][3] != (1U<<31) ||
+      ((headers[r][1]>>20)&7) != r) return -EPROTO;
+  if (r) lane[r] = (headers[r][1]>>8)&63;
+  if (!lane[r] || lane[r] > max) return -EPROTO;
+  for (i=1;i<=max;i++) {
+   ret=reads[r](context,i,1,0,4,p);if(ret)return ret;
+   if ((p[2]&0xffffff) && ((p[3]>>20)&63)!=i) return -EPROTO;
+   if ((p[2]&0xffffff)==(r?0x100102:0x100101)) {
+    if (endpoints[r]) return -EOPNOTSUPP;
+    endpoints[r]=i;
+   }
+  }
+  if (!endpoints[r]) return -ENODEV;
+ }
+ printf("USB4-PREFLIGHT discovered host-pcie=%u host-lane=%u remote-lane=%u remote-pcie=%u\n",endpoints[0],lane[0],lane[1],endpoints[1]);
+ for(r=0;r<2;r++) for(i=0;i<2;i++) {
+  unsigned int port=i?lane[r]:endpoints[r];
+  ret=reads[r](context,port,1,0,8,p);if(ret)return ret;
+  if((p[5]&2047)<8 || ((p[5]>>11)&2047)<8) return -ENOSPC;
+  wanted=i?1:4;off=p[1]&255;
+  for(n=0;;n++) {
+   if(n==16 || off<8 || off>255)return -ERANGE;
+   for(j=0;j<n;j++)if(seen[j]==off)return -ELOOP;
+   seen[n]=off;
+   ret=reads[r](context,port,1,off,1,&cap);if(ret)return ret;
+   if(((cap>>8)&255)==wanted)break;
+   off=cap&255;
+  }
+  if(!i && (cap & (1U<<31)))return -EBUSY;
+  ret=reads[r](context,port,0,16,2,path);if(ret)return ret;
+  if(path[0]&(1U<<31))return -EBUSY;
+  control[0]=control[1]=0;
+  if(i) {ret=reads[r](context,port,0,0,2,control);if(ret)return ret;}
+  {
+   unsigned int index = r ? (i ? 2 : 3) : i;
+   snapshot->port[index]=port; snapshot->cap[index]=off;
+   snapshot->old[index][0]=path[0]; snapshot->old[index][1]=path[1];
+   snapshot->nfc[index]=p[4]; snapshot->control[index]=control[0];
+  }
+  printf("USB4-PREFLIGHT route=%u port=%u cap=%#x cap-word=%08x buffers=%08x path8=%08x %08x control0=%08x %08x\n",r,port,off,cap,p[4],path[0],path[1],control[0],control[1]);
+ }
+ snapshot->valid=true;
+ puts("USB4-PREFLIGHT PASS; discovered endpoints and inactive paths; no path writes\n");
+ return 0;
+}
+
+/* USB4 protocol-adapter credit/IFC/ISE fields are vendor-defined (Linux path.c).
+ * Preserve them on BOTH ends; allocate minimum PCIe credits only on lanes.
+ */
+int apple_nhi_m1_usb4_path_plan(const struct apple_usb4_snapshot *s,
+                               const u32 *limits, u32 next[4][2])
+{
+ unsigned int i, out[4], total, control;
+ if (!s || !limits || !next || !s->valid) return -EINVAL;
+ if (limits[0]<6 || limits[1]<6) return -ENOSPC;
+ if (s->port[0]==s->port[1] || s->port[2]==s->port[3]) return -EPROTO;
+ out[0]=s->port[1];out[1]=s->port[0];out[2]=s->port[3];out[3]=s->port[2];
+ for(i=0;i<4;i++) {
+  if(!s->port[i] || s->port[i]>16 || s->cap[i]<8 || s->cap[i]>255) return -EPROTO;
+  if(s->old[i][0]&(1U<<31)) return -EBUSY;
+  if(i==1 || i==2) {
+   total=(s->nfc[i]>>20)&1023;control=(s->control[i]>>17)&127;
+   if(total<control+6) return -ENOSPC;
+  }
+ }
+ for(i=0;i<4;i++) {
+  next[i][0]=(1U<<31)|(out[i]<<11)|8;
+  next[i][1]=0x301;
+  if(i==0 || i==3) {
+   next[i][0]|=s->old[i][0]&(127U<<17);
+   next[i][1]|=s->old[i][1]&((1U<<24)|(1U<<26));
+   next[i][1]|=1U<<25;
+  } else {
+   next[i][0]|=6U<<17;next[i][1]|=1U<<24;
+  }
+ }
+ return 0;
+}
