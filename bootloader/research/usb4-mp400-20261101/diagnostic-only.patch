+/* One-shot USB4 link observation. No downstream configuration or disk I/O. */
+static int do_usb4check(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+ static const char *const forbidden[] = {
+  "u-boot,probe-remote-config",
+  "u-boot,probe-tunnel-preflight", "u-boot,probe-tunnel-paths",
+  "u-boot,probe-pcie-enable", "u-boot,probe-pcie-scan", "u-boot,probe-nvme-read",
+ };
+ ofnode node = ofnode_path("/soc/cio@501ac0000");
+ char *args[] = { "atcm1", "1", "usb4pciec" };
+ char *log;
+ unsigned int i;
+ int ret, count, tail;
+ bool overflow;
+ (void)argv;
+ env_set("usb4trace_addr", NULL);
+ env_set("usb4trace_size", NULL);
+ if (argc != 1 || !ofnode_valid(node)) return CMD_RET_USAGE;
+ for (i = 0; i < ARRAY_SIZE(forbidden); i++)
+  if (ofnode_read_bool(node, forbidden[i])) return CMD_RET_FAILURE;
+ if (!IS_ENABLED(CONFIG_CONSOLE_RECORD)) return CMD_RET_FAILURE;
+ log = memalign(4096, 0x100000 + 128);
+ if (!log) return CMD_RET_FAILURE;
+ if (console_record_reset_enable()) { free(log); return CMD_RET_FAILURE; }
+ puts("USB4CHECK BEGIN native integrated U-Boot; bounded USB4 NVMe read, no SSD writes\n");
+ ret = run_command("usb start", 0);
+ printf("USB4CHECK USB-start result=%d\n", ret);
+ if (!ret) ret = do_atcm1(cmdtp, flag, 3, args);
+ printf("USB4CHECK END command_result=%d; reset required\n", ret);
+ overflow = !!(gd->flags & GD_FLG_RECORD_OVF);
+ gd->flags &= ~GD_FLG_RECORD;
+ count = membuf_get((struct membuf *)&gd->console_out, log, 0x100000);
+ if (count <= 0 || count > 0x100000) { free(log); return CMD_RET_FAILURE; }
+ tail = snprintf(log + count, 128, "\nUSB4CHECK SUMMARY result=%d truncated=%u bytes=%d\n", ret, overflow, count);
+ if (tail < 0 || tail >= 128) { free(log); return CMD_RET_FAILURE; }
+ env_set_hex("usb4trace_addr", (ulong)log);
+ env_set_hex("usb4trace_size", count + tail);
+ puts("USB4CHECK capture ready for internal ESP; reset after saving\n");
+ return CMD_RET_SUCCESS;
+}
+U_BOOT_CMD(usb4check, 1, 0, do_usb4check,
+           "capture bounded native USB4 link observation; reset required", "");
+
+static int do_usb4mark(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+ static const char marker[] = "USB4CHECK boot command reached before USB scan\n";
+ (void)cmdtp; (void)flag; (void)argv;
+ if (argc != 1) return CMD_RET_USAGE;
+ env_set_hex("usb4mark_addr", (ulong)marker);
+ env_set_hex("usb4mark_size", sizeof(marker)-1);
+ return 0;
+}
+U_BOOT_CMD(usb4mark, 1, 0, do_usb4mark, "mark diagnostic boot entry", "");
+
+/* Diagnostic only. The sole allowed write target is this independent ESP. */
+static int do_usb4logtest(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+ const char *uuid = "f5af719f-ed4a-4004-b751-3f9e398a75d0";
+ const char *file = "/usb4-logonly-shutdown-v7.txt";
+ struct disk_partition info;
+ struct blk_desc *desc;
+ char target[32], *data, *check;
+ loff_t actual = 0;
+ int dev, part, ret, len;
+ (void)cmdtp; (void)flag; (void)argv;
+ if (argc != 1) return CMD_RET_USAGE;
+ puts("USB4 LOGONLY ENTRY: no USB scan, no PHY writes\n");
+ ret = nvme_scan_namespace();
+ printf("LOGONLY nvme scan=%d fw_dev_part=%s\n", ret, env_get("fw_dev_part"));
+ for (dev = 0; dev < 8; dev++) {
+  desc = blk_get_devnum_by_uclass_id(UCLASS_NVME, dev);
+  if (!desc) continue;
+  for (part = 1; part <= 32; part++) {
+   ret = part_get_info(desc, part, &info);
+   if (ret || strcasecmp(info.uuid, uuid)) continue;
+   snprintf(target, sizeof(target), "%x:%x", dev, part);
+   data = memalign(4096, 4096); check = memalign(4096, 4096);
+   if (!data || !check) { free(data); free(check); return CMD_RET_FAILURE; }
+   memset(data, 0, 4096); memset(check, 0, 4096);
+   len = snprintf(data,4096,"USB4 LOGONLY V7 ordered shutdown reached U-Boot main loop; device=%s blocksize=%lu UUID=%s\n",target,desc->blksz,info.uuid);
+   ret = fs_set_blk_dev("nvme", target, FS_TYPE_FAT);
+   printf("LOGONLY target=%s blocksize=%lu open=%d\n",target,desc->blksz,ret);
+   if (!ret) ret = fs_write(file,(ulong)data,0,len,&actual);
+   fs_close();
+   printf("LOGONLY write=%d actual=%lld expected=%d\n",ret,actual,len);
+   if (!ret && actual != len) ret = -EIO;
+   if (!ret) ret = fs_set_blk_dev("nvme",target,FS_TYPE_FAT);
+   if (!ret) ret = fs_read(file,(ulong)check,0,len,&actual);
+   fs_close();
+   if (!ret && (actual != len || memcmp(data,check,len))) ret = -EIO;
+   printf("LOGONLY readback=%d bytes=%lld\n",ret,actual);
+   free(data); free(check);
+   return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+  }
+ }
+ puts("LOGONLY target ESP not found; no writes performed\n");
+ return CMD_RET_FAILURE;
+}
+U_BOOT_CMD(usb4logtest, 1, 0, do_usb4logtest, "verify independent ESP logger only", "");
+
+/* Diagnostic transport only: no USB scan or external controller setup. */
+static int do_usb4handoff(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+ char log[4096];
+ struct blk_desc *desc;
+ struct disk_partition info;
+ int count, ret;
+ if (argc != 1) return CMD_RET_USAGE;
+ console_record_reset_enable();
+ ret = do_usb4logtest(cmdtp, flag, argc, argv);
+ printf("LOGONLY returned=%d; next=internal Linux with RAM transcript\n", ret);
+ gd->flags &= ~GD_FLG_RECORD;
+ count = membuf_get((struct membuf *)&gd->console_out, log, sizeof(log)-1);
+ if (count < 0 || count >= sizeof(log)) return CMD_RET_FAILURE;
+ log[count] = 0;
+ if (env_set("usb4diag_log", log)) return CMD_RET_FAILURE;
+ /* Read only, and only the verified independent Asahi ESP. */
+ desc = blk_get_devnum_by_uclass_id(UCLASS_NVME, 0);
+ if (!desc || part_get_info(desc, 8, &info) ||
+     strcasecmp(info.uuid, "f5af719f-ed4a-4004-b751-3f9e398a75d0"))
+  return CMD_RET_FAILURE;
+ ret = run_command("load nvme 0:8 ${kernel_addr_r} /EFI/Asahi/USB4DIAG.EFI", 0);
+ if (ret) return CMD_RET_FAILURE;
+ return run_command("bootefi ${kernel_addr_r}:${filesize} ${fdtcontroladdr}", 0);
+}
+U_BOOT_CMD(usb4handoff, 1, 0, do_usb4handoff, "pass logger-only result to internal Linux", "");
+
+static int do_usb4logreset(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+ struct blk_desc *desc;
+ struct disk_partition info;
+ struct udevice *controller;
+ int ret;
+ if (argc != 1) return CMD_RET_USAGE;
+ ret = do_usb4logtest(cmdtp, flag, argc, argv);
+ if (ret) return ret;
+ desc = blk_get_devnum_by_uclass_id(UCLASS_NVME, 0);
+ if (!desc || part_get_info(desc, 8, &info) ||
+     strcasecmp(info.uuid, "f5af719f-ed4a-4004-b751-3f9e398a75d0"))
+  return CMD_RET_FAILURE;
+ controller = dev_get_parent(desc->bdev);
+ if (!controller || !device_is_compatible(controller, "apple,nvme-ans2"))
+  return CMD_RET_FAILURE;
+ ret = nvme_shutdown(controller);
+ printf("LOGONLY orderly internal NVMe shutdown=%d; reset next\n", ret);
+ return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+U_BOOT_CMD(usb4logreset, 1, 0, do_usb4logreset, "persist logger before reset", "");
+
+static int usb4_save_trace(const void *data, unsigned long size)
+{
+ struct blk_desc *desc;
+ struct disk_partition info;
+ struct udevice *controller;
+ char *check;
+ loff_t actual = 0;
+ int ret;
+ if (!data || !size || size > 0x100000 + 127) return -EINVAL;
+ desc = blk_get_devnum_by_uclass_id(UCLASS_NVME, 0);
+ if (!desc || part_get_info(desc, 8, &info) ||
+     strcasecmp(info.uuid, "f5af719f-ed4a-4004-b751-3f9e398a75d0")) return -EPERM;
+ controller = dev_get_parent(desc->bdev);
+ if (!controller || !device_is_compatible(controller, "apple,nvme-ans2")) return -EPERM;
+ check = memalign(4096, ALIGN(size, 4096));
+ if (!check) return -ENOMEM;
+ ret = fs_set_blk_dev("nvme", "0:8", FS_TYPE_FAT);
+ if (!ret) ret = fs_write("/usb4-mp400-link-v15.log", (ulong)data, 0, size, &actual);
+ fs_close();
+ if (!ret && actual != size) ret = -EIO;
+ if (!ret) ret = fs_set_blk_dev("nvme", "0:8", FS_TYPE_FAT);
+ if (!ret) ret = fs_read("/usb4-mp400-link-v15.log", (ulong)check, 0, size, &actual);
+ fs_close();
+ if (!ret && (actual != size || memcmp(data, check, size))) ret = -EIO;
+ free(check);
+ return ret;
+}
+static int do_usb4persist(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+ int ret, saved = -ENODATA, shutdown;
+ if (argc != 1) return CMD_RET_USAGE;
+ ret = do_usb4check(cmdtp, flag, argc, argv);
+ if (!ret) saved = usb4_save_trace((void *)env_get_hex("usb4trace_addr", 0),
+                                  env_get_hex("usb4trace_size", 0));
+ printf("USB4CHECK durable save=%d capture=%d\n", saved, ret);
+ /* Also verifies the independent ESP before shutting down only Apple ANS. */
+ shutdown = do_usb4logreset(cmdtp, flag, argc, argv);
+ printf("USB4CHECK shutdown=%d; always reset, never Linux handoff\n", shutdown);
+ return ret || saved || shutdown ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+U_BOOT_CMD(usb4persist, 1, 0, do_usb4persist, "capture USB4 and persist before reset", "");
