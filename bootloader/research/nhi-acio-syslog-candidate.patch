+ if (type == 8) {
+  rtk->syslog_entries = msg & 0xff;
+  rtk->syslog_size = (msg >> 24) & 0xff;
+  printf("ACIO-SYSLOG INIT entries=%u size=%u\n", rtk->syslog_entries, rtk->syslog_size);
+  return;
+ }
