+ for (i = 0; i < rtk->syslog_size; i++) {
+  u8 ch = readb(base + 0x20 + i);
+  text[i] = ch && (ch < 32 || ch > 126) ? '.' : ch;
+ }
+ text[i] = 0;
+ printf("ACIO-SYSLOG %s: %s\n", context, text);
