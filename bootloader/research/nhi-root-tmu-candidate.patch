+/* USB4 root-router LOWRES sequence from Linux thunderbolt/tmu.c:
+ * Time Disruption -> packet interval 1000 -> clear Time Disruption.
+ * Only this discovered host capability is writable. No downstream writes.
+ * Retain the first failure and attempt to clear TD even after a failed write;
+ * the caller must stop the probe and reset on any error.
+ */
+int apple_nhi_m1_tmu_lowres(apple_nhi_read_fn read,
+                          apple_nhi_tmu_write_fn write, void *context, u32 cap)
+{
+ const u32 td = 1U << 27, ucap = 1U << 30, rate = 1000U << 16;
+ u32 control, interval, value;
+ int ret, cleanup;
+
+ if (!read || !write || cap < 5 || cap > 0x1ffc) return -EINVAL;
+ ret = read(context, 0, 2, cap, 1, &control);
+ if (ret) return ret;
+ if (((control >> 8) & 255) != 3 || !(control & ucap)) return -EPROTO;
+ if (control & td) return -EBUSY;
+ ret = read(context, 0, 2, cap + 3, 1, &interval);
+ if (ret) return ret;
+ printf("NHI-TMU before cap=%#x control=%08x interval=%08x\n", cap, control, interval);
+ if ((interval & 0xffff0000U) == rate) {
+  puts("NHI-TMU PASS already LOWRES; no writes\n");
+  return 0;
+ }
+ if (interval >> 16) return -EBUSY;
+ ret = write(context, cap, control | td);
+ if (ret) goto clear;
+ ret = read(context, 0, 2, cap, 1, &value);
+ if (ret) goto clear;
+ if (!(value & td)) { ret = -EIO; goto clear; }
+ ret = write(context, cap + 3, (interval & 0xffffU) | rate);
+ if (ret) goto clear;
+ ret = read(context, 0, 2, cap + 3, 1, &value);
+ if (ret) goto clear;
+ if ((value & 0xffff0000U) != rate) ret = -EIO;
+clear:
+ cleanup = read(context, 0, 2, cap, 1, &value);
+ if (!cleanup) cleanup = write(context, cap, value & ~td);
+ if (!cleanup) cleanup = read(context, 0, 2, cap, 1, &value);
+ if (!cleanup && (value & td)) cleanup = -EIO;
+ if (ret || cleanup) {
+  printf("NHI-TMU FAIL operation=%d cleanup=%d; mandatory reset\n", ret, cleanup);
+  return ret ? ret : cleanup;
+ }
+ puts("NHI-TMU PASS LOWRES interval=1000 TD=0\n");
+ return 0;
+}
