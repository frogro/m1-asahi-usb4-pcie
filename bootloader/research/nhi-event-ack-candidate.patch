+/* Linux tb_msgs.h cfg_event_pkg and ctl.c tb_cfg_ack_plug. */
+int usb4_cfg_decode_event(const void *frame, size_t size, unsigned int sof,
+                         unsigned int eof, struct usb4_cfg_event *event)
+{
+ const u8 *bytes = frame;
+ u32 hi, value;
+ if (!frame || !event) return -EINVAL;
+ if (eof != USB4_CFG_EVENT) return -EAGAIN;
+ if (sof || size != 16) return -EPROTO;
+ if (get_unaligned_be32(bytes + 12) != usb4_cfg_crc(bytes, 12)) return -EBADMSG;
+ hi = get_unaligned_be32(bytes);
+ value = get_unaligned_be32(bytes + 8);
+ if ((hi & 0xffc00000) != BIT(31) || (value & 0x7fffffc0)) return -EPROTO;
+ event->route = (u64)(hi & 0x003fffff) << 32 | get_unaligned_be32(bytes + 4);
+ event->port = value & 63;
+ event->unplug = !!(value & BIT(31));
+ return 0;
+}
+
+int usb4_cfg_ack_plug_encode(const struct usb4_cfg_event *event,
+                            void *frame, size_t capacity)
+{
+ u8 *bytes = frame;
+ if (!event || !frame || event->route >> 54 || event->port > 63) return -EINVAL;
+ if (capacity < 16) return -ENOSPC;
+ put_unaligned_be32(event->route >> 32, bytes);
+ put_unaligned_be32(event->route, bytes + 4);
+ put_unaligned_be32(7U | event->port << 8 |
+                    (event->unplug ? 3U : 2U) << 30, bytes + 8);
+ put_unaligned_be32(usb4_cfg_crc(bytes, 12), bytes + 12);
+ return 16;
+}
