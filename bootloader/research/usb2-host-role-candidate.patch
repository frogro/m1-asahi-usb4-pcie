+static int dm_test_atc_m1_usb2_host_role(struct unit_test_state *uts)
+{
+ const u32 patterns[] = { 0, 0xffffffff, 0xa53629b7 };
+ struct atc_m1_config c;
+ int mode, swap, pattern, i, role, run, off;
+
+ for (mode = 0; mode < 2; mode++) {
+  for (swap = 0; swap < 2; swap++) {
+   for (pattern = 0; pattern < ARRAY_SIZE(patterns); pattern++) {
+    c = setup(); c.mode = mode; c.swapped = swap;
+    fake.reg[ATC_USB2][8 / 4] = patterns[pattern];
+    ut_assertok(atc_m1_start(&c, &fake_io, &fake, true, &fake.stage));
+    role = run = off = -1;
+    for (i = 0; i < fake.writes; i++) {
+     struct atc_trace *t = &fake.trace[i];
+     if (t->region != ATC_USB2) continue;
+     if (t->offset == 0 && (t->value & 7) == 4) off = i;
+     if (t->offset == 8 && role < 0) role = i;
+     if (t->offset == 0 && t->value == 2) run = i;
+    }
+    ut_assert(off >= 0 && role > off && run > role);
+    ut_asserteq(patterns[pattern] | 0x7000, fake.trace[role].value);
+    ut_asserteq(patterns[pattern] | 0x700f, fake.reg[ATC_USB2][8 / 4]);
+   }
+  }
+ }
+ return 0;
+}
+DM_TEST(dm_test_atc_m1_usb2_host_role, 0);
