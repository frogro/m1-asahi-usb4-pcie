+static int dm_test_cd321x_power(struct unit_test_state *uts)
+{
+ struct status_fake f = { .usb4 = true };
+ struct apple_cd321x_power p;
+ ut_assertok(apple_cd321x_power_snapshot(status_read, &f, &p));
+ ut_asserteq(6, f.calls);
+ ut_asserteq(0x108280ef, p.status);
+ ut_asserteq(0xd, p.power_status);
+ ut_asserteq(0, p.system_power_state);
+ f = (struct status_fake){ .usb4 = true, .fault_call = 4, .bad_length = 10 };
+ ut_assertok(apple_cd321x_power_snapshot(status_read, &f, &p));
+ ut_asserteq(0xd, p.power_status);
+ return 0;
+}
+DM_TEST(dm_test_cd321x_power, 0);
+
+static int dm_test_cd321x_power_faults(struct unit_test_state *uts)
+{
+ struct apple_cd321x_power p, expected;
+ struct status_fake f;
+ int call, len;
+ const int sizes[] = {4, 4, 4, 2, 1, 4};
+ memset(&expected, 0xa5, sizeof(expected));
+ for (call = 1; call <= 6; call++) {
+  for (len = 0; len <= 255; len++) {
+   if (len == sizes[call-1] || (call == 4 && len == 10)) continue;
+   f = (struct status_fake){ .usb4 = true, .fault_call = call, .bad_length = len };
+   p = expected;
+   ut_asserteq(-EPROTO, apple_cd321x_power_snapshot(status_read, &f, &p));
+   ut_asserteq(call, f.calls);
+   ut_assertok(memcmp(&p, &expected, sizeof(p)));
+  }
+  f = (struct status_fake){ .usb4 = true, .fault_call = call, .transport = -ETIMEDOUT };
+  p = expected;
+  ut_asserteq(-ETIMEDOUT, apple_cd321x_power_snapshot(status_read, &f, &p));
+  ut_asserteq(call, f.calls);
+  ut_assertok(memcmp(&p, &expected, sizeof(p)));
+ }
+ for (call = 0; call < 3; call++) {
+  f = (struct status_fake){ .usb4 = true, .wrong_vendor = call == 0,
+       .wrong_mode = call == 1, .changed_power = call == 2 };
+  p = expected;
+  ut_asserteq(call ? -EAGAIN : -ENODEV, apple_cd321x_power_snapshot(status_read, &f, &p));
+  ut_assertok(memcmp(&p, &expected, sizeof(p)));
+ }
+ ut_asserteq(-EINVAL, apple_cd321x_power_snapshot(NULL, &f, &p));
+ ut_asserteq(-EINVAL, apple_cd321x_power_snapshot(status_read, &f, NULL));
+ return 0;
+}
+DM_TEST(dm_test_cd321x_power_faults, 0);
