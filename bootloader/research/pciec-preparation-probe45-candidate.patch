+ unsigned int calls, writes, status_reads, delay_us, fail_at, ready_after;
+ bool dump, invalid_status, initial_ready;
+} fake;
+static const u32 limits[] = {0x4000, 0x4000, 0x8000, 0x4000, 0x10000};
+static void setup(struct pciec_m1_config *cfg)
+{
+ unsigned int g, count;
+ memset(&fake, 0, sizeof(fake));
+ memset(cfg, 0, sizeof(*cfg));
+ fake.ready_after = 1;
+ for (g = 0; g < 5; g++) {
+  const struct pciec_m1_tunable *ref = pciec_m1_reference(g, &count);
+  cfg->count[g] = count;
+  memcpy(cfg->group[g], ref, count * sizeof(*ref));
+ }
+}
+static int rd(void *unused, unsigned int g, u32 off, u32 *value)
+{
+ if (g >= 5 || off % 4 || off >= limits[g]) return -ERANGE;
+ fake.calls++;
+ if (fake.calls == fake.fail_at) return -ETIMEDOUT;
+ if (g == PCIEC_PORT && off == 0x804) {
+  fake.status_reads++;
+  if (fake.initial_ready) *value = 3;
+  else if (fake.invalid_status) *value = ~0U;
+  else *value = fake.writes && fake.status_reads > fake.ready_after ? 3 : 0;
+ } else *value = fake.mem[g][off/4];
+ if (fake.dump) printf("PCIEC-TEST R %u %x %x\n", g, off, *value);
+ return 0;
+}
+static int wr(void *unused, unsigned int g, u32 off, u32 value)
+{
+ if (g >= 5 || off % 4 || off >= limits[g]) return -ERANGE;
+ fake.calls++;
+ if (fake.calls == fake.fail_at) return -ETIMEDOUT;
+ fake.writes++;
+ fake.mem[g][off/4] = value;
+ if (fake.dump) printf("PCIEC-TEST W %u %x %x\n", g, off, value);
+ return 0;
+}
+static void delay(void *unused, unsigned int us) { fake.delay_us += us; }
+static const struct pciec_m1_io io = {rd, wr, delay};
+
+static int dm_test_pciec_m1_sequence(struct unit_test_state *uts)
+{
+ struct pciec_m1_config cfg;
+ u32 status;
+ unsigned int i;
+ setup(&cfg); fake.dump = true;
+ ut_assertok(pciec_m1_prepare(&cfg, &io, NULL, &status));
+ ut_asserteq(3, status);
+ ut_asserteq(2, fake.status_reads);
+ ut_asserteq(0, fake.delay_us);
+ for (i = 0; i < 64; i++) ut_asserteq(0, fake.mem[PCIEC_PORT][(0x828+4*i)/4]);
+ ut_asserteq(0x100001, fake.mem[PCIEC_PORT][0x800/4]);
+ ut_asserteq(1, fake.mem[PCIEC_PORT][0x814/4]);
+ ut_asserteq(0, fake.mem[PCIEC_PORT][0x80/4]);
+ ut_asserteq(3, fake.mem[PCIEC_PORT][0x4020/4]);
+ return 0;
+}
+DM_TEST(dm_test_pciec_m1_sequence, 0);
+
+static int dm_test_pciec_m1_validation(struct unit_test_state *uts)
+{
+ struct pciec_m1_config cfg;
+ unsigned int g, i, f;
+ u32 status = 0x12345678;
+ for (g = 0; g < 5; g++) {
+  setup(&cfg); cfg.count[g] = 0;
+  ut_asserteq(-EINVAL, pciec_m1_prepare(&cfg, &io, NULL, &status));
+  ut_asserteq(0, fake.calls);
+  setup(&cfg); cfg.count[g] = PCIEC_M1_MAX_TUNABLES + 1;
+  ut_asserteq(-EINVAL, pciec_m1_prepare(&cfg, &io, NULL, &status));
+  ut_asserteq(0, fake.calls);
+  setup(&cfg);
+  for (i = 0; i < cfg.count[g]; i++) for (f = 0; f < 3; f++) {
+   u32 *field = f == 0 ? &cfg.group[g][i].offset : f == 1 ? &cfg.group[g][i].mask : &cfg.group[g][i].value;
+   *field ^= 1;
+   ut_asserteq(-EINVAL, pciec_m1_prepare(&cfg, &io, NULL, &status));
+   ut_asserteq(0, fake.calls); *field ^= 1;
+  }
+ }
+ ut_asserteq(0x12345678, status);
+ ut_asserteq(-EINVAL, pciec_m1_prepare(NULL, &io, NULL, &status));
+ setup(&cfg);
+ ut_asserteq(-EINVAL, pciec_m1_prepare(&cfg, NULL, NULL, &status));
+ ut_asserteq(-EINVAL, pciec_m1_prepare(&cfg, &io, NULL, NULL));
+ return 0;
+}
+DM_TEST(dm_test_pciec_m1_validation, 0);
+
+static int dm_test_pciec_m1_faults(struct unit_test_state *uts)
+{
+ struct pciec_m1_config cfg;
+ u32 status;
+ unsigned int count, i;
+ setup(&cfg); ut_assertok(pciec_m1_prepare(&cfg, &io, NULL, &status)); count = fake.calls;
+ for (i = 1; i <= count; i++) {
+  setup(&cfg); fake.fail_at = i;
+  ut_asserteq(-ETIMEDOUT, pciec_m1_prepare(&cfg, &io, NULL, &status));
+  ut_asserteq(i, fake.calls);
+ }
+ printf("PCIEC-FAULT-CASES %u\n", count);
+ return 0;
+}
+DM_TEST(dm_test_pciec_m1_faults, 0);
+
+static int dm_test_pciec_m1_ready(struct unit_test_state *uts)
+{
+ struct pciec_m1_config cfg;
+ u32 status;
+ setup(&cfg); fake.initial_ready = true;
+ ut_assertok(pciec_m1_prepare(&cfg, &io, NULL, &status));
+ ut_asserteq(1, fake.calls); ut_asserteq(0, fake.writes);
+ setup(&cfg); fake.invalid_status = true;
+ ut_asserteq(-ENODEV, pciec_m1_prepare(&cfg, &io, NULL, &status));
+ ut_asserteq(1, fake.calls); ut_asserteq(0, fake.writes);
+ setup(&cfg); fake.ready_after = 4;
+ ut_assertok(pciec_m1_prepare(&cfg, &io, NULL, &status));
+ ut_asserteq(30, fake.delay_us);
+ setup(&cfg); fake.ready_after = 30000;
+ ut_asserteq(-ETIMEDOUT, pciec_m1_prepare(&cfg, &io, NULL, &status));
+ ut_asserteq(25001, fake.status_reads); ut_asserteq(250000, fake.delay_us);
+ return 0;
+}
+DM_TEST(dm_test_pciec_m1_ready, 0);
