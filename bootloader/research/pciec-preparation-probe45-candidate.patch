+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef APPLE_PCIEC_M1_H
+#define APPLE_PCIEC_M1_H
+#include <linux/types.h>
+#define PCIEC_M1_GROUPS 5
+#define PCIEC_M1_MAX_TUNABLES 27
+/* Group/region order follows the cold preparation sequence, not DT order. */
+enum pciec_m1_region { PCIEC_DEBUG, PCIEC_FABRIC, PCIEC_PORT, PCIEC_OE, PCIEC_CONFIG };
+struct pciec_m1_tunable { u32 offset, mask, value; };
+struct pciec_m1_config {
+ struct pciec_m1_tunable group[PCIEC_M1_GROUPS][PCIEC_M1_MAX_TUNABLES];
+ unsigned int count[PCIEC_M1_GROUPS];
+};
+struct pciec_m1_io {
+ int (*read)(void *, unsigned int, u32, u32 *);
+ int (*write)(void *, unsigned int, u32, u32);
+ void (*delay)(void *, unsigned int);
+};
+const struct pciec_m1_tunable *pciec_m1_reference(unsigned int, unsigned int *);
+int pciec_m1_validate(const struct pciec_m1_config *);
+int pciec_m1_prepare(const struct pciec_m1_config *, const struct pciec_m1_io *, void *, u32 *);
+int apple_pciec_m1_check(void);
+int apple_pciec_m1_prepare(void *);
+#endif
