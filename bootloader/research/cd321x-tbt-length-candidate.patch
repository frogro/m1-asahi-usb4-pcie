--- a/lib/apple_cd321x.c
+++ b/lib/apple_cd321x.c
@@ -5,6 +5,7 @@
  * and core.c (TI and The Asahi Linux Contributors). No mode commands.
  */
 #include <apple_cd321x.h>
+#include <stdio.h>
 #include <linux/bitops.h>
 #include <linux/errno.h>
 #include <linux/string.h>
@@ -22,8 +23,15 @@
 	if (ret)
 		return ret;
 	/* Unknown layouts must not become lane or cable configuration. */
-	if (buf[0] != size)
+	/* CD321x Intel VID status reports 11 bytes on measured TB3 hardware.
+	 * Linux consumes the documented nine-byte prefix; trailing bytes are unused.
+	 * Keep all other lengths strict, including unknown Intel layouts.
+	 */
+	if (buf[0] != size && !(reg == 0x59 && size == 9 && buf[0] == 11)) {
+		printf("CD321X-LENGTH reg=%02x expected=%u reported=%u\n",
+		       reg, (unsigned int)size, buf[0]);
 		return -EPROTO;
+	}
 	memcpy(data, buf + 1, size);
 	return 0;
 }
