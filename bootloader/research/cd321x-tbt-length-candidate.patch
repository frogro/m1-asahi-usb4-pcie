@@ -7,7 +7,7 @@
 #include <test/ut.h>
 
 struct status_fake {
-	bool usb4, tbt, changed_tbt, wrong_vendor, wrong_mode, changed;
+	bool real_tbt, usb4, tbt, changed_tbt, wrong_vendor, wrong_mode, changed;
