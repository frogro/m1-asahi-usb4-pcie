diff --git a/test/dm/apple_cd321x.c b/test/dm/apple_cd321x.c
new file mode 100644
index 00000000..cc6ce95d
--- /dev/null
+++ b/test/dm/apple_cd321x.c
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <apple_cd321x.h>
+#include <command.h>
+#include <dm.h>
+#include <dm/test.h>
+#include <test/test.h>
+#include <test/ut.h>
+
+struct status_fake {
+	bool real_tbt, usb4, tbt, changed_tbt, changed_power, wrong_vendor, wrong_mode, changed;
+	int calls, fault_call, transport;
+	u8 bad_length;
+};
+
+/* Independent byte vectors from the two real M1 UART recordings. */
+static int status_read(void *ctx, u8 reg, u8 *buf, size_t size)
+{
+	struct status_fake *f = ctx;
+	static const u8 vid[] = { 4, 0x28, 0, 0, 0 };
+	static const u8 power[] = { 2, 0x0d, 0 }; /* synthetic PD/source/connected */
+	static const u8 system[] = { 1, 0 };
+	static const u8 mode[] = { 4, 'A', 'P', 'P', ' ' };
+	static const u8 usb_status[] = { 4, 0xfd, 0x48, 2, 0x10 };
+	static const u8 owc_status[] = { 4, 0xef, 0x80, 0x82, 0x10 };
+	static const u8 usb_data[] = { 5, 0x73, 0, 0, 0, 0 };
+	static const u8 owc_data[] = { 5, 0x11, 0, 0xc0, 0x16, 0 };
+	static const u8 usb4[] = { 9, 7, 0, 0xe0, 0x67, 0x26, 0, 0, 0, 0 };
+	/* Synthetic TB3 status/Intel VDO vector, not a hardware capture. */
+	static const u8 tbt_data[] = { 5, 1, 0, 1, 6, 0 };
+	static const u8 tbt_vid[] = { 9, 1, 0, 0, 0, 0, 0x12, 0x34, 1, 0 };
+	/* Linux capture on this M1/Yottamaster: prefix 11, nine fields read. */
+	static const u8 real_tbt_data[] = { 5, 3, 0, 1, 6, 0 };
+	static const u8 real_tbt_vid[] = { 11, 3, 0, 0, 0, 0, 3, 0, 0, 0 };
+	const u8 *data;
+	size_t len;
+
+	f->calls++;
+	if (f->calls == f->fault_call && f->transport)
+		return f->transport;
+	switch (reg) {
+	case 0:
+		data = vid;
+		len = sizeof(vid);
+		break;
+	case 3:
+		data = mode;
+		len = sizeof(mode);
+		break;
+	case 0x1a:
+		data = f->usb4 ? owc_status : usb_status;
+		len = sizeof(usb_status);
+		break;
+	case 0x3f:
+		data = power; len = sizeof(power); break;
+	case 0x20:
+		data = system; len = sizeof(system); break;
+	case 0x5f:
+		data = f->real_tbt ? real_tbt_data : f->tbt ? tbt_data : f->usb4 ? owc_data : usb_data;
+		len = sizeof(usb_data);
+		break;
+	case 0x59:
+		data = f->real_tbt ? real_tbt_vid : tbt_vid;
+		len = sizeof(tbt_vid);
+		break;
+	case 0x24:
+		data = usb4;
+		len = sizeof(usb4);
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (size != len)
+		return -EINVAL;
+	memcpy(buf, data, size);
+	if (f->changed_power && reg == 0x1a && f->calls == 6) buf[1] ^= 1;
+	if (f->wrong_vendor && !reg)
+		buf[1] = 0;
+	if (f->wrong_mode && reg == 3)
+		buf[1] = 'B';
+	if (f->changed && reg == 0x5f && f->calls > 4)
+		buf[1] ^= 2;
+	if (f->changed_tbt && reg == 0x59 && f->calls == 6)
+		buf[8] ^= 1;
+	if (f->calls == f->fault_call)
+		buf[0] = f->bad_length;
+	return 0;
+}
+
+static int dm_test_cd321x_vectors(struct unit_test_state *uts)
+{
+	struct status_fake f = {};
+	struct apple_cd321x_status s;
+
+	ut_assertok(apple_cd321x_snapshot(status_read, &f, &s));
+	ut_asserteq(5, f.calls);
+	ut_asserteq(0x100248fd, s.status);
+	ut_asserteq(0x73, s.data_status);
+	ut_asserteq(0, s.eudo);
+	ut_asserteq(0, s.usb4_mode);
+	f = (struct status_fake){ .usb4 = true };
+	ut_assertok(apple_cd321x_snapshot(status_read, &f, &s));
+	ut_asserteq(6, f.calls);
+	ut_asserteq(0x108280ef, s.status);
+	ut_asserteq(0x16c00011, s.data_status);
+	ut_asserteq(0x2667e000, s.eudo);
+	ut_asserteq(7, s.usb4_mode);
+	return 0;
+}
+
+DM_TEST(dm_test_cd321x_vectors, 0);
+
+static int dm_test_cd321x_lengths(struct unit_test_state *uts)
+{
+	struct apple_cd321x_status s, expected;
+	struct status_fake f;
+	int call, i;
+	u8 lengths[] = { 0, 1, 63, 255 };
+
+	memset(&expected, 0xa5, sizeof(expected));
+	for (call = 1; call <= 6; call++) {
+		for (i = 0; i < ARRAY_SIZE(lengths); i++) {
+			f = (struct status_fake){ .usb4 = true,
+				.fault_call = call, .bad_length = lengths[i] };
+			s = expected;
+			ut_asserteq(-EPROTO, apple_cd321x_snapshot(status_read, &f, &s));
+			ut_asserteq(call, f.calls);
+			ut_assertok(memcmp(&s, &expected, sizeof(s)));
+		}
+	}
+	return 0;
+}
+
+DM_TEST(dm_test_cd321x_lengths, 0);
+
+static int dm_test_cd321x_transport(struct unit_test_state *uts)
+{
+	struct apple_cd321x_status s, expected;
+	struct status_fake f;
+	int call;
+
+	memset(&expected, 0xa5, sizeof(expected));
+	for (call = 1; call <= 6; call++) {
+		f = (struct status_fake){ .usb4 = true,
+			.fault_call = call, .transport = -ETIMEDOUT };
+		s = expected;
+		ut_asserteq(-ETIMEDOUT, apple_cd321x_snapshot(status_read, &f, &s));
+		ut_asserteq(call, f.calls);
+		ut_assertok(memcmp(&s, &expected, sizeof(s)));
+	}
+	return 0;
+}
+
+DM_TEST(dm_test_cd321x_transport, 0);
+
+static int dm_test_cd321x_state(struct unit_test_state *uts)
+{
+	struct apple_cd321x_status s, expected;
+	struct status_fake f;
+	int i;
+
+	memset(&expected, 0xa5, sizeof(expected));
+	for (i = 0; i < 3; i++) {
+		f = (struct status_fake){ .usb4 = true,
+			.wrong_vendor = i == 0, .wrong_mode = i == 1,
+			.changed = i == 2 };
+		s = expected;
+		ut_asserteq(i ? -EAGAIN : -ENODEV,
+			    apple_cd321x_snapshot(status_read, &f, &s));
+		ut_assertok(memcmp(&s, &expected, sizeof(s)));
+	}
+	ut_asserteq(-EINVAL, apple_cd321x_snapshot(NULL, &f, &s));
+	ut_asserteq(-EINVAL, apple_cd321x_snapshot(status_read, &f, NULL));
+	return 0;
+}
+
+DM_TEST(dm_test_cd321x_state, 0);
+
+#if CONFIG_IS_ENABLED(CMD_APPLE_CD321X)
+static int dm_test_cd321x_command_args(struct unit_test_state *uts)
+{
+	/* Bad input is rejected before bus discovery or I2C transfers. */
+	ut_asserteq(1, run_command("cd321x", 0));
+	ut_asserteq(1, run_command("cd321x 256 3f", 0));
+	ut_asserteq(1, run_command("cd321x 0 50", 0));
+	ut_asserteq(1, run_command("cd321x 0 3fz", 0));
+	ut_asserteq(1, run_command("cd321x bogus 3f", 0));
+	return 0;
+}
+
+DM_TEST(dm_test_cd321x_command_args, 0);
+#endif
+
+static int dm_test_cd321x_tbt(struct unit_test_state *uts)
+{
+ struct status_fake f = { .tbt = true };
+ struct apple_cd321x_status s;
+ ut_assertok(apple_cd321x_snapshot(status_read, &f, &s));
+ ut_asserteq(7, f.calls);
+ ut_asserteq(0x06010001, s.data_status);
+ ut_asserteq(0x00010001, s.tbt_device_mode);
+ ut_asserteq(0x34120000, s.tbt_enter_vdo);
+ ut_asserteq(0, s.eudo);
+ return 0;
+}
+DM_TEST(dm_test_cd321x_tbt, 0);
+
+static int dm_test_cd321x_tbt_faults(struct unit_test_state *uts)
+{
+ struct apple_cd321x_status s, expected;
+ struct status_fake f;
+ int call, kind;
+ memset(&expected, 0xa5, sizeof(expected));
+ for (call = 1; call <= 7; call++) {
+  for (kind = 0; kind < 2; kind++) {
+   f = (struct status_fake){ .tbt = true, .fault_call = call,
+        .bad_length = 255, .transport = kind ? -ETIMEDOUT : 0 };
+   s = expected;
+   ut_asserteq(kind ? -ETIMEDOUT : -EPROTO,
+              apple_cd321x_snapshot(status_read, &f, &s));
+   ut_assertok(memcmp(&s, &expected, sizeof(s)));
+   ut_asserteq(call, f.calls);
+  }
+ }
+ f = (struct status_fake){ .tbt = true, .changed_tbt = true };
+ s = expected;
+ ut_asserteq(-EAGAIN, apple_cd321x_snapshot(status_read, &f, &s));
+ ut_assertok(memcmp(&s, &expected, sizeof(s)));
+ return 0;
+}
+DM_TEST(dm_test_cd321x_tbt_faults, 0);
+
+static int dm_test_cd321x_tbt_measured_length(struct unit_test_state *uts)
+{
+ struct status_fake f = { .tbt = true, .real_tbt = true };
+ struct apple_cd321x_status s, expected;
+ int call, len;
+ ut_assertok(apple_cd321x_snapshot(status_read, &f, &s));
+ ut_asserteq(7, f.calls);
+ ut_asserteq(0x06010003, s.data_status);
+ ut_asserteq(1, s.tbt_device_mode);
+ ut_asserteq(0x00030000, s.tbt_enter_vdo);
+ memset(&expected, 0xa5, sizeof(expected));
+ for (call = 5; call <= 6; call++) {
+  for (len = 0; len <= 255; len++) {
+   f = (struct status_fake){ .tbt = true, .real_tbt = true,
+                            .fault_call = call, .bad_length = len };
+   s = expected;
+   ut_asserteq((len == 9 || len == 11) ? 0 : -EPROTO,
+              apple_cd321x_snapshot(status_read, &f, &s));
+   if (len != 9 && len != 11)
+    ut_assertok(memcmp(&s, &expected, sizeof(s)));
+  }
+ }
+ f = (struct status_fake){ .tbt = true, .real_tbt = true, .changed_tbt = true };
+ s = expected;
+ ut_asserteq(-EAGAIN, apple_cd321x_snapshot(status_read, &f, &s));
+ ut_assertok(memcmp(&s, &expected, sizeof(s)));
+ return 0;
+}
+DM_TEST(dm_test_cd321x_tbt_measured_length, 0);
+
+static int dm_test_cd321x_power(struct unit_test_state *uts)
+{
+ struct status_fake f = { .usb4 = true };
+ struct apple_cd321x_power p;
+ ut_assertok(apple_cd321x_power_snapshot(status_read, &f, &p));
+ ut_asserteq(6, f.calls);
+ ut_asserteq(0x108280ef, p.status);
+ ut_asserteq(0xd, p.power_status);
+ ut_asserteq(0, p.system_power_state);
+ f = (struct status_fake){ .usb4 = true, .fault_call = 4, .bad_length = 10 };
+ ut_assertok(apple_cd321x_power_snapshot(status_read, &f, &p));
+ ut_asserteq(0xd, p.power_status);
+ return 0;
+}
+DM_TEST(dm_test_cd321x_power, 0);
+
+static int dm_test_cd321x_power_faults(struct unit_test_state *uts)
+{
+ struct apple_cd321x_power p, expected;
+ struct status_fake f;
+ int call, len;
+ const int sizes[] = {4, 4, 4, 2, 1, 4};
+ memset(&expected, 0xa5, sizeof(expected));
+ for (call = 1; call <= 6; call++) {
+  for (len = 0; len <= 255; len++) {
+   if (len == sizes[call-1] || (call == 4 && len == 10)) continue;
+   f = (struct status_fake){ .usb4 = true, .fault_call = call, .bad_length = len };
+   p = expected;
+   ut_asserteq(-EPROTO, apple_cd321x_power_snapshot(status_read, &f, &p));
+   ut_asserteq(call, f.calls);
+   ut_assertok(memcmp(&p, &expected, sizeof(p)));
+  }
+  f = (struct status_fake){ .usb4 = true, .fault_call = call, .transport = -ETIMEDOUT };
+  p = expected;
+  ut_asserteq(-ETIMEDOUT, apple_cd321x_power_snapshot(status_read, &f, &p));
+  ut_asserteq(call, f.calls);
+  ut_assertok(memcmp(&p, &expected, sizeof(p)));
+ }
+ for (call = 0; call < 3; call++) {
+  f = (struct status_fake){ .usb4 = true, .wrong_vendor = call == 0,
+       .wrong_mode = call == 1, .changed_power = call == 2 };
+  p = expected;
+  ut_asserteq(call ? -EAGAIN : -ENODEV, apple_cd321x_power_snapshot(status_read, &f, &p));
+  ut_assertok(memcmp(&p, &expected, sizeof(p)));
+ }
+ ut_asserteq(-EINVAL, apple_cd321x_power_snapshot(NULL, &f, &p));
+ ut_asserteq(-EINVAL, apple_cd321x_power_snapshot(status_read, &f, NULL));
+ return 0;
+}
+DM_TEST(dm_test_cd321x_power_faults, 0);
diff --git a/test/dm/apple_dart.c b/test/dm/apple_dart.c
new file mode 100644
index 00000000..f0b5f441
--- /dev/null
+++ b/test/dm/apple_dart.c
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Register-level tests; no ACIO firmware or actual DMA is emulated. */
+
+#include <dm.h>
+#include <iommu.h>
+#include <dm/device-internal.h>
+#include <dm/test.h>
+#include <dm/uclass.h>
+#include <mapmem.h>
+#include <asm/io.h>
+#include <asm/test.h>
+#include <test/test.h>
+#include <test/ut.h>
+
+static int check_dart_registers(struct unit_test_state *uts, bool usb4,
+				bool bypass)
+{
+	struct udevice *dev;
+	const char *name = usb4 ? "apple-dart@5004000" : "apple-dart@5000000";
+	u32 *regs = map_sysmem(usb4 ? 0x05004000 : 0x05000000, 0x4000);
+	int sid, idx, streams = usb4 ? 64 : 16;
+	int ttbr = usb4 ? 0x400 : 0x200;
+
+	sandbox_set_enable_memio(true);
+	memset(regs, 0, 0x4000);
+	/* USB4 must translate even if the generic bypass bit is advertised. */
+	writel(bypass ? 1 : 0, &regs[0x4 / 4]);
+	ut_assertok(uclass_get_device_by_name(UCLASS_IOMMU, name, &dev));
+	ut_asserteq(usb4 ? 0xffffffff : 0xffff, readl(&regs[0x34 / 4]));
+	ut_asserteq(usb4 ? 0xffffffff : 0, readl(&regs[0x38 / 4]));
+	ut_asserteq(BIT(20), readl(&regs[0x20 / 4]));
+	for (sid = 0; sid < streams; sid++) {
+		u32 expected = bypass && !usb4 ? BIT(8) | BIT(12) : BIT(7);
+
+		ut_asserteq(expected, readl(&regs[(0x100 + 4 * sid) / 4]));
+		ut_asserteq(!(bypass && !usb4),
+			    !!(readl(&regs[(ttbr + 16 * sid) / 4]) & BIT(31)));
+	}
+	if (!bypass || usb4)
+		ut_asserteq(0xffffffff, readl(&regs[0xfc / 4]));
+	/* The hardware-tested USB4 layout starts one word before T8020. */
+	ut_asserteq(usb4 ? 0xffffffff : 0, readl(&regs[0xf8 / 4]));
+	ut_assertok(device_remove(dev, DM_REMOVE_NORMAL));
+	for (sid = 0; sid < streams; sid++) {
+		ut_asserteq(0, readl(&regs[(0x100 + 4 * sid) / 4]));
+		for (idx = 0; idx < 4; idx++)
+			ut_asserteq(0, readl(&regs[(ttbr + 16 * sid + 4 * idx) / 4]));
+	}
+	unmap_sysmem(regs);
+	return 0;
+}
+
+static int dm_test_apple_dart_usb4(struct unit_test_state *uts)
+{
+	return check_dart_registers(uts, true, false);
+}
+
+DM_TEST(dm_test_apple_dart_usb4, UTF_SCAN_FDT);
+
+static int dm_test_apple_dart_usb4_no_bypass(struct unit_test_state *uts)
+{
+	return check_dart_registers(uts, true, true);
+}
+
+DM_TEST(dm_test_apple_dart_usb4_no_bypass, UTF_SCAN_FDT);
+
+static int dm_test_apple_dart_t8103_translate(struct unit_test_state *uts)
+{
+	return check_dart_registers(uts, false, false);
+}
+
+DM_TEST(dm_test_apple_dart_t8103_translate, UTF_SCAN_FDT);
+
+static int dm_test_apple_dart_t8103_bypass(struct unit_test_state *uts)
+{
+	return check_dart_registers(uts, false, true);
+}
+
+DM_TEST(dm_test_apple_dart_t8103_bypass, UTF_SCAN_FDT);
+
+/* These mappings program tables only: no peripheral performs actual DMA. */
+static int dm_test_apple_dart_map_reject(struct unit_test_state *uts)
+{
+	struct udevice *dev;
+	const struct iommu_ops *ops;
+	u32 *regs = map_sysmem(0x05004000, 0x4000);
+
+	sandbox_set_enable_memio(true);
+	memset(regs, 0, 0x4000);
+	ut_assertok(uclass_get_device_by_name(UCLASS_IOMMU,
+					    "apple-dart@5004000", &dev));
+	ops = device_get_ops(dev);
+	writel(0, &regs[0x20 / 4]);
+	ut_asserteq(0, ops->map(dev, (void *)0x100000, 0));
+	ut_asserteq(0, readl(&regs[0x20 / 4]));
+	ut_asserteq(0, ops->map(dev, (void *)0x100000, (size_t)-1));
+	ut_asserteq(0, ops->map(dev, (void *)(uintptr_t)-16, 32));
+	ut_asserteq(0, ops->map(dev, (void *)0x100000, 1ULL << 32));
+	ut_asserteq(0, readl(&regs[0x20 / 4]));
+	ut_assertok(device_remove(dev, DM_REMOVE_NORMAL));
+	unmap_sysmem(regs);
+	return 0;
+}
+DM_TEST(dm_test_apple_dart_map_reject, UTF_SCAN_FDT);
+
+static int dm_test_apple_dart_map_exhaust(struct unit_test_state *uts)
+{
+	struct udevice *dev;
+	const struct iommu_ops *ops;
+	u32 *regs = map_sysmem(0x05004000, 0x4000);
+	/* The entire supported IOVA aperture, excluding the two guard pages. */
+	size_t aperture = (1ULL << 32) - 2 * 16384;
+	dma_addr_t first, again;
+
+	sandbox_set_enable_memio(true);
+	memset(regs, 0, 0x4000);
+	ut_assertok(uclass_get_device_by_name(UCLASS_IOMMU,
+					    "apple-dart@5004000", &dev));
+	ops = device_get_ops(dev);
+	first = ops->map(dev, (void *)0x4000, aperture);
+	ut_asserteq(16384, first);
+	writel(0, &regs[0x20 / 4]);
+	ut_asserteq(0, ops->map(dev, (void *)0x100000, 16384));
+	/* Exhaustion must not install a mapping at reserved IOVA zero. */
+	ut_asserteq(0, readl(&regs[0x20 / 4]));
+	ops->unmap(dev, first, aperture);
+	again = ops->map(dev, (void *)0x4000, aperture);
+	ut_asserteq(first, again);
+	ops->unmap(dev, again, aperture);
+	ut_assertok(device_remove(dev, DM_REMOVE_NORMAL));
+	unmap_sysmem(regs);
+	return 0;
+}
+DM_TEST(dm_test_apple_dart_map_exhaust, UTF_SCAN_FDT);
+
+static int dm_test_apple_dart_unmap_bounds(struct unit_test_state *uts)
+{
+	struct udevice *dev;
+	const struct iommu_ops *ops;
+	u32 *regs = map_sysmem(0x05004000, 0x4000);
+	dma_addr_t addr, again;
+
+	sandbox_set_enable_memio(true);
+	memset(regs, 0, 0x4000);
+	ut_assertok(uclass_get_device_by_name(UCLASS_IOMMU,
+					    "apple-dart@5004000", &dev));
+	ops = device_get_ops(dev);
+	addr = ops->map(dev, (void *)0x100123, 17000);
+	ut_assert(addr != 0);
+	ut_asserteq(0x123, addr & 0x3fff);
+	writel(0, &regs[0x20 / 4]);
+	ops->unmap(dev, 0, 16384);
+	ops->unmap(dev, (dma_addr_t)-16, 32);
+	ops->unmap(dev, addr, (size_t)-1);
+	ops->unmap(dev, addr, 0);
+	ut_asserteq(0, readl(&regs[0x20 / 4]));
+	ops->unmap(dev, addr, 17000);
+	again = ops->map(dev, (void *)0x100123, 17000);
+	ut_asserteq(addr, again);
+	ops->unmap(dev, again, 17000);
+	ut_assertok(device_remove(dev, DM_REMOVE_NORMAL));
+	unmap_sysmem(regs);
+	return 0;
+}
+DM_TEST(dm_test_apple_dart_unmap_bounds, UTF_SCAN_FDT);
diff --git a/test/dm/apple_mbox.c b/test/dm/apple_mbox.c
new file mode 100644
index 00000000..4904cab0
--- /dev/null
+++ b/test/dm/apple_mbox.c
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Exercise the production mailbox driver with emulated register memory. */
+#include <dm.h>
+#include <dm/test.h>
+#include <dm/uclass.h>
+#include <mailbox.h>
+#include <mapmem.h>
+#include <asm/io.h>
+#include <asm/test.h>
+#include <linux/apple-mailbox.h>
+#include <test/test.h>
+#include <test/ut.h>
+#include <time.h>
+
+static int dm_test_apple_mbox_send(struct unit_test_state *uts)
+{
+	struct mbox_chan chan = {};
+	struct apple_mbox_msg msg = { .msg0 = 0x12345678, .msg1 = 7 };
+	u32 *regs = map_sysmem(0x05008000, 0x1000);
+
+	sandbox_set_enable_memio(true);
+	memset(regs, 0, 0x1000);
+	ut_assertok(uclass_get_device_by_name(UCLASS_MAILBOX,
+					    "mailbox@5008000", &chan.dev));
+	ut_assertok(mbox_send(&chan, &msg));
+	ut_asserteq(msg.msg0, readq((char *)regs + 0x800));
+	ut_asserteq(msg.msg1, readq((char *)regs + 0x808));
+	unmap_sysmem(regs);
+	return 0;
+}
+DM_TEST(dm_test_apple_mbox_send, UTF_SCAN_FDT);
+
+static int dm_test_apple_mbox_full(struct unit_test_state *uts)
+{
+	struct mbox_chan chan = {};
+	struct apple_mbox_msg msg = { .msg0 = 0x12345678, .msg1 = 7 };
+	u32 *regs = map_sysmem(0x05008000, 0x1000);
+	ulong start;
+
+	sandbox_set_enable_memio(true);
+	memset(regs, 0, 0x1000);
+	writel(BIT(16), &regs[0x110 / 4]);
+	ut_assertok(uclass_get_device_by_name(UCLASS_MAILBOX,
+					    "mailbox@5008000", &chan.dev));
+	start = get_timer(0);
+	ut_asserteq(-ETIMEDOUT, mbox_send(&chan, &msg));
+	ut_assert(get_timer(start) < 2000);
+	/* A full queue must not be overwritten. */
+	ut_asserteq(0, readq((char *)regs + 0x800));
+	ut_asserteq(0, readq((char *)regs + 0x808));
+	/* A timeout must not prevent a subsequent send when space returns. */
+	writel(0, &regs[0x110 / 4]);
+	ut_assertok(mbox_send(&chan, &msg));
+	ut_asserteq(msg.msg1, readq((char *)regs + 0x808));
+	unmap_sysmem(regs);
+	return 0;
+}
+DM_TEST(dm_test_apple_mbox_full, UTF_SCAN_FDT);
+
+static int dm_test_apple_mbox_m3(struct unit_test_state *uts)
+{
+	struct mbox_chan chan = {};
+	/* sandbox_write() takes unsigned int and truncates 64-bit TX values.
+	 * Exercise TX layout with 32 bits; preload full RX data via memory.
+	 */
+	struct apple_mbox_msg msg = { .msg0 = 0x89abcdef, .msg1 = 7 };
+	u64 receive0 = 0x123456789abcdef0ULL;
+	u64 receive1 = 0x1234500000000007ULL;
+	struct apple_mbox_msg reply;
+	void *regs = map_sysmem(0x05009000, 0x1000);
+	ulong start;
+
+	sandbox_set_enable_memio(true);
+	memset(regs, 0, 0x1000);
+	writel(0xf, regs + 0x48);
+	ut_assertok(uclass_get_device_by_name(UCLASS_MAILBOX,
+					    "mailbox@5009000", &chan.dev));
+	ut_asserteq(0, readl(regs + 0x48));
+	ut_assertok(mbox_send(&chan, &msg));
+	ut_assert(msg.msg0 == readq(regs + 0x60));
+	ut_assert(msg.msg1 == readq(regs + 0x68));
+	ut_assert(!readq(regs + 0x800) && !readq(regs + 0x808));
+	writel(BIT(17), regs + 0x80);
+	ut_asserteq(-ETIMEDOUT, mbox_recv(&chan, &reply, 0));
+	memcpy(regs + 0xa0, &receive0, sizeof(receive0));
+	memcpy(regs + 0xa8, &receive1, sizeof(receive1));
+	writel(0, regs + 0x80);
+	ut_assertok(mbox_recv(&chan, &reply, 0));
+	ut_assert(reply.msg0 == receive0 && reply.msg1 == 7);
+	ut_asserteq(BIT(3), readl(regs + 0x4c));
+	writel(BIT(16), regs + 0x50);
+	msg.msg0 = 42;
+	start = get_timer(0);
+	ut_asserteq(-ETIMEDOUT, mbox_send(&chan, &msg));
+	ut_assert(get_timer(start) < 2000);
+	ut_assert(readq(regs + 0x60) == 0x89abcdef);
+	writel(0, regs + 0x50);
+	ut_assertok(mbox_send(&chan, &msg));
+	ut_asserteq(42, readq(regs + 0x60));
+	unmap_sysmem(regs);
+	return 0;
+}
+DM_TEST(dm_test_apple_mbox_m3, UTF_SCAN_FDT);
diff --git a/test/dm/apple_pciec_m1.c b/test/dm/apple_pciec_m1.c
new file mode 100644
index 00000000..d99c1795
--- /dev/null
+++ b/test/dm/apple_pciec_m1.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <apple_pciec_m1.h>
+#include <dm.h>
+#include <dm/test.h>
+#include <test/test.h>
+#include <test/ut.h>
+
+static struct {
+ u32 mem[5][0x4000];
+ unsigned int calls, writes, status_reads, delay_us, fail_at, ready_after;
+ bool dump, invalid_status, initial_ready;
+} fake;
+static const u32 limits[] = {0x4000, 0x4000, 0x8000, 0x4000, 0x10000};
+static void setup(struct pciec_m1_config *cfg)
+{
+ unsigned int g, count;
+ memset(&fake, 0, sizeof(fake));
+ memset(cfg, 0, sizeof(*cfg));
+ fake.ready_after = 1;
+ for (g = 0; g < 5; g++) {
+  const struct pciec_m1_tunable *ref = pciec_m1_reference(g, &count);
+  cfg->count[g] = count;
+  memcpy(cfg->group[g], ref, count * sizeof(*ref));
+ }
+}
+static int rd(void *unused, unsigned int g, u32 off, u32 *value)
+{
+ if (g >= 5 || off % 4 || off >= limits[g]) return -ERANGE;
+ fake.calls++;
+ if (fake.calls == fake.fail_at) return -ETIMEDOUT;
+ if (g == PCIEC_PORT && off == 0x804) {
+  fake.status_reads++;
+  if (fake.initial_ready) *value = 3;
+  else if (fake.invalid_status) *value = ~0U;
+  else *value = fake.writes && fake.status_reads > fake.ready_after ? 3 : 0;
+ } else *value = fake.mem[g][off/4];
+ if (fake.dump) printf("PCIEC-TEST R %u %x %x\n", g, off, *value);
+ return 0;
+}
+static int wr(void *unused, unsigned int g, u32 off, u32 value)
+{
+ if (g >= 5 || off % 4 || off >= limits[g]) return -ERANGE;
+ fake.calls++;
+ if (fake.calls == fake.fail_at) return -ETIMEDOUT;
+ fake.writes++;
+ fake.mem[g][off/4] = value;
+ if (fake.dump) printf("PCIEC-TEST W %u %x %x\n", g, off, value);
+ return 0;
+}
+static void delay(void *unused, unsigned int us) { fake.delay_us += us; }
+static const struct pciec_m1_io io = {rd, wr, delay};
+
+static int dm_test_pciec_m1_sequence(struct unit_test_state *uts)
+{
+ struct pciec_m1_config cfg;
+ u32 status;
+ unsigned int i;
+ setup(&cfg); fake.dump = true;
+ ut_assertok(pciec_m1_prepare(&cfg, &io, NULL, &status));
+ ut_asserteq(3, status);
+ ut_asserteq(2, fake.status_reads);
+ ut_asserteq(0, fake.delay_us);
+ for (i = 0; i < 64; i++) ut_asserteq(0, fake.mem[PCIEC_PORT][(0x828+4*i)/4]);
+ ut_asserteq(0x100001, fake.mem[PCIEC_PORT][0x800/4]);
+ ut_asserteq(1, fake.mem[PCIEC_PORT][0x814/4]);
+ ut_asserteq(0, fake.mem[PCIEC_PORT][0x80/4]);
+ ut_asserteq(3, fake.mem[PCIEC_PORT][0x4020/4]);
+ return 0;
+}
+DM_TEST(dm_test_pciec_m1_sequence, 0);
+
+static int dm_test_pciec_m1_validation(struct unit_test_state *uts)
+{
+ struct pciec_m1_config cfg;
+ unsigned int g, i, f;
+ u32 status = 0x12345678;
+ for (g = 0; g < 5; g++) {
+  setup(&cfg); cfg.count[g] = 0;
+  ut_asserteq(-EINVAL, pciec_m1_prepare(&cfg, &io, NULL, &status));
+  ut_asserteq(0, fake.calls);
+  setup(&cfg); cfg.count[g] = PCIEC_M1_MAX_TUNABLES + 1;
+  ut_asserteq(-EINVAL, pciec_m1_prepare(&cfg, &io, NULL, &status));
+  ut_asserteq(0, fake.calls);
+  setup(&cfg);
+  for (i = 0; i < cfg.count[g]; i++) for (f = 0; f < 3; f++) {
+   u32 *field = f == 0 ? &cfg.group[g][i].offset : f == 1 ? &cfg.group[g][i].mask : &cfg.group[g][i].value;
+   *field ^= 1;
+   ut_asserteq(-EINVAL, pciec_m1_prepare(&cfg, &io, NULL, &status));
+   ut_asserteq(0, fake.calls); *field ^= 1;
+  }
+ }
+ ut_asserteq(0x12345678, status);
+ ut_asserteq(-EINVAL, pciec_m1_prepare(NULL, &io, NULL, &status));
+ setup(&cfg);
+ ut_asserteq(-EINVAL, pciec_m1_prepare(&cfg, NULL, NULL, &status));
+ ut_asserteq(-EINVAL, pciec_m1_prepare(&cfg, &io, NULL, NULL));
+ return 0;
+}
+DM_TEST(dm_test_pciec_m1_validation, 0);
+
+static int dm_test_pciec_m1_faults(struct unit_test_state *uts)
+{
+ struct pciec_m1_config cfg;
+ u32 status;
+ unsigned int count, i;
+ setup(&cfg); ut_assertok(pciec_m1_prepare(&cfg, &io, NULL, &status)); count = fake.calls;
+ for (i = 1; i <= count; i++) {
+  setup(&cfg); fake.fail_at = i;
+  ut_asserteq(-ETIMEDOUT, pciec_m1_prepare(&cfg, &io, NULL, &status));
+  ut_asserteq(i, fake.calls);
+ }
+ printf("PCIEC-FAULT-CASES %u\n", count);
+ return 0;
+}
+DM_TEST(dm_test_pciec_m1_faults, 0);
+
+static int dm_test_pciec_m1_ready(struct unit_test_state *uts)
+{
+ struct pciec_m1_config cfg;
+ u32 status;
+ setup(&cfg); fake.initial_ready = true;
+ ut_assertok(pciec_m1_prepare(&cfg, &io, NULL, &status));
+ ut_asserteq(1, fake.calls); ut_asserteq(0, fake.writes);
+ setup(&cfg); fake.invalid_status = true;
+ ut_asserteq(-ENODEV, pciec_m1_prepare(&cfg, &io, NULL, &status));
+ ut_asserteq(1, fake.calls); ut_asserteq(0, fake.writes);
+ setup(&cfg); fake.ready_after = 4;
+ ut_assertok(pciec_m1_prepare(&cfg, &io, NULL, &status));
+ ut_asserteq(30, fake.delay_us);
+ setup(&cfg); fake.ready_after = 30000;
+ ut_asserteq(-ETIMEDOUT, pciec_m1_prepare(&cfg, &io, NULL, &status));
+ ut_asserteq(25001, fake.status_reads); ut_asserteq(250000, fake.delay_us);
+ return 0;
+}
+DM_TEST(dm_test_pciec_m1_ready, 0);
diff --git a/test/dm/usb4_cfg.c b/test/dm/usb4_cfg.c
new file mode 100644
index 00000000..e59b3765
--- /dev/null
+++ b/test/dm/usb4_cfg.c
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <dm.h>
+#include <dm/test.h>
+#include <usb4_cfg.h>
+#include <asm/unaligned.h>
+#include <u-boot/crc.h>
+#include <test/test.h>
+#include <test/ut.h>
+#include "usb4_cfg_vectors.h"
+
+static const struct usb4_cfg_request sample = {
+	.route = 0x0102030405ULL, .offset = 0x123, .port = 3,
+	.space = 2, .seq = 1, .words = 2, .type = USB4_CFG_READ,
+};
+
+/* Separate, existing table-based CRC implementation for reply fault injection. */
+static void reseal(u8 *bytes, size_t size)
+{
+	u32 table[256], crc;
+
+	crc32c_init(table, 0x82f63b78);
+	crc = ~crc32c_cal(~0U, (const char *)bytes, size - 4, table);
+	put_unaligned_be32(crc, bytes + size - 4);
+}
+
+static int dm_test_usb4_cfg_vectors(struct unit_test_state *uts)
+{
+	struct usb4_cfg_request req = sample;
+	u32 data[] = { 0x12345678, 0xabcdef01 };
+	u8 buf[USB4_CFG_FRAME_BYTES];
+
+	ut_asserteq(sizeof(read_request), usb4_cfg_encode(&req, NULL, buf, sizeof(buf)));
+	ut_assertok(memcmp(buf, read_request, sizeof(read_request)));
+	req.type = USB4_CFG_WRITE;
+	ut_asserteq(sizeof(write_request), usb4_cfg_encode(&req, data, buf, sizeof(buf)));
+	ut_assertok(memcmp(buf, write_request, sizeof(write_request)));
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_vectors, 0);
+
+static int dm_test_usb4_cfg_reply(struct unit_test_state *uts)
+{
+	struct usb4_cfg_request req = sample;
+	u32 data[2] = {};
+	unsigned int port = 0;
+
+	ut_assertok(usb4_cfg_decode(&req, read_reply, sizeof(read_reply), 0,
+				   USB4_CFG_READ, data, &port));
+	ut_asserteq(0x12345678, data[0]);
+	ut_asserteq(0xabcdef01, data[1]);
+	ut_asserteq(9, port);
+	req.type = USB4_CFG_WRITE;
+	ut_assertok(usb4_cfg_decode(&req, write_reply, sizeof(write_reply), 0,
+				   USB4_CFG_WRITE, NULL, &port));
+	ut_asserteq(9, port);
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_reply, 0);
+
+static int dm_test_usb4_cfg_input_bounds(struct unit_test_state *uts)
+{
+	struct usb4_cfg_request req;
+	u8 buf[USB4_CFG_FRAME_BYTES], expected[USB4_CFG_FRAME_BYTES];
+	unsigned int i;
+
+	memset(expected, 0xa5, sizeof(expected));
+	for (i = 0; i < 9; i++) {
+		req = sample;
+		switch (i) {
+		case 0:
+			req.route = 1ULL << 54;
+			break;
+		case 1:
+			req.port = 64;
+			break;
+		case 2:
+			req.space = 4;
+			break;
+		case 3:
+			req.seq = 4;
+			break;
+		case 4:
+			req.words = 0;
+			break;
+		case 5:
+			req.words = 61;
+			break;
+		case 6:
+			req.offset = 0x2000;
+			break;
+		case 7:
+			req.offset = 0x1fff;
+			break;
+		case 8:
+			req.type = 9;
+			break;
+		}
+		memcpy(buf, expected, sizeof(buf));
+		ut_asserteq(-EINVAL, usb4_cfg_encode(&req, NULL, buf, sizeof(buf)));
+		ut_assertok(memcmp(buf, expected, sizeof(buf)));
+	}
+	ut_asserteq(-ENOSPC, usb4_cfg_encode(&sample, NULL, buf, 15));
+	ut_assertok(memcmp(buf, expected, sizeof(buf)));
+	ut_asserteq(-EINVAL, usb4_cfg_encode(NULL, NULL, buf, sizeof(buf)));
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_input_bounds, 0);
+
+static int dm_test_usb4_cfg_corrupt(struct unit_test_state *uts)
+{
+	u8 buf[sizeof(read_reply)];
+	u32 data[2];
+	unsigned int i, port;
+
+	for (i = 0; i < sizeof(buf); i++) {
+		memcpy(buf, read_reply, sizeof(buf));
+		buf[i] ^= 0x80;
+		data[0] = data[1] = 0xa5a5a5a5;
+		port = 0xdead;
+		ut_asserteq(-EBADMSG, usb4_cfg_decode(&sample, buf, sizeof(buf), 0,
+						   USB4_CFG_READ, data, &port));
+		ut_asserteq(0xa5a5a5a5, data[0]);
+		ut_asserteq(0xa5a5a5a5, data[1]);
+		ut_asserteq(0xdead, port);
+	}
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_corrupt, 0);
+
+static int dm_test_usb4_cfg_mismatch(struct unit_test_state *uts)
+{
+	u8 buf[sizeof(read_reply)];
+	u32 data[2];
+	unsigned int port, i;
+	/* Valid CRC, but wrong reply flag, reserved bits, address, or transaction. */
+	static const struct { unsigned int word; u32 bit; int error; } faults[] = {
+		{ 0, BIT(31), -EPROTO }, { 0, BIT(30), -EPROTO },
+		{ 1, BIT(0), -EAGAIN }, { 2, BIT(27), -EAGAIN },
+		{ 2, BIT(29), -EPROTO }, { 2, BIT(25), -EPROTO },
+		{ 2, BIT(0), -EPROTO }, { 2, BIT(13), -EPROTO },
+	};
+
+	for (i = 0; i < ARRAY_SIZE(faults); i++) {
+		memcpy(buf, read_reply, sizeof(buf));
+		put_unaligned_be32(get_unaligned_be32(buf + 4 * faults[i].word) ^
+				   faults[i].bit, buf + 4 * faults[i].word);
+		reseal(buf, sizeof(buf));
+		port = 0xdead;
+		data[0] = data[1] = 0xa5a5a5a5;
+		ut_asserteq(faults[i].error, usb4_cfg_decode(&sample, buf, sizeof(buf),
+							  0, USB4_CFG_READ, data, &port));
+		ut_asserteq(0xa5a5a5a5, data[0]);
+		ut_asserteq(0xa5a5a5a5, data[1]);
+		ut_asserteq(0xdead, port);
+	}
+	for (i = 0; i < 16; i++)
+		ut_asserteq(-EPROTO, usb4_cfg_decode(&sample, buf, i, 0,
+						  USB4_CFG_READ, data, &port));
+	ut_asserteq(-EPROTO, usb4_cfg_decode(&sample, read_reply, sizeof(read_reply),
+					  1, USB4_CFG_READ, data, &port));
+	ut_asserteq(-EAGAIN, usb4_cfg_decode(&sample, read_reply, sizeof(read_reply),
+					  0, USB4_CFG_WRITE, data, &port));
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_mismatch, 0);
+
+static int dm_test_usb4_cfg_full_frame(struct unit_test_state *uts)
+{
+	struct usb4_cfg_request req = sample;
+	u8 buf[USB4_CFG_FRAME_BYTES];
+	u32 input[USB4_CFG_MAX_WORDS], output[USB4_CFG_MAX_WORDS];
+	unsigned int i, port;
+
+	for (i = 0; i < ARRAY_SIZE(input); i++)
+		input[i] = 0x12340000 + i;
+	req.type = USB4_CFG_WRITE;
+	req.words = USB4_CFG_MAX_WORDS;
+	ut_asserteq(sizeof(buf), usb4_cfg_encode(&req, input, buf, sizeof(buf)));
+	/* Turn this independently CRC-checked payload into a normal read reply. */
+	put_unaligned_be32(get_unaligned_be32(buf) | BIT(31), buf);
+	reseal(buf, sizeof(buf));
+	req.type = USB4_CFG_READ;
+	ut_assertok(usb4_cfg_decode(&req, buf, sizeof(buf), 0, USB4_CFG_READ,
+				   output, &port));
+	ut_assertok(memcmp(input, output, sizeof(input)));
+	return 0;
+}
+DM_TEST(dm_test_usb4_cfg_full_frame, 0);
diff --git a/test/dm/usb4_cfg_vectors.h b/test/dm/usb4_cfg_vectors.h
new file mode 100644
index 00000000..20b457ea
--- /dev/null
+++ b/test/dm/usb4_cfg_vectors.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Fixed wire vectors generated independently of the codec under test. */
+static const u8 read_request[] = {
+	0x00, 0x00, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05,
+	0x0c, 0x18, 0x41, 0x23, 0x85, 0x4f, 0x38, 0x6b,
+};
+static const u8 write_request[] = {
