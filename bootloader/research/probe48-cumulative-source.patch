+++ b/include/apple_pciec_m1.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef APPLE_PCIEC_M1_H
+#define APPLE_PCIEC_M1_H
+#include <linux/types.h>
+#define PCIEC_M1_GROUPS 5
+#define PCIEC_M1_MAX_TUNABLES 27
+/* Group/region order follows the cold preparation sequence, not DT order. */
+enum pciec_m1_region { PCIEC_DEBUG, PCIEC_FABRIC, PCIEC_PORT, PCIEC_OE, PCIEC_CONFIG };
+struct pciec_m1_tunable { u32 offset, mask, value; };
+struct pciec_m1_config {
+ struct pciec_m1_tunable group[PCIEC_M1_GROUPS][PCIEC_M1_MAX_TUNABLES];
+ unsigned int count[PCIEC_M1_GROUPS];
+};
+struct pciec_m1_io {
+ int (*read)(void *, unsigned int, u32, u32 *);
+ int (*write)(void *, unsigned int, u32, u32);
+ void (*delay)(void *, unsigned int);
+};
+const struct pciec_m1_tunable *pciec_m1_reference(unsigned int, unsigned int *);
+int pciec_m1_validate(const struct pciec_m1_config *);
+int pciec_m1_prepare(const struct pciec_m1_config *, const struct pciec_m1_io *, void *, u32 *);
+int apple_pciec_m1_check(void);
+int apple_pciec_m1_prepare(void *);
+#endif
diff --git a/include/usb4_cfg.h b/include/usb4_cfg.h
new file mode 100644
index 00000000..5caa56f3
--- /dev/null
+++ b/include/usb4_cfg.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __USB4_CFG_H
+#define __USB4_CFG_H
+
+#include <linux/types.h>
+
+#define USB4_CFG_FRAME_BYTES 256
+#define USB4_CFG_MAX_WORDS 60
+#define USB4_CFG_READ 1
+#define USB4_CFG_WRITE 2
+#define USB4_CFG_ERROR 3
+#define USB4_CFG_EVENT 5
+
+struct usb4_cfg_event {
+	u64 route;
+	unsigned int port;
+	bool unplug;
+};
+
+/* Values are deliberately wider than their wire fields for input validation. */
+struct usb4_cfg_request {
+	u64 route;
+	u32 offset;
+	unsigned int port, space, seq, words, type;
+};
+
+/*
+ * Encode one read/write request, including the final CRC32C. The caller sets
+ * both TX SOF and EOF to req->type. Return frame bytes, or a negative errno.
+ * All input validation completes before frame is changed.
+ */
+int usb4_cfg_encode(const struct usb4_cfg_request *req, const u32 *data,
+		    void *frame, size_t capacity);
+
+/*
+ * Decode a normal read/write response from the NHI RX ring. Size includes CRC.
+ * RX SOF must be zero; EOF identifies the response. A different response type,
+ * route or sequence returns -EAGAIN for the caller to dispatch or discard.
+ * In particular, events/error packets need separate handling by the transport.
+ * Response port is the responder's upstream port, not necessarily req->port.
+ * Data and response_port change only after every check succeeds.
+ */
+int usb4_cfg_decode(const struct usb4_cfg_request *req, const void *frame,
+		    size_t size, unsigned int sof, unsigned int eof,
+		    u32 *data, unsigned int *response_port);
+
+/* Validated plug events only. Output is unchanged on failure. */
+int usb4_cfg_decode_event(const void *frame, size_t size, unsigned int sof,
+                         unsigned int eof, struct usb4_cfg_event *event);
+/* Linux tb_cfg_ack_plug wire format; no reply is expected. TX SOF/EOF are 3. */
+int usb4_cfg_ack_plug_encode(const struct usb4_cfg_event *event,
+                            void *frame, size_t capacity);
+
+#endif
diff --git a/lib/apple_acio_prereq.c b/lib/apple_acio_prereq.c
new file mode 100644
index 00000000..15e41bf3
--- /dev/null
+++ b/lib/apple_acio_prereq.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Derived from Asahi Linux reset-apple-cio.c and thunderbolt/apple.c.
+ * Copyright The Asahi Linux Contributors
+ * Copyright (c) Sven Peter <sven@kernel.org>
+ * Original reset driver author: Sven Peter <sven@kernel.org>
+ * Research helpers only; no device binding, power management or firmware boot.
+ */
+#include "apple_acio_prereq.h"
+#include <linux/errno.h>
+
+int acio_m1_deassert(const struct acio_reset_io *io, void *ctx,
+                    unsigned int port, u64 resource_size, u32 *last_status)
+{
+ u32 offset, value;
+ unsigned int elapsed;
+ int ret;
+
+ if (!io || !io->write || !io->read || !io->delay || !last_status || port > 1)
+  return -EINVAL;
+ offset = port * 0x4000;
+ if (resource_size < 4 || offset > resource_size - 4)
+  return -ERANGE;
+ ret = io->write(ctx, offset, 1);
+ if (ret)
+  return ret;
+ for (elapsed = 0; elapsed <= 100000; elapsed += 100) {
+  ret = io->read(ctx, offset, &value);
+  if (ret)
+   return ret;
+  *last_status = value;
+  /* Exact INIT_DONE, not merely a set bit alongside a pending request. */
+  if (value == 4)
+   return 0;
+  if (elapsed < 100000)
+   io->delay(ctx, 100);
+ }
+ return -ETIMEDOUT;
+}
+
+int acio_sram_translate(u64 physical_base, u64 window_size, u64 iova,
+                       u64 bytes, u64 *physical_address)
+{
+ u64 offset;
+
+ if (!physical_address || !bytes || !window_size || iova < 0x10000000ULL)
+  return -EINVAL;
+ offset = iova - 0x10000000ULL;
+ if (offset >= window_size || bytes > window_size - offset)
+  return -ERANGE;
+ if (physical_base > (~(u64)0) - offset ||
+     bytes - 1 > (~(u64)0) - (physical_base + offset))
+  return -EOVERFLOW;
+ *physical_address = physical_base + offset;
+ return 0;
+}
diff --git a/lib/apple_atc_m1.c b/lib/apple_atc_m1.c
new file mode 100644
index 00000000..7b538e64
--- /dev/null
+++ b/lib/apple_atc_m1.c
@@ -0,0 +1,304 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* M1 USB4/TBT PHY sequence derived from drivers/phy/apple/atc.c.
+ * Copyright (C) The Asahi Linux Contributors
+ * Original author: Sven Peter <sven@kernel.org>
+ * The Linux source is GPL-2.0 OR BSD-2-Clause; this port uses GPL-2.0.
+ * Explicit diagnostic only. No device discovery, power ownership or DMA here.
+ */
+#include <apple_atc_m1.h>
+#include <asm/byteorder.h>
+#include <linux/bitops.h>
+#include <linux/errno.h>
+
+#define POWER_CTRL 0x20000
+#define POWER_STAT 0x20004
+#define MISC 0x20008
+#define SMALL BIT(0)
+#define BIG BIT(1)
+#define CLAMP BIT(2)
+#define APB_RESET_N BIT(3)
+#define PHY_RESET_N BIT(4)
+#define LANE_SWAP BIT(2)
+#define PIPE_REQ 0x10
+#define PIPE_ACK 0x14
+
+int atc_m1_usb4_host_check(enum atc_m1_mode mode, u32 data_status)
+{
+	/* CD321x data-status definitions, as used by Linux tipd/core.c. */
+	if (mode != ATC_USB4 || !(data_status & BIT(0)) ||
+	    !(data_status & BIT(23)) || (data_status & BIT(16)) ||
+	    !(data_status & (BIT(4) | BIT(5))) || (data_status & BIT(7)))
+		return -EPROTONOSUPPORT;
+	return 0;
+}
+
+int atc_m1_validate(const struct atc_m1_config *cfg)
+{
+	static const size_t minimum[] = { 0x4c000, 0x4000, 0x20, 0x24, 0x4004 };
+	int i;
+	size_t j, limit;
+
+	if (!cfg || (cfg->mode != ATC_USB4 && cfg->mode != ATC_TBT))
+		return -EINVAL;
+	if (cfg->hold_dwc3_reset && cfg->mode != ATC_TBT)
+		return -EINVAL;
+	for (i = 0; i < ATC_REGIONS; i++)
+		if (cfg->size[i] < minimum[i])
+			return -ERANGE;
+	for (i = 0; i < 5; i++) {
+		const struct atc_m1_tunable *t = &cfg->tunable[i];
+
+		if (!t->data || !t->bytes || t->bytes % 12 || t->bytes > 65532)
+			return -EINVAL;
+		limit = cfg->size[i == 1 ? ATC_AXI : ATC_CORE];
+		for (j = 0; j < t->bytes / 4; j += 3) {
+			u32 offset = be32_to_cpu(t->data[j]);
+
+			if (offset % 4 || offset > limit - 4)
+				return -ERANGE;
+		}
+	}
+	return 0;
+}
+
+static int update(const struct atc_m1_io *io, void *ctx, enum atc_m1_region r,
+		  u32 offset, u32 clear, u32 set)
+{
+	u32 value;
+	int ret = io->read(ctx, r, offset, &value);
+
+	if (ret)
+		return ret;
+	return io->write(ctx, r, offset, (value & ~clear) | set);
+}
+
+static int poll(const struct atc_m1_io *io, void *ctx, enum atc_m1_region r,
+		u32 offset, u32 mask, u32 wanted, unsigned int timeout)
+{
+	unsigned int elapsed;
+	u32 value;
+	int ret;
+
+	for (elapsed = 0; elapsed <= timeout; elapsed += 10) {
+		ret = io->read(ctx, r, offset, &value);
+		if (ret)
+			return ret;
+		if ((value & mask) == wanted)
+			return 0;
+		if (elapsed < timeout)
+			io->delay(ctx, 10);
+	}
+	return -ETIMEDOUT;
+}
+
+/* Every operation returns before the next write if it fails. */
+#define DO(op) do { ret = (op); if (ret) return ret; } while (0)
+#define UP(r, off, clear, set) DO(update(io, ctx, r, off, clear, set))
+#define DELAY() io->delay(ctx, 10)
+#define POLL(r, off, mask, wanted, us) DO(poll(io, ctx, r, off, mask, wanted, us))
+
+int atc_m1_start_core(const struct atc_m1_config *cfg, const struct atc_m1_io *io,
+		 void *ctx, bool quiesced, enum atc_m1_stage *stage)
+{
+	int ret, i, group;
+	size_t j;
+
+	if (!stage)
+		return -EINVAL;
+	*stage = ATC_VALIDATE;
+	DO(atc_m1_validate(cfg));
+	if (!io || !io->read || !io->write || !io->delay || !io->verify_halted)
+		return -EINVAL;
+	if (!quiesced)
+		return -EBUSY;
+
+	*stage = ATC_ISOLATE;
+	/* Isolate DWC3 while rebuilding the PHY. */
+	UP(ATC_PIPE, 0x1c, BIT(0), 0);
+	UP(ATC_PIPE, 0x1c, 0, BIT(4));
+	/* Disable USB2 before cycling the shared PHY, as in Linux probe. */
+	UP(ATC_USB2, 0, 7, 4); DELAY();
+	UP(ATC_USB2, 4, 0, BIT(3)); DELAY();
+	UP(ATC_USB2, 4, 0, BIT(1)); DELAY();
+	UP(ATC_USB2, 4, 0, BIT(0)); DELAY();
+	UP(ATC_USB2, 4, BIT(2), 0); DELAY();
+	UP(ATC_USB2, 0x1c, 0, BIT(29));
+	UP(ATC_USB2, 0x1c, 0, BIT(30));
+	/* Disable DP AUX; neither DP altmode nor a display tunnel is requested. */
+	UP(ATC_DP, 0x4000, 0, BIT(4));
+	UP(ATC_DP, 0, 0, BIT(4));
+	UP(ATC_DP, 0x4000, 0, BIT(2));
+	UP(ATC_DP, 0x4000, BIT(0), 0); DELAY();
+	UP(ATC_DP, 0x4000, BIT(1), 0); DELAY();
+	UP(ATC_CORE, 0x7000, BIT(2), 0);
+	UP(ATC_CORE, 0x7000, BIT(15), 0);
+	UP(ATC_CORE, 0x7000, BIT(13), 0);
+	UP(ATC_CORE, 0x7000, BIT(14), 0);
+	UP(ATC_CORE, POWER_CTRL, PHY_RESET_N, 0);
+	UP(ATC_CORE, POWER_CTRL, 0, CLAMP);
+	UP(ATC_CORE, MISC, BIT(0) | LANE_SWAP, 0);
+	UP(ATC_CORE, POWER_CTRL, APB_RESET_N, 0);
+	*stage = ATC_SLEEP_BIG;
+	UP(ATC_CORE, POWER_CTRL, BIG, 0);
+	POLL(ATC_CORE, POWER_STAT, BIG, 0, 1000);
+	*stage = ATC_SLEEP_SMALL;
+	UP(ATC_CORE, POWER_CTRL, SMALL, 0);
+	POLL(ATC_CORE, POWER_STAT, SMALL, 0, 1000);
+
+	/* Linux probe_finalize establishes a clocked dummy mux while DWC3 and
+	 * the PHY are reset. Do not retain an inherited, now stopped PHY clock.
+	 */
+	*stage = ATC_PIPE_BOOTSTRAP;
+	UP(ATC_PIPE, 0xc, 0x38, 0); DELAY();
+	UP(ATC_PIPE, 0xc, 7, 2); DELAY();
+	UP(ATC_PIPE, 0xc, 0x38, 0x20); DELAY();
+
+	/* Linux dwc3_apple_init()/atcphy_usb2_set_mode(): select host role
+	 * while USB2 is still off, before releasing resets and enabling RUN.
+	 * This diagnostic supports only host USB4/TBT operation.
+	 */
+	if (!cfg->hold_dwc3_reset)
+		UP(ATC_USB2, 8, 0, 7 << 12);
+	UP(ATC_USB2, 8, 0, 0xf); DELAY();
+	UP(ATC_USB2, 4, BIT(3), 0); DELAY();
+	UP(ATC_USB2, 4, BIT(0), 0); DELAY();
+	UP(ATC_USB2, 4, BIT(1), 0); DELAY();
+	UP(ATC_USB2, 4, 0, BIT(2)); DELAY();
+	UP(ATC_USB2, 0x1c, BIT(29), 0);
+	UP(ATC_USB2, 0x1c, BIT(30), 0);
+	DO(io->write(ctx, ATC_USB2, 0, 2));
+	UP(ATC_CORE, MISC, 0, BIT(0));
+	*stage = ATC_WAKE_SMALL;
+	UP(ATC_CORE, POWER_CTRL, 0, SMALL);
+	POLL(ATC_CORE, POWER_STAT, SMALL, SMALL, 100000);
+	*stage = ATC_WAKE_BIG;
+	UP(ATC_CORE, POWER_CTRL, 0, BIG);
+	POLL(ATC_CORE, POWER_STAT, BIG, BIG, 100000);
+	UP(ATC_CORE, POWER_CTRL, CLAMP, 0);
+	UP(ATC_CORE, POWER_CTRL, 0, APB_RESET_N);
+
+	*stage = ATC_TUNABLES;
+	for (i = 0; i < 5; i++) {
+		const struct atc_m1_tunable *t;
+		enum atc_m1_region r = i == 1 ? ATC_AXI : ATC_CORE;
+
+		group = i;
+		if (cfg->swapped && i >= 3)
+			group = 7 - i;
+		t = &cfg->tunable[group];
+		/* Match Linux apple_tunable_apply(): redundant calibration writes
+		 * are skipped. Explicit power/reset/control updates above and below
+		 * deliberately retain their unconditional write semantics.
+		 */
+		for (j = 0; j < t->bytes / 4; j += 3) {
+			u32 off = be32_to_cpu(t->data[j]), old, value;
+
+			DO(io->read(ctx, r, off, &old));
+			value = (old & ~be32_to_cpu(t->data[j + 1])) |
+				be32_to_cpu(t->data[j + 2]);
+			if (value != old)
+				DO(io->write(ctx, r, off, value));
+		}
+	}
+	/* M1 post-tunable sequence, preserving the Linux 10 us gaps. */
+	UP(ATC_CORE, 0x1014, 0, 0x1fe000);
+	UP(ATC_CORE, 0x2000, 0, BIT(28));
+	UP(ATC_CORE, 8, 0, BIT(3)); DELAY();
+	UP(ATC_CORE, 8, 0, BIT(1)); DELAY();
+	UP(ATC_CORE, 8, 0, BIT(5)); DELAY();
+	UP(ATC_CORE, 0x1b0, 0xc0, 0xc0); DELAY();
+	UP(ATC_CORE, 0x1b0, 0x0c, 0x0c); DELAY();
+	UP(ATC_CORE, 0x1b0, 0xc00, 0xc00); DELAY();
+	UP(ATC_CORE, 8, 0x3000, 0x3000); DELAY();
+	UP(ATC_CORE, 8, 0x300, 0x300); DELAY();
+	UP(ATC_CORE, 8, 0x30000, 0x30000); DELAY();
+
+	*stage = ATC_LANES;
+	UP(ATC_CORE, 0x2a00, 0, BIT(1));
+	UP(ATC_CORE, 0x2a00, 0, BIT(5));
+	UP(ATC_CORE, 0x48, 7, 0);
+	UP(ATC_CORE, 0x48, 0x38, 0);
+	UP(ATC_CORE, 0x48, 0x1c0, 0);
+	UP(ATC_CORE, 0x48, 0xe00, 0);
+	UP(ATC_CORE, 0x4c, 0x1f, cfg->swapped ? 1 : 0);
+	/* USB4/TBT intentionally never set the independent lane-swap bit. */
+	UP(ATC_CORE, MISC, LANE_SWAP, 0);
+	UP(ATC_CORE, 0x4c, 0x1ffe0, 0);
+	UP(ATC_CORE, 0x4c, BIT(17), 0);
+	UP(ATC_CORE, 0x9010, BIT(0), 0); DELAY();
+	UP(ATC_CORE, 0x10010, BIT(0), 0); DELAY();
+	UP(ATC_CORE, POWER_CTRL, 0, PHY_RESET_N);
+
+	/* With no native USB role, Linux leaves DWC3 isolated while TB trains. */
+	if (cfg->hold_dwc3_reset) {
+		*stage = ATC_CORE_READY;
+		return 0;
+	}
+
+	/* Linux deasserts DWC3 reset before its PHY set_mode/PIPE handshake.
+	 * Do not start xHCI: verify it remains halted before proceeding.
+	 */
+	*stage = ATC_USB_RELEASE;
+	UP(ATC_PIPE, 0x1c, BIT(4), 0);
+	UP(ATC_PIPE, 0x1c, 0, BIT(0)); DELAY();
+	DO(io->verify_halted(ctx));
+
+	*stage = ATC_CORE_READY;
+	return 0;
+}
+
+int atc_m1_start_pipe(const struct atc_m1_config *cfg, const struct atc_m1_io *io,
+		    void *ctx, enum atc_m1_stage *stage)
+{
+	int ret;
+
+	if (!stage || *stage != ATC_CORE_READY)
+		return -EINVAL;
+	DO(atc_m1_validate(cfg));
+	if (cfg->hold_dwc3_reset)
+		return -EPERM;
+	if (!io || !io->read || !io->write || !io->delay || !io->verify_halted)
+		return -EINVAL;
+
+	/* A stale lock must be released before taking ownership. */
+	*stage = ATC_PIPE_CLEAR;
+	UP(ATC_PIPE, PIPE_REQ, BIT(0), 0);
+	POLL(ATC_PIPE, PIPE_ACK, BIT(0), 0, 1000);
+	UP(ATC_PIPE, 4, BIT(1) | BIT(2), 0);
+	UP(ATC_PIPE, 0, 0, BIT(0));
+	UP(ATC_PIPE, 0, 0, BIT(2));
+	*stage = ATC_PIPE_LOCK;
+	UP(ATC_PIPE, PIPE_REQ, 0, BIT(0));
+	POLL(ATC_PIPE, PIPE_ACK, BIT(0), BIT(0), 1000);
+	*stage = ATC_PIPE_MUX;
+	UP(ATC_PIPE, 0xc, 0x38, 0); DELAY();
+	UP(ATC_PIPE, 0xc, 7, cfg->mode == ATC_USB4 ? 1 : 2); DELAY();
+	UP(ATC_PIPE, 0xc, 0x38, cfg->mode == ATC_USB4 ? 0x10 : 0x20); DELAY();
+	if (cfg->mode == ATC_USB4) {
+		UP(ATC_PIPE, 0, BIT(0), 0);
+		UP(ATC_PIPE, 0, BIT(2), 0);
+	}
+	*stage = ATC_PIPE_UNLOCK;
+	UP(ATC_PIPE, PIPE_REQ, BIT(0), 0);
+	POLL(ATC_PIPE, PIPE_ACK, BIT(0), 0, 1000);
+	if (cfg->mode == ATC_TBT) {
+		UP(ATC_PIPE, 0x20, 0xf, 2);
+		UP(ATC_PIPE, 0x20, 0, BIT(12));
+	}
+	if (!cfg->retain_dwc3) {
+		*stage = ATC_USB_REISOLATE;
+		UP(ATC_PIPE, 0x1c, BIT(0), 0);
+		UP(ATC_PIPE, 0x1c, 0, BIT(4));
+	}
+	*stage = ATC_DONE;
+	return 0;
+}
+
+/* Compatibility entry point for earlier staged diagnostics. */
+int atc_m1_start(const struct atc_m1_config *cfg, const struct atc_m1_io *io,
+		 void *ctx, bool quiesced, enum atc_m1_stage *stage)
+{
+	int ret = atc_m1_start_core(cfg, io, ctx, quiesced, stage);
+
+	return ret ? ret : atc_m1_start_pipe(cfg, io, ctx, stage);
+}
diff --git a/lib/apple_cd321x.c b/lib/apple_cd321x.c
new file mode 100644
index 00000000..41cd3fe2
--- /dev/null
+++ b/lib/apple_cd321x.c
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only CD321x status for boot-time Apple USB4 bring-up.
+ * Register definitions follow Linux drivers/usb/typec/tipd/tps6598x.h
+ * and core.c (TI and The Asahi Linux Contributors). No mode commands.
+ */
+#include <apple_cd321x.h>
+#include <stdio.h>
+#include <linux/bitops.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <asm/unaligned.h>
+
+static int read_block(apple_cd321x_read read, void *ctx, u8 reg,
+		      u8 *data, size_t size)
+{
+	u8 buf[10];
+	int ret;
+
+	if (size + 1 > sizeof(buf))
+		return -EINVAL;
+	ret = read(ctx, reg, buf, size + 1);
+	if (ret)
+		return ret;
+	/* Unknown layouts must not become lane or cable configuration. */
+	/* CD321x Intel VID status reports 11 bytes on measured TB3 hardware.
+	 * Linux consumes the documented nine-byte prefix; trailing bytes are unused.
+	 * Keep all other lengths strict, including unknown Intel layouts.
+	 */
+	/* Measured CD321x POWER_STATUS reports ten bytes; Linux uses its
+	 * documented two-byte prefix. Accept only this observed extension. */
+	if (buf[0] != size && !(reg == 0x59 && size == 9 && buf[0] == 11) &&
+	    !(reg == 0x3f && size == 2 && buf[0] == 10)) {
+		printf("CD321X-LENGTH reg=%02x expected=%u reported=%u\n",
+		       reg, (unsigned int)size, buf[0]);
+		return -EPROTO;
+	}
+	memcpy(data, buf + 1, size);
+	return 0;
+}
+
+int apple_cd321x_snapshot(apple_cd321x_read read, void *ctx,
+			  struct apple_cd321x_status *status)
+{
+	struct apple_cd321x_status result = {};
+	u8 buf[9];
+	u8 first_data[5], first_tbt[9];
+	int ret;
+
+	if (!read || !status)
+		return -EINVAL;
+	ret = read_block(read, ctx, 0x00, buf, 4);
+	if (ret)
+		return ret;
+	if (get_unaligned_le32(buf) != 0x28)
+		return -ENODEV;
+	ret = read_block(read, ctx, 0x03, buf, 4);
+	if (ret)
+		return ret;
+	if (memcmp(buf, "APP ", 4))
+		return -EAGAIN;
+	ret = read_block(read, ctx, 0x1a, buf, 4);
+	if (ret)
+		return ret;
+	result.status = get_unaligned_le32(buf);
+	ret = read_block(read, ctx, 0x5f, first_data, 5);
+	if (ret)
+		return ret;
+	result.data_status = get_unaligned_le32(first_data);
+	if (result.data_status & BIT(23)) {
+		ret = read_block(read, ctx, 0x24, buf, 9);
+		if (ret)
+			return ret;
+		result.usb4_mode = buf[0];
+		result.eudo = get_unaligned_le32(buf + 1);
+	}
+	if (result.data_status & BIT(16)) {
+		if (result.data_status & BIT(23))
+			return -EPROTONOSUPPORT;
+		/* Intel VID status layout matches Linux tipd: 1+4+2+2 bytes. */
+		ret = read_block(read, ctx, 0x59, first_tbt, 9);
+		if (ret)
+			return ret;
+		ret = read_block(read, ctx, 0x59, buf, 9);
+		if (ret)
+			return ret;
+		if (memcmp(first_tbt, buf, 9))
+			return -EAGAIN;
+		result.tbt_enter_vdo = (u32)get_unaligned_le16(buf + 5) << 16;
+		result.tbt_device_mode = 1 | (u32)get_unaligned_le16(buf + 7) << 16;
+	}
+	ret = read_block(read, ctx, 0x5f, buf, 5);
+	if (ret)
+		return ret;
+	if (memcmp(first_data, buf, 5))
+		return -EAGAIN;
+	/* Sequential samples, not an atomic guarantee against cable changes. */
+	*status = result;
+	return 0;
+}
+
+/* Linux tipd core.c: 0x20 SYSTEM_POWER_STATE, 0x3f POWER_STATUS.
+ * Do not confuse the system sleep state with measured VBUS voltage.
+ * Read status twice to reject an observed plug/role change. Sequential reads
+ * cannot guarantee absence of a transient between samples.
+ */
+int apple_cd321x_power_snapshot(apple_cd321x_read read, void *ctx,
+                              struct apple_cd321x_power *power)
+{
+ struct apple_cd321x_power result = {};
+ u8 buf[4];
+ int ret;
+ if (!read || !power) return -EINVAL;
+ ret = read_block(read, ctx, 0x00, buf, 4);
+ if (ret) return ret;
+ if (get_unaligned_le32(buf) != 0x28) return -ENODEV;
+ ret = read_block(read, ctx, 0x03, buf, 4);
+ if (ret) return ret;
+ if (memcmp(buf, "APP ", 4)) return -EAGAIN;
+ ret = read_block(read, ctx, 0x1a, buf, 4);
+ if (ret) return ret;
+ result.status = get_unaligned_le32(buf);
+ ret = read_block(read, ctx, 0x3f, buf, 2);
+ if (ret) return ret;
+ result.power_status = get_unaligned_le16(buf);
+ ret = read_block(read, ctx, 0x20, buf, 1);
+ if (ret) return ret;
+ result.system_power_state = buf[0];
+ ret = read_block(read, ctx, 0x1a, buf, 4);
+ if (ret) return ret;
+ if (result.status != get_unaligned_le32(buf)) return -EAGAIN;
+ *power = result;
+ return 0;
+}
diff --git a/lib/apple_pciec_m1.c b/lib/apple_pciec_m1.c
new file mode 100644
index 00000000..ba70dff7
--- /dev/null
+++ b/lib/apple_pciec_m1.c
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-2.0
+/* RAM-only T8103 PCIe-C cold preparation diagnostic.
+ * Derived from the project's tested Linux apple_pcie_tunnel_prepare() and
+ * the saved J274 Linux device-tree tunables. Original PCIe driver attribution:
+ * Copyright (C) 2021 Alyssa Rosenzweig <alyssa@rosenzweig.io>
+ * Copyright (C) 2021 Google LLC; Corellium LLC; Mark Kettenis
+ * Authors: Alyssa Rosenzweig and Marc Zyngier <maz@kernel.org>.
+ * This experiment does not enumerate PCI devices, enable DMA, or build tunnels.
+ */
+#include <apple_pciec_m1.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+
+static const struct pciec_m1_tunable group0[] = {
+ { 0x1000, 0x1, 0x0 },
+};
+static const struct pciec_m1_tunable group1[] = {
+ { 0x4, 0x1f001f, 0x180018 },
+ { 0x8, 0x1, 0x1 },
+ { 0xc, 0x1, 0x1 },
+ { 0x10, 0x801f, 0x4 },
+ { 0x18, 0x3ff, 0x280 },
+ { 0x44, 0x1, 0x1 },
+ { 0x94, 0x801f, 0x4 },
+ { 0x9c, 0x801f, 0x4 },
+ { 0x20, 0x801f, 0x4 },
+ { 0x28, 0x3f, 0x20 },
+ { 0x2c, 0x801f, 0x4 },
+ { 0x34, 0x3f, 0x20 },
+ { 0x38, 0x801f, 0x4 },
+ { 0x40, 0x10001, 0x10001 },
+ { 0x48, 0x1, 0x1 },
+ { 0x4c, 0x801f, 0x4 },
+ { 0x54, 0x7f007f, 0x4b004b },
+ { 0x58, 0x801f, 0x4 },
+ { 0x60, 0x801f, 0x4 },
+ { 0x68, 0x1, 0x1 },
+ { 0x6c, 0x801f, 0x4 },
+ { 0x74, 0x1, 0x1 },
+ { 0x78, 0x801f, 0x4 },
+ { 0x84, 0x801f, 0x4 },
+ { 0x8c, 0x1, 0x1 },
+ { 0x90, 0x1, 0x1 },
+ { 0xa4, 0x801f, 0x4 },
+};
+static const struct pciec_m1_tunable group2[] = {
+ { 0x140, 0x1, 0x1 },
+};
+static const struct pciec_m1_tunable group3[] = {
+ { 0x4, 0x70007, 0x40004 },
+ { 0x8, 0x1, 0x1 },
+ { 0xc, 0x1, 0x1 },
+ { 0x10, 0x801f, 0x4 },
+ { 0x18, 0x7f007f, 0x450045 },
+ { 0x1c, 0x801f, 0x4 },
+ { 0x24, 0x801f, 0x4 },
+ { 0x2c, 0x1, 0x1 },
+ { 0x30, 0x1, 0x1 },
+ { 0x34, 0x801f, 0x4 },
+};
+static const struct pciec_m1_tunable group4[] = {
+ { 0x718, 0x7c000, 0x0 },
+ { 0x8bc, 0x1, 0x0 },
+ { 0x78, 0x7000, 0x0 },
+ { 0x814, 0xffffffff, 0xf060 },
+};
+const struct pciec_m1_tunable *pciec_m1_reference(unsigned int group, unsigned int *count)
+{
+ if (!count) return NULL;
+ switch (group) {
+ case 0: *count = ARRAY_SIZE(group0); return group0;
+ case 1: *count = ARRAY_SIZE(group1); return group1;
+ case 2: *count = ARRAY_SIZE(group2); return group2;
+ case 3: *count = ARRAY_SIZE(group3); return group3;
+ case 4: *count = ARRAY_SIZE(group4); return group4;
+ default: *count = 0; return NULL;
+ }
+}
+
+int pciec_m1_validate(const struct pciec_m1_config *cfg)
+{
+ unsigned int g, count, i;
+ const struct pciec_m1_tunable *ref;
+ if (!cfg) return -EINVAL;
+ /* Diagnostic is intentionally limited to the saved machine's 43 entries.
+  * Do not accept arbitrary offsets merely because they fit an MMIO aperture. */
+ for (g = 0; g < PCIEC_M1_GROUPS; g++) {
+  ref = pciec_m1_reference(g, &count);
+  if (cfg->count[g] != count) return -EINVAL;
+  for (i = 0; i < count; i++)
+   if (cfg->group[g][i].offset != ref[i].offset ||
+       cfg->group[g][i].mask != ref[i].mask ||
+       cfg->group[g][i].value != ref[i].value) return -EINVAL;
+ }
+ return 0;
+}
+
+static const struct { u16 offset; u32 value; } cold_reset[] = {
+
+	{ 0x08c, 0x00000110 }, { 0x100, 0xffffffff },
+	{ 0x148, 0xffffffff }, { 0x210, 0xffffffff },
+	{ 0x080, 0x00000000 }, { 0x084, 0x00000000 },
+	{ 0x104, 0xffffffff }, { 0x124, 0x00000000 },
+	{ 0x128, 0x00000000 }, { 0x168, 0x00000000 },
+	{ 0x13c, 0x00000010 }, { 0x800, 0x00100100 },
+	{ 0x808, 0x00100045 }, { 0x810, 0x00000100 },
+	{ 0x814, 0x00000000 }, { 0x130, 0x00000000 },
+	{ 0x140, 0x00000010 }, { 0x144, 0x00253770 },
+	{ 0x21c, 0x00000000 }, { 0x81c, 0x00000000 },
+	{ 0x824, 0x00000000 },
+};
+
+static int apply(const struct pciec_m1_config *cfg, const struct pciec_m1_io *io,
+                 void *ctx, unsigned int group)
+{
+ unsigned int i;
+ u32 old, value;
+ int ret;
+ for (i = 0; i < cfg->count[group]; i++) {
+  const struct pciec_m1_tunable *t = &cfg->group[group][i];
+  ret = io->read(ctx, group, t->offset, &old);
+  if (ret) return ret;
+  value = (old & ~t->mask) | (t->value & t->mask);
+  if (value != old) {
+   ret = io->write(ctx, group, t->offset, value);
+   if (ret) return ret;
+  }
+ }
+ return 0;
+}
+
+static int rmw(const struct pciec_m1_io *io, void *ctx, u32 offset, u32 clear, u32 set)
+{
+ u32 value;
+ int ret = io->read(ctx, PCIEC_PORT, offset, &value);
+ if (ret) return ret;
+ return io->write(ctx, PCIEC_PORT, offset, (value & ~clear) | set);
+}
+
+int pciec_m1_prepare(const struct pciec_m1_config *cfg, const struct pciec_m1_io *io,
+                     void *ctx, u32 *last_status)
+{
+ unsigned int i;
+ u32 status;
+ int ret = pciec_m1_validate(cfg);
+ if (ret) return ret;
+ if (!io || !io->read || !io->write || !io->delay || !last_status) return -EINVAL;
+ ret = io->read(ctx, PCIEC_PORT, 0x804, &status);
+ if (ret) return ret;
+ *last_status = status;
+ if (status == ~0U) return -ENODEV;
+ /* Like Linux, never replay reset/tunables against an already-ready port. */
+ if (status & 1) return 0;
+ ret = apply(cfg, io, ctx, PCIEC_DEBUG);
+ if (ret) return ret;
+ ret = apply(cfg, io, ctx, PCIEC_FABRIC);
+ if (ret) return ret;
+ for (i = 0; i < ARRAY_SIZE(cold_reset); i++) {
+  ret = io->write(ctx, PCIEC_PORT, cold_reset[i].offset, cold_reset[i].value);
+  if (ret) return ret;
+ }
+ /* Clear requester-to-stream mappings; no endpoint DMA is authorized. */
+ for (i = 0; i < 64; i++) {
+  ret = io->write(ctx, PCIEC_PORT, 0x828 + 4*i, 0);
+  if (ret) return ret;
+ }
+ ret = apply(cfg, io, ctx, PCIEC_PORT);
+ if (ret) return ret;
+ ret = rmw(io, ctx, 0x814, 0, 1);
+ if (ret) return ret;
+ ret = rmw(io, ctx, 0x800, 0, 1);
+ if (ret) return ret;
+ ret = rmw(io, ctx, 0x800, 0x100, 0);
+ if (ret) return ret;
+ ret = apply(cfg, io, ctx, PCIEC_OE);
+ if (ret) return ret;
+ ret = apply(cfg, io, ctx, PCIEC_CONFIG);
+ if (ret) return ret;
+ ret = io->write(ctx, PCIEC_PORT, 0x4020, 3);
+ if (ret) return ret;
+ ret = io->write(ctx, PCIEC_PORT, 0x100, ~0U);
+ if (ret) return ret;
+ ret = io->write(ctx, PCIEC_PORT, 0x210, ~0U);
+ if (ret) return ret;
+ /* Same 10us/250ms bound as Linux, plus explicit all-ones rejection. */
+ for (i = 0; i < 25000; i++) {
+  ret = io->read(ctx, PCIEC_PORT, 0x804, &status);
+  if (ret) return ret;
+  *last_status = status;
+  if (status == ~0U) return -ENODEV;
+  if (status & 1) return 0;
+  io->delay(ctx, 10);
+ }
+ return -ETIMEDOUT;
+}
diff --git a/lib/usb4_cfg.c b/lib/usb4_cfg.c
new file mode 100644
index 00000000..59bba613
--- /dev/null
+++ b/lib/usb4_cfg.c
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * USB4/Thunderbolt boot configuration packet codec.
+ * Wire layout and CRC convention follow Linux drivers/thunderbolt/tb_msgs.h
+ * and ctl.c (Andreas Noever, Intel Corporation). Uses explicit words rather
+ * than C bitfields, and has no hardware access or automatic authorization.
+ */
+#include <usb4_cfg.h>
+#include <linux/errno.h>
+#include <linux/bitops.h>
+#include <asm/unaligned.h>
+
+/* Reflected Castagnoli polynomial; these control frames are at most 256 B. */
+static u32 usb4_cfg_crc(const u8 *data, size_t size)
+{
+	u32 crc = ~0U;
+	int bit;
+
+	while (size--) {
+		crc ^= *data++;
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc >> 1) ^ ((crc & 1) ? 0x82f63b78 : 0);
+	}
+	return ~crc;
+}
+
+static int usb4_cfg_validate(const struct usb4_cfg_request *req)
+{
+	if (!req || req->route >> 54 || req->port > 63 || req->space > 3 ||
+	    req->seq > 3 || !req->words || req->words > USB4_CFG_MAX_WORDS ||
+	    req->offset > 0x1fff || req->words > 0x2000 - req->offset ||
+	    (req->type != USB4_CFG_READ && req->type != USB4_CFG_WRITE))
+		return -EINVAL;
+	return 0;
+}
+
+int usb4_cfg_encode(const struct usb4_cfg_request *req, const u32 *data,
+		    void *frame, size_t capacity)
+{
+	u8 *bytes = frame;
+	u32 address;
+	size_t size;
+	unsigned int i;
+	int ret = usb4_cfg_validate(req);
+
+	if (ret)
+		return ret;
+	if (!frame || (req->type == USB4_CFG_WRITE && !data))
+		return -EINVAL;
+	size = 16 + (req->type == USB4_CFG_WRITE ? 4 * req->words : 0);
+	if (capacity < size)
+		return -ENOSPC;
+
+	address = req->offset | req->words << 13 | req->port << 19 |
+		  req->space << 25 | req->seq << 27;
+	put_unaligned_be32(req->route >> 32, bytes);
+	put_unaligned_be32(req->route, bytes + 4);
+	put_unaligned_be32(address, bytes + 8);
+	if (req->type == USB4_CFG_WRITE) {
+		for (i = 0; i < req->words; i++)
+			put_unaligned_be32(data[i], bytes + 12 + 4 * i);
+	}
+	put_unaligned_be32(usb4_cfg_crc(bytes, size - 4), bytes + size - 4);
+	return size;
+}
+
+int usb4_cfg_decode(const struct usb4_cfg_request *req, const void *frame,
+		    size_t size, unsigned int sof, unsigned int eof,
+		    u32 *data, unsigned int *response_port)
+{
+	const u8 *bytes = frame;
+	u32 hi, address;
+	u64 route;
+	size_t expected;
+	unsigned int i;
+	int ret = usb4_cfg_validate(req);
+
+	if (ret)
+		return ret;
+	if (!frame || !response_port || (req->type == USB4_CFG_READ && !data))
+		return -EINVAL;
+	if (size < 16 || size > USB4_CFG_FRAME_BYTES || size % 4 || sof)
+		return -EPROTO;
+	if (get_unaligned_be32(bytes + size - 4) != usb4_cfg_crc(bytes, size - 4))
+		return -EBADMSG;
+	if (eof != req->type)
+		return -EAGAIN;
+
+	hi = get_unaligned_be32(bytes);
+	if ((hi & 0xffc00000) != BIT(31))
+		return -EPROTO;
+	route = (u64)(hi & 0x003fffff) << 32 | get_unaligned_be32(bytes + 4);
+	address = get_unaligned_be32(bytes + 8);
+	if (route != req->route || ((address >> 27) & 3) != req->seq)
+		return -EAGAIN;
+	expected = 16 + (req->type == USB4_CFG_READ ? 4 * req->words : 0);
+	if (size != expected || address >> 29 || (address & 0x1fff) != req->offset ||
+	    ((address >> 13) & 63) != req->words || ((address >> 25) & 3) != req->space)
+		return -EPROTO;
+
+	if (req->type == USB4_CFG_READ) {
+		for (i = 0; i < req->words; i++)
+			data[i] = get_unaligned_be32(bytes + 12 + 4 * i);
+	}
+	*response_port = (address >> 19) & 63;
+	return 0;
+}
+
+/* Linux tb_msgs.h cfg_event_pkg and ctl.c tb_cfg_ack_plug. */
+int usb4_cfg_decode_event(const void *frame, size_t size, unsigned int sof,
+                         unsigned int eof, struct usb4_cfg_event *event)
+{
+ const u8 *bytes = frame;
+ u32 hi, value;
+ if (!frame || !event) return -EINVAL;
+ if (eof != USB4_CFG_EVENT) return -EAGAIN;
+ if (sof || size != 16) return -EPROTO;
+ if (get_unaligned_be32(bytes + 12) != usb4_cfg_crc(bytes, 12)) return -EBADMSG;
+ hi = get_unaligned_be32(bytes);
+ value = get_unaligned_be32(bytes + 8);
+ if ((hi & 0xffc00000) != BIT(31) || (value & 0x7fffffc0)) return -EPROTO;
+ event->route = (u64)(hi & 0x003fffff) << 32 | get_unaligned_be32(bytes + 4);
+ event->port = value & 63;
+ event->unplug = !!(value & BIT(31));
+ return 0;
+}
+
+int usb4_cfg_ack_plug_encode(const struct usb4_cfg_event *event,
+                            void *frame, size_t capacity)
+{
+ u8 *bytes = frame;
+ if (!event || !frame || event->route >> 54 || event->port > 63) return -EINVAL;
+ if (capacity < 16) return -ENOSPC;
+ put_unaligned_be32(event->route >> 32, bytes);
+ put_unaligned_be32(event->route, bytes + 4);
+ put_unaligned_be32(7U | event->port << 8 |
+                    (event->unplug ? 3U : 2U) << 30, bytes + 8);
+ put_unaligned_be32(usb4_cfg_crc(bytes, 12), bytes + 12);
+ return 16;
+}
diff --git a/test/dm/apple_atc_m1.c b/test/dm/apple_atc_m1.c
new file mode 100644
index 00000000..4779e823
--- /dev/null
+++ b/test/dm/apple_atc_m1.c
@@ -0,0 +1,521 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <apple_atc_m1.h>
+#include <asm/byteorder.h>
+#include <dm.h>
+#include <command.h>
+#include <dm/test.h>
+#include <test/test.h>
+#include <test/ut.h>
+#include "apple_atc_m1_data.h"
+
+static int dm_test_atc_m1_usb4_host_policy(struct unit_test_state *uts)
+{
+	static const u8 bits[] = { 0, 4, 5, 7, 16, 23 };
+	unsigned int combination, bit, mode, orientation;
+
+	/* Cover disconnected, no USB role, device role and conflicting protocols. */
+	for (combination = 0; combination < 64; combination++) {
+		u32 data = 0;
+		bool host = (combination & 1) && (combination & 6) &&
+			    !(combination & 8) && !(combination & 16) &&
+			    (combination & 32);
+
+		for (bit = 0; bit < ARRAY_SIZE(bits); bit++)
+			if (combination & BIT(bit))
+				data |= BIT(bits[bit]);
+		for (mode = ATC_USB4; mode <= ATC_TBT; mode++)
+			for (orientation = 0; orientation < 2; orientation++)
+				ut_asserteq(host && mode == ATC_USB4 ? 0 :
+					   -EPROTONOSUPPORT,
+					   atc_m1_usb4_host_check(mode,
+						data | (orientation << 1)));
+	}
+	ut_assertok(atc_m1_usb4_host_check(ATC_USB4, 0x16c00013));
+	ut_asserteq(-EPROTONOSUPPORT,
+		   atc_m1_usb4_host_check(ATC_TBT, 0x06010003));
+	return 0;
+}
+DM_TEST(dm_test_atc_m1_usb4_host_policy, 0);
+
+struct atc_trace { int region; u32 offset, value; };
+struct atc_fake {
+	u32 reg[ATC_REGIONS][0x4c000 / 4];
+	struct atc_trace trace[1024];
+	int calls, fault_call, writes, stall;
+	unsigned int elapsed;
+	enum atc_m1_stage stage;
+};
+
+static struct atc_fake fake;
+
+static int fake_read(void *ctx, enum atc_m1_region r, u32 off, u32 *value)
+{
+	struct atc_fake *f = ctx;
+
+	if (++f->calls == f->fault_call)
+		return -EIO;
+	if (r >= ATC_REGIONS || off >= 0x4c000 || off % 4)
+		return -ERANGE;
+	*value = f->reg[r][off / 4];
+	if (r == ATC_CORE && off == 0x20004) {
+		*value = f->reg[ATC_CORE][0x20000 / 4] & 3;
+		if (f->stage == f->stall)
+			*value ^= f->stage == ATC_WAKE_BIG ||
+				  f->stage == ATC_SLEEP_BIG ? 2 : 1;
+	}
+	if (r == ATC_PIPE && off == 0x14) {
+		*value = f->reg[ATC_PIPE][0x10 / 4] & 1;
+		if (f->stage == f->stall)
+			*value ^= 1;
+	}
+	return 0;
+}
+
+static int fake_write(void *ctx, enum atc_m1_region r, u32 off, u32 value)
+{
+	struct atc_fake *f = ctx;
+
+	if (++f->calls == f->fault_call)
+		return -EIO;
+	if (r >= ATC_REGIONS || off >= 0x4c000 || off % 4 ||
+	    f->writes >= ARRAY_SIZE(f->trace))
+		return -ERANGE;
+	f->reg[r][off / 4] = value;
+	f->trace[f->writes++] = (struct atc_trace){ r, off, value };
+	return 0;
+}
+
+static void fake_delay(void *ctx, unsigned int us)
+{
+	struct atc_fake *f = ctx;
+
+	f->elapsed += us;
+}
+
+static int fake_verify_halted(void *ctx)
+{
+	struct atc_fake *f = ctx;
+
+	if (++f->calls == f->fault_call)
+		return -EIO;
+	if (f->stall == ATC_USB_RELEASE ||
+	    (f->reg[ATC_PIPE][0x1c / 4] & 0x11) != 1)
+		return -EBUSY;
+	return 0;
+}
+
+static const struct atc_m1_io fake_io = {
+	.read = fake_read, .write = fake_write, .delay = fake_delay,
+	.verify_halted = fake_verify_halted,
+};
+
+static struct atc_m1_config setup(void)
+{
+	struct atc_m1_config c = {
+		.mode = ATC_USB4,
+		.size = { 0x4c000, 0x4000, 0x4000, 0x4000, 0x8000 },
+		.tunable = {
+			{ calibration_0, sizeof(calibration_0) },
+			{ calibration_1, sizeof(calibration_1) },
+			{ calibration_2, sizeof(calibration_2) },
+			{ calibration_3, sizeof(calibration_3) },
+			{ calibration_4, sizeof(calibration_4) },
+		},
+	};
+
+	memset(&fake, 0, sizeof(fake));
+	memset(fake.reg, 0xa5, sizeof(fake.reg));
+	fake.stall = -1;
+	return c;
+}
+
+static int dm_test_atc_m1_modes(struct unit_test_state *uts)
+{
+	struct atc_m1_config c;
+	int mode, swap;
+
+	for (mode = 0; mode < 2; mode++) {
+		for (swap = 0; swap < 2; swap++) {
+			c = setup();
+			c.mode = mode;
+			c.swapped = swap;
+			ut_assertok(atc_m1_start(&c, &fake_io, &fake, true, &fake.stage));
+			ut_asserteq(ATC_DONE, fake.stage);
+			ut_asserteq(swap, fake.reg[ATC_CORE][0x4c / 4] & 0x3ffff);
+			ut_asserteq(0, fake.reg[ATC_CORE][0x48 / 4] & 0xfff);
+			ut_asserteq(0, fake.reg[ATC_CORE][0x20008 / 4] & 4);
+			ut_asserteq(0x1b, fake.reg[ATC_CORE][0x20000 / 4] & 0x1f);
+			ut_asserteq(mode == ATC_USB4 ? 0x11 : 0x22,
+				    fake.reg[ATC_PIPE][0xc / 4] & 0x3f);
+			ut_asserteq(0, fake.reg[ATC_PIPE][0x10 / 4] & 1);
+			ut_asserteq(0x10, fake.reg[ATC_PIPE][0x1c / 4] & 0x11);
+			ut_assert(fake.elapsed < 1000);
