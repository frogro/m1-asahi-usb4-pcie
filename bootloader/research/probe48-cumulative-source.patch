+/* ACIO/NHI may run between core and PIPE. The split must preserve every
+ * hardware write of the legacy sequence, but keep the halted DWC3 on the dummy clock until then.
+ */
+static int dm_test_atc_m1_split_order(struct unit_test_state *uts)
+{
+ static struct atc_trace expected[1024];
+ struct atc_m1_config c;
+ int mode, swap, count, calls;
+
+ for (mode = 0; mode < 2; mode++) {
+  for (swap = 0; swap < 2; swap++) {
+   c = setup(); c.mode = mode; c.swapped = swap; c.retain_dwc3 = true;
+   ut_assertok(atc_m1_start(&c, &fake_io, &fake, true, &fake.stage));
+   count = fake.writes;
+   memcpy(expected, fake.trace, count * sizeof(expected[0]));
+   c = setup(); c.mode = mode; c.swapped = swap; c.retain_dwc3 = true;
+   fake.stage = ATC_VALIDATE;
+   ut_asserteq(-EINVAL, atc_m1_start_pipe(&c, &fake_io, &fake, &fake.stage));
+   ut_asserteq(0, fake.calls);
+   ut_assertok(atc_m1_start_core(&c, &fake_io, &fake, true, &fake.stage));
+   ut_asserteq(ATC_CORE_READY, fake.stage);
+   ut_asserteq(1, fake.reg[ATC_PIPE][0x1c / 4] & 0x11);
+   ut_asserteq(0x22, fake.reg[ATC_PIPE][0xc / 4] & 0x3f);
+   ut_asserteq(0x1b, fake.reg[ATC_CORE][0x20000 / 4] & 0x1f);
+   ut_assertok(atc_m1_start_pipe(&c, &fake_io, &fake, &fake.stage));
+   ut_asserteq(count, fake.writes);
+   ut_assert(!memcmp(expected, fake.trace, count * sizeof(expected[0])));
+   calls = fake.calls;
+   ut_asserteq(-EINVAL, atc_m1_start_pipe(&c, &fake_io, &fake, &fake.stage));
+   ut_asserteq(calls, fake.calls);
+  }
+ }
+ return 0;
+}
+DM_TEST(dm_test_atc_m1_split_order, 0);
+
+static int dm_test_atc_m1_split_failure(struct unit_test_state *uts)
+{
+ struct atc_m1_config c = setup();
+ int first, last, i, calls;
+
+ ut_assertok(atc_m1_start_core(&c, &fake_io, &fake, true, &fake.stage));
+ first = fake.calls + 1;
+ ut_assertok(atc_m1_start_pipe(&c, &fake_io, &fake, &fake.stage));
+ last = fake.calls;
+ for (i = first; i <= last; i++) {
+  c = setup();
+  ut_assertok(atc_m1_start_core(&c, &fake_io, &fake, true, &fake.stage));
+  fake.fault_call = i;
+  ut_asserteq(-EIO, atc_m1_start_pipe(&c, &fake_io, &fake, &fake.stage));
+  ut_asserteq(i, fake.calls);
+  calls = fake.calls;
+  ut_asserteq(-EINVAL, atc_m1_start_pipe(&c, &fake_io, &fake, &fake.stage));
+  ut_asserteq(calls, fake.calls);
+ }
+ return 0;
+}
+DM_TEST(dm_test_atc_m1_split_failure, 0);
