+#include <linux/usb/dwc3.h>
+
+struct atc_m1_hw {
+	void *base[ATC_REGIONS];
+	struct atc_m1_config cfg;
+	enum atc_m1_stage stage, printed_stage;
+	enum atc_m1_region last_region;
+	u32 last_offset, last_value;
+	void *xhci;
+	u32 cap;
+	bool hostrun;
+	struct udevice *usb;
+	struct xhci_ctrl *retained_xhci;
+};
+
+static void show_stage(struct atc_m1_hw *hw)
+{
+	if (hw->stage != hw->printed_stage) {
+		printf("ATC-M1 stage=%u\n", hw->stage);
+		hw->printed_stage = hw->stage;
+	}
+}
+
+static int hw_read(void *ctx, enum atc_m1_region r, u32 off, u32 *value)
+{
+	struct atc_m1_hw *hw = ctx;
+
+	if (r >= ATC_REGIONS || off % 4 || off > hw->cfg.size[r] - 4)
+		return -ERANGE;
+	show_stage(hw);
+	*value = readl(hw->base[r] + off);
+	hw->last_region = r;
+	hw->last_offset = off;
+	hw->last_value = *value;
+	return 0;
+}
+
+static int hw_write(void *ctx, enum atc_m1_region r, u32 off, u32 value)
+{
+	struct atc_m1_hw *hw = ctx;
+
+	if (r >= ATC_REGIONS || off % 4 || off > hw->cfg.size[r] - 4)
+		return -ERANGE;
+	show_stage(hw);
+	if (r == ATC_USB2 && off == 8 && hw->last_region == r &&
+	    hw->last_offset == off)
+		printf("USB2-ROLE signal old=%#x new=%#x\n", hw->last_value, value);
+	writel(value, hw->base[r] + off);
+	return 0;
+}
+
+static void hw_delay(void *ctx, unsigned int us)
+{
+	udelay(us);
+}
+
+static int hw_verify_halted(void *ctx)
+{
+	struct atc_m1_hw *hw = ctx;
+	u32 cap = readl(hw->xhci) & 0xff;
+	u32 command, status;
+	int ret;
+
+	show_stage(hw);
+	if (cap != hw->cap)
+		return -EPROTO;
+	ret = readl_poll_timeout(hw->xhci + cap + 4, status,
+				status != 0xffffffff && (status & BIT(0)), 100000);
+	command = readl(hw->xhci + cap);
+	printf("ATC-M1 released DWC3: command=%#x status=%#x\n", command, status);
+	if (ret)
+		return ret;
+	if (command == 0xffffffff || (command & BIT(0)))
+		return -EBUSY;
+	return 0;
+}
+
+/* Known powered PHY control/status registers only; no FIFO or clear-on-read. */
+static void snapshot_phy(struct atc_m1_hw *hw, const char *phase)
+{
+ static const u32 core[] = { 8, 0x48, 0x4c, 0x1b0, 0x2a00,
+                            0x20000, 0x20004, 0x20008, 0x9010, 0x10010 };
+ static const u32 pipe[] = { 0, 4, 0xc, 0x10, 0x14, 0x1c, 0x20 };
+ unsigned int i;
+ for (i = 0; i < ARRAY_SIZE(core); i++)
+  printf("ATC-SNAPSHOT %s core[%#x]=%#x\n", phase, core[i], readl(hw->base[ATC_CORE] + core[i]));
+ for (i = 0; i < ARRAY_SIZE(pipe); i++)
+  printf("ATC-SNAPSHOT %s pipe[%#x]=%#x\n", phase, pipe[i], readl(hw->base[ATC_PIPE] + pipe[i]));
+ printf("USB2-SNAPSHOT %s control=%#x reset=%#x signal=%#x misc=%#x\n",
+        phase, readl(hw->base[ATC_USB2]), readl(hw->base[ATC_USB2] + 4),
+        readl(hw->base[ATC_USB2] + 8), readl(hw->base[ATC_USB2] + 0x1c));
+}
+
+/* Linux atc.c control registers already accessed using read/modify/write,
+ * plus status registers read by the driver. No FIFO, event or read-clear bank.
+ * Observed only after link polling, while PHY and ACIO remain powered.
+ */
+static void snapshot_phy_extended(void *context)
+{
+ struct atc_m1_hw *hw = context;
+ static const u32 core[] = { 0x8, 0x48, 0x4c, 0x1b0, 0x804, 0xa00, 0xa04, 0xa20, 0xa74, 0x1014, 0x1028, 0x2000, 0x2200, 0x2208, 0x2214, 0x2220, 0x2224, 0x2a00, 0x2a20, 0x2a38, 0x2aa4, 0x9010, 0x90f0, 0xb000, 0xb004, 0xb02c, 0xb030, 0xb034, 0xb048, 0xb054, 0xb060, 0xd000, 0xd004, 0xd008, 0x10010, 0x100f0, 0x12000, 0x12004, 0x1202c, 0x12030, 0x12034, 0x12048, 0x12054, 0x12060, 0x14000, 0x14004, 0x14008, 0x20000, 0x20004, 0x20008 };
+ static const u32 pipe[] = { 0x0, 0x4, 0xc, 0x10, 0x14, 0x1c, 0x20 };
+ static const u32 usb2[] = { 0x0, 0x4, 0x8, 0x1c };
+ unsigned int i;
+ for (i = 0; i < ARRAY_SIZE(core); i++)
+  printf("ATC-EXTENDED core[%#x]=%#x\n", core[i], readl(hw->base[ATC_CORE] + core[i]));
+ for (i = 0; i < ARRAY_SIZE(pipe); i++)
+  printf("ATC-EXTENDED pipe[%#x]=%#x\n", pipe[i], readl(hw->base[ATC_PIPE] + pipe[i]));
+ for (i = 0; i < ARRAY_SIZE(usb2); i++)
+  printf("ATC-EXTENDED usb2[%#x]=%#x\n", usb2[i], readl(hw->base[ATC_USB2] + usb2[i]));
+}
+
+/* Read-only allowlist: no FIFO, event ring, W1C writes or device registers. */
+static void snapshot_dwc3(struct atc_m1_hw *hw, const char *phase)
+{
+ static const u32 offsets[] = {
+  0xc110, 0xc11c, 0xc120, 0xc12c, 0xc140, 0xc144, 0xc14c,
+  0xc200, 0xc2c0, 0xc630, 0xcd38, 0xcd3c, 0xcd40,
+ };
+ unsigned int i;
+
+ for (i = 0; i < ARRAY_SIZE(offsets); i++)
+  printf("DWC3-SNAPSHOT %s reg[%#x]=%#x\n", phase, offsets[i],
+         readl(hw->xhci + offsets[i]));
+ printf("DWC3-SNAPSHOT %s command=%#x status=%#x\n", phase,
+        readl(hw->xhci + hw->cap), readl(hw->xhci + hw->cap + 4));
+}
+
+static const struct atc_m1_io hw_io = {
+	.read = hw_read, .write = hw_write, .delay = hw_delay,
+	.verify_halted = hw_verify_halted,
+};
+
+/* Linux dwc3-apple.c host/CIO sequence; selected, powered, halted port only.
+ * This diagnostic does not initialize xHCI rings or enable its RUN bit.
+ */
+static int dwc3_update_checked(struct atc_m1_hw *hw, u32 off,
+                              u32 mask, u32 value)
+{
+ u32 old = readl(hw->xhci + off), next, observed;
+
+ if (old == 0xffffffff || (value & ~mask))
+  return -EIO;
+ next = (old & ~mask) | value;
+ writel(next, hw->xhci + off);
+ observed = readl(hw->xhci + off);
+ if (observed == 0xffffffff || observed != next)
+  return -EIO;
+ return 0;
+}
+
+static int check_usb_darts(struct atc_m1_hw *hw)
+{
+ static const u64 bases[] = { 0x502f00000ULL, 0x502f80000ULL };
+ struct ofnode_phandle_args args;
+ struct udevice *dart;
+ void *regs;
+ u32 control, error;
+ int i, ret;
+ if (dev_count_phandle_with_args(hw->usb, "iommus", "#iommu-cells", 0) != 2)
+  return -EINVAL;
+ for (i = 0; i < 2; i++) {
+  ret = dev_read_phandle_with_args(hw->usb, "iommus", "#iommu-cells", 0, i, &args);
+  if (ret) return ret;
+  if (args.args_count != 1 || args.args[0] != (unsigned int)i ||
+      ofnode_get_addr(args.node) != bases[i]) return -EINVAL;
+  ret = uclass_find_device_by_ofnode(UCLASS_IOMMU, args.node, &dart);
+  if (ret || !device_active(dart)) return -ENODEV;
+  ret = dev_power_domain_on(dart);
+  if (ret) return ret;
+  regs = map_sysmem(bases[i], 0x4000);
+  control = readl(regs + 0x100 + 4 * i);
+  error = readl(regs + 0x40);
+  printf("M1-XHCI DART%u sid=%u tcr=%#x error=%#x\n", i, i, control, error);
+  if (!(readl(regs + 4) & BIT(0)) || control != (BIT(8) | BIT(12)) ||
+      (error & BIT(31))) return -EPERM;
+  if (i == 1 && hw->usb->iommu != dart) return -EINVAL;
+ }
+ return 0;
+}
+
+static int prepare_dwc3_host(struct atc_m1_hw *hw)
+{
+ u32 id, params, ctl;
+ int ret;
+
+ if (hw->stage != ATC_CORE_READY)
+  return -EPERM;
+ ret = hw_verify_halted(hw);
+ if (ret)
+  return ret;
+ id = readl(hw->xhci + 0xc120);
+ params = readl(hw->xhci + 0xc140);
+ ctl = readl(hw->xhci + 0xc110);
+ /* The measured M1 DWC3.1 core is DRD; reject an unexpected core/reset. */
+ if (id != 0x33313130 || params == 0xffffffff || (params & 3) != 2 ||
+     ctl == 0xffffffff || (ctl & BIT(11)))
+  return -ENODEV;
+#define DWC3_UPDATE(off, mask, val) do { \
+ ret = dwc3_update_checked(hw, off, mask, val); \
+ if (ret) return ret; \
+} while (0)
+ if (hw->hostrun) {
+#if CONFIG_IS_ENABLED(USB_XHCI_DWC3)
+  ret = check_usb_darts(hw);
+  if (ret) return ret;
+  apple_boot_trace("dwc3-core-init-begin");
+  ret = dwc3_m1_diag_init_preserve_phy((struct dwc3 *)(hw->xhci + DWC3_REG_OFFSET));
+  apple_boot_trace("dwc3-core-init-return");
+  printf("M1-DWC3 core-init preserve-phy ret=%d\n", ret);
+  if (ret) return ret;
+  ret = hw_verify_halted(hw);
+  if (ret) return ret;
+#else
+  return -ENOSYS;
+#endif
+ }
+ /* Apple CIO controls from dwc3_apple_setup_cio(), preserve upper timer bits. */
+ DWC3_UPDATE(0xcd38, 0xffffffff, 0x0f800f80);
+ DWC3_UPDATE(0xcd3c, 0xffffffff, 0x0fc00fc0);
+ DWC3_UPDATE(0xcd40, 0x00ffffff, 0x00140a10);
+ /* DRD role switching requires SUSPHY clear before selecting HOST. */
+ DWC3_UPDATE(0xc2c0, BIT(17), 0);
+ DWC3_UPDATE(0xc200, BIT(6), 0);
+ DWC3_UPDATE(0xc110, 3 << 12, 1 << 12);
+ /* Core USB2 LPM setup, followed by Apple-required SUSPHY before PIPE. */
+ DWC3_UPDATE(0xc200, BIT(8) | BIT(6), BIT(8) | BIT(6));
+ DWC3_UPDATE(0xc2c0, BIT(17), BIT(17));
+#undef DWC3_UPDATE
+ return hw_verify_halted(hw);
+}
+
+static int start_late_pipe(void *context)
+{
+ struct atc_m1_hw *hw = context;
+ int ret;
+
+ apple_boot_trace("dwc3-host-begin");
+ ret = prepare_dwc3_host(hw);
+ apple_boot_trace("dwc3-host-return");
+ printf("DWC3-HOST ret=%d; xHCI not started\n", ret);
+ if (ret)
+  return ret;
+ snapshot_dwc3(hw, "host-configured");
+ apple_boot_trace("late-pipe-begin");
+ ret = atc_m1_start_pipe(&hw->cfg, &hw_io, hw, &hw->stage);
+ apple_boot_trace("late-pipe-return");
+ printf("ATC-M1 late PIPE ret=%d stage=%u\n", ret, hw->stage);
+ if (!ret && hw->hostrun) {
+#if CONFIG_IS_ENABLED(USB_XHCI_HCD)
+  ret = check_usb_darts(hw);
+  if (ret) return ret;
+  apple_boot_trace("xhci-start-begin");
+  ret = xhci_m1_diag_start(hw->usb, hw->xhci, hw->xhci + hw->cap,
+                           &hw->retained_xhci);
+  apple_boot_trace("xhci-start-return");
+  if (!ret) ret = check_usb_darts(hw);
+#else
+  ret = -ENOSYS;
+#endif
+ }
+ return ret;
+}
+
+static int status_read(void *ctx, u8 reg, u8 *buf, size_t size)
+{
+	return dm_i2c_read(ctx, reg, buf, size);
+}
+
+/* Fixed chip on the selected J274 port; no scan or mode command. */
+static void snapshot_cable_power(void *unused)
+{
+ struct udevice *bus, *chip;
+ struct apple_cd321x_power p;
+ int ret;
+ ret = uclass_get_device_by_seq(UCLASS_I2C, 0, &bus);
+ if (!ret) ret = i2c_get_chip(bus, 0x3f, 1, &chip);
+ if (!ret) ret = i2c_set_chip_offset_len(chip, 1);
+ if (!ret) ret = apple_cd321x_power_snapshot(status_read, chip, &p);
+ if (ret) {
+  printf("CD321X-POWER-SAMPLE ms=%lu error=%d\n", get_timer(0), ret);
+  /* A failed diagnostic read must not invent a power state or retry. */
+  apple_nhi_m1_set_link_sample(NULL, NULL);
+  return;
+ }
+ printf("CD321X-POWER-SAMPLE ms=%lu status=%08x power=%04x system=%02x plug=%u connection=%u source_sink=%u opmode=%u\n",
+        get_timer(0), p.status, p.power_status, p.system_power_state,
+        !!(p.status & BIT(0)), p.power_status & 1,
+        (p.power_status >> 1) & 1, (p.power_status >> 2) & 3);
+}
+
+static int load_config(ofnode node, struct atc_m1_hw *hw,
+		       struct apple_cd321x_status *status)
+{
+	static const char *const names[] = {
+		"core", "axi2af", "usb2phy", "pipehandler", "lpdptx",
+	};
+	static const u64 addresses[] = {
+		0x503000000, 0x500000000, 0x502a90000, 0x502a84000, 0x503050000,
+	};
+	static const size_t sizes[] = { 0x4c000, 0x4000, 0x4000, 0x4000, 0x8000 };
+	static const char *const props[] = {
+		"apple,tunable-common-a", "apple,tunable-axi2af",
+		"apple,tunable-common-b", "apple,tunable-lane0-cio",
+		"apple,tunable-lane1-cio",
+	};
+	struct udevice *bus, *chip;
+	struct resource res;
+	int i, len, ret;
+
+	if (!ofnode_device_is_compatible(ofnode_root(), "apple,j274") ||
+	    !ofnode_device_is_compatible(node, "apple,t8103-atcphy"))
+		return -ENODEV;
+	for (i = 0; i < ATC_REGIONS; i++) {
+		ret = ofnode_read_resource_byname(node, names[i], &res);
+		if (ret)
+			return ret;
+		if (res.start != addresses[i] || resource_size(&res) != sizes[i])
+			return -ERANGE;
+		hw->cfg.size[i] = sizes[i];
+	}
+	for (i = 0; i < 5; i++) {
+		hw->cfg.tunable[i].data = ofnode_get_property(node, props[i], &len);
+		if (!hw->cfg.tunable[i].data || len <= 0)
+			return -ENOENT;
+		hw->cfg.tunable[i].bytes = len;
+	}
+	/* Validate every offset before even talking to the Type-C controller. */
+	ret = atc_m1_validate(&hw->cfg);
+	if (ret)
+		return ret;
+	ret = uclass_get_device_by_seq(UCLASS_I2C, 0, &bus);
+	if (!ret)
+		ret = i2c_get_chip(bus, 0x3f, 1, &chip);
+	if (!ret)
+		ret = i2c_set_chip_offset_len(chip, 1);
+	if (!ret)
+		ret = apple_cd321x_snapshot(status_read, chip, status);
+	if (ret)
+		return ret;
+	if (!(status->data_status & BIT(0)))
+		return -ENOTCONN;
+	if (!!(status->data_status & BIT(23)) == !!(status->data_status & BIT(16)))
+		return -EPROTONOSUPPORT;
+	hw->cfg.mode = status->data_status & BIT(23) ? ATC_USB4 : ATC_TBT;
+	hw->cfg.swapped = !!(status->data_status & BIT(1));
+	return 0;
+}
+
+/* Explicit fresh-cable diagnostic, after selected xHCI is halted and before
+ * PHY/ACIO start. Only bounded read-only PD snapshots during the user window.
+ */
+static int wait_fresh_cable(struct apple_cd321x_status *result)
+{
+ struct udevice *bus, *chip;
+ struct apple_cd321x_status status;
+ ulong started;
+ bool detached = false;
+ int ret;
+ ret = uclass_get_device_by_seq(UCLASS_I2C, 0, &bus);
+ if (!ret) ret = i2c_get_chip(bus, 0x3f, 1, &chip);
+ if (!ret) ret = i2c_set_chip_offset_len(chip, 1);
+ if (ret) return ret;
+ puts("ATC-FRESH-CABLE WAIT detach then reconnect same OWC; 120-second limit\n");
+ started = get_timer(0);
+ while (get_timer(started) < 120000) {
+  ret = apple_cd321x_snapshot(status_read, chip, &status);
+  /* A changing read-only snapshot can be retried within this window. */
+  if (ret && ret != -EAGAIN) return ret;
+  if (!ret) {
+   if (!(status.data_status & BIT(0))) {
+    if (!detached) puts("ATC-FRESH-CABLE DETACHED\n");
+    detached = true;
+   } else if (detached &&
+              (!!(status.data_status & BIT(23)) != !!(status.data_status & BIT(16)))) {
+    *result = status;
+    printf("ATC-FRESH-CABLE CONNECTED data=%#x eudo=%#x\n", status.data_status, status.eudo);
+    return 0;
+   }
+  }
+  /* U-Boot udelay services schedule/watchdog in bounded chunks. */
+  udelay(50000);
+ }
+ return -ETIMEDOUT;
+}
+
+static int do_atcm1(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	struct atc_m1_hw hw = {};
+	struct apple_cd321x_status before, after;
+	struct udevice *usb, *reset;
+	ofnode node, usbnode;
+	struct resource res;
+	void *xhci;
+	u32 cap, halted;
+	int ret, i;
+	unsigned int stage;
+	bool acio, fresh, tb_only, usb4_host, queries, extended, power_trace, pciec;
+
+	if (argc != 3 || strcmp(argv[1], "1") ||
+	    (strcmp(argv[2], "check") && strcmp(argv[2], "start") &&
+	     strcmp(argv[2], "acio") && strcmp(argv[2], "nhi") && strcmp(argv[2], "dart") && strcmp(argv[2], "tune") && strcmp(argv[2], "host") && strcmp(argv[2], "hostrun") && strcmp(argv[2], "fresh") && strcmp(argv[2], "tbonly") && strcmp(argv[2], "usb4host") && strcmp(argv[2], "usb4query") && strcmp(argv[2], "usb4snapshot") && strcmp(argv[2], "usb4power") && strcmp(argv[2], "usb4pciec")))
+		return CMD_RET_USAGE;
+	fresh = !strcmp(argv[2], "fresh");
+	tb_only = !strcmp(argv[2], "tbonly");
+	pciec = !strcmp(argv[2], "usb4pciec");
+	power_trace = !strcmp(argv[2], "usb4power") || pciec;
+	extended = !strcmp(argv[2], "usb4snapshot") || power_trace;
+	queries = !strcmp(argv[2], "usb4query") || extended;
+	usb4_host = !strcmp(argv[2], "usb4host") || queries;
+	hw.hostrun = !strcmp(argv[2], "hostrun") || usb4_host;
+	stage = (!strcmp(argv[2], "host") || hw.hostrun || fresh || tb_only) ? 4 : !strcmp(argv[2], "tune") ? 3 : !strcmp(argv[2], "dart") ? 2 : !strcmp(argv[2], "nhi");
+	acio = !strcmp(argv[2], "acio") || stage;
+	if (stage >= 4) {
+		ret = apple_nhi_m1_control_check();
+		if (ret) goto fail;
+	}
+	if (stage >= 3) {
+		ret = apple_nhi_m1_tunables_check();
+		if (ret) goto fail;
+	}
+	if (stage >= 2) {
+		ret = apple_nhi_m1_check();
+		if (ret) goto fail;
+	}
+	if (acio) {
+		ret = apple_acio_m1_check();
+		if (ret) goto fail;
+	}
+	if (pciec) {
+		ret = apple_pciec_m1_check();
+		if (ret) goto fail;
+	}
+	node = ofnode_path("/soc/phy@503000000");
+	usbnode = ofnode_path("/soc/usb@502280000");
+	ret = load_config(node, &hw, &before);
+	if (ret)
+		goto fail;
+	printf("ATC-M1 port=1 mode=%s swapped=%u validated=5 groups\n",
+	       hw.cfg.mode == ATC_USB4 ? "USB4" : "TBT", hw.cfg.swapped);
+	if (usb4_host) {
+		ret = atc_m1_usb4_host_check(hw.cfg.mode, before.data_status);
+		if (ret)
+			goto fail;
+		puts("USB4-HOST policy validated; native USB role present\n");
+	}
+	/* TIPD leaves USB_ROLE_NONE when neither native USB connection bit is set. */
+	if (tb_only && (hw.cfg.mode != ATC_TBT ||
+		       (before.data_status & (BIT(4) | BIT(5))))) {
+		ret = -EPROTONOSUPPORT;
+		goto fail;
+	}
+	if (!strcmp(argv[2], "check"))
+		return CMD_RET_SUCCESS;
+
+	/* Do not probe or stop any other USB controller, especially debug port0. */
+	ret = uclass_find_device_by_ofnode(UCLASS_USB, usbnode, &usb);
+	if (ret || !device_active(usb)) {
+		ret = -EBUSY;
+		goto fail;
+	}
+	if (!ofnode_device_is_compatible(usbnode, "apple,t8103-dwc3") ||
+	    dev_read_addr(usb) != 0x502280000ULL) {
+		ret = -ENODEV;
+		goto fail;
+	}
+	ret = uclass_get_device_by_ofnode(UCLASS_RESET, node, &reset);
+	if (ret)
+		goto fail;
+	ret = dev_power_domain_on(reset);
+	if (ret)
+		goto fail;
+	xhci = map_sysmem(0x502280000ULL, 0x10000);
+	cap = readl(xhci) & 0xff;
+	if (cap < 0x20 || cap > 0x100 || cap % 4) {
+		ret = -EPROTO;
+		goto fail;
+	}
+	hw.xhci = xhci;
+	hw.cap = cap;
+	hw.usb = usb;
+	if (power_trace) snapshot_cable_power(NULL);
+	snapshot_dwc3(&hw, "before-remove");
+	ret = device_remove(usb, DM_REMOVE_NORMAL | DM_REMOVE_NO_PD);
+	if (ret)
+		goto fail;
+	/* xhci_deregister() discards the low-level stop result; verify HALTED. */
+	ret = readl_poll_timeout(xhci + cap + 4, halted,
+				halted != 0xffffffff && (halted & BIT(0)), 100000);
+	if (ret)
+		goto fail;
+	puts("ATC-M1 selected DWC3 halted; other USB hosts untouched\n");
+	if (fresh) {
+		ret = wait_fresh_cable(&before);
+		if (ret) goto fail;
+	}
+	ret = load_config(node, &hw, &after);
+	if (ret)
+		goto fail;
+	if (before.data_status != after.data_status || before.eudo != after.eudo ||
+	    before.tbt_device_mode != after.tbt_device_mode ||
+	    before.tbt_enter_vdo != after.tbt_enter_vdo) {
+		ret = -EAGAIN;
+		goto fail;
+	}
+	if (stage >= 4) {
+		ret = apple_nhi_m1_set_cable(&after);
+		if (ret) goto fail;
+	}
+	for (i = 0; i < ATC_REGIONS; i++) {
+		static const char *const resource_names[] = {
+			"core", "axi2af", "usb2phy", "pipehandler", "lpdptx",
+		};
+
+		ret = ofnode_read_resource_byname(node, resource_names[i], &res);
+		if (ret)
+			goto fail;
+		hw.base[i] = map_sysmem(res.start, resource_size(&res));
+	}
+	hw.cfg.retain_dwc3 = acio;
+	hw.cfg.hold_dwc3_reset = tb_only;
+	hw.xhci = xhci;
+	hw.cap = cap;
+	hw.printed_stage = ATC_DONE;
+	apple_boot_trace("phy-sequence-begin");
+	/* Test Linux ordering only in full host mode; earlier diagnostics unchanged. */
+	ret = stage >= 4 ?
+		atc_m1_start_core(&hw.cfg, &hw_io, &hw, true, &hw.stage) :
+		atc_m1_start(&hw.cfg, &hw_io, &hw, true, &hw.stage);
+	apple_boot_trace("phy-sequence-return");
+	if (ret) {
+		printf("ATC-M1 stopped at stage=%u; reset required\n", hw.stage);
+		printf("ATC-M1 last read region=%u offset=%#x value=%#x\n",
+		       hw.last_region, hw.last_offset, hw.last_value);
+		goto fail;
+	}
+	if (acio) {
+		puts("ATC-M1 PHY retained for ACIO; xHCI remains halted\n");
+		snapshot_phy(&hw, "before-acio");
+		if (!tb_only)
+			snapshot_dwc3(&hw, "before-acio");
+		else
+			puts("TBT-ONLY DWC3 remains reset; no late PIPE, xHCI or USB DMA\n");
+		if (stage >= 4 && !tb_only)
+			apple_nhi_m1_set_post_cable(start_late_pipe, &hw);
+		if (extended)
+			apple_nhi_m1_set_post_link(snapshot_phy_extended, &hw);
+		if (power_trace) apple_nhi_m1_set_link_sample(snapshot_cable_power, NULL);
+		if (pciec) apple_nhi_m1_set_pre_link(apple_pciec_m1_prepare, NULL);
+		apple_nhi_m1_set_queries(queries);
+		ret = apple_acio_m1_start(stage);
+		apple_nhi_m1_set_pre_link(NULL, NULL);
+		apple_nhi_m1_set_link_sample(NULL, NULL);
+		if (power_trace) snapshot_cable_power(NULL);
+		apple_nhi_m1_set_queries(false);
+		apple_nhi_m1_set_post_link(NULL, NULL);
+		apple_nhi_m1_set_post_cable(NULL, NULL);
+#if CONFIG_IS_ENABLED(USB_XHCI_HCD)
+        if (hw.retained_xhci) {
+         int stop;
+         apple_boot_trace("xhci-stop-begin");
+         stop = xhci_m1_diag_stop(hw.retained_xhci);
+         apple_boot_trace("xhci-stop-return");
+         printf("M1-XHCI stop ret=%d; buffers retained\n", stop);
+         if (stop) ret = stop;
+        }
+#endif
+		snapshot_phy(&hw, "after-acio");
+		if (!tb_only)
+			snapshot_dwc3(&hw, "after-acio");
+		if (ret) goto fail;
+	} else {
+		puts("ATC-M1 PHY SEQUENCE PASS; DWC3 held reset, no ACIO/NHI/tunnel/DMA\n");
+	}
+	apple_boot_trace_dump();
+	puts("Diagnostic state only: reset before any OS handover\n");
+	return CMD_RET_SUCCESS;
+fail:
+	apple_boot_trace_dump();
+	printf("ATC-M1 diagnostic error=%d; no automatic retry\n", ret);
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(atcm1, 3, 0, do_atcm1,
+	   "explicit M1 port1 PHY diagnostic, requires reset afterwards",
+	   "1 check|start|acio|nhi|dart|tune|host|hostrun|fresh|tbonly|usb4host|usb4query|usb4snapshot|usb4power|usb4pciec - bounded diagnostic; hostrun/usb4host also enable xHCI DMA");
diff --git a/cmd/apple_cd321x.c b/cmd/apple_cd321x.c
new file mode 100644
index 00000000..8f832f9e
--- /dev/null
+++ b/cmd/apple_cd321x.c
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <apple_cd321x.h>
+#include <command.h>
+#include <dm.h>
+#include <i2c.h>
+#include <linux/bitops.h>
+
+static int cd321x_read(void *ctx, u8 reg, u8 *buf, size_t size)
+{
+	return dm_i2c_read(ctx, reg, buf, size);
+}
+
+static int do_cd321x(struct cmd_tbl *cmdtp, int flag, int argc,
+		     char *const argv[])
+{
+	struct apple_cd321x_status s;
+	struct udevice *bus, *chip;
+	unsigned long busnum, addr;
+	int ret;
+
+	if (argc != 3 || strict_strtoul(argv[1], 10, &busnum) ||
+	    strict_strtoul(argv[2], 16, &addr) || busnum > 255 ||
+	    (addr != 0x38 && addr != 0x3f))
+		return CMD_RET_USAGE;
+	/* Explicit J274 controller selection; never scan unrelated I2C devices. */
+	ret = uclass_get_device_by_seq(UCLASS_I2C, busnum, &bus);
+	if (!ret)
+		ret = i2c_get_chip(bus, addr, 1, &chip);
+	if (!ret)
+		ret = i2c_set_chip_offset_len(chip, 1);
+	if (!ret)
+		ret = apple_cd321x_snapshot(cd321x_read, chip, &s);
+	if (ret) {
+		printf("CD321x status unavailable: %d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+	printf("CD321x bus=%lu addr=%02lx status=%08x data=%08x\n",
+	       busnum, addr, s.status, s.data_status);
+	printf("USB4=%u TBT=%u USB3=%u orientation=%u active_cable=%u\n",
+	       !!(s.data_status & BIT(23)), !!(s.data_status & BIT(16)),
+	       !!(s.data_status & BIT(5)), !!(s.data_status & BIT(1)),
+	       !!(s.data_status & BIT(22)));
+	if (s.data_status & BIT(23))
+		printf("USB4 mode=%02x EUDO=%08x\n", s.usb4_mode, s.eudo);
+	puts("Status only: no PHY setup, tunnel or disk access performed.\n");
+	if (s.data_status & BIT(16))
+		printf("TBT device_mode=%08x enter_vdo=%08x\n", s.tbt_device_mode, s.tbt_enter_vdo);
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(cd321x, 3, 0, do_cd321x,
+	   "read selected M1 CD321x status without changing its mode",
+	   "<bus decimal> <chip hex: 38 or 3f>");
diff --git a/cmd/apple_nhi_m1.c b/cmd/apple_nhi_m1.c
new file mode 100644
index 00000000..8d7e0d72
--- /dev/null
+++ b/cmd/apple_nhi_m1.c
@@ -0,0 +1,276 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* J274 port1 NHI diagnostic, no ring activation or external storage access.
+ * Register layout and stream assignment derived from Asahi Linux apple.c
+ * and t8103.dtsi. Copyright The Asahi Linux Contributors.
+ * Copyright (c) Sven Peter <sven@kernel.org>
+ */
+#include <apple_nhi_m1.h>
+#include <apple_acio_m1.h>
+#include <linux/errno.h>
+#ifdef CONFIG_ARCH_APPLE
+#include <apple_dart.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <dm.h>
+#include <dm/device-internal.h>
+#include <dm/lists.h>
+#include <dm/ofnode.h>
+#include <iommu.h>
+#include <linux/ioport.h>
+#include <linux/sizes.h>
+#include <malloc.h>
+#include <mapmem.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+#define ACIO_PATH "/soc/cio@501ac0000"
+#define NHI_PATH ACIO_PATH "/nhi@f00000"
+#define DART_PATH ACIO_PATH "/iommu@a80000"
+#define NHI_BASE 0x501f00000ULL
+#define DART_BASE 0x501a80000ULL
+
+static int exact_resource(ofnode node, const char *name, u64 addr, u64 size)
+{
+	struct resource res;
+	int ret = name ? ofnode_read_resource_byname(node, name, &res) :
+			 ofnode_read_resource(node, 0, &res);
+
+	if (ret)
+		return ret;
+	return res.start == addr && resource_size(&res) == size ? 0 : -ERANGE;
+}
+
+int apple_nhi_m1_check(void)
+{
+	ofnode node = ofnode_path(DART_PATH), nhi = ofnode_path(NHI_PATH);
+	struct ofnode_phandle_args args;
+	int ret;
+
+	if (!ofnode_device_is_compatible(ofnode_root(), "apple,j274") ||
+	    !ofnode_device_is_compatible(node, "apple,t8103-dart") ||
+	    !ofnode_device_is_compatible(nhi, "apple,t8103-usb4-nhi") ||
+	    ofnode_is_enabled(node) || ofnode_is_enabled(nhi) ||
+	    !ofnode_read_bool(node, "u-boot,force-dart-translation"))
+		return -ENODEV;
+	ret = exact_resource(node, NULL, DART_BASE, 0x4000);
+	if (ret)
+		return ret;
+	ret = exact_resource(nhi, "nhi", NHI_BASE, 0x100000);
+	if (ret)
+		return ret;
+	ret = ofnode_parse_phandle_with_args(nhi, "iommus", "#iommu-cells",
+					   0, 0, &args);
+	if (ret || args.args_count != 1 || args.args[0] != 1 ||
+	    !ofnode_equal(args.node, node))
+		return -EINVAL;
+	return 0;
+}
+
+int apple_nhi_m1_control_check(void)
+{
+	return exact_resource(ofnode_path(NHI_PATH), "pdf", 0x501db0000ULL, 0x30004);
+}
+
+/* Same BE32 offset/clear-mask/set-value format as Linux apple_tunable.
+ * Validate BOTH groups before power or MMIO, then revalidate before applying.
+ */
+static int tunable_load(bool nhi, const u32 **data, int *bytes)
+{
+	u32 off, size = nhi ? 0x100000 : 0xc000;
+	int i;
+
+	*data = ofnode_get_property(ofnode_path(nhi ? NHI_PATH : ACIO_PATH),
+			nhi ? "apple,tunable-nhi" : "apple,tunable-rc", bytes);
+	if (!*data || *bytes <= 0)
+		return -ENOENT;
+	if (*bytes > 65532 || *bytes % 12)
+		return -EINVAL;
+	for (i = 0; i < *bytes / 4; i += 3) {
+		off = be32_to_cpu((*data)[i]);
+		if ((off & 3) || off > size - 4)
+			return -ERANGE;
+		/* NHI ring control registers are not tuning targets. */
+		if (nhi && !((off >= 0xe8000 && off < 0x100000) ||
+			     (off >= 0x4000 && off < 0x4400)))
+			return -EPERM;
+	}
+	return 0;
+}
+
+int apple_nhi_m1_tunables_check(void)
+{
+	const u32 *data;
+	int bytes, ret = tunable_load(false, &data, &bytes);
+
+	return ret ? ret : tunable_load(true, &data, &bytes);
+}
+
+int apple_nhi_m1_tunables_apply(bool nhi)
+{
+	const u32 *data;
+	void *regs;
+	u32 off, mask, value, old;
+	unsigned int written = 0, skipped = 0;
+	int i, bytes, ret = tunable_load(nhi, &data, &bytes);
+
+	if (ret)
+		return ret;
+	regs = map_sysmem(nhi ? NHI_BASE : 0x501ac0000ULL,
+			  nhi ? 0x100000 : 0xc000);
+	for (i = 0; i < bytes / 4; i += 3) {
+		off = be32_to_cpu(data[i]);
+		mask = be32_to_cpu(data[i + 1]);
+		value = be32_to_cpu(data[i + 2]);
+		old = readl(regs + off);
+		value = (old & ~mask) | value;
+		if (value != old) {
+			writel(value, regs + off);
+			written++;
+		} else {
+			skipped++;
+		}
+	}
+	printf("ACIO %s tunables applied count=%d written=%u skipped=%u\n",
+	       nhi ? "NHI" : "RC", bytes / 12, written, skipped);
+	return 0;
+}
+
+/* Only called after ACIO firmware is ready and power is held. */
+static int rings_idle(void)
+{
+	void *nhi = map_sysmem(NHI_BASE, 0x100000);
+	u32 value;
+	int i;
+
+	for (i = 0; i < 12; i++) {
+		value = readl(nhi + 0x10000 + i * 0x4000 + 0x10);
+		if (value == 0xffffffff || (value & BIT(31)))
+			return -EBUSY;
+		value = readl(nhi + 0x80000 + i * 0x4000 + 0x10);
+		if (value == 0xffffffff || (value & BIT(31)))
+			return -EBUSY;
+	}
+	return 0;
+}
+
+/* Probe13 observed 0x80080 on all cold streams. Do not treat this alone
+ * as ownership: accept only that exact state or disabled TCR, and require
+ * every TTBR to be invalid. Active/unknown mappings must never be replaced.
+ * The caller also proves all NHI rings disabled before touching this DART.
+ */
+static int empty_translation(void *regs)
+{
+	u32 value;
+	int sid, index, ret = 0;
+
+	for (sid = 0; sid < 16; sid++) {
+		value = readl(regs + 0x100 + sid * 4);
+		printf("NHI DART initial TCR[%d]=%#x\n", sid, value);
+		if (value != 0 && value != 0x80080)
+			ret = -EBUSY;
+		for (index = 0; index < 4; index++) {
+			value = readl(regs + 0x200 + sid * 16 + index * 4);
+			if (value & BIT(31)) {
+				printf("NHI DART valid TTBR[%d,%d]=%#x\n", sid, index, value);
+				ret = -EBUSY;
+			}
+		}
+	}
+	value = readl(regs + 0x20);
+	if (value == 0xffffffff || (value & BIT(2)))
+		ret = -EBUSY;
+	if (!ret)
+		puts("NHI DART initial tables empty; no inherited mapping\n");
+	return ret;
+}
+
+int apple_nhi_m1_dart_test(unsigned int stage)
+{
+	struct udevice *dart = NULL;
+	const struct iommu_ops *ops;
+	void *regs = map_sysmem(DART_BASE, 0x4000);
+	void *buffer = NULL;
+	dma_addr_t dva;
+	u32 value;
+	int i, ret;
+
+	ret = apple_nhi_m1_check();
+	if (ret)
+		return ret;
+	ret = rings_idle();
+	if (ret)
+		return ret;
+	value = readl(regs + 0x60);
+	printf("NHI DART config=%#x params2=%#x\n", value, readl(regs + 4));
+	if (value == 0xffffffff || (value & BIT(15)))
+		return -EBUSY;
+	ret = empty_translation(regs);
+	if (ret)
+		return ret;
+	ret = lists_bind_fdt(gd->dm_root, ofnode_path(DART_PATH), &dart,
+			    lists_driver_lookup_name("apple_dart"), false);
+	if (ret || !dart)
+		return ret ? ret : -ENODEV;
+	apple_boot_trace("nhi-dart-probe-begin");
+	ret = device_probe(dart);
+	apple_boot_trace("nhi-dart-probe-return");
+	if (ret)
+		return ret;
+	ret = apple_dart_limit_stream(dart, 1);
+	if (ret)
+		return ret;
+	for (i = 0; i < 16; i++) {
+		if (readl(regs + 0x100 + i * 4) != (i == 1 ? BIT(7) : 0))
+			return -EIO;
+	}
+	puts("NHI DART stream1 translation enabled; all other streams disabled\n");
+	if (stage >= 3) {
+		apple_boot_trace("nhi-tunables-begin");
+		ret = apple_nhi_m1_tunables_apply(true);
+		apple_boot_trace("nhi-tunables-return");
+		if (!ret)
+			ret = rings_idle();
+		if (ret)
+			return ret;
+		puts("NHI-TUNABLES PASS; all rings remain disabled\n");
+	}
+	if (stage >= 4)
+		return apple_nhi_m1_control_read(dart);
+	ops = device_get_ops(dart);
+	buffer = memalign(SZ_16K, 2 * SZ_16K);
+	if (!buffer)
+		return -ENOMEM;
+	memset(buffer, 0xa5, 2 * SZ_16K);
+	dva = ops->map(dart, buffer, 2 * SZ_16K);
+	ret = apple_dart_get_error(dart);
+	/* On any uncertain failure retain the buffer until mandatory reset. */
+	if (ret)
+		return ret;
+	if (!dva) {
+		free(buffer);
+		return -ENOMEM;
+	}
+	printf("NHI DART mapped size=%#x iova=%llx\n", 2 * SZ_16K, (u64)dva);
+	if (dva < SZ_16K || dva > 0x100000000ULL - 3 * SZ_16K ||
+	    (dva & (SZ_16K - 1)))
+		return -ERANGE;
+	ret = rings_idle();
+	if (ret)
+		return ret;
+	ops->unmap(dart, dva, 2 * SZ_16K);
+	ret = apple_dart_get_error(dart);
+	if (ret)
+		return ret;
+	free(buffer);
+	ret = device_remove(dart, DM_REMOVE_NORMAL);
+	if (ret)
+		return ret;
+	puts("NHI-DART-MAP PASS; map/unmap/remove only, no DMA issued\n");
+	return 0;
+}
+#else
+int apple_nhi_m1_control_check(void) { return -ENOSYS; }
+int apple_nhi_m1_tunables_check(void) { return -ENOSYS; }
+int apple_nhi_m1_tunables_apply(bool nhi) { return -ENOSYS; }
+int apple_nhi_m1_check(void) { return -ENOSYS; }
+int apple_nhi_m1_dart_test(unsigned int stage) { return -ENOSYS; }
+#endif
diff --git a/cmd/apple_nhi_m1_inventory.c b/cmd/apple_nhi_m1_inventory.c
new file mode 100644
index 00000000..da68084d
--- /dev/null
+++ b/cmd/apple_nhi_m1_inventory.c
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Host-router inventory, never unlocks a port or writes cable info.
+ * Layout: Linux drivers/thunderbolt/{cap.c,tb_regs.h,apple.c}.
+ * Copyright (c) 2014 Andreas Noever <andreas.noever@gmail.com>
+ * Copyright (C) 2018, Intel Corporation
+ * Copyright The Asahi Linux Contributors
+ */
+#include <apple_nhi_m1.h>
+#include <linux/errno.h>
+#include <stdio.h>
+
+int apple_nhi_m1_inventory(apple_nhi_read_fn read,
+			   apple_nhi_host_config_fn configure, void *context,
+			   struct apple_nhi_host_info *info)
+{
+	u32 data[8], config[4], seen[32], offset, next, cap, vsec, length;
+	u32 max_port, upstream, apple = 0, null_ports = 0, port1_cap = 0, tmu = 0;
+	unsigned int count = 0, i, port;
+	u32 dp_in_ports = 0;
+	int ret;
+
+	if (!read || !configure || !info)
+		return -EINVAL;
+	ret = read(context, 0, 2, 0, 5, data);
+	if (ret)
+		return ret;
+	max_port = (data[1] >> 14) & 63;
+	upstream = (data[1] >> 8) & 63;
+	if ((data[0] & 0xffff) != 0x05ac || !max_port || max_port > 16 ||
+	    upstream > max_port || data[2] || (data[3] & 0x7fffffff) ||
+	    ((data[1] >> 20) & 7))
+		return -EPROTO;
+	printf("NHI host vendor/device=%08x max-port=%u upstream=%u version=%02x enabled=%u\n",
+	       data[0], max_port, upstream, data[4] >> 24, data[3] >> 31);
+	/* Linux tb_switch_configure(): root route unchanged, enable CM access,
+	 * notification delay 255 ms and CM version appropriate to USB4 version.
+	 * Restrict this diagnostic to the observed USB4 v1 host revision.
+	 */
+	if ((data[4] >> 24) != 0x20 || (data[3] >> 31))
+		return -EPROTO;
+	config[0] = data[1];
+	config[1] = data[2];
+	config[2] = data[3] | (1U << 31);
+	config[3] = (data[4] & 0xffff0000) | 0x10ff;
+	offset = data[1] & 255;
+	while (offset) {
+		if (offset < 5 || offset > 0x1ffe)
+			return -ERANGE;
+		if (count == 32)
+			return -E2BIG;
+		for (i = 0; i < count; i++)
+			if (seen[i] == offset)
+				return -ELOOP;
+		seen[count++] = offset;
+		ret = read(context, 0, 2, offset, 2, data);
+		if (ret)
+			return ret;
+		cap = (data[0] >> 8) & 255;
+		vsec = (data[0] >> 16) & 255;
+		next = data[0] & 255;
+		length = 1;
+		if (cap == 5) {
+			length = data[0] >> 24;
+			if (!length) {
+				if (next)
+					return -EPROTO;
+				next = data[1] & 0xffff;
+				length = data[1] >> 16;
+				if (length < 2)
+					return -EPROTO;
+			}
+			if (length > 0x2000 - offset)
+				return -ERANGE;
+		} else if (cap != 3) {
+			return -EPROTO;
+		}
+		printf("NHI capability offset=%#x id=%#x vsec=%#x length=%u next=%#x raw=%08x %08x\n",
+		       offset, cap, vsec, length, next, data[0], data[1]);
+		if (cap == 3) {
+			if (tmu || offset > 0x1ffc)
+				return -EPROTO;
+			tmu = offset;
+		}
+		if (cap == 5 && !vsec) {
+			if (apple || length < 2)
+				return -EPROTO;
+			apple = offset;
+		}
+		offset = next;
+	}
+	if (!apple)
+		return -ENOENT;
+	ret = configure(context, config);
+	if (ret)
+		return ret;
+	ret = read(context, 0, 2, 1, 4, data);
+	if (ret)
+		return ret;
+	for (i = 0; i < 4; i++)
+		if (data[i] != config[i])
+			return -EIO;
+	puts("NHI-HOST-CONFIG PASS; root enabled, no cable-info or tunnel writes\n");
+	for (port = 1; port <= max_port; port++) {
+		ret = read(context, port, 1, 0, 8, data);
+		if (ret)
+			return ret;
+		printf("NHI adapter port=%u type=%06x header=%08x %08x %08x %08x %08x %08x %08x %08x\n",
+		       port, data[2] & 0xffffff, data[0], data[1], data[2],
+		       data[3], data[4], data[5], data[6], data[7]);
+		if ((data[2] & 0xffffff) && ((data[3] >> 20) & 63) != port)
+			return -EPROTO;
+		if ((data[2] & 0xffffff) == 1)
+			null_ports |= 1U << port;
+		if ((data[2] & 0xffffff) == 0xe0101)
+			dp_in_ports |= 1U << port;
+		if (port == 1)
+			port1_cap = data[1] & 255;
+	}
+	printf("NHI-HOST-INVENTORY PASS capabilities=%u apple=%#x null-ports=%#x; ports read-only\n",
+	       count, apple, null_ports);
+	info->apple = apple;
+	info->null_ports = null_ports;
+	info->port1_cap = port1_cap;
+	info->tmu = tmu;
+	info->dp_in_ports = dp_in_ports;
+	return 0;
+}
+
+/* Validate the exported revision-1 DROM without exposing its device UID.
+ * The diagnostic is restricted to the measured J274 lane pair 1/2.
+ */
+static int validate_link_drom(const u8 *d, unsigned int len)
+{
+	u32 crc = ~0U, stored, seen = 0, pair = 0;
+	unsigned int total, pos, i, bit, n, port;
+	u8 uid_crc = 255;
+
+	if (!d || len < 22 || len > 4096 || d[13] != 1)
+		return -EINVAL;
+	total = 13 + ((d[14] | d[15] << 8) & 4095);
+	if (total < 22 || total > len || len - total > 3)
+		return -ERANGE;
+	for (i = total; i < len; i++)
+		if (d[i]) return -EPROTO;
+	for (i = 1; i <= 8; i++) {
+		uid_crc ^= d[i];
+		for (bit = 0; bit < 8; bit++)
+			uid_crc = (uid_crc << 1) ^ ((uid_crc & 128) ? 7 : 0);
+	}
+	if (uid_crc != d[0]) return -EBADMSG;
+	for (i = 13; i < total; i++) {
+		crc ^= d[i];
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc >> 1) ^ ((crc & 1) ? 0x82f63b78 : 0);
+	}
+	stored = (u32)d[9] | (u32)d[10] << 8 | (u32)d[11] << 16 | (u32)d[12] << 24;
+	if (~crc != stored) return -EBADMSG;
+	for (pos = 22; pos < total; pos += n) {
+		if (total - pos < 2) return -EPROTO;
+		n = d[pos];
+		if (n < 2 || n > total - pos) return -EPROTO;
+		if (!(d[pos + 1] & 128)) continue;
+		port = d[pos + 1] & 63;
+		if (!port || port > 7 || d[pos + 1] & 64 || seen & (1U << port))
+			return -EPROTO;
+		seen |= 1U << port;
+		if (port <= 2) {
+			if (n != 8 || !(d[pos + 2] & 128) ||
+			    ((d[pos + 2] >> 4) & 1) != port - 1 ||
+			    (d[pos + 3] & 63) != 3 - port) return -EPROTO;
+			pair |= 1U << port;
+		}
+	}
+	if (seen != 0xfe || pair != 6) return -EPROTO;
+	return 0;
+}
+
+int apple_nhi_m1_link_metadata(const u8 *d, unsigned int len,
+                              u32 status, u32 eudo, u32 *cable)
+{
+ u32 result = 1;
+ int ret;
+ if (!cable) return -EINVAL;
+ if (!(status & 1) || !(status & (1U << 23)) || status & (1U << 16) ||
+     ((eudo >> 21) & 7) < 2 || ((eudo >> 21) & 7) > 3)
+  return -EPROTONOSUPPORT;
+ ret = validate_link_drom(d, len);
+ if (ret) return ret;
+ if (status & 2) result |= 2;
+ if ((eudo >> 19) & 3) result |= 4;
+ if (((eudo >> 21) & 7) == 3) result |= 16;
+ *cable = result;
+ return 0;
+}
+
+/* Linux tipd/core.c -> thunderbolt/apple.c TBT cable mapping. */
+int apple_nhi_m1_tbt_metadata(const u8 *d, unsigned int len,
+                             u32 status, u32 device_mode, u32 *cable)
+{
+ u32 result = (1U << 10) | 1, speed = (status >> 25) & 7;
+ int ret;
+ if (!cable) return -EINVAL;
+ if (!(status & 1) || !(status & (1U << 16)) || status & (1U << 23) ||
+     (device_mode & 0xffff) != 1 || speed < 1 || speed > 3)
+  return -EPROTONOSUPPORT;
+ ret = validate_link_drom(d, len);
+ if (ret) return ret;
+ if (status & 2) result |= 2;
+ if (status & (1U << 2)) {
+  result |= 4;
+  if (!(status & (1U << 20))) result |= 8;
+ }
+ if (device_mode & (1U << 16)) result |= 1U << 9;
+ if (speed == 3) result |= 16;
+ *cable = result;
+ return 0;
+}
+
+/* USB4 root-router LOWRES sequence from Linux thunderbolt/tmu.c:
+ * Time Disruption -> packet interval 1000 -> clear Time Disruption.
+ * Only this discovered host capability is writable. No downstream writes.
+ * Retain the first failure and attempt to clear TD even after a failed write;
+ * the caller must stop the probe and reset on any error.
+ */
+int apple_nhi_m1_tmu_lowres(apple_nhi_read_fn read,
+                          apple_nhi_tmu_write_fn write, void *context, u32 cap)
+{
+ const u32 td = 1U << 27, ucap = 1U << 30, rate = 1000U << 16;
+ u32 control, interval, value;
+ int ret, cleanup;
+
+ if (!read || !write || cap < 5 || cap > 0x1ffc) return -EINVAL;
+ ret = read(context, 0, 2, cap, 1, &control);
+ if (ret) return ret;
+ if (((control >> 8) & 255) != 3 || !(control & ucap)) return -EPROTO;
+ if (control & td) return -EBUSY;
+ ret = read(context, 0, 2, cap + 3, 1, &interval);
+ if (ret) return ret;
+ printf("NHI-TMU before cap=%#x control=%08x interval=%08x\n", cap, control, interval);
+ if ((interval & 0xffff0000U) == rate) {
+  puts("NHI-TMU PASS already LOWRES; no writes\n");
+  return 0;
+ }
+ if (interval >> 16) return -EBUSY;
+ ret = write(context, cap, control | td);
+ if (ret) goto clear;
+ ret = read(context, 0, 2, cap, 1, &value);
+ if (ret) goto clear;
+ if (!(value & td)) { ret = -EIO; goto clear; }
+ ret = write(context, cap + 3, (interval & 0xffffU) | rate);
+ if (ret) goto clear;
+ ret = read(context, 0, 2, cap + 3, 1, &value);
+ if (ret) goto clear;
+ if ((value & 0xffff0000U) != rate) ret = -EIO;
+clear:
+ cleanup = read(context, 0, 2, cap, 1, &value);
+ if (!cleanup) cleanup = write(context, cap, value & ~td);
+ if (!cleanup) cleanup = read(context, 0, 2, cap, 1, &value);
+ if (!cleanup && (value & td)) cleanup = -EIO;
+ if (ret || cleanup) {
+  printf("NHI-TMU FAIL operation=%d cleanup=%d; mandatory reset\n", ret, cleanup);
+  return ret ? ret : cleanup;
+ }
+ puts("NHI-TMU PASS LOWRES interval=1000 TD=0\n");
+ return 0;
+}
+
+/* Linux usb4_native_switch_op() protocol, restricted to read-only operations.
+ * Reference: Linux usb4.c, Copyright (C) 2019 Intel Corporation;
+ * authors Mika Westerberg and Rajmohan Mani.
+ * No NVM programming/authentication, DP allocation or arbitrary opcode input.
+ * All register traffic is constrained to host route zero by the callbacks.
+ */
+int apple_nhi_m1_query(apple_nhi_read_fn read, apple_nhi_tmu_write_fn write,
+                      void (*wait)(void *), void *context, u32 opcode, u32 metadata)
+{
+ u32 value, data[16];
+ unsigned int i, poll;
+ int ret;
+ if (!read || !write || !wait ||
+     !((opcode == 0x25 || opcode == 0x33) ? metadata == 0 :
+       opcode == 0x10 && (metadata == 5 || metadata == 6)))
+  return -EINVAL;
+ ret = read(context, 0, 2, 0x1a, 1, &value);
+ if (ret) return ret;
+ if (value & (1U << 31)) return -EBUSY;
+ ret = write(context, 0x19, metadata);
+ if (ret) return ret;
+ ret = write(context, 0x1a, (1U << 31) | opcode);
+ if (ret) return ret;
+ for (poll = 0; poll < 10; poll++) {
+  ret = read(context, 0, 2, 0x1a, 1, &value);
+  if (ret) return ret;
+  if (!(value & (1U << 31))) break;
+  if (poll != 9) wait(context);
+ }
+ if (value & (1U << 31)) return -ETIMEDOUT;
+ printf("NHI-QUERY opcode=%#x input=%#x completion=%08x polls=%u\n",
+        opcode, metadata, value, poll + 1);
+ if (value & (1U << 30)) return -EOPNOTSUPP;
+ if ((value & 0x3f000000U) == 0x02000000U && opcode == 0x25)
+  return -EOPNOTSUPP;
+ if (value & 0x3f000000U) return -EIO;
+ ret = read(context, 0, 2, 0x19, 1, &metadata);
+ if (ret) return ret;
+ printf("NHI-QUERY result opcode=%#x metadata=%08x\n", opcode, metadata);
+ if (opcode == 0x33) {
+  if ((metadata & 255) > 16) return -EMSGSIZE;
+  ret = read(context, 0, 2, 9, 16, data);
+  if (ret) return ret;
+  for (i = 0; i < (metadata & 255); i++)
+   printf("NHI-QUERY buffer[%u]=%08x\n", i, data[i]);
+ }
+ return 0;
+}
diff --git a/cmd/apple_nhi_m1_ring.c b/cmd/apple_nhi_m1_ring.c
new file mode 100644
index 00000000..fdde3df4
--- /dev/null
+++ b/cmd/apple_nhi_m1_ring.c
@@ -0,0 +1,494 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* RAM-only M1 host-router read, never an external PCIe tunnel.
+ * Ring layout/sequence derived from Asahi Linux apple.c, nhi.c and ctl.c.
+ * Copyright The Asahi Linux Contributors
+ * Copyright (c) Sven Peter <sven@kernel.org>
+ * Copyright (c) 2014 Andreas Noever <andreas.noever@gmail.com>
+ * Copyright (C) 2018, Intel Corporation
+ */
+#include <apple_nhi_m1.h>
+#include <linux/errno.h>
+#ifdef CONFIG_ARCH_APPLE
+#include <apple_dart.h>
+#include <apple_acio_m1.h>
+#include <apple_cd321x.h>
+#include <dm/ofnode.h>
+#include <asm/io.h>
+#include <asm/unaligned.h>
+#include <cpu_func.h>
+#include <dm.h>
+#include <iommu.h>
+#include <linux/delay.h>
+#include <linux/sizes.h>
+#include <malloc.h>
+#include <mapmem.h>
+#include <time.h>
+#include <usb4_cfg.h>
+
+#define NHI_BASE 0x501f00000ULL
+#define PDF_BASE 0x501db0000ULL
+#define DART_BASE 0x501a80000ULL
+#define PAGE SZ_16K
+#define RING_COUNT 128
+/* Two 16K pages per packet block; descriptors still occupy one page each. */
+_Static_assert(RING_COUNT * 256 <= 2 * PAGE, "packet block capacity");
+_Static_assert(RING_COUNT * 16 <= PAGE, "descriptor block capacity");
+#define DESC_POSTED BIT(22)
+#define DESC_DONE BIT(21)
+#define DESC_ERROR (BIT(20) | BIT(22))
+#define RING_ENABLE BIT(31)
+#define RING_RAW BIT(30)
+struct diagnostic_desc { u64 address; u32 fields, time; };
+struct diagnostic_ring {
+ void *buffer, *nhi, *dart_regs;
+ struct diagnostic_desc *tx, *rx;
+ unsigned int sent, received, skipped, acked, pending_count;
+ u32 tmu_cap;
+ struct usb4_cfg_event pending[8];
+ ulong started;
+};
+
+static void (*post_link)(void *);
+static void *post_link_context;
+void apple_nhi_m1_set_post_link(void (*callback)(void *), void *context)
+{ post_link = callback; post_link_context = context; }
+
+static bool diagnostic_queries;
+void apple_nhi_m1_set_queries(bool enabled) { diagnostic_queries = enabled; }
+
+static int (*post_cable)(void *);
+static void *post_cable_context;
+
+void apple_nhi_m1_set_post_cable(int (*callback)(void *), void *context)
+{
+ post_cable = callback;
+ post_cable_context = context;
+}
+
+static u32 diagnostic_cable;
+static bool diagnostic_cable_valid;
+
+int apple_nhi_m1_set_cable(const struct apple_cd321x_status *status)
+{
+ const u8 *drom;
+ int len, ret;
+ diagnostic_cable_valid = false;
+ if (!status) return -EINVAL;
+ drom = ofnode_get_property(ofnode_path("/soc/cio@501ac0000/nhi@f00000"),
+                            "apple,thunderbolt-drom", &len);
+ if (!drom || len < 0) return -ENOENT;
+ if (status->data_status & BIT(16))
+  ret = apple_nhi_m1_tbt_metadata(drom, len, status->data_status,
+                                 status->tbt_device_mode, &diagnostic_cable);
+ else
+  ret = apple_nhi_m1_link_metadata(drom, len, status->data_status,
+                                  status->eudo, &diagnostic_cable);
+ if (ret) return ret;
+ diagnostic_cable_valid = true;
+ printf("NHI link metadata PASS: DROM lane pair 1/2 verified, cable=%#x\n", diagnostic_cable);
+ return 0;
+}
+
+/* No descriptor is recycled. Only one TX is outstanding, up to 127 transactions.
+ * RX descriptors are published once and only invalidated/read afterwards.
+ * This avoids CPU cache writeback racing a device update on a shared line.
+ */
+/* Serialize ACKs after the current TX descriptor completes. No descriptor
+ * reuse, recursion or response wait: Linux sends these notifications one-way.
+ * This M1 diagnostic acknowledges only validated events from its root ports.
+ */
+static int diagnostic_ack_events(struct diagnostic_ring *r)
+{
+ unsigned int i;
+ for (i = 0; i < r->pending_count; i++) {
+  const struct usb4_cfg_event *event = &r->pending[i];
+  unsigned int slot = r->sent;
+  ulong started;
+  int len, ret;
+  if (event->route || !event->port || event->port > 7) return -EPROTO;
+  if (r->acked >= 8 || slot >= RING_COUNT - 1) return -ENOSPC;
+  if (get_timer(r->started) >= 10000) return -ETIMEDOUT;
+  len = usb4_cfg_ack_plug_encode(event, r->buffer + 2 * PAGE + slot * 256, 256);
+  if (len < 0) return len;
+  invalidate_dcache_range((ulong)r->tx, (ulong)r->tx + PAGE);
+  r->tx[slot].fields = cpu_to_le32(len | (USB4_CFG_ERROR << 12) |
+                                  (USB4_CFG_ERROR << 16) | DESC_POSTED);
+  flush_dcache_range((ulong)r->buffer + 2 * PAGE, (ulong)r->buffer + 4 * PAGE);
+  flush_dcache_range((ulong)r->tx, (ulong)r->tx + PAGE);
+  mb();
+  r->sent++;
+  writel(r->sent << 16, r->nhi + 0x10008);
+  started = get_timer(0);
+  for (;;) {
+   ret = apple_acio_m1_service();
+   if (ret) return ret;
+   invalidate_dcache_range((ulong)r->tx, (ulong)r->tx + PAGE);
+   mb();
+   if (readl(r->dart_regs + 0x40) & BIT(31)) return -EFAULT;
+   if (readl(&r->tx[slot].fields) & DESC_DONE) break;
+   if (get_timer(started) >= 2000 || get_timer(r->started) >= 10000)
+    return -ETIMEDOUT;
+   udelay(50);
+  }
+  r->acked++;
+  printf("NHI-EVENT-ACK SENT port=%u unplug=%u count=%u\n",
+         event->port, event->unplug, r->acked);
+ }
+ r->pending_count = 0;
+ return 0;
+}
+
+static int diagnostic_xfer(void *context, unsigned int port, unsigned int space,
+                           unsigned int offset, unsigned int words, u32 *data,
+                           unsigned int type, u64 route)
+{
+ struct diagnostic_ring *r = context;
+ struct usb4_cfg_request req = {
+  .route = route, .offset = offset, .port = port, .space = space,
+  .seq = r->sent & 3, .words = words, .type = type,
+ };
+ unsigned int slot = r->sent, response_port = 0;
+ u32 fields = 0, tx_flags = 0;
+ ulong started;
+ bool got_reply = false;
+ int len, ret = -ETIMEDOUT;
+
+ ret = apple_acio_m1_service();
+ if (ret) return ret;
+ if (slot >= RING_COUNT - 1 || r->received >= RING_COUNT - 1)
+  return -ENOSPC;
+ if (get_timer(r->started) >= 10000)
+  return -ETIMEDOUT;
+ len = usb4_cfg_encode(&req, type == USB4_CFG_WRITE ? data : NULL,
+                       r->buffer + 2 * PAGE + slot * 256, 256);
+ if (len < 0) return len;
+ /* Previous TX completed before this function can be called again. */
+ invalidate_dcache_range((ulong)r->tx, (ulong)r->tx + PAGE);
+ r->tx[slot].fields = cpu_to_le32(len | (type << 12) | (type << 16) | DESC_POSTED);
+ flush_dcache_range((ulong)r->buffer + 2 * PAGE,
+                    (ulong)r->buffer + 4 * PAGE);
+ flush_dcache_range((ulong)r->tx, (ulong)r->tx + PAGE);
+ mb();
+ r->sent++;
+ writel(r->sent << 16, r->nhi + 0x10008);
+ started = get_timer(0);
+ while (get_timer(started) < 2000 && get_timer(r->started) < 10000) {
+  ret = apple_acio_m1_service();
+  if (ret) return ret;
+  invalidate_dcache_range((ulong)r->rx, (ulong)r->rx + PAGE);
+  invalidate_dcache_range((ulong)r->tx, (ulong)r->tx + PAGE);
+  mb();
+  tx_flags = readl(&r->tx[slot].fields);
+  if (readl(r->dart_regs + 0x40) & BIT(31)) return -EFAULT;
+  while (!got_reply && r->received < RING_COUNT - 1) {
+   fields = readl(&r->rx[r->received].fields);
+   if (!(fields & DESC_DONE)) break;
+   if (fields & DESC_ERROR) return -EIO;
+   invalidate_dcache_range((ulong)r->buffer + 4 * PAGE,
+                           (ulong)r->buffer + 6 * PAGE);
+   mb();
+   ret = usb4_cfg_decode(&req, r->buffer + 4 * PAGE + r->received * 256,
+                        fields & 0xfff, (fields >> 16) & 15,
+                        (fields >> 12) & 15, data, &response_port);
+   r->received++;
+   if (!ret) got_reply = true;
+   else if (ret != -EAGAIN) return ret;
+   else {
+    const u8 *packet = r->buffer + 4 * PAGE + (r->received - 1) * 256;
+    unsigned int length = fields & 0xfff, j;
+    /* decode already validated bounds, framing and CRC. Never ack by guess. */
+    r->skipped++;
+    printf("NHI unsolicited rx=%u sof=%u eof=%u bytes=%u words=",
+           r->received, (fields >> 16) & 15, (fields >> 12) & 15, length);
+    for (j = 0; j < length / 4 && j < 8; j++)
+     printf(" %08x", get_unaligned_be32(packet + 4 * j));
+    printf("\n");
+    if (((fields >> 12) & 15) == USB4_CFG_EVENT) {
+     struct usb4_cfg_event event;
+     ret = usb4_cfg_decode_event(packet, length, (fields >> 16) & 15,
+                                 (fields >> 12) & 15, &event);
+     if (ret) return ret;
+     if (event.route || !event.port || event.port > 7) return -EPROTO;
+     if (r->pending_count >= 8) return -ENOSPC;
+     r->pending[r->pending_count++] = event;
+    }
+   }
+  }
+  if (r->pending_count && (tx_flags & DESC_DONE)) {
+   ret = diagnostic_ack_events(r);
+   if (ret) return ret;
+  }
+  if (got_reply && (tx_flags & DESC_DONE)) {
+   /* Timing counterprobe: keep successful per-packet output off the critical path. */
+   return 0;
+  }
+  udelay(50);
+ }
+ printf("NHI read timeout port=%u space=%u offset=%#x TX=%#x RX=%#x\n",
+        port, space, offset, tx_flags, fields);
+ return -ETIMEDOUT;
+}
+
+static int diagnostic_read(void *context, unsigned int port, unsigned int space,
+                           unsigned int offset, unsigned int words, u32 *data)
+{
+ return diagnostic_xfer(context, port, space, offset, words, data, USB4_CFG_READ, 0);
+}
+
+/* Root configuration callback; diagnostic_link separately constrains the
+ * host-port unlock and cable-information writes. No arbitrary write command.
+ */
+static int diagnostic_host_config(void *context, u32 *data)
+{
+ if (!data || ((data[0] >> 8) & 63) != 7 ||
+     ((data[0] >> 14) & 63) != 7 || ((data[0] >> 20) & 7) ||
+     data[1] || data[2] != BIT(31) || data[3] != 0x200010ff)
+  return -EINVAL;
+ return diagnostic_xfer(context, 0, 2, 1, 4, data, USB4_CFG_WRITE, 0);
+}
+
+static int diagnostic_tmu_write(void *context, unsigned int offset, u32 value)
+{
+ struct diagnostic_ring *ring = context;
+ if (!ring || ring->tmu_cap < 5 || ring->tmu_cap > 0x1ffc ||
+     (offset != ring->tmu_cap && offset != ring->tmu_cap + 3)) return -EINVAL;
+ if (offset == ring->tmu_cap && (((value >> 8) & 255) != 3 || !(value & BIT(30))))
+  return -EINVAL;
+ if (offset == ring->tmu_cap + 3 && (value >> 16) != 1000) return -EINVAL;
+ return diagnostic_xfer(ring, 0, 2, offset, 1, &value, USB4_CFG_WRITE, 0);
+}
+
+static int diagnostic_query_write(void *context, unsigned int offset, u32 value)
+{
+ if ((offset == 0x19 && value != 0 && value != 5 && value != 6) ||
+     (offset == 0x1a && value != 0x80000025 && value != 0x80000033 &&
+      value != 0x80000010) || (offset != 0x19 && offset != 0x1a))
+  return -EINVAL;
+ return diagnostic_xfer(context, 0, 2, offset, 1, &value, USB4_CFG_WRITE, 0);
+}
+
+static void diagnostic_query_wait(void *context) { udelay(50000); }
+
+static int diagnostic_query(struct diagnostic_ring *ring, u32 opcode, u32 input)
+{
+ int ret = apple_nhi_m1_query(diagnostic_read, diagnostic_query_write,
+                              diagnostic_query_wait, ring, opcode, input);
+ /* Unsupported optional queries are reported, as Linux does; transport,
+  * malformed replies and operation errors stop this bounded experiment. */
+ if (ret == -EOPNOTSUPP) {
+  printf("NHI-QUERY unsupported opcode=%#x input=%#x\n", opcode, input);
+  return 0;
+ }
+ return ret;
+}
+
+static void (*link_sample)(void *);
+static void *link_sample_context;
+void apple_nhi_m1_set_link_sample(void (*callback)(void *), void *context)
+{ link_sample = callback; link_sample_context = context; }
+
+static int (*pre_link)(void *);
+static void *pre_link_context;
+void apple_nhi_m1_set_pre_link(int (*callback)(void *), void *context)
+{ pre_link = callback; pre_link_context = context; }
+
+static int diagnostic_link(struct diagnostic_ring *ring,
+                           const struct apple_nhi_host_info *info)
+{
+ u32 data[8], seen[16], phy[2] = {}, offset, value;
+ unsigned int count = 0, i, port, state;
+ int ret;
+ if (!diagnostic_cable_valid || info->null_ports != 6 ||
+     info->apple < 5 || info->apple > 0x1ffe) return -EPROTO;
+ /* Discover each lane's capability independently before changing the link. */
+ for (port = 1; port <= 2; port++) {
+ count = 0;
+ offset = info->port1_cap;
+ if (port == 2) {
+  ret = diagnostic_read(ring, 2, 1, 0, 8, data);
+  if (ret) return ret;
+  offset = data[1] & 255;
+ }
+ while (offset) {
+  if (offset < 8 || offset > 255 || count == 16) return -ERANGE;
+  for (i = 0; i < count; i++) if (seen[i] == offset) return -ELOOP;
+  seen[count++] = offset;
+  ret = diagnostic_read(ring, port, 1, offset, 2, data);
+  if (ret) return ret;
+  if (((data[0] >> 8) & 255) == 1) { phy[port - 1] = offset; break; }
+  offset = data[0] & 255;
+ }
+ if (!phy[port - 1]) return -ENOENT;
+ }
+ for (port = 1; port <= 2; port++) {
+  ret = diagnostic_read(ring, port, 1, 4, 1, &value);
+  if (ret) return ret;
+  value &= ~BIT(31);
+  ret = diagnostic_xfer(ring, port, 1, 4, 1, &value, USB4_CFG_WRITE, 0);
+  if (ret) return ret;
+  ret = diagnostic_read(ring, port, 1, 4, 1, &value);
+  if (ret) return ret;
+  if (value & BIT(31)) return -EIO;
+ }
+ apple_boot_trace("lane-unlock-verified");
+ puts("NHI-PORT-UNLOCK PASS lane-pair=1/2\n");
+ value = diagnostic_cable;
+ apple_boot_trace("cable-info-submit");
+ ret = diagnostic_xfer(ring, 0, 2, info->apple + 1, 1,
+                       &value, USB4_CFG_WRITE, 0);
+ if (ret) return ret;
+ ret = diagnostic_read(ring, 0, 2, info->apple + 1, 1, &value);
+ if (ret) return ret;
+ if ((value & 0x61f) != diagnostic_cable) return -EIO;
+ apple_boot_trace("cable-info-readback-verified");
+ printf("NHI-CABLE-INFO PASS value=%#x\n", value);
+ if (post_cable) {
+  int (*callback)(void *) = post_cable;
+  void *context = post_cable_context;
+  /* Consume before calling: no retry on a partially configured PIPE. */
+  apple_nhi_m1_set_post_cable(NULL, NULL);
+  ret = callback(context);
+  if (ret) return ret;
+ }
+ for (i = 0; i < 10; i++) {
+  if (link_sample) link_sample(link_sample_context);
+  ret = diagnostic_read(ring, 1, 1, phy[0], 2, data);
+  if (ret) return ret;
+  state = (data[1] >> 26) & 15;
+  printf("NHI lane1 state=%u raw=%08x %08x time-ms=%lu\n",
+         state, data[0], data[1], get_timer(ring->started));
+  ret = diagnostic_read(ring, 2, 1, phy[1], 2, data);
+  if (ret) return ret;
+  printf("NHI lane2 state=%u raw=%08x %08x time-ms=%lu\n",
+         (data[1] >> 26) & 15, data[0], data[1], get_timer(ring->started));
+  if (state >= 2 && state <= 6) break;
+  /* Diagnostic only: bounded five-second observation, same slot budget. */
+  {
+   unsigned int tick;
+   for (tick = 0; tick < 50; tick++) {
+    ret = apple_acio_m1_service();
+    if (ret) return ret;
+    if (get_timer(ring->started) >= 10000) return -ETIMEDOUT;
+    udelay(10000);
+   }
+  }
+ }
+ if (i == 10) return -ETIMEDOUT;
+ ret = diagnostic_xfer(ring, 0, 2, 0, 5, data, USB4_CFG_READ, 1);
+ if (ret) return ret;
+ if (!data[0] || data[0] == ~0U || !((data[1] >> 14) & 63)) return -EPROTO;
+ printf("NHI-REMOTE-READ PASS route=1 header=%08x %08x %08x %08x %08x; no external writes\n",
+        data[0], data[1], data[2], data[3], data[4]);
+ return 0;
+}
+
+int apple_nhi_m1_control_read(struct udevice *dart)
+{
+ const struct iommu_ops *ops = device_get_ops(dart);
+ void *nhi = map_sysmem(NHI_BASE, 0x100000);
+ void *pdf = map_sysmem(PDF_BASE, 0x30004);
+ void *dart_regs = map_sysmem(DART_BASE, 0x4000);
+ struct diagnostic_ring ring = { .nhi = nhi, .dart_regs = dart_regs };
+ struct apple_nhi_host_info info;
+ void *buffer;
+ dma_addr_t dva;
+ int i, ret;
+
+ if (!diagnostic_cable_valid) return -EINVAL;
+ ret = apple_dart_get_error(dart);
+ if (ret) return ret;
+ if (readl(dart_regs + 0x40) & BIT(31)) return -EFAULT;
+ for (i = 0; i < 12; i++) {
+  if (readl(nhi + 0x10010 + i * 0x4000) & RING_ENABLE ||
+      readl(nhi + 0x80010 + i * 0x4000) & RING_ENABLE)
+   return -EBUSY;
+ }
+ buffer = memalign(PAGE, 6 * PAGE);
+ if (!buffer) return -ENOMEM;
+ memset(buffer, 0, 6 * PAGE);
+ dva = ops->map(dart, buffer, 6 * PAGE);
+ ret = apple_dart_get_error(dart);
+ if (ret) return ret; /* uncertain mapping: retain allocation until reset */
+ if (!dva) { free(buffer); return -ENOMEM; }
+ if (dva < PAGE || (dva & (PAGE - 1)) ||
+     dva > 0x100000000ULL - 7 * PAGE) return -ERANGE;
+ ring.buffer = buffer;
+ ring.tx = buffer;
+ ring.rx = buffer + PAGE;
+ for (i = 0; i < RING_COUNT - 1; i++) {
+  ring.tx[i].address = cpu_to_le64(dva + 2 * PAGE + i * 256);
+  ring.rx[i].address = cpu_to_le64(dva + 4 * PAGE + i * 256);
+  ring.rx[i].fields = cpu_to_le32(DESC_POSTED);
+ }
+ flush_dcache_range((ulong)buffer, (ulong)buffer + 6 * PAGE);
+ mb();
+ writel(0, nhi + 0xd0010);
+ writel((u32)dva, nhi + 0x10000);
+ writel((u32)(dva >> 32), nhi + 0x10004);
+ writel(0, nhi + 0x10008);
+ writel(RING_COUNT, nhi + 0x1000c);
+ writel(2, nhi + 0x10014);
+ writel((u32)(dva + PAGE), nhi + 0x80000);
+ writel((u32)((dva + PAGE) >> 32), nhi + 0x80004);
+ writel(0, nhi + 0x80008);
+ writel((256 << 16) | RING_COUNT, nhi + 0x8000c);
+ writel(0xffffffff, nhi + 0x80014);
+ writel(0xffffffff, pdf);
+ writel(RING_ENABLE | RING_RAW, nhi + 0x80010);
+ writel(RING_ENABLE | RING_RAW, nhi + 0x10010);
+ writel(RING_COUNT - 1, nhi + 0x80008);
+ ring.started = get_timer(0);
+ apple_boot_trace("nhi-control-rings-started");
+ ret = apple_nhi_m1_inventory(diagnostic_read, diagnostic_host_config, &ring, &info);
+ if (!ret && diagnostic_queries) {
+  if (info.dp_in_ports != (BIT(5) | BIT(6))) ret = -EPROTO;
+  if (!ret) ret = diagnostic_query(&ring, 0x25, 0);
+  if (!ret) ret = diagnostic_query(&ring, 0x33, 0);
+ }
+ if (!ret) {
+  ring.tmu_cap = info.tmu;
+  ret = apple_nhi_m1_tmu_lowres(diagnostic_read, diagnostic_tmu_write, &ring, info.tmu);
+ }
+ if (!ret && diagnostic_queries) {
+  ret = diagnostic_query(&ring, 0x10, 5);
+  if (!ret) ret = diagnostic_query(&ring, 0x10, 6);
+  if (!ret) puts("NHI-QUERIES complete before lane unlock and cable submit\n");
+ }
+ if (!ret && pre_link) {
+  int (*callback)(void *) = pre_link;
+  void *context = pre_link_context;
+  apple_nhi_m1_set_pre_link(NULL, NULL);
+  ret = callback(context);
+ }
+ if (!ret) {
+  ret = diagnostic_link(&ring, &info);
+  /* Observe after the bounded link attempt, before RTKit shutdown. */
+  if (post_link) {
+   void (*callback)(void *) = post_link;
+   void *context = post_link_context;
+   apple_nhi_m1_set_post_link(NULL, NULL);
+   callback(context);
+  }
+ }
+ apple_boot_trace("link-observation-return");
+ writel(0, nhi + 0x10010);
+ writel(0, nhi + 0x80010);
+ mb();
+ if (readl(nhi + 0x10010) || readl(nhi + 0x80010)) ret = -EBUSY;
+ if (readl(dart_regs + 0x40) & BIT(31)) ret = -EFAULT;
+ printf("NHI inventory transport ret=%d sent=%u received=%u DART-error=%#x\n",
+        ret, ring.sent, ring.received, readl(dart_regs + 0x40));
+ /* A stop readback is not proof that DMA drained. Never free on return. */
+ puts("NHI control buffers and DART retained until mandatory reset\n");
+ return ret;
+}
+
+#else
+void apple_nhi_m1_set_pre_link(int (*callback)(void *), void *context) {}
+void apple_nhi_m1_set_link_sample(void (*callback)(void *), void *context) {}
+void apple_nhi_m1_set_post_link(void (*callback)(void *), void *context) {}
+void apple_nhi_m1_set_queries(bool enabled) {}
+void apple_nhi_m1_set_post_cable(int (*callback)(void *), void *context) {}
+int apple_nhi_m1_set_cable(const struct apple_cd321x_status *status) { return -ENOSYS; }
+int apple_nhi_m1_control_read(struct udevice *dart) { return -ENOSYS; }
+#endif
diff --git a/cmd/apple_pciec_m1.c b/cmd/apple_pciec_m1.c
new file mode 100644
index 00000000..3fc52adb
--- /dev/null
+++ b/cmd/apple_pciec_m1.c
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Explicit, RAM-only J274 port1 PCIe-C preparation. Never auto-probed. */
+#include <apple_pciec_m1.h>
+#include <linux/errno.h>
+#ifdef CONFIG_ARCH_APPLE
+#include <apple_acio_m1.h>
+#include <asm/io.h>
+#include <dm/ofnode.h>
+#include <linux/ioport.h>
+#include <linux/delay.h>
+#include <mapmem.h>
+#include <asm/unaligned.h>
+
+#define NODE "/soc/pcie@530000000"
+static struct pciec_m1_config config;
+static void *base[PCIEC_M1_GROUPS];
+static bool checked, used;
+static unsigned int mmio_reads, mmio_writes;
+static const char *const names[] = { "debug", "fabric", "port0", "oe-fabric", "config" };
+static const char *const props[] = { "apple,tunable-debug", "apple,tunable-fabric", "apple,tunable", "apple,tunable-oe-fabric", "apple,tunable-rc" };
+/* Separate diagnostic namespace: the boot stage may append apple,* properties.
+ * Only absent generated properties use these saved, exact-validated values.
+ * A present but malformed/different generated property must still fail. */
+static const char *const reference_props[] = {
+ "u-boot,probe-pciec-debug", "u-boot,probe-pciec-fabric",
+ "u-boot,probe-pciec-port0", "u-boot,probe-pciec-oe-fabric",
+ "u-boot,probe-pciec-config"
+};
+static const u64 addresses[] = { 0x520200000, 0x520004000, 0x521000000, 0x520008000, 0x530000000 };
+static const u32 sizes[] = { 0x4000, 0x4000, 0x8000, 0x4000, 0x10000 };
+
+int apple_pciec_m1_check(void)
+{
+ ofnode node = ofnode_path(NODE), port = ofnode_path(NODE "/pci@0,0");
+ struct pciec_m1_config candidate = {};
+ struct resource resource;
+ unsigned int g, i, count;
+ const u8 *data;
+ const struct pciec_m1_tunable *ref;
+ int len, ret;
+ if (used) return -EALREADY;
+ checked = false;
+ if (!ofnode_device_is_compatible(ofnode_root(), "apple,j274") ||
+     !ofnode_device_is_compatible(node, "apple,t8103-pciec") ||
+     !ofnode_valid(port) || ofnode_is_enabled(node) || ofnode_is_enabled(port)) {
+  puts("PCIEC-M1 preflight rejected: incompatible or enabled controller/port\n");
+  return -ENODEV;
+ }
+ for (g = 0; g < PCIEC_M1_GROUPS; g++) {
+  ret = ofnode_read_resource_byname(node, names[g], &resource);
+  if (ret) {
+   printf("PCIEC-M1 resource %s lookup failed ret=%d\n", names[g], ret);
+   return ret;
+  }
+  printf("PCIEC-M1 resource %s start=%#llx size=%#llx\n", names[g],
+         (unsigned long long)resource.start, (unsigned long long)resource_size(&resource));
+  if (resource.start != addresses[g] ||
+      resource_size(&resource) != (g == PCIEC_CONFIG ? 0x10000000 : sizes[g])) {
+   puts("PCIEC-M1 preflight rejected: resource mismatch\n");
+   return -ERANGE;
+  }
+  data = ofnode_get_property(g == PCIEC_PORT ? port : node, props[g], &len);
+  if (!data) {
+   printf("PCIEC-M1 generated %s absent; checking saved Linux reference %s\n",
+          props[g], reference_props[g]);
+   data = ofnode_get_property(ofnode_path("/config"), reference_props[g], &len);
+  } else {
+   printf("PCIEC-M1 using generated %s\n", props[g]);
+  }
+  ref = pciec_m1_reference(g, &count);
+  printf("PCIEC-M1 property %s present=%u len=%d expected=%u\n",
+         props[g], !!data, len, count * 12);
+  if (!data || len != count * 12) {
+   puts("PCIEC-M1 preflight rejected: missing property or length mismatch\n");
+   return -EINVAL;
+  }
+  candidate.count[g] = count;
+  for (i = 0; i < count; i++) {
+   candidate.group[g][i].offset = get_unaligned_be32(data + 12*i);
+   candidate.group[g][i].mask = get_unaligned_be32(data + 12*i + 4);
+   candidate.group[g][i].value = get_unaligned_be32(data + 12*i + 8);
+   if (candidate.group[g][i].offset != ref[i].offset ||
+       candidate.group[g][i].mask != ref[i].mask ||
+       candidate.group[g][i].value != ref[i].value)
+    printf("PCIEC-M1 mismatch %s[%u] actual=%#x/%#x/%#x expected=%#x/%#x/%#x\n",
+           props[g], i, candidate.group[g][i].offset,
+           candidate.group[g][i].mask, candidate.group[g][i].value,
+           ref[i].offset, ref[i].mask, ref[i].value);
+  }
+ }
+ ret = pciec_m1_validate(&candidate);
+ if (ret) {
+  printf("PCIEC-M1 preflight rejected: exact-reference validation ret=%d\n", ret);
+  return ret;
+ }
+ config = candidate;
+ for (g = 0; g < PCIEC_M1_GROUPS; g++) base[g] = map_sysmem(addresses[g], sizes[g]);
+ checked = true;
+ puts("PCIEC-M1 preflight PASS: 5 fixed resources, 43 exact Linux tunables; no MMIO\n");
+ return 0;
+}
+
+static int hw_read(void *ctx, unsigned int region, u32 offset, u32 *value)
+{
+ if (region >= PCIEC_M1_GROUPS || offset % 4 || offset > sizes[region] - 4) return -ERANGE;
+ *value = readl(base[region] + offset);
+ mmio_reads++;
+ mb(); asm volatile("isb" ::: "memory");
+ return 0;
+}
+static int hw_write(void *ctx, unsigned int region, u32 offset, u32 value)
+{
+ if (region >= PCIEC_M1_GROUPS || offset % 4 || offset > sizes[region] - 4) return -ERANGE;
+ writel(value, base[region] + offset);
+ mmio_writes++;
+ mb(); asm volatile("isb" ::: "memory");
+ return 0;
+}
+static void hw_delay(void *ctx, unsigned int us) { udelay(us); }
+static const struct pciec_m1_io io = { hw_read, hw_write, hw_delay };
+
+int apple_pciec_m1_prepare(void *unused)
+{
+ static const u32 domains[] = { 0x448, 0x450, 0x458, 0x460, 0x468 };
+ u32 status = 0, pd;
+ unsigned int i;
+ int ret;
+ if (!checked || used) return -EPERM;
+ /* ACIO's existing reset-before-power has already run. Do not access a
+  * native controller register before all shared power domains are live. */
+ for (i = 0; i < ARRAY_SIZE(domains); i++) {
+  pd = readl(map_sysmem(0x23b700000ULL + domains[i], 4));
+  if ((pd & 0xff) != 0xff || (pd & (BIT(31) | BIT(10)))) return -EIO;
+ }
+ used = true;
+ mmio_reads = mmio_writes = 0;
+ apple_boot_trace("pciec-cold-prepare-begin");
+ ret = pciec_m1_prepare(&config, &io, NULL, &status);
+ apple_boot_trace("pciec-cold-prepare-return");
+ printf("PCIEC-M1 cold prepare ret=%d ready=%#x reads=%u writes=%u; no native DART access, PCI scan or DMA\n", ret, status, mmio_reads, mmio_writes);
+ if (!ret) puts("PCIEC-PREPARE PASS\n");
+ /* Never attempt partial rollback: retain powered state until mandatory reset. */
+ return ret;
+}
+#else
+int apple_pciec_m1_check(void) { return -ENOSYS; }
+int apple_pciec_m1_prepare(void *unused) { return -ENOSYS; }
+#endif
diff --git a/drivers/i2c/apple_i2c.c b/drivers/i2c/apple_i2c.c
new file mode 100644
index 00000000..da818c4a
--- /dev/null
+++ b/drivers/i2c/apple_i2c.c
@@ -0,0 +1,410 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Polled Apple/PA Semi I2C for boot-time Type-C controller access.
+ * Register protocol derived from Linux i2c-pasemi-core/platform.c:
+ * Copyright (C) 2006-2007 PA Semi, Inc
+ * Copyright (C) 2021 The Asahi Linux Contributors
+ * Linux authors: Olof Johansson and Sven Peter.
+ * This bounded initial implementation supports at most two short messages.
+ */
+#include <clk.h>
+#include <dm.h>
+#include <i2c.h>
+#include <time.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+
+#define TX 0x00
+#define RX 0x04
+#define STATUS 0x14
+#define IMASK 0x18
+#define CONTROL 0x1c
+#define TX_READ BIT(10)
+#define TX_STOP BIT(9)
+#define TX_START BIT(8)
+#define RX_EMPTY BIT(8)
+#define ST_ACTIVE BIT(28)
+#define ST_END BIT(27)
+#define ST_JAM BIT(24)
+#define ST_TIMEOUT BIT(23)
+#define ST_ARB BIT(22)
+#define ST_NACK BIT(21)
+#define ST_FIFO_TIMEOUT BIT(6)
+#define CT_ENABLE BIT(11)
+#define CT_RX_RESET BIT(10)
+#define CT_TX_RESET BIT(9)
+#define CT_UNJAM BIT(8)
+#define POLL_MS 100
+#define MAX_MESSAGE 64
+
+struct apple_i2c_priv {
+	void *base;
+	struct clk clk;
+	u32 control;
+	u32 (*read)(struct apple_i2c_priv *p, u32 reg);
+	void (*write)(struct apple_i2c_priv *p, u32 reg, u32 val);
+	void *test;
+};
+
+static u32 apple_i2c_read(struct apple_i2c_priv *p, u32 reg)
+{
+	return readl(p->base + reg);
+}
+
+static void apple_i2c_write(struct apple_i2c_priv *p, u32 reg, u32 val)
+{
+	writel(val, p->base + reg);
+}
+
+static int apple_i2c_status_error(u32 status)
+{
+	if (status & (ST_TIMEOUT | ST_FIFO_TIMEOUT))
+		return -ETIMEDOUT;
+	if (status & ST_ARB)
+		return -EAGAIN;
+	if (status & ST_NACK)
+		return -ENXIO;
+	if (status & ST_JAM)
+		return -EIO;
+	return 0;
+}
+
+static void apple_i2c_reset(struct apple_i2c_priv *p)
+{
+	p->write(p, CONTROL, p->control | CT_RX_RESET | CT_TX_RESET);
+	p->write(p, STATUS, ~0U);
+}
+
+static int apple_i2c_validate(struct i2c_msg *msg, int count)
+{
+	int i;
+
+	/* Validate the entire transaction before its first bus side effect. */
+	if (!msg || count < 1 || count > 2)
+		return -EOPNOTSUPP;
+	for (i = 0; i < count; i++) {
+		if (msg[i].addr > 0x7f || (msg[i].flags & ~I2C_M_RD))
+			return -EOPNOTSUPP;
+		if (!msg[i].buf || !msg[i].len || msg[i].len > MAX_MESSAGE)
+			return -EINVAL;
+	}
+	/* The first leg of a combined operation must write the register. */
+	if (count == 2 && ((msg[0].flags & I2C_M_RD) ||
+			  !(msg[1].flags & I2C_M_RD) ||
+			  msg[0].addr != msg[1].addr))
+		return -EOPNOTSUPP;
+	return 0;
+}
+
+static int apple_i2c_transfer(struct apple_i2c_priv *p,
+			      struct i2c_msg *msg, int count)
+{
+	u8 data[MAX_MESSAGE];
+	u32 st, value;
+	ulong start;
+	int i, j, ret;
+
+	ret = apple_i2c_validate(msg, count);
+	if (ret)
+		return ret;
+	start = get_timer(0);
+	do {
+		st = p->read(p, STATUS);
+		if (!(st & (ST_ACTIVE | ST_JAM)))
+			break;
+		if (get_timer(start) >= POLL_MS)
+			return -ETIMEDOUT;
+		udelay(10);
+	} while (1);
+	apple_i2c_reset(p);
+	for (i = 0; i < count; i++) {
+		bool read = msg[i].flags & I2C_M_RD;
+		bool stop = i == count - 1;
+
+		p->write(p, TX, TX_START | (msg[i].addr << 1) | read);
+		if (read) {
+			p->write(p, TX, TX_READ | msg[i].len |
+				 (stop ? TX_STOP : 0));
+		} else {
+			for (j = 0; j < msg[i].len; j++)
+				p->write(p, TX, msg[i].buf[j] |
+					 (stop && j == msg[i].len - 1 ? TX_STOP : 0));
+		}
+	}
+	start = get_timer(0);
+	do {
+		st = p->read(p, STATUS);
+		ret = apple_i2c_status_error(st);
+		if (ret)
+			goto fail;
+		if (st & ST_END)
+			break;
+		if (get_timer(start) >= POLL_MS) {
+			ret = -ETIMEDOUT;
+			goto fail;
+		}
+		udelay(10);
+	} while (1);
+	if (st & ST_ACTIVE) {
+		ret = -EIO;
+		goto fail;
+	}
+	/* Stage the read so short FIFO responses do not publish partial data. */
+	i = count - 1;
+	if (msg[i].flags & I2C_M_RD) {
+		for (j = 0; j < msg[i].len; j++) {
+			value = p->read(p, RX);
+			if (value & RX_EMPTY) {
+				ret = -ENODATA;
+				goto fail;
+			}
+			data[j] = value;
+		}
+		memcpy(msg[i].buf, data, msg[i].len);
+	}
+	p->write(p, STATUS, ST_END);
+	return 0;
+fail:
+	apple_i2c_reset(p);
+	return ret;
+}
+
+static int apple_i2c_xfer(struct udevice *dev, struct i2c_msg *msg, int count)
+{
+	return apple_i2c_transfer(dev_get_priv(dev), msg, count);
+}
+
+static int apple_i2c_set_speed(struct udevice *dev, unsigned int speed)
+{
+	struct apple_i2c_priv *p = dev_get_priv(dev);
+	ulong rate = clk_get_rate(&p->clk);
+	u32 div;
+
+	if (IS_ERR_VALUE(rate) || !rate || !speed || speed > 400000)
+		return -EINVAL;
+	div = DIV_ROUND_UP(rate, 16 * speed);
+	if (div < 4 || div > 255)
+		return -EINVAL;
+	p->control = CT_ENABLE | CT_UNJAM | div;
+	p->write(p, CONTROL, p->control);
+	return 0;
+}
+
+static int apple_i2c_probe(struct udevice *dev)
+{
+	struct apple_i2c_priv *p = dev_get_priv(dev);
+	int ret;
+
+	p->base = dev_read_addr_ptr(dev);
+	if (!p->base)
+		return -EINVAL;
+	p->read = apple_i2c_read;
+	p->write = apple_i2c_write;
+	ret = clk_get_by_index(dev, 0, &p->clk);
+	if (ret)
+		return ret;
+	ret = clk_enable(&p->clk);
+	if (ret)
+		return ret;
+	p->write(p, IMASK, 0);
+	ret = apple_i2c_set_speed(dev,
+		dev_read_u32_default(dev, "clock-frequency", 100000));
+	if (ret)
+		clk_disable(&p->clk);
+	return ret;
+}
+
+static int apple_i2c_remove(struct udevice *dev)
+{
+	struct apple_i2c_priv *p = dev_get_priv(dev);
+
+	p->write(p, IMASK, 0);
+	return clk_disable(&p->clk);
+}
+
+static const struct dm_i2c_ops apple_i2c_ops = {
+	.xfer = apple_i2c_xfer,
+	.set_bus_speed = apple_i2c_set_speed,
+};
+
+static const struct udevice_id apple_i2c_ids[] = {
+	{ .compatible = "apple,t8103-i2c" },
+	{ }
+};
+
+U_BOOT_DRIVER(apple_i2c) = {
+	.name = "apple_i2c",
+	.id = UCLASS_I2C,
+	.of_match = apple_i2c_ids,
+	.probe = apple_i2c_probe,
+	.remove = apple_i2c_remove,
+	.priv_auto = sizeof(struct apple_i2c_priv),
+	.ops = &apple_i2c_ops,
+};
+
+#if CONFIG_IS_ENABLED(SANDBOX)
+#include <dm/test.h>
+#include <test/test.h>
+#include <test/ut.h>
+
+struct apple_i2c_fake {
+	u32 tx[132];
+	int ntx, rxpos, rxlen;
+	u32 completion;
+	bool busy;
+};
+
+static u32 fake_read(struct apple_i2c_priv *p, u32 reg)
+{
+	struct apple_i2c_fake *f = p->test;
+
+	if (reg == STATUS)
+		return f->busy ? ST_ACTIVE : f->ntx ? f->completion : 0;
+	if (reg == RX)
+		return f->rxpos < f->rxlen ? 0x40 + f->rxpos++ : RX_EMPTY;
+	return 0;
+}
+
+static void fake_write(struct apple_i2c_priv *p, u32 reg, u32 value)
+{
+	struct apple_i2c_fake *f = p->test;
+
+	if (reg == TX && f->ntx < ARRAY_SIZE(f->tx))
+		f->tx[f->ntx++] = value;
+}
+
+static int dm_test_apple_i2c_read(struct unit_test_state *uts)
+{
+	struct apple_i2c_fake f = { .completion = ST_END, .rxlen = 4 };
+	struct apple_i2c_priv p = { .read = fake_read, .write = fake_write, .test = &f };
+	u8 offset = 3, data[4] = {};
+	struct i2c_msg msg[] = {
+		{ .addr = 0x3f, .buf = &offset, .len = 1 },
+		{ .addr = 0x3f, .buf = data, .len = 4, .flags = I2C_M_RD },
+	};
+
+	ut_assertok(apple_i2c_transfer(&p, msg, 2));
+	ut_asserteq(4, f.ntx);
+	ut_asserteq(TX_START | 0x7e, f.tx[0]);
+	ut_asserteq(3, f.tx[1]);
+	ut_asserteq(TX_START | 0x7f, f.tx[2]);
+	ut_asserteq(TX_READ | TX_STOP | 4, f.tx[3]);
+	ut_asserteq_mem("@ABC", data, 4);
+	return 0;
+}
+DM_TEST(dm_test_apple_i2c_read, 0);
+
+static int dm_test_apple_i2c_errors(struct unit_test_state *uts)
+{
+	struct apple_i2c_fake f = {};
+	struct apple_i2c_priv p = { .read = fake_read, .write = fake_write, .test = &f };
+	u8 data[4] = {1, 2, 3, 4};
+	struct i2c_msg msg = { .addr = 0x3f, .buf = data, .len = 4, .flags = I2C_M_RD };
+	const u32 flags[] = { ST_NACK, ST_ARB, ST_TIMEOUT, ST_FIFO_TIMEOUT, ST_JAM };
+	const int errors[] = { -ENXIO, -EAGAIN, -ETIMEDOUT, -ETIMEDOUT, -EIO };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(flags); i++) {
+		f = (struct apple_i2c_fake){ .completion = flags[i] | ST_END };
+		ut_asserteq(errors[i], apple_i2c_transfer(&p, &msg, 1));
+		ut_asserteq_mem("\1\2\3\4", data, 4);
+	}
+	f = (struct apple_i2c_fake){ .completion = ST_END, .rxlen = 2 };
+	ut_asserteq(-ENODATA, apple_i2c_transfer(&p, &msg, 1));
+	ut_asserteq_mem("\1\2\3\4", data, 4);
+	/* A failed read must not poison a later valid request. */
+	f = (struct apple_i2c_fake){ .completion = ST_END, .rxlen = 4 };
+	ut_assertok(apple_i2c_transfer(&p, &msg, 1));
+	ut_asserteq_mem("@ABC", data, 4);
+	return 0;
+}
+DM_TEST(dm_test_apple_i2c_errors, 0);
+
+static int dm_test_apple_i2c_reject(struct unit_test_state *uts)
+{
+	struct apple_i2c_fake f = {};
+	struct apple_i2c_priv p = { .read = fake_read, .write = fake_write, .test = &f };
+	u8 data[65] = {};
+	struct i2c_msg msg = { .addr = 0x3f, .buf = data, .len = 65, .flags = I2C_M_RD };
+
+	ut_asserteq(-EINVAL, apple_i2c_transfer(&p, &msg, 1));
+	msg.len = 0;
+	ut_asserteq(-EINVAL, apple_i2c_transfer(&p, &msg, 1));
+	msg.len = 4;
+	msg.addr = 0x100;
+	ut_asserteq(-EOPNOTSUPP, apple_i2c_transfer(&p, &msg, 1));
+	msg.addr = 0x3f;
+	msg.flags = I2C_M_TEN;
+	ut_asserteq(-EOPNOTSUPP, apple_i2c_transfer(&p, &msg, 1));
+	ut_asserteq(-EOPNOTSUPP, apple_i2c_transfer(&p, &msg, 0));
+	ut_asserteq(0, f.ntx);
+	return 0;
+}
+DM_TEST(dm_test_apple_i2c_reject, 0);
+
+static int dm_test_apple_i2c_timeout(struct unit_test_state *uts)
+{
+	struct apple_i2c_fake f = {};
+	struct apple_i2c_priv p = { .read = fake_read, .write = fake_write, .test = &f };
+	u8 byte = 0;
+	struct i2c_msg msg = { .addr = 0x3f, .buf = &byte, .len = 1 };
+	ulong start = get_timer(0);
+
+	ut_asserteq(-ETIMEDOUT, apple_i2c_transfer(&p, &msg, 1));
+	ut_assert(get_timer(start) < 1000);
+	f = (struct apple_i2c_fake){ .busy = true };
+	start = get_timer(0);
+	ut_asserteq(-ETIMEDOUT, apple_i2c_transfer(&p, &msg, 1));
+	ut_assert(get_timer(start) < 1000);
+	ut_asserteq(0, f.ntx);
+	return 0;
+}
+DM_TEST(dm_test_apple_i2c_timeout, 0);
+
+static int dm_test_apple_i2c_combined_reject(struct unit_test_state *uts)
+{
+	struct apple_i2c_fake f = {};
+	struct apple_i2c_priv p = { .read = fake_read, .write = fake_write, .test = &f };
+	u8 reg = 3, data[4] = {};
+	struct i2c_msg msg[] = {
+		{ .addr = 0x3f, .buf = &reg, .len = 1 },
+		{ .addr = 0x38, .buf = data, .len = 4, .flags = I2C_M_RD },
+	};
+
+	ut_asserteq(-EOPNOTSUPP, apple_i2c_transfer(&p, msg, 2));
+	msg[1].addr = 0x3f;
+	msg[1].flags = 0;
+	ut_asserteq(-EOPNOTSUPP, apple_i2c_transfer(&p, msg, 2));
+	msg[1].flags = I2C_M_RD;
+	msg[0].flags = I2C_M_RD;
+	ut_asserteq(-EOPNOTSUPP, apple_i2c_transfer(&p, msg, 2));
+	msg[0].flags = 0;
+	msg[1].buf = NULL;
+	ut_asserteq(-EINVAL, apple_i2c_transfer(&p, msg, 2));
+	ut_asserteq(0, f.ntx);
+	return 0;
+}
+DM_TEST(dm_test_apple_i2c_combined_reject, 0);
+
+static int dm_test_apple_i2c_write_and_max_read(struct unit_test_state *uts)
+{
+	struct apple_i2c_fake f = { .completion = ST_END };
+	struct apple_i2c_priv p = { .read = fake_read, .write = fake_write, .test = &f };
+	u8 data[64] = { 0x12, 0x34 };
+	struct i2c_msg msg = { .addr = 0x38, .buf = data, .len = 2 };
+
+	ut_assertok(apple_i2c_transfer(&p, &msg, 1));
+	ut_asserteq(3, f.ntx);
+	ut_asserteq(TX_START | 0x70, f.tx[0]);
+	ut_asserteq(0x12, f.tx[1]);
+	ut_asserteq(TX_STOP | 0x34, f.tx[2]);
+	f = (struct apple_i2c_fake){ .completion = ST_END, .rxlen = 64 };
+	msg.flags = I2C_M_RD;
+	msg.len = sizeof(data);
+	ut_assertok(apple_i2c_transfer(&p, &msg, 1));
+	ut_asserteq(64, f.rxpos);
+	ut_asserteq(0x7f, data[63]);
+	return 0;
+}
+DM_TEST(dm_test_apple_i2c_write_and_max_read, 0);
+#endif
