@@ -127,10 +127,10 @@
 #if CONFIG_IS_ENABLED(USB_XHCI_HCD)
  int ret;
  if (!boot_xhci) return 0;
- ret = xhci_m1_diag_stop(boot_xhci);
+ ret = xhci_m1_os_handoff(boot_xhci);
  if (ret) return ret;
  boot_xhci = NULL;
- puts("USB4-XHCI OS halt verified; DMA buffers retained\n");
+ puts("USB4-XHCI OS reset verified; DMA buffers retained\n");
  return 0;
