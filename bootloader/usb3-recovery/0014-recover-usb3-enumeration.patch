+/* Verify command identity before changing ownership of any DMA allocation. */
+static int xhci_slot_command(struct xhci_ctrl *ctrl, dma_addr_t input,
+			     unsigned int slot, trb_type type,
+			     unsigned int *completion, unsigned int *allocated)
+{
+	union xhci_trb *event;
+	dma_addr_t command;
+	u64 reported;
+	unsigned int id, code, max_slots;
