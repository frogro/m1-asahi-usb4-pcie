+static int xhci_disable_device_slot(struct usb_device *udev)
+{
+	struct xhci_ctrl *ctrl = xhci_get_ctrl(udev);
+	unsigned int code;
+	int ret;
+
+	ret = xhci_slot_command(ctrl, 0, udev->slot_id, TRB_DISABLE_SLOT,
+				&code, NULL);
+	if (ret)
+		return ret;
+	if (code != COMP_SUCCESS)
+		return -EIO;
+	/* The completion is the ownership barrier; never free on timeout. */
+	xhci_free_virt_device(ctrl, udev->slot_id);
+	udev->slot_id = 0;
+	return 0;
+}
