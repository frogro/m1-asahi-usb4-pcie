+/* USB 3.1 BOS sublink attributes and extended port status, not VID/PID. */
+static int usb_hub_ssp_speed(const u8 *bos, unsigned int length, u32 status)
+{
+	unsigned int off, caps = 0, seen_ssp = 0;
+	int speed = USB_SPEED_SUPER;
+
+	if (length < 5 || bos[0] != 5 || bos[1] != USB_DT_BOS ||
+	    get_unaligned_le16(bos + 2) != length)
+		return -EINVAL;
+	for (off = 5; off < length;) {
+		unsigned int len = bos[off], n, i;
+
+		if (len < 3 || len > length - off || bos[off + 1] != 0x10)
+			return -EINVAL;
+		caps++;
+		if (bos[off + 2] == 0x0a) {
+			bool found = false;
+
+			if (++seen_ssp != 1 || len < 12)
+				return -EINVAL;
+			n = (get_unaligned_le32(bos + off + 4) & 0x1f) + 1;
+			if (len != 12 + 4 * n)
+				return -EINVAL;
+			for (i = 0; i < n; i++) {
+				u32 attr = get_unaligned_le32(bos + off + 12 + 4 * i);
+				unsigned int type = (attr >> 6) & 3;
+				unsigned int mantissa = (attr >> 16) & 0xff;
+				unsigned int exponent = (attr >> 4) & 3;
+
+				/* Only the negotiated, symmetric receive sublink. */
+				if ((attr & 15) != (status & 15) || type == 2)
+					continue;
+				if (found || type != 0)
+					return -EOPNOTSUPP;
+				found = true;
+				if (((attr >> 14) & 3) == 0)
+					continue;
+				if (((attr >> 14) & 3) != 1)
+					return -EOPNOTSUPP;
+				for (; exponent < 3; exponent++)
+					mantissa /= 1000;
+				/* xHCI standard speed ID 5: symmetric Gen2 x1. */
+				if (mantissa != 10 || (status & 0xff00) ||
+				    ((status >> 4) & 15) != (status & 15))
+					return -EOPNOTSUPP;
+				speed = USB_SPEED_SUPER_PLUS;
+			}
+			if (!found)
+				return -EINVAL;
+		}
+		off += len;
+	}
+	if (caps != bos[4])
+		return -EINVAL;
+	return speed;
+}
+
+static int usb_hub_negotiated_speed(struct usb_device *dev, int port)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(u8, bos, USB_BUFSIZ);
+	ALLOC_CACHE_ALIGN_BUFFER(u8, status, 8);
+	unsigned int length;
+	int ret;
+	u32 ext;
+
+#if CONFIG_IS_ENABLED(DM_USB)
+	if (usb_hub_is_root_hub(dev->dev))
+		return USB_SPEED_SUPER;
+#endif
+	if (!usb_hub_is_superspeed(dev) || dev->descriptor.bcdUSB < 0x0310)
+		return USB_SPEED_SUPER;
+	ret = usb_control_msg(dev, usb_rcvctrlpipe(dev, 0), USB_REQ_GET_DESCRIPTOR,
+			      USB_DIR_IN, USB_DT_BOS << 8, 0, bos, 5,
+			      USB_CNTL_TIMEOUT);
+	if (ret != 5)
+		return ret < 0 ? ret : -EPROTO;
+	length = get_unaligned_le16(bos + 2);
+	if (bos[0] != 5 || bos[1] != USB_DT_BOS || length < 5 || length > USB_BUFSIZ)
+		return -EINVAL;
+	ret = usb_control_msg(dev, usb_rcvctrlpipe(dev, 0), USB_REQ_GET_DESCRIPTOR,
+			      USB_DIR_IN, USB_DT_BOS << 8, 0, bos, length,
+			      USB_CNTL_TIMEOUT);
+	if (ret != length)
+		return ret < 0 ? ret : -EPROTO;
+	/* USB 3.1 hub GET_STATUS, selector 2, eight-byte port status. */
+	ret = usb_control_msg(dev, usb_rcvctrlpipe(dev, 0), USB_REQ_GET_STATUS,
+			     USB_DIR_IN | USB_RT_PORT, 2, port + 1, status, 8,
+			     USB_CNTL_TIMEOUT);
+	if (ret != 8)
+		return ret < 0 ? ret : -EPROTO;
+	if ((get_unaligned_le16(status) & 3) != 3)
+		return -ENOTCONN;
+	ext = get_unaligned_le32(status + 4);
+	ret = usb_hub_ssp_speed(bos, length, ext);
+	printf("USB-HUB speed hub=%04x:%04x port=%u ext=%08x speed=%d\n",
+	       dev->descriptor.idVendor, dev->descriptor.idProduct, port + 1,
+	       ext, ret);
+	return ret;
+}
