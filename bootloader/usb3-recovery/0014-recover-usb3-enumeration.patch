+		max_slots = HCS_MAX_SLOTS(xhci_readl(&ctrl->hccr->cr_hcsparams1));
+		if (code != COMP_SUCCESS)
+			return -EIO;
+		if (!allocated || !id || id >= MAX_HC_SLOTS || id > max_slots ||
+		    ctrl->devs[id])
+			return -EPROTO;
+		*allocated = id;
+	} else if (!slot || id != slot) {
+		return -EPROTO;
+	}
