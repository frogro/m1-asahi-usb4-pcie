+static int xhci_enable_device_slot(struct usb_device *udev)
+{
+	struct xhci_ctrl *ctrl = xhci_get_ctrl(udev);
+	unsigned int code, slot;
+	int ret, cleanup;
+
+	ret = xhci_slot_command(ctrl, 0, 0, TRB_ENABLE_SLOT, &code, &slot);
+	if (ret)
+		return ret;
+	udev->slot_id = slot;
+	ret = xhci_alloc_virt_device(ctrl, slot);
+	if (!ret && ctrl->m1_diag && ctrl->m1_dma_failed)
+		ret = -EFAULT;
+	if (!ret)
+		return 0;
+	/* Retain partial allocations if Disable Slot cannot be confirmed. */
+	cleanup = xhci_disable_device_slot(udev);
+	return cleanup ? cleanup : ret;
