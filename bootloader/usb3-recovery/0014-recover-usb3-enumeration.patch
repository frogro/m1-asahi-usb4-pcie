+	if (ctrl->m1_diag && ctrl->m1_dma_failed)
+		return -EFAULT;
+	if (ctrl->hcor && (xhci_readl(&ctrl->hcor->or_usbsts) &
+			   (STS_HALT | STS_FATAL | STS_HCE))) {
+		printf("USB-SLOT halted command=%u slot=%u status=%x; no retry\n",
+		       type, slot, xhci_readl(&ctrl->hcor->or_usbsts));
+		return -EIO;
+	}
+	command = xhci_queue_command(ctrl, input, slot, 0, type);
+	event = xhci_wait_for_event_timeout(ctrl, TRB_COMPLETION, XHCI_TIMEOUT);
+	if (!event) {
+		printf("USB-SLOT timeout command=%u slot=%u trb=%llx status=%x\n",
+		       type, slot, (unsigned long long)command,
+		       ctrl->hcor ? xhci_readl(&ctrl->hcor->or_usbsts) : 0);
+		return -ETIMEDOUT;
+	}
+	reported = le32_to_cpu(event->generic.field[0]) |
+		   ((u64)le32_to_cpu(event->generic.field[1]) << 32);
+	id = TRB_TO_SLOT_ID(le32_to_cpu(event->event_cmd.flags));
+	code = GET_COMP_CODE(le32_to_cpu(event->event_cmd.status));
+	xhci_acknowledge_event(ctrl);
+	if ((reported & ~0xfULL) != command)
+		return -EPROTO;
