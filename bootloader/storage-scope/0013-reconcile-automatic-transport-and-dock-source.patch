+/* Bounded USB4 DROM capture. Linux usb4.c opcode0x24 and eeprom.c v3
+ * framing/CRC. Metadata/opcode writes request reads only; never flash writes. */
+static int usb4_drom_block(apple_nhi_read_fn read, apple_nhi_tmu_write_fn write,
+ void (*wait)(void *), void *ctx, unsigned int offset, unsigned int words, u32 *data)
+{
+ u32 status, metadata = (words << 15) | offset;
+ unsigned int poll;
+ int ret;
+ if (offset & 3 || offset > 508 || !words || words > 16 ||
+     words > (512 - offset) / 4) return -EINVAL;
+ ret = write(ctx, 0x19, metadata); if (ret) return ret;
+ ret = write(ctx, 0x1a, 0x80000024); if (ret) return ret;
+ for (poll = 0; poll <= 50; poll++) {
+  ret = read(ctx, 0, 2, 0x1a, 1, &status); if (ret) return ret;
+  if (!(status & (1U << 31))) break;
+  if (poll < 50) wait(ctx);
+ }
+ if (status & (1U << 31)) return -ETIMEDOUT;
+ if (status & (1U << 30)) return -EOPNOTSUPP;
+ if ((status & 0x3f000000) || (status & 0xffff) != 0x24) return -EIO;
+ return read(ctx, 0, 2, 9, words, data);
