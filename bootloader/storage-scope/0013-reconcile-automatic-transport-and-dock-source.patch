+// SPDX-License-Identifier: GPL-2.0-only
+#include <apple_boot_port.h>
+#include <linux/errno.h>
+#include <linux/libfdt.h>
+#include <stdio.h>
+#include <string.h>
+/* Values verified against the J274 DT resources, power-domain phandles and
+ * Type-C endpoint graph. Existing per-resource checks remain mandatory. */
+const struct apple_boot_port apple_m1_ports[2] = {
+ { .index=0, .pd_address=0x38, .pin=39,
+  .phy="/soc/phy@383000000",
+  .usb="/soc/usb@382280000",
+  .acio="/soc/cio@381ac0000",
