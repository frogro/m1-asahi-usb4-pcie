+/* Recover through this installation's native Apple NVMe ESP, never through
+ * another discovered external OS. fw_dev_part is resolved by board code from
+ * the Apple boot registration; also require the configured GPT identity. */
+int apple_pciec_m1_boot_recovery(void)
+{
+ const char *uuid = ofnode_read_string(ofnode_path("/config"), "u-boot,recovery-partuuid");
+ const char *device = env_get("fw_dev_part");
+ const char *path = "/EFI/BOOT/BOOTAA64.EFI";
+ struct blk_desc *desc = NULL;
+ struct disk_partition info;
+ loff_t size = 0, actual = 0;
+ void *image;
+ int part, ret;
+ if (!apple_boot_scan_enabled() || !apple_boot_partuuid_valid(uuid) ||
+     !device || !*device) return -EINVAL;
+ part = blk_get_device_part_str("nvme", device, &desc, &info, 0);
+ if (part <= 0 || !desc || !desc->bdev || !desc->bdev->parent ||
+     strcmp(desc->bdev->driver->name, "nvme-blk") ||
+     strcmp(desc->bdev->parent->driver->name, "apple_nvme")) return -ENODEV;
+ if (!apple_boot_partuuid_valid(info.uuid) || strcasecmp(uuid, info.uuid) ||
+     !(info.bootable & PART_EFI_SYSTEM_PARTITION)) return -EPERM;
+ ret = fs_set_blk_dev_with_part(desc, part);
+ if (ret) return ret;
+ ret = fs_size(path, &size); fs_close();
+ if (ret) return ret;
+ if (size < 512 || size > 128 * 1024 * 1024) return -EFBIG;
+ image = memalign(4096, ALIGN(size, 4096));
+ if (!image) return -ENOMEM;
+ ret = fs_set_blk_dev_with_part(desc, part);
+ if (!ret) { ret = fs_read(path, (ulong)image, 0, size, &actual); fs_close(); }
+ if (ret || actual != size) { free(image); return ret ? ret : -EIO; }
+ printf("TB-MEDIA verified internal recovery partuuid=%s bytes=%llu\n", info.uuid, (unsigned long long)size);
+ return tb_boot_loaded_efi(image, size, NULL, 0);
+}
