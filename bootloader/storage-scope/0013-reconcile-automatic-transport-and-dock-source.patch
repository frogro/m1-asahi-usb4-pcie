+/* Linux tb_pci_init_credits: unbonded legacy lane=16, PCIe adapter=7.
+ * The USB4 host lane uses its allocation query; preserve the host protocol
+ * adapter's vendor-defined credits/IFC/ISE, as in Linux path.c.
+ * Bonded lanes and deeper routes are not enabled by this single-hop planner.
+ */
+static int tb3_path_plan(const struct apple_usb4_snapshot *s,
+ unsigned int host_credit, u32 next[4][2], bool nested)
+{
+ unsigned int credit[4] = {0, host_credit, 16, 7};
+ unsigned int out[4], i, total, ctl;
+ if (!s || !next || !s->valid) return -EINVAL;
+ if (host_credit < 6 || host_credit > 127) return -ENOSPC;
+ if ((!nested && s->port[1] != 1) || s->port[0] == s->port[1] || s->port[2] == s->port[3])
+  return -EPROTO;
+ out[0] = s->port[1]; out[1] = s->port[0];
+ out[2] = s->port[3]; out[3] = s->port[2];
+ for (i = 0; i < 4; i++) {
+  if (!s->port[i] || s->port[i] > ((nested && i<2)?63U:16U) || s->cap[i] < 8 || s->cap[i] > 254)
+   return -EPROTO;
+  if (s->old[i][0] & (1U << 31)) return -EBUSY;
+  if (i == 1 || i == 2) {
+   total = (s->nfc[i] >> 20) & 1023;
