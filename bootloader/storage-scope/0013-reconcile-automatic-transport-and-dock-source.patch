+int apple_nhi_m1_tb3_path_plan(const struct apple_usb4_snapshot *s,
+ unsigned int credit,u32 next[4][2]) { return tb3_path_plan(s,credit,next,false); }
+int apple_nhi_m1_child_path_plan(const struct apple_usb4_snapshot *s,
+ unsigned int credit,u32 next[4][2]) { return tb3_path_plan(s,credit,next,true); }
