+   for(j=0;j<n;j++)if(seen[j]==off)return -ELOOP;
+   seen[n]=off;
+   ret=reads[r](context,port,1,off,1,&cap);if(ret)return ret;
+   if(((cap>>8)&255)==wanted)break;
+   off=cap&255;
+  }
+  if(!i && (cap & (1U<<31)))return -EBUSY;
+  ret=reads[r](context,port,0,2*(i?lane_hop:8),2,path);if(ret)return ret;
+  if(path[0]&(1U<<31))return -EBUSY;
+  control[0]=control[1]=0;
+  if(i) {ret=reads[r](context,port,0,0,2,control);if(ret)return ret;}
+  {
+   unsigned int index = r ? (i ? 2 : 3) : i;
+   snapshot->hop[index]=i?lane_hop:8; snapshot->port[index]=port; snapshot->cap[index]=off;
+   snapshot->old[index][0]=path[0]; snapshot->old[index][1]=path[1];
+   snapshot->nfc[index]=p[4]; snapshot->control[index]=control[0];
+  }
+  printf("USB3-PREFLIGHT route=%u port=%u cap=%#x cap-word=%08x buffers=%08x path=%08x %08x control0=%08x %08x\n",r,port,off,cap,p[4],path[0],path[1],control[0],control[1]);
+ }
+ snapshot->valid=true;
+ puts("USB3-PREFLIGHT PASS; discovered endpoints and inactive paths; no path writes\n");
+ return 0;
+}
+
+int apple_nhi_m1_usb3_preflight(apple_nhi_read_fn host, apple_nhi_read_fn remote,
+ void *context, struct apple_usb4_snapshot *snapshot)
+{
+ return usb3_preflight_hop(host,remote,context,snapshot,8);
+}
+
+/* Immutable router/port identity reads shared by the two preflights. Only
+ * cache exact header reads, never paths, capability controls or resource data.
+ * No writes occur while this cache exists. Avoid consuming the bounded NHI
+ * ring twice for the same adapter inventory. */
+struct auto_inventory_cache {
+ apple_nhi_read_fn read[2]; void *context;
+ u32 header[2][5], port[2][64][4];
+ unsigned int mask[2];
+};
+static int auto_cached_read(struct auto_inventory_cache *c, unsigned int route,
+ unsigned int port, unsigned int space, unsigned int offset, unsigned int words, u32 *data)
+{
+ if (!offset && !port && space==2 && words==5) {
+  memcpy(data,c->header[route],5*sizeof(u32));return 0;
+ }
+ if (!offset && port && port<=((c->header[route][1]>>14)&63) && space==1 && words==4) {
+  memcpy(data,c->port[route][port],4*sizeof(u32));return 0;
+ }
+ return c->read[route](c->context,port,space,offset,words,data);
+}
+static int auto_host_read(void *ctx,unsigned int p,unsigned int s,unsigned int o,unsigned int n,u32 *d)
+{ return auto_cached_read(ctx,0,p,s,o,n,d); }
+static int auto_remote_read(void *ctx,unsigned int p,unsigned int s,unsigned int o,unsigned int n,u32 *d)
+{ return auto_cached_read(ctx,1,p,s,o,n,d); }
+int apple_nhi_m1_auto_preflight(apple_nhi_read_fn host, apple_nhi_read_fn remote,
+ void *context, struct apple_usb4_snapshot *pcie, struct apple_usb4_snapshot *usb,
+ unsigned int *protocols)
+{
+ struct auto_inventory_cache c={.read={host,remote},.context=context};
+ unsigned int r,p,max,type,mask,counts[2][2]={{0}};
+ int ret;
+ if(!host || !remote || !pcie || !usb || !protocols)return -EINVAL;
+ *pcie=(struct apple_usb4_snapshot){0};*usb=(struct apple_usb4_snapshot){0};*protocols=0;
+ for(r=0;r<2;r++) {
+  ret=c.read[r](context,0,2,0,5,c.header[r]);if(ret)return ret;
+  max=(c.header[r][1]>>14)&63;
+  if(!max || max>(r?APPLE_NHI_ROUTER_MAX_PORT:16U) ||
+     !c.header[r][0] || c.header[r][0]==~0U ||
+     ((c.header[r][4]>>29)&7)!=1 || c.header[r][2]!=r ||
+     c.header[r][3]!=(1U<<31) || ((c.header[r][1]>>20)&7)!=r)return -EPROTO;
+  for(p=1;p<=max;p++) {
+   ret=c.read[r](context,p,1,0,4,c.port[r][p]);if(ret)return ret;
+   type=c.port[r][p][2]&0xffffff;
+   if(type && ((c.port[r][p][3]>>20)&63)!=p)return -EPROTO;
+   if(type==(r?0x100102U:0x100101U))counts[r][0]++;
+   if(type==(r?0x200102U:0x200101U))counts[r][1]++;
+  }
+  for(p=0;p<2;p++) {
+   if(counts[r][p]>1)return -EOPNOTSUPP;
+   if(counts[r][p])c.mask[r]|=1U<<p;
+  }
+ }
+ /* Never silently omit a remote transport that the host cannot service. */
+ if(c.mask[1]&~c.mask[0])return -EOPNOTSUPP;
+ mask=c.mask[0]&c.mask[1];if(!mask)return -ENODEV;
+ if(mask&1) {ret=apple_nhi_m1_usb4_preflight(auto_host_read,auto_remote_read,&c,pcie);if(ret)return ret;}
+ if(mask&2) {
+  ret=usb3_preflight_hop(auto_host_read,auto_remote_read,&c,usb,(mask&1)?9:8);if(ret)return ret;
+  usb->lane_reserve=(mask&1)?6:0;
+ }
+ *protocols=mask;
+ printf("AUTO-TRANSPORT PREFLIGHT protocols=%u PCIe=%u USB3=%u lane-hops=%u,%u; no path writes\n",mask,!!(mask&1),!!(mask&2),(mask&1)?8:0,(mask&2)?((mask&1)?9:8):0);
+ return 0;
+}
+
+/* Exclusive direct USB3 tunnel, not simultaneous PCIe. All four hop8 slots
+ * must be inactive. Preserve USB4 protocol credits/IFC/ISE as Linux path.c.
+ * Apple NHI has QUIRK_NO_USB3_BW_ALLOC: no CMR/HCA bandwidth writes here.
+ */
+int apple_nhi_m1_usb3_path_plan(const struct apple_usb4_snapshot *s,
+                               const u32 *limits, u32 next[4][2])
+{
+ unsigned int i, out[4], total, control;
+ if(!s || !limits || !next || !s->valid)return -EINVAL;
+ if(!limits[0] || limits[0]>127 || !limits[1] || limits[1]>127)return -ENOSPC;
+ if(s->port[0]==s->port[1] || s->port[2]==s->port[3])return -EPROTO;
+ if((s->hop[0] && s->hop[0]!=8) || (s->hop[3] && s->hop[3]!=8) ||
+    (s->hop[1]?s->hop[1]:8)!=(s->hop[2]?s->hop[2]:8) ||
+    ((s->hop[1]==9)!=(s->lane_reserve==6)) ||
+    (s->lane_reserve && s->lane_reserve!=6))return -EPROTO;
+ out[0]=s->port[1];out[1]=s->port[0];out[2]=s->port[3];out[3]=s->port[2];
+ for(i=0;i<4;i++) {
+  if(s->hop[i] && s->hop[i] != ((i==1 || i==2)?9U:8U)) {
+   if(s->hop[i]!=8)return -EPROTO;
+  }
+  if(!s->port[i] || s->port[i]>63 || s->cap[i]<8 || s->cap[i]>255)return -EPROTO;
+  if(s->old[i][0]&(1U<<31))return -EBUSY;
+  if(i==1 || i==2) {
+   total=(s->nfc[i]>>20)&1023;control=(s->control[i]>>17)&127;
+   if(total<control+limits[i>=2]+s->lane_reserve)return -ENOSPC;
+  }
+ }
+ for(i=0;i<4;i++) {
+  unsigned int peer=(i==0)?2:(i==1)?0:(i==2)?3:1;
+  if(s->lane_reserve!=0 && s->lane_reserve!=6)return -EPROTO;
+  next[i][0]=(1U<<31)|(out[i]<<11)|(s->hop[peer]?s->hop[peer]:8);
+  next[i][1]=0x302;
+  if(i==0 || i==3) {
+   next[i][0]|=s->old[i][0]&(127U<<17);
+   next[i][1]|=s->old[i][1]&((1U<<24)|(1U<<26));
+   next[i][1]|=1U<<25;
+  } else {
+   next[i][0]|=limits[i>=2]<<17;next[i][1]|=1U<<24;
+  }
+ }
+ return 0;
+}
+
+/* Direct USB4 parent's first downstream router. Pairing is from the checked
+ * DROM, not adjacency or a dock model. PCIe mapping follows usb4_port_index()
+ * and usb4_switch_map_pcie_down(). Read-only; no child configuration yet. */
+int apple_nhi_m1_child_discover(apple_nhi_read_fn read, void *ctx,
+ const u8 *drom, unsigned int len, struct apple_nhi_child *child)
+{
+ u32 h[5], ports[64][4]={{0}}, cap[2], seen[16];
+ u8 present[64]={0},disabled[64]={0},secondary[64]={0},pair[64]={0};
+ unsigned int max,up,pos,n,port,j,off,k,down[64],ndown=0,index=0,found=0,state;
+ struct apple_nhi_child result={0};int ret;
+ if(!read || !drom || !child || len<16 || len>512)return -EINVAL;
+ *child=(struct apple_nhi_child){0};
+ if(drom[13]!=1 && drom[13]!=0 && drom[13]!=3)return -EPROTONOSUPPORT;
+ pos=drom[13]==3?16:22;
+ if(len<pos || len!=13U+((drom[14]|(drom[15]<<8))&4095U))return -EMSGSIZE;
+ /* CRC is checked by apple_nhi_m1_usb4_drom_capture before this helper. */
+ for(;pos<len;pos+=n) {
+  if(len-pos<2)return -EPROTO;
+  n=drom[pos];
+  if(n<2 || n>len-pos)return -EPROTO;
+  if(!(drom[pos+1]&128))continue;
+  port=drom[pos+1]&63;if(!port || present[port])return -EPROTO;
+  present[port]=1;disabled[port]=!!(drom[pos+1]&64);
+  if(n>=8) {
+   secondary[port]=!!(drom[pos+2]&16);
+   if(drom[pos+2]&128)pair[port]=drom[pos+3]&63;
+  }
+ }
+ ret=read(ctx,0,2,0,5,h);if(ret)return ret;
+ max=(h[1]>>14)&63;up=(h[1]>>8)&63;
+ if(!max || max>63 || !up || up>max || h[2]!=1 || h[3]!=(1U<<31) ||
+    ((h[1]>>20)&7)!=1 || ((h[4]>>29)&7)!=1)return -EPROTO;
+ for(port=1;port<=max;port++) {
+  ret=read(ctx,port,1,0,4,ports[port]);if(ret)return ret;
+  if((ports[port][2]&0xffffff) && ((ports[port][3]>>20)&63)!=port)return -EPROTO;
+  if(disabled[port])continue;
+  if((ports[port][2]&0xffffff)==0x100101)down[ndown++]=port;
+ }
+ for(port=1;port<=max;port++) {
+  if(disabled[port] || (ports[port][2]&0xffffff)!=1)continue;
+  if(!present[port] || !pair[port] || pair[port]>max || !present[pair[port]] ||
+     disabled[pair[port]] || pair[pair[port]]!=port ||
+     secondary[port]==secondary[pair[port]] || (ports[pair[port]][2]&0xffffff)!=1)
+   return -EOPNOTSUPP;
+  if(port==up || pair[port]==up || secondary[port])continue;
+  if(index>=ndown)return -ENODEV;
+  off=ports[port][1]&255;
+  for(k=0;;k++) {
+   if(k==16 || off<8 || off>254)return -ERANGE;
+   for(j=0;j<k;j++)if(seen[j]==off)return -ELOOP;
+   seen[k]=off;
+   ret=read(ctx,port,1,off,2,cap);if(ret)return ret;
+   if(((cap[0]>>8)&255)==1)break;
+   off=cap[0]&255;
+  }
+  state=(cap[1]>>26)&15;
+  printf("CHILD-LANE primary=%u paired=%u PCIe-down=%u state=%u\n",port,pair[port],down[index],state);
+  if(state==2) {
+   if(found++)return -EOPNOTSUPP;
+   result=(struct apple_nhi_child){.route=1ULL|((u64)port<<8),.lane=port,.pcie_down=down[index]};
+  } else if(state!=0 && state!=7)return -EAGAIN;
+  index++;
+ }
+ if(!found)return -ENOTCONN;
+ *child=result;
+ printf("CHILD-DISCOVERY route=%llx lane=%u PCIe-down=%u; read-only\n",
+        (unsigned long long)result.route,result.lane,result.pcie_down);
+ return 0;
+}
diff --git a/cmd/apple_nhi_m1_nested.inc b/cmd/apple_nhi_m1_nested.inc
new file mode 100644
index 00000000..97d632dd
--- /dev/null
+++ b/cmd/apple_nhi_m1_nested.inc
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Two-router PCIe path, selected by runtime topology or an explicit test. All identities are runtime discoveries.
+ * Failure after writes mandates full reset; no partial OS handoff. */
+static int nested_read(struct diagnostic_ring *r,u64 route,unsigned int p,
+ unsigned int sp,unsigned int off,unsigned int n,u32 *v)
+{
+ if(route<=1 && sp==1 && p<64 && !off && n==4 && r->identity_valid[route][p]) {
+  memcpy(v,r->identity[route][p],16);return 0;
+ }
+ if((sp!=0 && sp!=1 && sp!=2) || p>63 || !n || n>8 ||
+    (sp==2 && p) || (sp==0 && (!p || n!=2 || (off!=0 && off!=16))))return -EINVAL;
+ return diagnostic_xfer(r,p,sp,off,n,v,USB4_CFG_READ,route);
+}
+static int nested_host(void *x,unsigned int p,unsigned int s,unsigned int o,unsigned int n,u32 *v)
+{ return nested_read(x,0,p,s,o,n,v); }
+static int nested_parent(void *x,unsigned int p,unsigned int s,unsigned int o,unsigned int n,u32 *v)
+{ return nested_read(x,1,p,s,o,n,v); }
+static int nested_child(void *x,unsigned int p,unsigned int s,unsigned int o,unsigned int n,u32 *v)
+{
+ struct diagnostic_ring *r=x;
+ if(!r->child_route || p>r->child_max_port)return -EINVAL;
+ return nested_read(r,r->child_route,p,s,o,n,v);
+}
+struct nested_credit_context {struct diagnostic_ring *r;u32 meta,data[16];bool data_valid;};
+static int nested_credit_read(void *x,unsigned int p,unsigned int s,unsigned int o,unsigned int n,u32 *v)
+{
+ struct nested_credit_context *c=x;int ret=diagnostic_usb4_credit_read(c->r,p,s,o,n,v);
+ if(!ret && o==0x19)c->meta=v[0];
+ if(!ret && o==9 && n==16){memcpy(c->data,v,64);c->data_valid=true;}
+ return ret;
+}
+static int nested_credit_write(void *x,unsigned int o,u32 v)
+{struct nested_credit_context *c=x;return diagnostic_usb4_credit_write(c->r,o,v);}
+static void nested_credit_wait(void *x){(void)x;udelay(10000);}
+static int nested_limit(u32 meta,const u32 *data,u32 *limit)
+{
+ unsigned int j;*limit=0;
+ if(!(meta&255) || (meta&255)>16)return -EPROTO;
+ for(j=0;j<(meta&255);j++)if((data[j]&65535)==4) {
+  if(*limit)return -EPROTO;
+  *limit=data[j]>>16;
+ }
+ return *limit>=6 && *limit<=127?0:-ENOSPC;
+}
+static int diagnostic_nested_pcie(struct diagnostic_ring *r)
+{
+ struct apple_usb4_snapshot s[2];u32 plan[2][4][2],limits[2],v[2],original[2][2];
+ struct nested_credit_context credit={.r=r};
+ const unsigned int enable_order[4][2]={{1,3},{1,0},{0,3},{0,0}};
+ unsigned int a,i,k;u64 route;int ret;
+ if(r->automatic && r->usb4_snapshot.valid)s[0]=r->usb4_snapshot;
+ else {ret=apple_nhi_m1_usb4_preflight(nested_host,nested_parent,r,&s[0]);if(ret)return ret;}
+ ret=apple_nhi_m1_child_preflight(nested_parent,nested_child,r,&r->child,
+     r->child_upstream,r->child_pcie,&s[1]);if(ret)return ret;
+ if(!r->host_credit_valid)return -EPROTO;
+ ret=nested_limit(r->host_credit_meta,r->host_credit_data,&limits[0]);if(ret)return ret;
+ ret=apple_nhi_m1_query(nested_credit_read,nested_credit_write,nested_credit_wait,&credit,0x33,0);
+ if(ret)return ret;
+ if(!credit.data_valid)return -EPROTO;
+ ret=nested_limit(credit.meta,credit.data,&limits[1]);if(ret)return ret;
+ ret=apple_nhi_m1_usb4_path_plan(&s[0],limits,plan[0]);if(ret)return ret;
+ ret=apple_nhi_m1_child_path_plan(&s[1],6,plan[1]);if(ret)return ret;
+ /* Validate the combined USB3 credit reservation before any PCIe path writes.
+  * The USB3 tunnel uses HopID9 on shared lanes, with six credits reserved for
+  * PCIe HopID8. Re-query/readback during its activation remains mandatory. */
+ if(r->automatic && r->auto_usb_snapshot.valid) {
+  u32 usb_limits[2]={0},usb_plan[4][2];unsigned int j,k;
+  const u32 *data[2]={r->host_credit_data,credit.data};
+  u32 meta[2]={r->host_credit_meta,credit.meta};
+  for(k=0;k<2;k++)for(j=0;j<(meta[k]&255);j++)if((data[k][j]&65535)==1) {
+   if(usb_limits[k])return -EPROTO;
+   usb_limits[k]=data[k][j]>>16;
+  }
+  if(r->auto_usb_snapshot.lane_reserve!=6 || r->auto_usb_snapshot.hop[1]!=9 ||
+     r->auto_usb_snapshot.hop[2]!=9)return -EPROTO;
+  ret=apple_nhi_m1_usb3_path_plan(&r->auto_usb_snapshot,usb_limits,usb_plan);if(ret)return ret;
+ }
+
+ printf("NESTED-PCIE PLAN PASS limits=%u,%u sent=%u received=%u child=%llx\n",limits[0],limits[1],r->sent,r->received,(unsigned long long)r->child_route);
+ for(a=0;a<2;a++)for(i=0;i<4;i++)
+  printf("NESTED-PLAN tunnel=%u route=%llx port=%u path8=%08x %08x\n",a,
+    (unsigned long long)(a?(i>=2?r->child_route:1):(i>=2)),s[a].port[i],plan[a][i][0],plan[a][i][1]);
+ if(!r->automatic && !ofnode_read_bool(ofnode_path("/config"),"u-boot,downstream-pcie-activate"))return -EINPROGRESS;
+ /* 24 path transactions +12 endpoint transactions, with12 spare events.
+  * Error paths halt NHI and reset; do not recycle descriptors or hand off. */
+ if(r->sent>r->capacity-1-48 || r->received>r->capacity-1-48)return -ENOSPC;
+ for(a=0;a<2;a++)for(i=0;i<4;i++) {
+  route=a?(i>=2?r->child_route:1):(i>=2);
+  ret=diagnostic_xfer(r,s[a].port[i],0,16,2,v,USB4_CFG_READ,route);if(ret)return ret;
+  if(v[0]!=s[a].old[i][0] || v[1]!=s[a].old[i][1])return -EBUSY;
+  ret=diagnostic_xfer(r,s[a].port[i],0,16,2,plan[a][i],USB4_CFG_WRITE,route);if(ret)return ret;
+  ret=diagnostic_xfer(r,s[a].port[i],0,16,2,v,USB4_CFG_READ,route);if(ret)return ret;
+  if(v[0]!=plan[a][i][0] || (v[1]&~BIT(28))!=plan[a][i][1])return -EIO;
+ }
+ puts("NESTED-PCIE PATHS PASS; both adjacent tunnels read back\n");
+ for(k=0;k<4;k++) {
+  a=enable_order[k][0];i=enable_order[k][1];route=a?(i?r->child_route:1):(i?1:0);
+  ret=diagnostic_xfer(r,s[a].port[i],1,s[a].cap[i],1,&original[a][i?1:0],USB4_CFG_READ,route);if(ret)return ret;
+  v[0]=original[a][i?1:0];
+  if((v[0]&BIT(31)) || ((v[0]>>25)&15) || ((v[0]>>8)&255)!=4)return -EBUSY;
+  v[0]|=BIT(31);
+  ret=diagnostic_xfer(r,s[a].port[i],1,s[a].cap[i],1,v,USB4_CFG_WRITE,route);if(ret)return ret;
+  ret=diagnostic_xfer(r,s[a].port[i],1,s[a].cap[i],1,v,USB4_CFG_READ,route);if(ret)return ret;
+  if(!(v[0]&BIT(31)))return -EIO;
+  printf("NESTED-PCIE ENABLE route=%llx port=%u value=%08x\n",(unsigned long long)route,s[a].port[i],v[0]);
+ }
+ ret=apple_pciec_m1_start_link();if(ret)return ret;
+ ret=apple_pciec_m1_scan();if(ret)return ret;
+ ret=apple_pciec_m1_nvme_read();
+ printf("NESTED-PCIE NVME result=%d sent=%u received=%u; no disk writes\n",ret,r->sent,r->received);
+ return ret;
+}
