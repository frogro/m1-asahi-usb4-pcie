+/* Diagnostic only: use already-read status; never issue extra USB requests. */
+static void usb_hub_reset_trace(struct usb_device *dev, int port,
+			       const char *phase, int attempt, int delay,
+			       int result, unsigned short status,
+			       unsigned short change)
+{
+#if CONFIG_IS_ENABLED(DM_USB)
+	struct usb_bus_priv *priv = dev_get_uclass_priv(usb_get_bus(dev->dev));
+
+	if (priv && priv->scan_strict)
+		printf("USB-RESET hub=%u VID=%04x PID=%04x protocol=%u port=%d phase=%s attempt=%d wait_ms=%d result=%d status=%04x change=%04x\n",
+		       dev->devnum, dev->descriptor.idVendor,
+		       dev->descriptor.idProduct, dev->descriptor.bDeviceProtocol,
+		       port + 1, phase, attempt, delay, result, status, change);
+#endif
+}
+
+/* Positive reset outcome: a powered USB2 port is confirmed empty. */
+#define USB_HUB_RESET_DISCONNECTED 1
+
+static int usb_hub_confirm_disconnect(struct usb_device *dev, int port,
+				      unsigned short status,
+				      unsigned short change)
+{
+#if CONFIG_IS_ENABLED(DM_USB)
+	struct usb_bus_priv *priv = dev_get_uclass_priv(usb_get_bus(dev->dev));
+	ALLOC_CACHE_ALIGN_BUFFER(struct usb_port_status, sample, 1);
+	int ret, step;
+
+	/* No chipset exceptions, and no interpretation of transport errors. */
+	if (!priv || !priv->scan_strict || usb_hub_is_superspeed(dev) ||
+	    status != USB_PORT_STAT_POWER ||
+	    !(change & USB_PORT_STAT_C_CONNECTION) ||
+	    (change & ~(USB_PORT_STAT_C_CONNECTION | USB_PORT_STAT_C_RESET)))
+		return -1;
+
+	ret = usb_clear_port_feature(dev, port + 1, USB_PORT_FEAT_C_CONNECTION);
+	if (ret < 0)
+		return ret;
+	ret = usb_clear_port_feature(dev, port + 1, USB_PORT_FEAT_C_RESET);
+	if (ret < 0)
+		return ret;
+
+	/* Confirm 100ms of stable absence after acknowledging the change. */
+	for (step = 1; step <= 4; step++) {
+		mdelay(25);
+		ret = usb_get_port_status(dev, port + 1, sample);
+		if (ret < 0)
+			return ret;
+		if (ret != sizeof(*sample))
+			return -EIO;
+		status = le16_to_cpu(sample->wPortStatus);
+		change = le16_to_cpu(sample->wPortChange);
+		usb_hub_reset_trace(dev, port, "disconnect-check", step, 25,
+				    0, status, change);
+		if (status != USB_PORT_STAT_POWER || change)
+			return -EAGAIN;
+	}
+	usb_hub_reset_trace(dev, port, "disconnected-stable", 4, 100,
+			    USB_HUB_RESET_DISCONNECTED, status, change);
+	return USB_HUB_RESET_DISCONNECTED;
+#else
+	return -1;
+#endif
+}
