 #include <time.h>
 #include <usb.h>
+#include <blk.h>
 #include <usb/xhci.h>
 #include <linux/usb/dwc3.h>
 
+/* Match usb_stop(): removal alone leaves inactive devices visible to EFI.
+ * Unbind only this halted controller's old root hubs, never another port. */
+static int atc_unbind_stopped_usb_children(struct udevice *usb)
+{
+ struct udevice *child,*next;
+ struct uclass *uc;
+ unsigned int roots=0;
+ int ret;
+ if(!usb || device_get_uclass_id(usb)!=UCLASS_USB || device_active(usb))return -EBUSY;
+ device_foreach_child(child,usb) {
+  if(device_active(child) || device_get_uclass_id(child)!=UCLASS_USB_HUB)return -EPROTO;
+  roots++;
+ }
+ uc=uclass_find(UCLASS_BLK);
+ if(uc)uclass_foreach_dev(child,uc) {
+  struct udevice *parent=child->parent;unsigned int depth=0;
+  while(parent && parent!=usb && depth++<16)parent=parent->parent;
+  if(parent==usb) {
+   struct blk_desc *desc=dev_get_uclass_plat(child);
+   printf("USB3-STALE block=%s dev=%d active=%u selected-controller=%s\n",
+          child->name,desc?desc->devnum:-1,device_active(child),usb->name);
+   if(device_active(child))return -EBUSY;
+  }
+ }
+ printf("USB3-STALE roots=%u; unbind only selected halted host\n",roots);
+ if(ofnode_read_bool(ofnode_path("/config"),"u-boot,diagnostic-nvme-flush")) {
+  ret=apple_boot_test_snapshot();if(ret)return ret;
+ }
+ device_foreach_child_safe(child,next,usb) {
+  ret=device_unbind(child);if(ret)return ret;
+ }
+ if(!list_empty(&usb->child_head))return -EIO;
+ puts("USB3-STALE cleanup PASS; controller retained, other hosts untouched\n");
+ return 0;
+}
