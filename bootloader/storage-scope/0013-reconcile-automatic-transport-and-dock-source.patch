+  for(i=0;i<words*4;i++) out[offset+i]=(u8)(data[i/4] >> ((i%4)*8));
+  if (!offset) {
+   printf("USB4-DROM HEADER words=%08x %08x %08x %08x revision=%u\n",data[0],data[1],data[2],data[3],out[13]);
