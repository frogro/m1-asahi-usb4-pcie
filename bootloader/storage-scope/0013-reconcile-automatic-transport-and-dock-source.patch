diff --git a/lib/apple_boot_media.c b/lib/apple_boot_media.c
new file mode 100644
index 00000000..c77599b3
--- /dev/null
+++ b/lib/apple_boot_media.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <apple_boot_media.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+
+static unsigned int lower_hex(unsigned int c)
+{
+ return c >= 'A' && c <= 'F' ? c + 'a' - 'A' : c;
+}
+int apple_boot_partuuid_valid(const char *uuid)
+{
+ unsigned int i, c, nonzero = 0;
+ if (!uuid || strnlen(uuid, APPLE_BOOT_MEDIA_UUID_SIZE) != 36)
+  return 0;
+ for (i = 0; i < 36; i++) {
+  c = lower_hex((unsigned char)uuid[i]);
+  if (i == 8 || i == 13 || i == 18 || i == 23) {
+   if (c != '-') return 0;
+  } else {
+   if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+    return 0;
+   nonzero |= c != '0';
+  }
+ }
+ return !!nonzero;
+}
+static bool same_uuid(const char *a, const char *b)
+{
+ unsigned int i;
+ for (i = 0; i < 36; i++)
+  if (lower_hex((unsigned char)a[i]) != lower_hex((unsigned char)b[i]))
+   return false;
+ return true;
+}
+int apple_boot_media_select(const struct apple_boot_inventory *inv,
+                           const char *target, size_t *selected)
+{
+ size_t i, j, found = (size_t)-1, matches = 0;
+ int pending = 0, error = 0;
+ if (!selected) return -EINVAL;
+ *selected = (size_t)-1;
+ if (!inv || !inv->sources || !inv->source_count ||
+     (inv->media_count && !inv->media)) return -EINVAL;
+ if (inv->source_count > APPLE_BOOT_MEDIA_MAX_SOURCES ||
+     inv->media_count > APPLE_BOOT_MEDIA_MAX_CANDIDATES) return -E2BIG;
+ if (target && !apple_boot_partuuid_valid(target)) return -EINVAL;
+ for (i = 0; i < inv->source_count; i++) {
+  const struct apple_boot_source *s = &inv->sources[i];
+  switch (s->state) {
+  case APPLE_BOOT_SOURCE_UNSAFE: return -EBUSY;
+  case APPLE_BOOT_SOURCE_PENDING: pending = 1; break;
+  case APPLE_BOOT_SOURCE_FAILED:
+   if (!error) error = s->error < 0 ? s->error : -EIO;
+   break;
+  case APPLE_BOOT_SOURCE_COMPLETE:
+  case APPLE_BOOT_SOURCE_ABSENT:
+   if (s->error) return -EINVAL;
+   break;
+  default: return -EINVAL;
+  }
+ }
+ /* Never equate an incomplete/failed inventory with 'target absent'. */
+ if (error) return error;
+ if (pending) return -EAGAIN;
+ for (i = 0; i < inv->media_count; i++) {
+  const struct apple_boot_media *m = &inv->media[i];
+  if ((m->transport != APPLE_BOOT_TRANSPORT_NVME &&
+       m->transport != APPLE_BOOT_TRANSPORT_USB) ||
+      m->source >= inv->source_count || !m->partition ||
+      inv->sources[m->source].state != APPLE_BOOT_SOURCE_COMPLETE)
+   return -EINVAL;
+  for (j = 0; j < i; j++) {
+   const struct apple_boot_media *p = &inv->media[j];
+   if (p->transport == m->transport &&
+       p->source == m->source && p->device == m->device &&
+       p->route == m->route && p->partition == m->partition)
+    return -EEXIST;
+  }
+  if (!m->efi_system_partition || !m->has_efi_loader) continue;
+  if (!apple_boot_partuuid_valid(m->partuuid)) return -EPROTO;
+  if (target && !same_uuid(target, m->partuuid)) continue;
+  matches++;
+  found = i;
+ }
+ if (!matches) return -ENOENT;
+ if (matches != 1) return -ENOTUNIQ;
+ *selected = found;
+ return 0;
+}
diff --git a/lib/apple_pciec_m1.c b/lib/apple_pciec_m1.c
index d83748d3..a6d1969e 100644
--- a/lib/apple_pciec_m1.c
+++ b/lib/apple_pciec_m1.c
@@ -291,3 +291,39 @@ int pciec_m1_scan(const struct pciec_m1_io *io, void *ctx, struct pciec_scan *sc
  memset(scan, 0, sizeof(*scan)); scan->next_bus = 1;
  return pciec_scan_bus(io, ctx, scan, 0);
 }
+
+/* Classify complete direct PCIe inventories without probing BARs or enabling
+ * endpoint DMA. Unknown classes, other storage transports and mixed endpoint
+ * trees remain unsupported, rather than being misreported as empty media. */
+int pciec_m1_boot_endpoint(const struct pciec_scan *scan, unsigned int *index)
+{
+ unsigned int i, nvmes = 0, nonstorage = 0;
+ if (!scan || !index || scan->count > PCIEC_SCAN_MAX) return -EINVAL;
+ *index = PCIEC_SCAN_MAX;
+ if (!scan->count) return -ENODATA;
+ for (i = 0; i < scan->count; i++) {
+  const struct pciec_scan_entry *e = &scan->entry[i];
+  unsigned int cls = e->class_rev >> 8;
+  if (!(e->id & 0xffff) || (e->id & 0xffff) == 0xffff ||
+      e->class_rev == ~0U) return -EPROTO;
+  if ((cls >> 8) == 0x0604) {
+   if (((e->header >> 16) & 0x7f) != 1) return -EPROTO;
+   continue;
+  }
+  if (((e->header >> 16) & 0x7f) != 0) return -EPROTO;
+  if (e->command & 7) return -EBUSY;
+  if (cls == 0x010802) { nvmes++; *index = i; continue; }
+  switch (cls >> 16) {
+  case 0x02: /* Network */
+  case 0x03: /* Display */
+  case 0x04: /* Multimedia, including GPU audio */
+  case 0x0c: /* Serial bus, including xHCI and I2C */
+   nonstorage++; break;
+  default: return -EOPNOTSUPP;
+  }
+ }
+ if (nvmes > 1) return -EBUSY;
+ if (nvmes && nonstorage) return -EOPNOTSUPP;
+ if (nvmes) return PCIEC_BOOT_NVME;
+ return nonstorage ? PCIEC_BOOT_NONSTORAGE : -ENODATA;
+}
diff --git a/lib/usb4_cfg.c b/lib/usb4_cfg.c
index 59bba613..5e5ac8a9 100644
--- a/lib/usb4_cfg.c
+++ b/lib/usb4_cfg.c
@@ -138,3 +138,42 @@ int usb4_cfg_ack_plug_encode(const struct usb4_cfg_event *event,
  put_unaligned_be32(usb4_cfg_crc(bytes, 12), bytes + 12);
  return 16;
 }
+
+/* Linux cfg_error_pkg. These replies have no request sequence field. */
+int usb4_cfg_decode_error(const void *frame, size_t size, unsigned int sof,
+                         unsigned int eof, struct usb4_cfg_error *error)
+{
+ const u8 *bytes=frame; u32 hi,value;
+ struct usb4_cfg_error result;
+ if(!frame || !error)return -EINVAL;
+ if(eof!=USB4_CFG_ERROR)return -EAGAIN;
+ if(sof || size!=16)return -EPROTO;
+ if(get_unaligned_be32(bytes+12)!=usb4_cfg_crc(bytes,12))return -EBADMSG;
+ hi=get_unaligned_be32(bytes);value=get_unaligned_be32(bytes+8);
+ if((hi&0xffc00000)!=BIT(31) || (value&0x3fffc000))return -EPROTO;
+ result.route=(u64)(hi&0x003fffff)<<32|get_unaligned_be32(bytes+4);
+ result.port=(value>>8)&63;result.code=value&255;result.pg=value>>30;
+ *error=result;return 0;
+}
+int usb4_cfg_error_result(const struct usb4_cfg_request *req,
+                          const struct usb4_cfg_error *error)
+{
+ if(!req || !error)return -EINVAL;
+ /* Operation-complete and other asynchronous notifications carry no
+  * current-request status. The caller logs them and retains its deadline. */
+ switch(error->code) {
+ case 32: case 33: case 34: case 35: case 36: case 37: case 38: case 39:
+  return -EAGAIN;
+ case 1: case 12: case 13: return -EIO;
+ }
+ if(error->pg || error->route!=req->route ||
+    (req->port && error->port!=req->port))return -EPROTO;
+ switch(error->code) {
+ case 0:return -ENOTCONN;
+ case 2:return -ENXIO;
+ case 4:return -ENODEV;
+ case 8:return -ELOOP;
+ case 15:return -EACCES;
+ default:return -EREMOTEIO;
+ }
+}
