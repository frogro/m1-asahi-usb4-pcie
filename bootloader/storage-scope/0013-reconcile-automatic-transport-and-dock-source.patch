+ }
+ for (r = 0; r < 2; r++) for (i = 0; i < 2; i++) {
+  unsigned int port = i ? lane[r] : endpoints[r];
+  ret = reads[r](context, port, 1, 0, 8, p);
+  if (ret) return ret;
+  type = i ? 1 : (r ? 0x100102 : 0x100101);
