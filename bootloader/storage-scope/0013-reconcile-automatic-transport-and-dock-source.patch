+  ret = reads[r](context, 0, 2, 0, 5, h);
+  if (ret) return ret;
+  max = (h[1] >> 14) & 63;
+  if (!h[0] || h[0] == ~0U || !max || max > 16 ||
+      h[2] != r || h[3] != (1U << 31) || ((h[1] >> 20) & 7) != r ||
