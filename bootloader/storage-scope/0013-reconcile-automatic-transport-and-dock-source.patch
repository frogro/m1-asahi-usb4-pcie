+void apple_boot_test_record(void)
+{
+ const char *profile;
+ if (!ofnode_read_bool(ofnode_path("/config"), "u-boot,dual-port-test")) return;
+ enabled = !console_record_reset_enable();
+ profile = ofnode_read_string(ofnode_path("/chosen"), "u-boot,integration");
+ printf("BOOT-TEST profile=%s\n", profile ? profile : "unspecified");
+}
+int apple_boot_test_snapshot(void)
+{
+ struct blk_desc *desc;
+ struct disk_partition info;
+ struct udevice *controller;
+ struct membuf view;
+ void *log, *check;
+ loff_t actual = 0;
+ int count, ret;
+ if (!enabled) return 0;
+ desc=blk_get_devnum_by_uclass_id(UCLASS_NVME,0);
+ if(!desc || part_get_info(desc,8,&info) ||
+    strcasecmp(info.uuid,"f5af719f-ed4a-4004-b751-3f9e398a75d0")) return -EPERM;
+ controller=dev_get_parent(desc->bdev);
+ if(!controller || !device_is_compatible(controller,"apple,nvme-ans2")) return -EPERM;
+ log=memalign(4096,0x100000);check=memalign(4096,0x100000);
+ if(!log || !check){free(log);free(check);return -ENOMEM;}
+ gd->flags &= ~GD_FLG_RECORD;
+ view=gd->console_out;
+ count=membuf_get(ofnode_read_bool(ofnode_path("/config"),"u-boot,diagnostic-nvme-flush")?
+                  &view:(struct membuf *)&gd->console_out,log,0x100000);
+ if(count<=0){ret=-ENODATA;goto out;}
+ ret=fs_set_blk_dev("nvme","0:8",FS_TYPE_FAT);
+ if(!ret)ret=fs_write("/media-selection-reset-20261102.log",(ulong)log,0,count,&actual);
+ fs_close();
+ if(!ret && actual!=count)ret=-EIO;
+ if(!ret)ret=fs_set_blk_dev("nvme","0:8",FS_TYPE_FAT);
+ if(!ret)ret=fs_read("/media-selection-reset-20261102.log",(ulong)check,0,count,&actual);
+ fs_close();
+ if(!ret && (actual!=count || memcmp(log,check,count)))ret=-EIO;
+ if(!ret && ofnode_read_bool(ofnode_path("/config"),"u-boot,diagnostic-nvme-flush")) {
+  ret=nvme_flush_namespace(desc->bdev);
+  printf("BOOT-CHECKPOINT internal namespace flush=%d\n",ret);
+ }
+ out:
+ free(log);free(check);gd->flags |= GD_FLG_RECORD;
+ return ret;
+}
