+  .usb_darts={0x502f00000ULL,0x502f80000ULL},
+  .pcie_regs={0x520200000ULL,0x520004000ULL,0x521000000ULL,0x520008000ULL,0x530000000ULL},
+  .acio_domains={0x458ULL,0x460ULL,0x468ULL,0x450ULL},
+  .pcie_domains={0x448ULL,0x450ULL,0x458ULL,0x460ULL,0x468ULL},
+  .common_domain=0x448, .pcie_domain=0x450, .cio_domain=0x458 },
+};
+static unsigned int selected = 1;
+static unsigned int committed;
+static bool scanning;
+bool apple_boot_scan_enabled(void) { return scanning; }
+int apple_boot_scan_begin(void)
+{
+ if (committed || scanning) return -EBUSY;
+ scanning = true;
+ return 0;
+}
+const struct apple_boot_port *apple_boot_port(void) { return &apple_m1_ports[selected]; }
+int apple_boot_port_select(unsigned int index)
+{
+ if (index >= 2) return -EINVAL;
+ if (committed && !scanning) return index == selected ? 0 : -EBUSY;
+ selected = index;
+ return 0;
+}
+void apple_boot_port_commit(void) { committed |= 1U << selected; }
+
+/* Validate wiring using the live DT graph before talking to the PD chip.
+ * Selecting the wrong PD controller can otherwise look like a plausible
+ * cable status while configuring a completely different physical port. */
+static int port_ref(const void *fdt, int node, const char *property,
+                    int target, int cells, int argument)
+{
+ int len;
+ const fdt32_t *p = fdt_getprop(fdt, node, property, &len);
+ if (!p || len != cells * 4 || target < 0 ||
+     fdt_node_offset_by_phandle(fdt, fdt32_to_cpu(p[0])) != target)
+  return -EINVAL;
+ if (cells == 2 && fdt32_to_cpu(p[1]) != (unsigned int)argument)
+  return -EINVAL;
+ return 0;
+}
+int apple_boot_port_validate(const void *fdt, unsigned int index)
+{
+ const struct apple_boot_port *p;
+ const fdt32_t *reg;
+ char pd[96], end[160], target[160];
+ int controller, acio, len, i;
+ if (!fdt || fdt_check_header(fdt) || index >= 2) return -EINVAL;
+ if (fdt_node_check_compatible(fdt, 0, "apple,j274")) return -ENODEV;
+ p = &apple_m1_ports[index];
+ snprintf(pd, sizeof(pd), "/soc/i2c@235010000/usb-pd@%x", p->pd_address);
+ controller = fdt_path_offset(fdt, pd);
+ if (controller < 0 || fdt_node_check_compatible(fdt, controller, "apple,cd321x")) return -ENODEV;
+ reg = fdt_getprop(fdt, controller, "reg", &len);
+ if (!reg || len != 4 || fdt32_to_cpu(*reg) != p->pd_address) return -EINVAL;
+ for (i = 0; i < 2; i++) {
+  snprintf(end, sizeof(end), "%s/connector/ports/port@%u/endpoint", pd, i ? 2 : 0);
+  snprintf(target, sizeof(target), "%s/ports/port@%u/endpoint", i ? p->acio : p->usb, i ? 1 : 0);
+  if (port_ref(fdt, fdt_path_offset(fdt,end), "remote-endpoint",
+               fdt_path_offset(fdt,target), 1, 0)) return -EINVAL;
+  if (port_ref(fdt, fdt_path_offset(fdt,target), "remote-endpoint",
+               fdt_path_offset(fdt,end), 1, 0)) return -EINVAL;
+ }
+ acio = fdt_path_offset(fdt, p->acio);
+ if (port_ref(fdt, acio, "resets", fdt_path_offset(fdt,"/soc/reset-controller@23b784000"),2,index)) return -EINVAL;
+ if (port_ref(fdt, acio, "mboxes", fdt_path_offset(fdt,p->mbox),1,0)) return -EINVAL;
+ if (port_ref(fdt, acio, "pinctrl-0", fdt_path_offset(fdt,p->pin_group),1,0)) return -EINVAL;
+ /* The NVMe BAR must be inside the native non-prefetchable CPU aperture.
+  * This also prevents passing Linux a different address translation. */
+ snprintf(target,sizeof(target),"/soc/usb4-pcie-tunnel-%u/pcie@%llx",index,
+          (unsigned long long)p->pcie_regs[4]);
+ reg=fdt_getprop(fdt,fdt_path_offset(fdt,target),"ranges",&len);
+ if(!reg || len<=0 || len%28) return -EINVAL;
+ for(i=0;i<len/4;i+=7) {
+  u64 bus, cpu, size;
+  if(fdt32_to_cpu(reg[i])!=0x02000000) continue;
+  bus=(u64)fdt32_to_cpu(reg[i+1])<<32 | fdt32_to_cpu(reg[i+2]);
+  cpu=(u64)fdt32_to_cpu(reg[i+3])<<32 | fdt32_to_cpu(reg[i+4]);
+  size=(u64)fdt32_to_cpu(reg[i+5])<<32 | fdt32_to_cpu(reg[i+6]);
+  if(p->bar_bus>=bus && size>=0x100000 && p->bar_bus-bus<=size-0x100000 &&
+     cpu<=~0ULL-(p->bar_bus-bus) && p->bar_cpu==cpu+(p->bar_bus-bus)) return 0;
+ }
+ return -ERANGE;
+}
diff --git a/cmd/apple_boot_reset.c b/cmd/apple_boot_reset.c
new file mode 100644
index 00000000..e87d0afb
--- /dev/null
+++ b/cmd/apple_boot_reset.c
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <apple_boot_port.h>
+#include <command.h>
+#include <dm.h>
+#include <dm/uclass-internal.h>
+#include <nvme.h>
+#include <stdio.h>
+
+/* A watchdog reset does not run the OS-handoff device removal callbacks.
+ * Finish internal NVMe writes (including recovery images and diagnostics)
+ * before resetting. A successful readback alone does not imply durability.
+ * This is a terminal operation: no further block I/O before the reset.
+ * Do not probe inactive devices or touch external tunnel-owned controllers.
+ */
+int apple_boot_prepare_reset(void)
+{
+	struct uclass *uc = uclass_find(UCLASS_NVME);
+	struct udevice *dev;
+	int ret, first_error = 0;
+
+	if (!uc)
+		return 0;
+
+	uclass_foreach_dev(dev, uc) {
+		if (!device_active(dev) ||
+		    !device_is_compatible(dev, "apple,nvme-ans2"))
+			continue;
+
+		ret = nvme_shutdown(dev);
+		printf("Apple boot: internal NVMe %s shutdown=%d\n",
+		       dev->name, ret);
+		if (ret && !first_error)
+			first_error = ret;
+	}
+
+	return first_error;
+}
+
+/* All external-boot reset exits must use the same durability boundary. */
+int apple_boot_reset(void)
+{
+ int ret = apple_boot_prepare_reset();
+
+ if (ret)
+  printf("Internal NVMe shutdown failed=%d; recovery writes are not verified durable\n", ret);
+ return do_reset(NULL, 0, 0, NULL);
+}
