+static int tb_boot_efi(unsigned int partition)
+{
+ struct blk_desc *desc;
+ void *image = NULL;
+ int length = 0, ret;
+ if (!IS_ENABLED(CONFIG_EFI_VARIABLE_NO_STORE) || !tb.live || !tb.dma ||
+     tb.failed || !env_get_hex("fdt_addr_r", 0)) return -EPERM;
+ ret = tb_prepare_block();
+ if (ret) return ret;
+ desc = dev_get_uclass_plat(tb.blk);
+ ret = partition ? tb_read_efi(partition, &image, &length) : tb_find_efi(desc, &image, &length);
+ if (ret) return ret;
+ return tb_boot_loaded_efi(image, length, NULL, 0);
+}
+
+int apple_pciec_m1_boot_selected(unsigned int partition)
+{
+ if (!apple_boot_scan_enabled() || !partition) return -EINVAL;
+ return tb_boot_efi(partition);
+}
