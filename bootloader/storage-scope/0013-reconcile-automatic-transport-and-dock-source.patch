+/* Flush an already active namespace without resetting its controller. */
+int nvme_flush_namespace(struct udevice *udev)
+{
+ struct nvme_ns *ns;
+ struct nvme_command cmd = {0};
+ if (!udev || device_get_uclass_id(udev) != UCLASS_BLK ||
+     !device_active(udev) || !udev->parent ||
+     device_get_uclass_id(udev->parent) != UCLASS_NVME ||
+     !device_active(udev->parent)) return -EINVAL;
+ ns = dev_get_priv(udev);
+ if (!ns || !ns->ns_id || !ns->dev || ns->dev->udev != udev->parent ||
+     !ns->dev->queues[NVME_IO_Q]) return -ENODEV;
+ cmd.common.opcode = nvme_cmd_flush;
+ cmd.common.nsid = cpu_to_le32(ns->ns_id);
+ return nvme_submit_sync_cmd(ns->dev->queues[NVME_IO_Q], &cmd, NULL, IO_TIMEOUT);
+}
