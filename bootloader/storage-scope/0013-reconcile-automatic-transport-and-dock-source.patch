+  .nhi_dart="/soc/cio@381ac0000/iommu@a80000",
+  .mbox="/soc/mailbox@381100000",
+  .pcie="/soc/pcie@3b0000000",
+  .pcie_child="/soc/pcie@3b0000000/pci@0,0",
+  .dart="/soc/iommu@3a1008000",
+  .adapter_alias="usb4_0_pcie_adapter",
+  .pin_group="/soc/pinctrl@24a820000/acio0-pins",
+  .usb_base=0x382280000ULL,
+  .rc=0x381ac0000ULL,
+  .sram=0x381080000ULL,
+  .mailbox=0x381100000ULL,
+  .nhi_base=0x381f00000ULL,
+  .nhi_dart_base=0x381a80000ULL,
+  .pdf=0x381db0000ULL,
+  .adapter=0x381e44000ULL,
+  .dart_base=0x3a1008000ULL,
+  .bar_cpu=0x480000000ULL, .bar_bus=0x80000000,
+  .phy_regs={0x383000000ULL,0x380000000ULL,0x382a90000ULL,0x382a84000ULL,0x383050000ULL},
+  .usb_darts={0x382f00000ULL,0x382f80000ULL},
+  .pcie_regs={0x3a0200000ULL,0x3a0004000ULL,0x3a1000000ULL,0x3a0008000ULL,0x3b0000000ULL},
+  .acio_domains={0x430ULL,0x438ULL,0x440ULL,0x428ULL},
+  .pcie_domains={0x420ULL,0x428ULL,0x430ULL,0x438ULL,0x440ULL},
+  .common_domain=0x420, .pcie_domain=0x428, .cio_domain=0x430 },
+ { .index=1, .pd_address=0x3f, .pin=41,
+  .phy="/soc/phy@503000000",
+  .usb="/soc/usb@502280000",
+  .acio="/soc/cio@501ac0000",
+  .nhi="/soc/cio@501ac0000/nhi@f00000",
+  .nhi_dart="/soc/cio@501ac0000/iommu@a80000",
+  .mbox="/soc/mailbox@501100000",
+  .pcie="/soc/pcie@530000000",
+  .pcie_child="/soc/pcie@530000000/pci@0,0",
+  .dart="/soc/iommu@521008000",
+  .adapter_alias="usb4_1_pcie_adapter",
+  .pin_group="/soc/pinctrl@24a820000/acio1-pins",
+  .usb_base=0x502280000ULL,
+  .rc=0x501ac0000ULL,
+  .sram=0x501080000ULL,
+  .mailbox=0x501100000ULL,
+  .nhi_base=0x501f00000ULL,
+  .nhi_dart_base=0x501a80000ULL,
