+   next[i][0] |= s->old[i][0] & (127U << 17);
+   next[i][1] |= s->old[i][1] & ((1U << 24) | (1U << 26));
+  } else {
+   next[i][0] |= credit[i] << 17;
+   next[i][1] |= 1U << 24;
+  }
+  if (i == 0 || i == 3) next[i][1] |= 1U << 25;
+ }
+ return 0;
+}
