+                              void *context, struct apple_usb4_snapshot *s)
+{
+ apple_nhi_read_fn reads[2] = {host, remote};
+ u32 h[5], p[8], cap[2], path[2], control[2];
+ unsigned int endpoints[2] = {0, 0}, lane[2] = {1, 0};
+ unsigned int r, i, max, off, wanted, seen[16], n, j, type, index;
+ int ret;
+ if (!s) return -EINVAL;
+ *s = (struct apple_usb4_snapshot){0};
+ if (!host || !remote) return -EINVAL;
