+int apple_atc_m1_usb_status(void)
+{
+#if CONFIG_IS_ENABLED(USB_XHCI_HCD)
+ struct xhci_ctrl *ctrl=boot_xhci;
+ unsigned int i,ports;
+ u32 state;
+ if(!ctrl)return -ENODEV;
+ ports=HCS_MAX_PORTS(xhci_readl(&ctrl->hccr->cr_hcsparams1));
+ if(!ports || ports>16)return -EPROTO;
+ for(i=0;i<ports;i++) {
+  state=xhci_readl(&ctrl->hcor->portregs[i].or_portsc);
+  if(state==~0U)return -ENODEV;
+  printf("USB3-XHCI port=%u status=%08x connected=%u enabled=%u speed=%u\n",i+1,state,state&1,(state>>1)&1,(state>>10)&15);
+ }
+ return 0;
+#else
+ return -ENOSYS;
+#endif
+}
