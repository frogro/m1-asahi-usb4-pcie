+/* USB4 v1 router registers only. No path/adapter/NVM writes. */
+static int diagnostic_usb4_router_write(void *context, unsigned int offset,
+                                      unsigned int words, const u32 *data)
+{
+ u32 copy[4];
+ if (!data) return -EINVAL;
+ if (offset == 1 && words == 4) {
+  if (data[1] != 1 || data[2] != BIT(31) ||
+      ((data[0] >> 20) & 7) != 1 ||
+      !((data[0] >> 8) & 63) || ((data[0] >> 8) & 63) > 16 ||
+      ((data[3] >> 29) & 7) != 1 || (data[3] & 0xffff) != 0x10ff)
+   return -EINVAL;
+ } else if (offset == 5 && words == 1) {
+  if (!(data[0] & BIT(24)) || (data[0] & (BIT(0) | BIT(23))))
+   return -EINVAL;
+ } else return -EINVAL;
+ memcpy(copy, data, words * sizeof(*copy));
+ return diagnostic_xfer(context, 0, 2, offset, words, copy, USB4_CFG_WRITE, 1);
+}
