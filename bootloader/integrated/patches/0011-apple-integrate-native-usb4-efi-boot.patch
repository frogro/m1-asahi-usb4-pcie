+static int diagnostic_usb4_path_read(void *context, unsigned int port,
+ unsigned int space, unsigned int offset, unsigned int words, u32 *data)
+{
+ if (space == 0) {
+  if (!port || port > 16 || words != 2 || (offset != 0 && offset != 16))
+   return -EINVAL;
+  return diagnostic_xfer(context,port,space,offset,words,data,USB4_CFG_READ,1);
+ }
+ return diagnostic_remote_read(context,port,space,offset,words,data);
+}
+
+/* USB4 router buffer-allocation query. Only operation 0x33 allowed. */
+static int diagnostic_usb4_credit_read(void *context, unsigned int port,
+ unsigned int space, unsigned int offset, unsigned int words, u32 *data)
+{
+ if (port || space != 2 ||
+     !((words == 1 && (offset == 0x19 || offset == 0x1a)) ||
+       (words == 16 && offset == 9))) return -EINVAL;
+ return diagnostic_xfer(context,0,2,offset,words,data,USB4_CFG_READ,1);
+}
+static int diagnostic_usb4_credit_write(void *context, unsigned int offset, u32 value)
+{
+ if (!((offset == 0x19 && value == 0) ||
+       (offset == 0x1a && value == 0x80000033))) return -EINVAL;
+ return diagnostic_xfer(context,0,2,offset,1,&value,USB4_CFG_WRITE,1);
+}
+static void diagnostic_usb4_credit_wait(void *context)
+{
+ udelay(10000);
+}
+static int diagnostic_usb4_credits(struct diagnostic_ring *ring)
+{
+ int ret;
+ puts("USB4-REMOTE-CREDITS BEGIN; buffer allocation query only\n");
+ ret=apple_nhi_m1_query(diagnostic_usb4_credit_read,diagnostic_usb4_credit_write,
+                      diagnostic_usb4_credit_wait,ring,0x33,0);
+ if (!ret) puts("USB4-REMOTE-CREDITS PASS; no path programming\n");
+ return ret;
+}
+
+/* Enable discovered USB4 adapters and enumerate PCIe; optionally boot EFI.
+ * Every returning path disables adapters and restores paths before reset.
+ */
+static int diagnostic_usb4_endpoint_scan(struct diagnostic_ring *ring, unsigned int mode)
+{
+ struct apple_usb4_snapshot *s=&ring->usb4_snapshot;
+ const unsigned int order[2]={3,0};
+ u32 original[2],value;
+ unsigned int k,i,done=0;
+ int ret,cleanup=0;
+ for(k=0;k<2;k++) {
+  i=order[k];
+  ret=diagnostic_xfer(ring,s->port[i],1,s->cap[i],1,&original[k],USB4_CFG_READ,i?1:0);
+  if(ret)return ret;
+  if((original[k]&(1U<<31)) || ((original[k]>>25)&15))return -EBUSY;
+ }
+ for(k=0;k<2;k++) {
+  i=order[k];value=original[k]|(1U<<31);done=k+1;
+  ret=diagnostic_xfer(ring,s->port[i],1,s->cap[i],1,&value,USB4_CFG_WRITE,i?1:0);
+  if(ret)goto stop;
+  ret=diagnostic_xfer(ring,s->port[i],1,s->cap[i],1,&value,USB4_CFG_READ,i?1:0);
+  if(ret)goto stop;
+  if(!(value&(1U<<31))){ret=-EIO;goto stop;}
+  printf("USB4-PCIE ENABLE route=%u port=%u value=%08x\n",i?1:0,s->port[i],value);
+ }
+ ret=apple_pciec_m1_start_link();
+ if(!ret)ret=apple_pciec_m1_scan();
+ if(!ret && mode==15)ret=apple_pciec_m1_nvme_read();
+stop:
+ while(done) {
+  k=--done;i=order[k];
+  value=original[k]&~(1U<<31);
+  int e=diagnostic_xfer(ring,s->port[i],1,s->cap[i],1,&value,USB4_CFG_WRITE,i?1:0);
+  if(!e)e=diagnostic_xfer(ring,s->port[i],1,s->cap[i],1,&value,USB4_CFG_READ,i?1:0);
+  if(!e&&(value&(1U<<31)))e=-EIO;
+  if(e&&!cleanup)cleanup=e;
+ }
+ printf("USB4-PCIE DISABLE result=%d scan/read-result=%d; no SSD writes\n",cleanup,ret);
+ return ret?ret:cleanup;
+}
+
+static int diagnostic_usb4_paths(struct diagnostic_ring *ring, unsigned int scan)
+{
+ struct apple_usb4_snapshot *s=&ring->usb4_snapshot;
+ u32 limits[2]={0},metadata,data[16],next[4][2],current[2];
+ unsigned int r,i,j,done=0;
+ int ret,cleanup=0;
+ if(!s->valid)return -EPERM;
+ /* Refresh host query after DP resource queries, then read both router results. */
+ ret=diagnostic_query(ring,0x33,0);if(ret)return ret;
+ for(r=0;r<2;r++) {
+  ret=diagnostic_xfer(ring,0,2,0x19,1,&metadata,USB4_CFG_READ,r);if(ret)return ret;
+  if(!(metadata&255)||(metadata&255)>16)return -EPROTO;
+  ret=diagnostic_xfer(ring,0,2,9,16,data,USB4_CFG_READ,r);if(ret)return ret;
+  for(j=0;j<(metadata&255);j++)if((data[j]&65535)==4) {
+   if(limits[r])return -EPROTO;
+   limits[r]=data[j]>>16;
+  }
+ }
+ ret=apple_nhi_m1_usb4_path_plan(s,limits,next);if(ret)return ret;
+ printf("USB4-PATHS limits=%u,%u; single-tunnel lane allocation=6,6\n",limits[0],limits[1]);
+ for(i=0;i<4;i++) {
+  r=i>=2;
+  ret=diagnostic_xfer(ring,s->port[i],0,16,2,current,USB4_CFG_READ,r);if(ret)goto restore;
+  if(current[0]!=s->old[i][0] || current[1]!=s->old[i][1]){ret=-EBUSY;goto restore;}
+  done=i+1; /* Also restore after an uncertain write completion. */
+  ret=diagnostic_xfer(ring,s->port[i],0,16,2,next[i],USB4_CFG_WRITE,r);if(ret)goto restore;
+  ret=diagnostic_xfer(ring,s->port[i],0,16,2,current,USB4_CFG_READ,r);if(ret)goto restore;
+  printf("USB4-PATHS route=%u port=%u written=%08x %08x read=%08x %08x\n",r,s->port[i],next[i][0],next[i][1],current[0],current[1]);
+  if(current[0]!=next[i][0] || (current[1]&~(1U<<28))!=next[i][1]){ret=-EIO;goto restore;}
+ }
+ puts("USB4-PATHS PROGRAM PASS; PCIe protocol adapters remain disabled\n");
+ if(scan)ret=diagnostic_usb4_endpoint_scan(ring,scan);
+restore:
+ while(done) {
+  i=--done;r=i>=2;
+  int e=diagnostic_xfer(ring,s->port[i],0,16,2,s->old[i],USB4_CFG_WRITE,r);
+  if(!e)e=diagnostic_xfer(ring,s->port[i],0,16,2,current,USB4_CFG_READ,r);
