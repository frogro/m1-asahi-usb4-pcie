+static int do_tbboot(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+ char *check[] = { "atcm1", "1", "check" };
+ char *start[] = { "atcm1", "1", "tbtpciec" };
+ if (argc != 1) return CMD_RET_USAGE;
+ /* No link / USB-only cable: no PHY writes were made. Standard internal and
+  * USB bootflow remains usable. TB3 setup errors after writes require reset,
+  * so a partially live controller is never handed to an OS as a fallback. */
+ if (do_atcm1(cmdtp, flag, 3, check)) {
+  puts("TB: no supported external link; continuing standard bootflow\n");
+  return run_command("bootflow scan -lb", 0);
+ }
+ do_atcm1(cmdtp, flag, 3, start);
+ puts("TB boot returned; resetting before fallback to the default Apple OS\n");
+ return run_command("reset", 0);
+}
+U_BOOT_CMD(tbboot, 1, 0, do_tbboot,
+           "boot a Thunderbolt EFI system or scan internal/USB media", "");
