+ printf("TB-DART empty preflight ret=%d residual-address-words=%u tcr0=%#x ttbr0=%#x\n",ret,residual,tcr[0],ttbr[0]);
+ if(ret)return ret;
+ ret = lists_bind_fdt(gd->dm_root,node,&dart,lists_driver_lookup_name("apple_dart"),false);
+ if (ret || !dart) return ret ? ret : -ENODEV;
+ ret = device_probe(dart); if (ret) return ret;
+ ret = apple_dart_limit_stream(dart, 0); if (ret) return ret;
+ tb.dart = dart; tb.ops = device_get_ops(dart);
+ tb.arena = memalign(TB_PAGE, TB_ARENA); if (!tb.arena) return -ENOMEM;
+ memset(tb.arena,0,TB_ARENA); flush_dcache_range((ulong)tb.arena,(ulong)tb.arena+TB_ARENA);
