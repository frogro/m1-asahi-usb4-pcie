 #include <linux/string.h>
@@ -22,8 +23,18 @@ static int read_block(apple_cd321x_read read, void *ctx, u8 reg,
 	if (ret)
 		return ret;
 	/* Unknown layouts must not become lane or cable configuration. */
-	if (buf[0] != size)
