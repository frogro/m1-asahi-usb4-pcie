+ ret=tb_linux_fdt((void*)dest,gd->fdt_blob,0x200000);
+ if(ret){printf("TB-BOOT FDT ret=%d\n",ret);return CMD_RET_FAILURE;}
+ ret=env_set("bootargs","root=UUID=1d4d5fd6-ea8a-4bb0-bf3c-2fc1f9e65935 rootwait rw console=tty0 console=ttySAC0,115200n8 earlycon loglevel=7 panic=20 rd.retry=60 rd.timeout=90 rd.shell=0 rd.emergency=reboot maxcpus=1 systemd.unit=multi-user.target pcie_apple_pciec.pciec_topology_events=1 pcie_apple_pciec.pciec_reset_ack_clear=0 pci=hpbussize=16,hpmmiosize=32M,hpmmioprefsize=512M,realloc=on");
+ if(ret)return CMD_RET_FAILURE;
