+DECLARE_GLOBAL_DATA_PTR;
+
+#define NODE "/soc/pcie@530000000"
+static struct pciec_m1_config config;
+static void *base[PCIEC_M1_GROUPS];
+static bool checked, used;
+static unsigned int mmio_reads, mmio_writes;
+static const char *const names[] = { "debug", "fabric", "port0", "oe-fabric", "config" };
+static const char *const props[] = { "apple,tunable-debug", "apple,tunable-fabric", "apple,tunable", "apple,tunable-oe-fabric", "apple,tunable-rc" };
+/* Separate diagnostic namespace: the boot stage may append apple,* properties.
+ * Only absent generated properties use these saved, exact-validated values.
+ * A present but malformed/different generated property must still fail. */
+static const char *const reference_props[] = {
+ "u-boot,probe-pciec-debug", "u-boot,probe-pciec-fabric",
+ "u-boot,probe-pciec-port0", "u-boot,probe-pciec-oe-fabric",
+ "u-boot,probe-pciec-config"
+};
+static const u64 addresses[] = { 0x520200000, 0x520004000, 0x521000000, 0x520008000, 0x530000000 };
+static const u32 sizes[] = { 0x4000, 0x4000, 0x8000, 0x4000, 0x10000 };
+
+int apple_pciec_m1_check(void)
+{
+ ofnode node = ofnode_path(NODE), port = ofnode_path(NODE "/pci@0,0");
+ struct pciec_m1_config candidate = {};
+ struct resource resource;
+ unsigned int g, i, count;
+ const u8 *data;
+ const struct pciec_m1_tunable *ref;
+ int len, ret;
+ if (used) return -EALREADY;
+ checked = false;
+ if (!ofnode_device_is_compatible(ofnode_root(), "apple,j274") ||
+     !ofnode_device_is_compatible(node, "apple,t8103-pciec") ||
+     !ofnode_valid(port) || ofnode_is_enabled(node) || ofnode_is_enabled(port)) {
+  puts("PCIEC-M1 preflight rejected: incompatible or enabled controller/port\n");
+  return -ENODEV;
+ }
+ for (g = 0; g < PCIEC_M1_GROUPS; g++) {
+  ret = ofnode_read_resource_byname(node, names[g], &resource);
+  if (ret) {
+   printf("PCIEC-M1 resource %s lookup failed ret=%d\n", names[g], ret);
+   return ret;
+  }
+  printf("PCIEC-M1 resource %s start=%#llx size=%#llx\n", names[g],
+         (unsigned long long)resource.start, (unsigned long long)resource_size(&resource));
+  if (resource.start != addresses[g] ||
+      resource_size(&resource) != (g == PCIEC_CONFIG ? 0x10000000 : sizes[g])) {
+   puts("PCIEC-M1 preflight rejected: resource mismatch\n");
+   return -ERANGE;
+  }
+  data = ofnode_get_property(g == PCIEC_PORT ? port : node, props[g], &len);
+  if (!data) {
+   printf("PCIEC-M1 generated %s absent; checking saved Linux reference %s\n",
+          props[g], reference_props[g]);
+   data = ofnode_get_property(ofnode_path("/config"), reference_props[g], &len);
+  } else {
+   printf("PCIEC-M1 using generated %s\n", props[g]);
+  }
+  ref = pciec_m1_reference(g, &count);
+  printf("PCIEC-M1 property %s present=%u len=%d expected=%u\n",
+         props[g], !!data, len, count * 12);
+  if (!data || len != count * 12) {
+   puts("PCIEC-M1 preflight rejected: missing property or length mismatch\n");
+   return -EINVAL;
+  }
+  candidate.count[g] = count;
+  for (i = 0; i < count; i++) {
+   candidate.group[g][i].offset = get_unaligned_be32(data + 12*i);
+   candidate.group[g][i].mask = get_unaligned_be32(data + 12*i + 4);
+   candidate.group[g][i].value = get_unaligned_be32(data + 12*i + 8);
+   if (candidate.group[g][i].offset != ref[i].offset ||
+       candidate.group[g][i].mask != ref[i].mask ||
+       candidate.group[g][i].value != ref[i].value)
+    printf("PCIEC-M1 mismatch %s[%u] actual=%#x/%#x/%#x expected=%#x/%#x/%#x\n",
+           props[g], i, candidate.group[g][i].offset,
+           candidate.group[g][i].mask, candidate.group[g][i].value,
+           ref[i].offset, ref[i].mask, ref[i].value);
+  }
+ }
+ ret = pciec_m1_validate(&candidate);
+ if (ret) {
+  printf("PCIEC-M1 preflight rejected: exact-reference validation ret=%d\n", ret);
+  return ret;
+ }
+ config = candidate;
+ for (g = 0; g < PCIEC_M1_GROUPS; g++) base[g] = map_sysmem(addresses[g], sizes[g]);
+ checked = true;
+ puts("PCIEC-M1 preflight PASS: 5 fixed resources, 43 exact Linux tunables; no MMIO\n");
+ return 0;
+}
+
+static int hw_read(void *ctx, unsigned int region, u32 offset, u32 *value)
+{
+ if (region >= PCIEC_M1_GROUPS || offset % 4 || offset > sizes[region] - 4) return -ERANGE;
+ *value = readl(base[region] + offset);
+ mmio_reads++;
+ mb(); asm volatile("isb" ::: "memory");
+ return 0;
+}
+static int hw_write(void *ctx, unsigned int region, u32 offset, u32 value)
+{
+ if (region >= PCIEC_M1_GROUPS || offset % 4 || offset > sizes[region] - 4) return -ERANGE;
+ writel(value, base[region] + offset);
+ mmio_writes++;
+ mb(); asm volatile("isb" ::: "memory");
+ return 0;
+}
+static void hw_delay(void *ctx, unsigned int us) { udelay(us); }
+static const struct pciec_m1_io io = { hw_read, hw_write, hw_delay };
+
+int apple_pciec_m1_prepare(void *unused)
+{
+ static const u32 domains[] = { 0x448, 0x450, 0x458, 0x460, 0x468 };
+ u32 status = 0, pd;
+ unsigned int i;
+ int ret;
+ if (!checked || used) return -EPERM;
+ /* ACIO's existing reset-before-power has already run. Do not access a
+  * native controller register before all shared power domains are live. */
+ for (i = 0; i < ARRAY_SIZE(domains); i++) {
+  pd = readl(map_sysmem(0x23b700000ULL + domains[i], 4));
+  if ((pd & 0xff) != 0xff || (pd & (BIT(31) | BIT(10)))) return -EIO;
+ }
+ used = true;
+ mmio_reads = mmio_writes = 0;
+ apple_boot_trace("pciec-cold-prepare-begin");
+ ret = pciec_m1_prepare(&config, &io, NULL, &status);
+ apple_boot_trace("pciec-cold-prepare-return");
+ printf("PCIEC-M1 cold prepare ret=%d ready=%#x reads=%u writes=%u; no native DART access, PCI scan or DMA\n", ret, status, mmio_reads, mmio_writes);
+ if (!ret) puts("PCIEC-PREPARE PASS\n");
+ /* Never attempt partial rollback: retain powered state until mandatory reset. */
+ return ret;
+}
+
+static bool stable_link;
+static int link_service_error;
+static int link_read(void *ctx, unsigned int region, u32 offset, u32 *value)
+{
+ if (link_service_error) return link_service_error;
+ return hw_read(ctx, region, offset, value);
+}
+static void link_delay(void *ctx, unsigned int us)
+{
+ if (!link_service_error) link_service_error = apple_acio_m1_service();
+ udelay(us);
+}
+
+int apple_pciec_m1_start_link(void)
+{
+ const struct pciec_m1_io link_io = { link_read, hw_write, link_delay };
+ u32 status = 0, tunnel = 0, irq = 0, ltssm = 0;
+ int ret;
+ if (!checked || !used) return -EPERM;
+ link_service_error = 0;
+ ret = pciec_m1_start_link(&link_io, NULL, &status);
+ hw_read(NULL, PCIEC_PORT, 0x98c, &tunnel);
+ hw_read(NULL, PCIEC_PORT, 0x100, &irq);
+ hw_read(NULL, PCIEC_PORT, 0x80, &ltssm);
+ printf("PCIEC-LINK ret=%d link=%#x tunnel=%#x irq=%#x ltssm=%#x; no endpoint config or DMA\n",
+        ret, status, tunnel, irq, ltssm);
+ if (!ret) { stable_link = true; puts("PCIEC-LINK PASS\n"); }
+ return ret;
+}
+
+static struct pciec_scan topology;
+static unsigned int ecam_ops;
+static int ecam_guard(unsigned int region, u32 offset)
+{
+ u32 status;
+ if (!stable_link || region != PCIEC_CONFIG || offset % 4 || offset >= 0x1000000 || ++ecam_ops > 8192) return -ERANGE;
+ if (apple_acio_m1_service()) return -EIO;
+ hw_read(NULL, PCIEC_PORT, 0x208, &status);
+ if (status == ~0U || !(status & 1)) return -ENOLINK;
+ return 0;
+}
+static int ecam_read(void *ctx, unsigned int region, u32 offset, u32 *value)
+{
+ int ret = ecam_guard(region, offset); if (ret) return ret;
+ *value = readl(map_sysmem(0x530000000ULL + offset, 4));
+ mb(); asm volatile("isb" ::: "memory"); return 0;
+}
+static int ecam_write(void *ctx, unsigned int region, u32 offset, u32 value)
+{
+ int ret = ecam_guard(region, offset); if (ret) return ret;
+ if ((offset & 0xfff) != 0x18) return -EPERM;
+ writel(value, map_sysmem(0x530000000ULL + offset, 4));
+ mb(); asm volatile("isb" ::: "memory"); return 0;
+}
+int apple_pciec_m1_scan(void)
+{
+ const struct pciec_m1_io scan_io = { ecam_read, ecam_write, link_delay };
+ int ret; unsigned int i, nvme = 0;
+ if (!checked || !used || !stable_link) return -EPERM;
+ ecam_ops = 0;
+ ret = pciec_m1_scan(&scan_io, NULL, &topology);
+ for (i = 0; i < topology.count; i++) {
+  struct pciec_scan_entry *e = &topology.entry[i];
+  printf("PCIEC-BDF %02x:%02x.%x id=%08x class=%08x hdr=%08x cmd=%08x secondary=%u\n",
+   e->bdf >> 8, (e->bdf >> 3) & 31, e->bdf & 7, e->id, e->class_rev, e->header, e->command, e->secondary);
+  if (e->class_rev >> 8 == 0x010802) nvme++;
+ }
+ printf("PCIEC-SCAN ret=%d entries=%u nvme=%u config-ops=%u; no endpoint DMA or disk IO\n",ret,topology.count,nvme,ecam_ops);
+ if (!ret && nvme) puts("PCIEC-NVME-DISCOVERY PASS\n");
+ return ret;
+}
+
+/* Read-only bounded NVMe experiment. Queue/command formats follow the existing
+ * U-Boot NVMe driver (NXP Semiconductors, Bin Meng, GPL-2.0+). All DMA is confined
+ * to a five-page DART mapping; arbitrary buffers are copied through page four.
+ * No write, format, sanitize, firmware or persistent-feature command exists. */
+#define TB_PAGE 0x4000
+#define TB_ARENA (5 * TB_PAGE)
+#define TB_DEPTH 16
+struct tb_queue { unsigned tail, head, phase; u16 cid; };
+static struct {
+ struct udevice *dart, *blk;
+ const struct iommu_ops *ops;
+ u8 *arena;
+ dma_addr_t dva;
+ void *bar, *dart_regs;
+ u32 bdf, stride, original_cmd;
+ u64 sectors;
+ unsigned blksz;
+ struct tb_queue q[2];
+ bool live, dma, failed, files_loaded, boot_ready;
+} tb;
+
+static int tb_health(void)
+{
+ u32 link;
+ int ret = apple_acio_m1_service(); if (ret) return ret;
+ hw_read(NULL, PCIEC_PORT, 0x208, &link);
+ if (link == ~0U || !(link & 1)) return -ENOLINK;
+ if (tb.dart_regs && (readl(tb.dart_regs + 0x40) & BIT(31))) return -EFAULT;
+ return tb.failed ? -EIO : 0;
+}
+static int tb_cfg_write(u32 bdf, u32 reg, u32 val)
+{
+ int ret = ecam_guard(PCIEC_CONFIG, (bdf << 12) + reg);
+ if (ret) return ret;
+ if (reg != 4 && reg != 0x10 && reg != 0x14 && reg != 0x20) return -EPERM;
+ writel(val, map_sysmem(0x530000000ULL + (bdf << 12) + reg, 4)); mb();
+ return 0;
+}
+static int tb_wait_ready(bool ready)
+{
+ unsigned i; int ret; u32 val;
+ for (i = 0; i < 2000; i++) {
+  ret = tb_health(); if (ret && !(tb.failed && ret == -EIO)) return ret;
+  val = readl(tb.bar + 0x1c);
+  if (val == ~0U || (val & 2)) return -EIO;
+  if (!!(val & 1) == ready) return 0;
+  udelay(1000);
+ }
+ return -ETIMEDOUT;
+}
+static int tb_command(unsigned qid, struct nvme_command *cmd, u32 *result)
+{
+ struct tb_queue *q; struct nvme_completion *cq; struct nvme_command *sq;
+ u16 status, cid; ulong start; int ret;
+ if (qid > 1 || !tb.live || tb.failed) return -EPERM;
+ /* Explicit opcode whitelist. Data commands are read-only. */
+ if ((!qid && cmd->common.opcode != nvme_admin_identify &&
+      cmd->common.opcode != nvme_admin_create_cq && cmd->common.opcode != nvme_admin_create_sq) ||
+     (qid && cmd->common.opcode != nvme_cmd_read)) return -EPERM;
+ ret = tb_health(); if (ret) return ret;
+ q = &tb.q[qid]; sq = (void *)(tb.arena + qid * 2 * TB_PAGE);
+ cq = (void *)(tb.arena + (qid * 2 + 1) * TB_PAGE);
+ cid = ++q->cid; cmd->common.command_id = cpu_to_le16(cid);
+ sq[q->tail] = *cmd;
+ flush_dcache_range((ulong)sq, (ulong)sq + TB_PAGE);
+ flush_dcache_range((ulong)tb.arena + 4 * TB_PAGE, (ulong)tb.arena + TB_ARENA);
+ mb(); q->tail = (q->tail + 1) % TB_DEPTH;
+ writel(q->tail, tb.bar + 0x1000 + qid * 2 * tb.stride);
+ start = get_timer(0);
+ do {
+  ret = tb_health(); if (ret) goto failed;
+  invalidate_dcache_range((ulong)cq, (ulong)cq + TB_PAGE); mb();
+  status = le16_to_cpu(cq[q->head].status);
+  if ((status & 1) == q->phase) {
+   if (le16_to_cpu(cq[q->head].command_id) != cid || le16_to_cpu(cq[q->head].sq_id) != qid) { ret = -EPROTO; goto failed; }
+   if (result) *result = le32_to_cpu(cq[q->head].result);
+   q->head++; if (q->head == TB_DEPTH) { q->head = 0; q->phase ^= 1; }
+   writel(q->head, tb.bar + 0x1000 + (qid * 2 + 1) * tb.stride);
+   invalidate_dcache_range((ulong)tb.arena + 4 * TB_PAGE, (ulong)tb.arena + TB_ARENA);
+   if (status >> 1) { printf("TB-NVME completion q=%u op=%u status=%#x\n",qid,cmd->common.opcode,status); ret = -EIO; goto failed; }
+   return 0;
+  }
+  udelay(10);
+ } while (get_timer(start) < 2000);
+ ret = -ETIMEDOUT;
+failed:
+ tb.failed = true;
+ printf("TB-NVME command failed q=%u op=%u cid=%u ret=%d\n",qid,cmd->common.opcode,cid,ret);
+ return ret;
+}
+static int tb_read_chunk(u64 start, unsigned count, void *dest)
+{
+ struct nvme_command cmd = {}; int ret;
+ if (!count || !tb.blksz || count > 4096 / tb.blksz || start >= tb.sectors || count > tb.sectors - start) return -ERANGE;
+ cmd.rw.opcode = nvme_cmd_read; cmd.rw.nsid = cpu_to_le32(1);
+ cmd.rw.prp1 = cpu_to_le64(tb.dva + 4 * TB_PAGE);
+ cmd.rw.slba = cpu_to_le64(start); cmd.rw.length = cpu_to_le16(count - 1);
+ ret = tb_command(1, &cmd, NULL);
+ if (!ret) memcpy(dest, tb.arena + 4 * TB_PAGE, count * tb.blksz);
+ return ret;
+}
+
+static ulong tb_blk_read(struct udevice *dev, lbaint_t start, lbaint_t count, void *buf)
+{
+ lbaint_t done=0; unsigned chunk; int ret;
+ if (!tb.live || tb.failed || !count || start>=tb.sectors || count>tb.sectors-start) return 0;
+ while(done<count) {
+  chunk=min_t(lbaint_t,count-done,4096/tb.blksz);
+  ret=tb_read_chunk(start+done,chunk,(u8*)buf+done*tb.blksz);
+  if(ret){printf("TB-NVME read LBA=%llu ret=%d\n",(unsigned long long)(start+done),ret);break;}
+  done+=chunk; schedule();
+ }
+ return done;
+}
+static const struct blk_ops tb_blk_ops={.read=tb_blk_read};
+U_BOOT_DRIVER(tb_nvme_readonly)={.name="tb-nvme-readonly",.id=UCLASS_BLK,.ops=&tb_blk_ops};
+static int tb_fs_open(unsigned part)
+{
+ /* This diagnostic block device has no generic PCI/NVMe parent. Use its
+  * verified descriptor directly, rather than the interface-name lookup. */
+ struct blk_desc *desc=dev_get_uclass_plat(tb.blk);
+ return fs_set_blk_dev_with_part(desc,part);
+}
+static int tb_load_boot(const char *name, const char *address, ulong limit,
+                       const char *size_env, const char *known_hash)
+{
+ loff_t size,actual; ulong dest=env_get_hex(address,0); int ret;
+ u8 digest[32]; char printed[65]; unsigned i;
+ ret=tb_fs_open(2);if(ret)return ret;
+ ret=fs_size(name,&size);fs_close();
+ if(ret||size<=0||size>limit||!dest) return -ERANGE;
+ ret=tb_fs_open(2);if(ret)return ret;
+ ret=fs_read(name,dest,0,size,&actual);fs_close();
+ if(ret||actual!=size)return -EIO;
+ sha256_csum_wd((void*)dest,size,digest,CHUNKSZ_SHA256);
+ for(i=0;i<32;i++)sprintf(printed+2*i,"%02x",digest[i]);
+ printf("TB-BOOT-FILE %s bytes=%llu addr=%lx sha256=%s expected-match=%u\n",name,(unsigned long long)size,dest,printed,!strcmp(printed,known_hash));
+ env_set_hex(size_env,size);
+ return strcmp(printed,known_hash)?-EBADMSG:0;
+}
+
+/* Exercise the real EFI protocols while the diagnostic tunnel is still live.
+ * Explicit opt-in, known disk UUIDs checked by tb_files(), no EFI app executed.
+ * The no-store build and read-only block operations forbid persistent writes.
+ */
+static int tb_efi_read_probe(void)
+{
+ struct udevice *child, *esp = NULL;
+ struct efi_handler *handler;
+ struct efi_block_io *bio;
+ struct efi_simple_file_system_protocol *fs;
+ struct efi_file_handle *root = NULL, *file = NULL;
+ efi_handle_t handle;
+ efi_status_t status, closing;
+ struct disk_part *part;
+ u8 *buffer = NULL, digest[32];
+ char printed[65];
+ loff_t size;
+ efi_uintn_t count;
+ ulong begin;
+ unsigned i, total = 0;
+ int ret = -EIO;
+ const char *known = "e9c439d22305d4962befc73ba0b2dbb6bef0cd7113399765ae9bc302bd3d269f";
+
+ env_set("probe_efi", "FAIL");
+ if (!IS_ENABLED(CONFIG_EFI_VARIABLE_NO_STORE) ||
+     IS_ENABLED(CONFIG_EFI_VARIABLE_FILE_STORE) ||
+     !tb.live || !tb.dma || tb.failed || !tb.files_loaded)
+  return -EPERM;
+ /* Determine the expected size through the already verified block path. */
+ if (tb_fs_open(1)) return -ENODEV;
+ ret = fs_size("/EFI/BOOT/BOOTAA64.EFI", &size); fs_close();
+ if (ret || size < 1 || size > 8 * 1024 * 1024) return -ERANGE;
+ buffer = memalign(4096, ALIGN(size + 1, 4096));
+ if (!buffer) return -ENOMEM;
+ memset(buffer, 0, 4096);
+ ret = -EIO;
+ begin = get_timer(0);
+ status = efi_init_obj_list();
+ printf("TB-EFI init status=%lx elapsed=%lums\n", status, get_timer(begin));
+ if (status != EFI_SUCCESS) goto out;
+ if (dev_tag_get_ptr(tb.blk, DM_TAG_EFI, (void **)&handle)) goto out;
+ status = efi_search_protocol(handle, &efi_block_io_guid, &handler);
+ if (status != EFI_SUCCESS) goto out;
+ bio = handler->protocol_interface;
+ if (!bio || !bio->media || bio->media->block_size != tb.blksz ||
+     bio->media->last_block != tb.sectors - 1) goto out;
+ bio->media->read_only = true;
+ status = EFI_CALL(bio->read_blocks(bio, bio->media->media_id, 1, tb.blksz, buffer));
+ printf("TB-EFI raw-GPT status=%lx signature=%.8s\n", status, buffer);
+ if (status != EFI_SUCCESS || memcmp(buffer, "EFI PART", 8)) goto out;
+ device_foreach_child(child, tb.blk) {
+  if (device_get_uclass_id(child) != UCLASS_PARTITION) continue;
+  part = dev_get_uclass_plat(child);
+  if (part->partnum == 1) {
+   if (esp) goto out;
+   esp = child;
+  }
+ }
+ if (!esp || dev_tag_get_ptr(esp, DM_TAG_EFI, (void **)&handle)) goto out;
+ status = efi_search_protocol(handle, &efi_simple_file_system_protocol_guid, &handler);
+ if (status != EFI_SUCCESS) goto out;
+ fs = handler->protocol_interface;
+ status = EFI_CALL(fs->open_volume(fs, &root));
+ printf("TB-EFI open-volume status=%lx\n", status);
+ if (status != EFI_SUCCESS || !root) goto out;
+ status = EFI_CALL(root->open(root, &file, u"\\EFI\\BOOT\\BOOTAA64.EFI", EFI_FILE_MODE_READ, 0));
+ printf("TB-EFI open-file status=%lx bytes=%llu\n", status, (unsigned long long)size);
+ if (status != EFI_SUCCESS || !file) goto out;
+ while (total < size) {
+  if (get_timer(begin) > 30000 || tb_health()) { ret = -ETIMEDOUT; goto out; }
+  count = min_t(efi_uintn_t, 65536, size - total);
+  status = EFI_CALL(file->read(file, &count, buffer + total));
+  if (status != EFI_SUCCESS || !count || count > size - total) goto out;
+  total += count;
+ }
+ count = 1;
+ status = EFI_CALL(file->read(file, &count, buffer + total));
+ if (status != EFI_SUCCESS || count) goto out;
+ sha256_csum_wd(buffer, total, digest, CHUNKSZ_SHA256);
+ for (i = 0; i < 32; i++) sprintf(printed + 2 * i, "%02x", digest[i]);
+ printf("TB-EFI FILE bytes=%u sha256=%s expected-match=%u elapsed=%lums\n",
+        total, printed, !strcmp(printed, known), get_timer(begin));
+ ret = strcmp(printed, known) ? -EBADMSG : 0;
+out:
+ if (file) {
+  closing = EFI_CALL(file->close(file));
+  if (closing != EFI_SUCCESS && !ret) ret = -EIO;
+ }
+ if (root) {
+  closing = EFI_CALL(root->close(root));
+  if (closing != EFI_SUCCESS && !ret) ret = -EIO;
+ }
+ free(buffer);
+ if (!ret) { env_set("probe_efi", "PASS"); puts("TB-EFI-READ PASS; real BlockIO and File protocols; no EFI image executed\n"); }
+ else printf("TB-EFI-READ FAIL ret=%d\n", ret);
+ return ret;
+}
