+static int tb_quiesce(void)
+{
+ int ret = 0, cfgret;
+ if (tb.live) {
+  ret = tb_health();
+  if (!ret || (tb.failed && ret == -EIO)) {
+   writel(0, tb.bar + 0x14); mb(); ret = tb_wait_ready(false);
+  }
+ }
+ cfgret = tb_cfg_write(tb.bdf, 4, tb.original_cmd & ~7U);
+ tb.live = false;
+ if (!ret) ret = cfgret;
+ if (!ret && tb.dma) {
+  tb.ops->unmap(tb.dart, tb.dva, TB_ARENA);
+  ret = apple_dart_get_error(tb.dart);
+  if (!ret) { tb.dma = false; hw_write(NULL, PCIEC_PORT, 0x828, 0); }
+ }
+ /* Retain memory and tables until full reset even after a successful stop. */
+ printf("TB-NVME STOP ret=%d dma-mapping-retained=%u\n",ret,tb.dma);
+ return ret;
+}
+static int tb_empty_dart(const u32 tcr[64], const u32 ttbr[256], const u32 rid[64], u32 tlb)
+{
+ unsigned i;
+ if (tlb == ~0U || (tlb & BIT(2))) return -EBUSY;
+ for (i=0;i<64;i++) if ((tcr[i] && tcr[i]!=0x80080) || rid[i]) return -EBUSY;
+ /* T8020 TTBR validity is bit31, not whether residual address bits are zero.
+  * Same rule as Linux and the already tested NHI DART preflight. */
+ for (i=0;i<256;i++) if (ttbr[i]&BIT(31)) return -EBUSY;
+ return 0;
+}
