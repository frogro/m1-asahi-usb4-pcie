+/* An unchanged calibration register must never be written, while a changed
+ * entry still applies exactly once. Use an offset untouched by the sequence.
+ */
+static int dm_test_atc_m1_unchanged_calibration(struct unit_test_state *uts)
+{
+	struct atc_m1_config c;
+	__be32 calibration[] = { cpu_to_be32(0x40000), cpu_to_be32(~0U), 0 };
+	int changed, group, i, count;
+
+	for (changed = 0; changed < 2; changed++) {
+		c = setup();
+		calibration[2] = cpu_to_be32(changed ? 0x12345678 : 0xa5a5a5a5);
+		for (group = 0; group < 5; group++)
+			if (group != 1)
+				c.tunable[group] = (struct atc_m1_tunable){calibration, sizeof(calibration)};
+		ut_assertok(atc_m1_start(&c, &fake_io, &fake, true, &fake.stage));
+		count = 0;
+		for (i = 0; i < fake.writes; i++)
+			if (fake.trace[i].region == ATC_CORE && fake.trace[i].offset == 0x40000)
+				count++;
+		ut_asserteq(changed, count);
+		ut_asserteq(changed ? 0x12345678 : 0xa5a5a5a5,
+			    fake.reg[ATC_CORE][0x40000 / 4]);
+	}
+	return 0;
+}
+DM_TEST(dm_test_atc_m1_unchanged_calibration, 0);
