+ ret = apple_dart_get_error(dart); if (ret) return ret;
+ if (!tb.dva || tb.dva % TB_PAGE || tb.dva > 0x100000000ULL - TB_ARENA) return -ERANGE;
+ tb.dma = true;
+ ret = hw_write(NULL,PCIEC_PORT,0x828,BIT(31)|tb.bdf); if (ret) return ret;
+ hw_read(NULL,PCIEC_PORT,0x828,&value); if (value != (BIT(31)|tb.bdf)) return -EIO;
+ printf("TB-NVME DART stream0 RID=%#x arena=%#llx size=%#x; other streams disabled\n",tb.bdf,(unsigned long long)tb.dva,TB_ARENA);
+ return 0;
+}
