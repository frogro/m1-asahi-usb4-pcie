+/* Run a fixed, RAM-supplied GRUB script that reads known files then exits.
+ * This is deliberately not the installed GRUB configuration or an OS handoff.
+ */
+static int tb_grub_read_probe(void)
+{
+ const void *payload;
+ void *image;
+ u8 digest[32], sector[4096];
+ char printed[65], command[128];
+ int length, ret;
+ unsigned i;
+ if (!IS_ENABLED(CONFIG_EFI_VARIABLE_NO_STORE) || !tb.live || !tb.dma ||
+     tb.failed || !tb.files_loaded) return -EPERM;
+ payload = ofnode_get_property(ofnode_path("/config"), "u-boot,probe-grub-image", &length);
+ if (!payload || length != 782336) return -EINVAL;
+ sha256_csum_wd(payload, length, digest, CHUNKSZ_SHA256);
+ for (i = 0; i < 32; i++) sprintf(printed + i * 2, "%02x", digest[i]);
+ if (strcmp(printed, "9fc4474e8d230abcfa24c7dcf49721d230fbff99a97778568c3babfa9f32a561"))
+  return -EBADMSG;
+ image = memalign(4096, ALIGN(length, 4096));
+ if (!image) return -ENOMEM;
+ memcpy(image, payload, length);
+ snprintf(command, sizeof(command), "bootefi %lx:%x %lx", (ulong)image,
+          length, (ulong)gd->fdt_blob);
+ puts("TB-GRUB80 ENTER; fixed read-only script; tunnel remains live\n");
+ ret = run_command(command, 0);
+ printf("TB-GRUB80 RETURN command-status=%d; validate GRUB file hashes in UART\n", ret);
+ free(image);
+ if (ret) return -EIO;
+ ret = tb_read_chunk(1, 1, sector);
+ if (ret || memcmp(sector, "EFI PART", 8)) return ret ? ret : -EPROTO;
+ puts("TB-GRUB80 POST-READ PASS; NVMe remains readable after EFI return\n");
+ return 0;
+}
