+ for(i=0;i<ARRAY_SIZE(debug_port);i++){
+  node=fdt_path_offset(dest,debug_port[i]);if(node<0)return node;
+  ret=fdt_setprop_string(dest,node,"status","disabled");if(ret)return ret;
+ }
