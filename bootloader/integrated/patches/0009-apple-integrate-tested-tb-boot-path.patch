+ if (ret) return ret;
+ if (memcmp(buf, "APP ", 4)) return -EAGAIN;
+ ret = read_block(read, ctx, 0x1a, buf, 4);
+ if (ret) return ret;
+ result.status = get_unaligned_le32(buf);
+ ret = read_block(read, ctx, 0x3f, buf, 2);
+ if (ret) return ret;
+ result.power_status = get_unaligned_le16(buf);
+ ret = read_block(read, ctx, 0x20, buf, 1);
+ if (ret) return ret;
+ result.system_power_state = buf[0];
+ ret = read_block(read, ctx, 0x1a, buf, 4);
+ if (ret) return ret;
+ if (result.status != get_unaligned_le32(buf)) return -EAGAIN;
+ *power = result;
+ return 0;
+}
diff --git a/lib/apple_pciec_m1.c b/lib/apple_pciec_m1.c
new file mode 100644
index 00000000..d83748d3
--- /dev/null
+++ b/lib/apple_pciec_m1.c
@@ -0,0 +1,293 @@
+// SPDX-License-Identifier: GPL-2.0
+/* RAM-only T8103 PCIe-C cold preparation diagnostic.
+ * Derived from the project's tested Linux apple_pcie_tunnel_prepare() and
+ * the saved J274 Linux device-tree tunables. Original PCIe driver attribution:
+ * Copyright (C) 2021 Alyssa Rosenzweig <alyssa@rosenzweig.io>
+ * Copyright (C) 2021 Google LLC; Corellium LLC; Mark Kettenis
+ * Authors: Alyssa Rosenzweig and Marc Zyngier <maz@kernel.org>.
+ * This experiment does not enumerate PCI devices, enable DMA, or build tunnels.
+ */
+#include <apple_pciec_m1.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+
+static const struct pciec_m1_tunable group0[] = {
+ { 0x1000, 0x1, 0x0 },
+};
+static const struct pciec_m1_tunable group1[] = {
+ { 0x4, 0x1f001f, 0x180018 },
+ { 0x8, 0x1, 0x1 },
+ { 0xc, 0x1, 0x1 },
+ { 0x10, 0x801f, 0x4 },
+ { 0x18, 0x3ff, 0x280 },
+ { 0x44, 0x1, 0x1 },
+ { 0x94, 0x801f, 0x4 },
+ { 0x9c, 0x801f, 0x4 },
+ { 0x20, 0x801f, 0x4 },
+ { 0x28, 0x3f, 0x20 },
+ { 0x2c, 0x801f, 0x4 },
+ { 0x34, 0x3f, 0x20 },
+ { 0x38, 0x801f, 0x4 },
+ { 0x40, 0x10001, 0x10001 },
+ { 0x48, 0x1, 0x1 },
+ { 0x4c, 0x801f, 0x4 },
+ { 0x54, 0x7f007f, 0x4b004b },
+ { 0x58, 0x801f, 0x4 },
+ { 0x60, 0x801f, 0x4 },
+ { 0x68, 0x1, 0x1 },
+ { 0x6c, 0x801f, 0x4 },
+ { 0x74, 0x1, 0x1 },
+ { 0x78, 0x801f, 0x4 },
+ { 0x84, 0x801f, 0x4 },
+ { 0x8c, 0x1, 0x1 },
+ { 0x90, 0x1, 0x1 },
+ { 0xa4, 0x801f, 0x4 },
+};
+static const struct pciec_m1_tunable group2[] = {
+ { 0x140, 0x1, 0x1 },
+};
+static const struct pciec_m1_tunable group3[] = {
+ { 0x4, 0x70007, 0x40004 },
+ { 0x8, 0x1, 0x1 },
+ { 0xc, 0x1, 0x1 },
+ { 0x10, 0x801f, 0x4 },
+ { 0x18, 0x7f007f, 0x450045 },
+ { 0x1c, 0x801f, 0x4 },
+ { 0x24, 0x801f, 0x4 },
+ { 0x2c, 0x1, 0x1 },
+ { 0x30, 0x1, 0x1 },
+ { 0x34, 0x801f, 0x4 },
+};
+static const struct pciec_m1_tunable group4[] = {
+ { 0x718, 0x7c000, 0x0 },
+ { 0x8bc, 0x1, 0x0 },
+ { 0x78, 0x7000, 0x0 },
+ { 0x814, 0xffffffff, 0xf060 },
+};
+const struct pciec_m1_tunable *pciec_m1_reference(unsigned int group, unsigned int *count)
+{
+ if (!count) return NULL;
+ switch (group) {
+ case 0: *count = ARRAY_SIZE(group0); return group0;
+ case 1: *count = ARRAY_SIZE(group1); return group1;
+ case 2: *count = ARRAY_SIZE(group2); return group2;
+ case 3: *count = ARRAY_SIZE(group3); return group3;
+ case 4: *count = ARRAY_SIZE(group4); return group4;
+ default: *count = 0; return NULL;
+ }
+}
+
+int pciec_m1_validate(const struct pciec_m1_config *cfg)
+{
+ unsigned int g, count, i;
+ const struct pciec_m1_tunable *ref;
+ if (!cfg) return -EINVAL;
+ /* Diagnostic is intentionally limited to the saved machine's 43 entries.
+  * Do not accept arbitrary offsets merely because they fit an MMIO aperture. */
+ for (g = 0; g < PCIEC_M1_GROUPS; g++) {
+  ref = pciec_m1_reference(g, &count);
+  if (cfg->count[g] != count) return -EINVAL;
+  for (i = 0; i < count; i++)
+   if (cfg->group[g][i].offset != ref[i].offset ||
+       cfg->group[g][i].mask != ref[i].mask ||
+       cfg->group[g][i].value != ref[i].value) return -EINVAL;
+ }
+ return 0;
+}
+
+static const struct { u16 offset; u32 value; } cold_reset[] = {
+
+	{ 0x08c, 0x00000110 }, { 0x100, 0xffffffff },
+	{ 0x148, 0xffffffff }, { 0x210, 0xffffffff },
+	{ 0x080, 0x00000000 }, { 0x084, 0x00000000 },
+	{ 0x104, 0xffffffff }, { 0x124, 0x00000000 },
+	{ 0x128, 0x00000000 }, { 0x168, 0x00000000 },
+	{ 0x13c, 0x00000010 }, { 0x800, 0x00100100 },
+	{ 0x808, 0x00100045 }, { 0x810, 0x00000100 },
+	{ 0x814, 0x00000000 }, { 0x130, 0x00000000 },
+	{ 0x140, 0x00000010 }, { 0x144, 0x00253770 },
+	{ 0x21c, 0x00000000 }, { 0x81c, 0x00000000 },
+	{ 0x824, 0x00000000 },
+};
+
+static int apply(const struct pciec_m1_config *cfg, const struct pciec_m1_io *io,
+                 void *ctx, unsigned int group)
+{
+ unsigned int i;
+ u32 old, value;
+ int ret;
+ for (i = 0; i < cfg->count[group]; i++) {
+  const struct pciec_m1_tunable *t = &cfg->group[group][i];
+  ret = io->read(ctx, group, t->offset, &old);
+  if (ret) return ret;
+  value = (old & ~t->mask) | (t->value & t->mask);
+  if (value != old) {
+   ret = io->write(ctx, group, t->offset, value);
+   if (ret) return ret;
+  }
+ }
+ return 0;
+}
+
+static int rmw(const struct pciec_m1_io *io, void *ctx, u32 offset, u32 clear, u32 set)
+{
+ u32 value;
+ int ret = io->read(ctx, PCIEC_PORT, offset, &value);
+ if (ret) return ret;
+ return io->write(ctx, PCIEC_PORT, offset, (value & ~clear) | set);
+}
+
+int pciec_m1_prepare(const struct pciec_m1_config *cfg, const struct pciec_m1_io *io,
+                     void *ctx, u32 *last_status)
+{
+ unsigned int i;
+ u32 status;
+ int ret = pciec_m1_validate(cfg);
+ if (ret) return ret;
+ if (!io || !io->read || !io->write || !io->delay || !last_status) return -EINVAL;
+ ret = io->read(ctx, PCIEC_PORT, 0x804, &status);
+ if (ret) return ret;
+ *last_status = status;
+ if (status == ~0U) return -ENODEV;
+ /* Like Linux, never replay reset/tunables against an already-ready port. */
+ if (status & 1) return 0;
+ ret = apply(cfg, io, ctx, PCIEC_DEBUG);
+ if (ret) return ret;
+ ret = apply(cfg, io, ctx, PCIEC_FABRIC);
+ if (ret) return ret;
+ for (i = 0; i < ARRAY_SIZE(cold_reset); i++) {
+  ret = io->write(ctx, PCIEC_PORT, cold_reset[i].offset, cold_reset[i].value);
+  if (ret) return ret;
+ }
+ /* Clear requester-to-stream mappings; no endpoint DMA is authorized. */
+ for (i = 0; i < 64; i++) {
+  ret = io->write(ctx, PCIEC_PORT, 0x828 + 4*i, 0);
+  if (ret) return ret;
+ }
+ ret = apply(cfg, io, ctx, PCIEC_PORT);
+ if (ret) return ret;
+ ret = rmw(io, ctx, 0x814, 0, 1);
+ if (ret) return ret;
+ ret = rmw(io, ctx, 0x800, 0, 1);
+ if (ret) return ret;
+ ret = rmw(io, ctx, 0x800, 0x100, 0);
+ if (ret) return ret;
+ ret = apply(cfg, io, ctx, PCIEC_OE);
+ if (ret) return ret;
+ ret = apply(cfg, io, ctx, PCIEC_CONFIG);
+ if (ret) return ret;
+ ret = io->write(ctx, PCIEC_PORT, 0x4020, 3);
+ if (ret) return ret;
+ ret = io->write(ctx, PCIEC_PORT, 0x100, ~0U);
+ if (ret) return ret;
+ ret = io->write(ctx, PCIEC_PORT, 0x210, ~0U);
+ if (ret) return ret;
+ /* Same 10us/250ms bound as Linux, plus explicit all-ones rejection. */
+ for (i = 0; i < 25000; i++) {
+  ret = io->read(ctx, PCIEC_PORT, 0x804, &status);
+  if (ret) return ret;
+  *last_status = status;
+  if (status == ~0U) return -ENODEV;
+  if (status & 1) return 0;
+  io->delay(ctx, 10);
+ }
+ return -ETIMEDOUT;
+}
+
+/* Linux apple_pcie_tunnel_release_reset/restart_link, first start only.
+ * Keep all requester-to-stream maps disabled. No endpoint config or DMA.
+ */
+int pciec_m1_start_link(const struct pciec_m1_io *io, void *ctx, u32 *last)
+{
+ u32 status, irq;
+ unsigned int i;
+ int ret;
+ if (!io || !io->read || !io->write || !io->delay || !last) return -EINVAL;
+ ret = io->read(ctx, PCIEC_PORT, 0x804, &status);
+ if (ret) return ret;
+ if (status == ~0U || !(status & 1)) return -ENODEV;
+ ret = io->read(ctx, PCIEC_PORT, 0x80, &status);
+ if (ret) return ret;
+ if (status) return -EBUSY;
+ ret = io->write(ctx, PCIEC_PORT, 0x988, 0);
+ if (ret) return ret;
+ for (i = 0; i < 500; i++) {
+  ret = io->read(ctx, PCIEC_PORT, 0x98c, &status);
+  if (ret) return ret;
+  *last = status;
+  if (status == ~0U) return -ENODEV;
+  if (!(status & 1)) break;
+  io->delay(ctx, 1000);
+ }
+ if (i == 500) return -ETIMEDOUT;
+ ret = io->write(ctx, PCIEC_PORT, 0x100, (1U << 12) | (1U << 14));
+ if (ret) return ret;
+ ret = io->write(ctx, PCIEC_PORT, 0x80, 1);
+ if (ret) return ret;
+ for (i = 0; i < 500; i++) {
+  ret = io->read(ctx, PCIEC_PORT, 0x100, &irq);
+  if (ret) return ret;
+  ret = io->read(ctx, PCIEC_PORT, 0x208, &status);
+  if (ret) return ret;
+  *last = status;
+  if (status == ~0U || irq == ~0U) return -ENODEV;
+  if ((status & 1) && (irq & (1U << 12))) break;
+  io->delay(ctx, 1000);
+ }
+ if (i == 500) return -ETIMEDOUT;
+ /* PCIe reset recovery, while the wrapper continues servicing RTKit. */
+ for (i = 0; i < 100; i++) io->delay(ctx, 1000);
+ ret = io->read(ctx, PCIEC_PORT, 0x208, &status);
+ if (ret) return ret;
+ *last = status;
+ if (status == ~0U || !(status & 1)) return -ENOLINK;
+ return 0;
+}
+
+/* Bounded configuration enumeration only. The only writes assign bridge bus
+ * numbers; no BARs, command-enable bits, RID/SID entries or DMA are changed. */
+static int pciec_scan_bus(const struct pciec_m1_io *io, void *ctx,
+                          struct pciec_scan *scan, unsigned int bus)
+{
+ unsigned int dev, fn, functions; u32 off, id, hdr, cls, cmd, buses, readback;
+ int ret;
+ for (dev = 0; dev < (bus ? 32 : 1); dev++) {
+  functions = 1;
+  for (fn = 0; fn < functions; fn++) {
+   struct pciec_scan_entry *e;
+   off = (bus << 20) | (dev << 15) | (fn << 12);
+   ret = io->read(ctx, PCIEC_CONFIG, off, &id); if (ret) return ret;
+   if ((id & 0xffff) == 0xffff || !(id & 0xffff)) continue;
+   if (scan->count >= PCIEC_SCAN_MAX) return -E2BIG;
+   ret = io->read(ctx, PCIEC_CONFIG, off + 0xc, &hdr); if (ret) return ret;
+   ret = io->read(ctx, PCIEC_CONFIG, off + 8, &cls); if (ret) return ret;
+   ret = io->read(ctx, PCIEC_CONFIG, off + 4, &cmd); if (ret) return ret;
+   if (!fn && (hdr & BIT(23))) functions = 8;
+   e = &scan->entry[scan->count++];
+   e->bdf = off >> 12; e->id = id; e->class_rev = cls;
+   e->header = hdr; e->command = cmd; e->secondary = 0;
+   /* Reject inherited endpoint DMA. Root/bridge master only forwards TLPs. */
+   if ((cls >> 16) != 0x0604 && (cmd & BIT(2))) return -EBUSY;
+   if ((cls >> 16) != 0x0604) continue;
+   if (((hdr >> 16) & 0x7f) != 1 || scan->next_bus >= 16) return -ERANGE;
+   e->secondary = scan->next_bus++;
+   ret = io->read(ctx, PCIEC_CONFIG, off + 0x18, &buses); if (ret) return ret;
+   buses = (buses & 0xff000000) | bus | (e->secondary << 8) | (15 << 16);
+   ret = io->write(ctx, PCIEC_CONFIG, off + 0x18, buses); if (ret) return ret;
+   ret = io->read(ctx, PCIEC_CONFIG, off + 0x18, &readback); if (ret) return ret;
+   if (readback != buses) return -EIO;
+   io->delay(ctx, 1000);
+   ret = pciec_scan_bus(io, ctx, scan, e->secondary); if (ret) return ret;
+   buses = (buses & ~0xff0000U) | ((scan->next_bus - 1) << 16);
+   ret = io->write(ctx, PCIEC_CONFIG, off + 0x18, buses); if (ret) return ret;
+  }
+ }
+ return 0;
+}
+int pciec_m1_scan(const struct pciec_m1_io *io, void *ctx, struct pciec_scan *scan)
+{
+ if (!io || !io->read || !io->write || !io->delay || !scan) return -EINVAL;
+ memset(scan, 0, sizeof(*scan)); scan->next_bus = 1;
+ return pciec_scan_bus(io, ctx, scan, 0);
+}
diff --git a/lib/usb4_cfg.c b/lib/usb4_cfg.c
index 675f07a9..59bba613 100644
--- a/lib/usb4_cfg.c
+++ b/lib/usb4_cfg.c
@@ -105,3 +105,36 @@ int usb4_cfg_decode(const struct usb4_cfg_request *req, const void *frame,
 	*response_port = (address >> 19) & 63;
 	return 0;
 }
+
+/* Linux tb_msgs.h cfg_event_pkg and ctl.c tb_cfg_ack_plug. */
+int usb4_cfg_decode_event(const void *frame, size_t size, unsigned int sof,
+                         unsigned int eof, struct usb4_cfg_event *event)
+{
+ const u8 *bytes = frame;
+ u32 hi, value;
+ if (!frame || !event) return -EINVAL;
+ if (eof != USB4_CFG_EVENT) return -EAGAIN;
+ if (sof || size != 16) return -EPROTO;
+ if (get_unaligned_be32(bytes + 12) != usb4_cfg_crc(bytes, 12)) return -EBADMSG;
+ hi = get_unaligned_be32(bytes);
+ value = get_unaligned_be32(bytes + 8);
+ if ((hi & 0xffc00000) != BIT(31) || (value & 0x7fffffc0)) return -EPROTO;
+ event->route = (u64)(hi & 0x003fffff) << 32 | get_unaligned_be32(bytes + 4);
+ event->port = value & 63;
+ event->unplug = !!(value & BIT(31));
+ return 0;
+}
+
+int usb4_cfg_ack_plug_encode(const struct usb4_cfg_event *event,
+                            void *frame, size_t capacity)
+{
+ u8 *bytes = frame;
+ if (!event || !frame || event->route >> 54 || event->port > 63) return -EINVAL;
+ if (capacity < 16) return -ENOSPC;
+ put_unaligned_be32(event->route >> 32, bytes);
+ put_unaligned_be32(event->route, bytes + 4);
+ put_unaligned_be32(7U | event->port << 8 |
+                    (event->unplug ? 3U : 2U) << 30, bytes + 8);
+ put_unaligned_be32(usb4_cfg_crc(bytes, 12), bytes + 12);
+ return 16;
+}
