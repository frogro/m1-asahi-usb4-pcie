+static int tb_stop_for_efi(void)
+{
+ int ret;
+ if (tb_efi_exit_done) return 0;
+ ret = tb_quiesce();
+ if (ret || tb.live || tb.dma) return ret ? ret : -EBUSY;
+ ret = apple_nhi_m1_quiesce();
+ if (ret) return ret;
+ ret = apple_acio_m1_prepare_os();
+ if (ret) return ret;
+ if (tb_efi_check_dart) {
+  ret = apple_nhi_m1_remove_dart();
+  if (ret) return ret;
+  ret = device_remove(tb.dart, DM_REMOVE_NORMAL);
+  if (ret) return ret;
+  puts("PCIEC-DART OS removal PASS; both diagnostic IOMMUs removed\n");
+ }
+ tb_efi_exit_done = true;
+ return 0;
+}
+static void EFIAPI tb_efi_exit_notify(struct efi_event *event, void *context)
+{
+ int ret;
+ EFI_ENTRY("%p, %p", event, context);
+ puts("TB-EFI-EXIT begin: NVMe -> NHI -> ACIO\n");
+ ret = tb_stop_for_efi();
+ if (ret) {
+  printf("TB-EFI-EXIT FAILED ret=%d; refusing Linux handoff, reset\n", ret);
+  do_reset(NULL, 0, 0, NULL);
+  hang();
+ }
+ puts("TB-EFI-EXIT PASS; endpoint DMA unmapped, NHI stopped, ACIO asleep\n");
+ EFI_EXIT(EFI_SUCCESS);
+}
+static int tb_read_grub_disk(void **image_out, int *length_out)
+{
+ const char *path = "/EFI/CODEXTB/GRUB89.EFI";
+ loff_t size = 0, actual = 0;
+ void *image;
+ int ret;
+ *image_out = NULL;
+ *length_out = 0;
+ ret = tb_fs_open(1);
+ if (ret) return ret;
+ ret = fs_size(path, &size);
+ fs_close();
+ if (ret) return ret;
+ if (size != 1519616) return -EINVAL;
+ image = memalign(4096, ALIGN(size, 4096));
+ if (!image) return -ENOMEM;
