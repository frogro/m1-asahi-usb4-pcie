diff --git a/cmd/apple_acio_m1.c b/cmd/apple_acio_m1.c
new file mode 100644
index 00000000..34833157
--- /dev/null
+++ b/cmd/apple_acio_m1.c
@@ -0,0 +1,546 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* RAM-only J274 port1 ACIO readiness diagnostic. Staged NHI/DART checks and bounded host-router read.
+ * Sequence derived from Asahi Linux thunderbolt/apple.c and reset-apple-cio.c.
+ * Copyright The Asahi Linux Contributors
+ * Copyright (c) Sven Peter <sven@kernel.org>
+ * Power/reset operations use U-Boot's existing Apple PMGR provider.
+ */
+#include <apple_acio_m1.h>
+#include <apple_nhi_m1.h>
+#include <linux/errno.h>
+#ifdef CONFIG_ARCH_APPLE
+#include <apple_acio_prereq.h>
+#include <asm/io.h>
+#include <asm/global_data.h>
+#include <mailbox.h>
+#include <asm/arch/rtkit.h>
+#include <dm.h>
+#include <dm/device-internal.h>
+#include <dm/ofnode.h>
+#include <dm/read.h>
+#include <dm/lists.h>
+#include <dm/uclass-internal.h>
+#include <linux/delay.h>
+#include <linux/ioport.h>
+#include <linux/iopoll.h>
+#include <mailbox.h>
+#include <mapmem.h>
+#include <power-domain.h>
+#include <reset.h>
+#include <time.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+#define PMGR_NODE "/soc/power-management@23b700000"
+#define ACIO_NODE "/soc/cio@501ac0000"
+#define NHI_NODE ACIO_NODE "/nhi@f00000"
+#define MBOX_NODE "/soc/mailbox@501100000"
+#define RESET_NODE "/soc/reset-controller@23b784000"
+static const u32 domains[] = { 0x458, 0x460, 0x468, 0x450 };
+static bool used;
+static struct apple_rtkit *diagnostic_rtk;
+static unsigned int diagnostic_messages;
+static bool diagnostic_rtk_slept;
+
+/* Fixed-size RAM trace: never print or allocate in the measured path.
+ * Timestamps describe host actions/message consumption, not firmware emission.
+ */
+static struct { const char *event; ulong ms; } boot_trace[64];
+static unsigned int boot_trace_count, boot_trace_dropped;
+void apple_boot_trace(const char *event)
+{
+ if (boot_trace_count == ARRAY_SIZE(boot_trace)) {
+  boot_trace_dropped++;
+  return;
+ }
+ boot_trace[boot_trace_count].event = event;
+ boot_trace[boot_trace_count++].ms = get_timer(0);
+}
+void apple_boot_trace_dump(void)
+{
+ unsigned int i;
+ ulong first = boot_trace_count ? boot_trace[0].ms : 0;
+ for (i = 0; i < boot_trace_count; i++)
+  printf("BOOT-TIMING ms=%lu delta=%lu event=%s\n",
+         boot_trace[i].ms, boot_trace[i].ms - first, boot_trace[i].event);
+ printf("BOOT-TIMING count=%u dropped=%u\n", boot_trace_count, boot_trace_dropped);
+}
+
+/* Used at the EFI OS handoff after endpoint DMA and NHI rings stop. */
+int apple_acio_m1_prepare_os(void)
+{
+ int ret;
+ if (!diagnostic_rtk) return -ENODEV;
+ if (diagnostic_rtk_slept) return 0;
+ ret = apple_rtkit_shutdown(diagnostic_rtk, APPLE_RTKIT_PWR_STATE_SLEEP);
+ if (!ret) diagnostic_rtk_slept = true;
+ printf("ACIO-OS-HANDOFF sleep ret=%d\n", ret);
+ return ret;
+}
+
+/* Nonblocking RX, at most eight messages per call and 512 for this run.
+ * Existing mailbox send and outer RTKit/NHI phase timeouts stay in force.
+ */
+int apple_acio_m1_service(void)
+{
+ unsigned int i;
+ int ret;
+ if (!diagnostic_rtk || diagnostic_rtk_slept) return 0;
+ for (i = 0; i < 8; i++) {
+  if (diagnostic_messages >= 512) return -EOVERFLOW;
+  ret = apple_rtkit_poll_diagnostic(diagnostic_rtk);
+  if (ret == -EAGAIN) return 0;
+  if (ret) return ret;
+  diagnostic_messages++;
+  if (diagnostic_messages <= 8) apple_boot_trace("rtkit-message-consumed");
+ }
+ return 0;
+}
+
+static ofnode pdnode(u32 off)
+{
+ char path[112];
+ snprintf(path, sizeof(path), PMGR_NODE "/power-controller@%x", off);
+ return ofnode_path(path);
+}
+
+static int resource(ofnode node, const char *name, u64 addr, u64 size)
+{
+ struct resource r;
+ int ret = name ? ofnode_read_resource_byname(node, name, &r) :
+                  ofnode_read_resource(node, 0, &r);
+ if (ret) return ret;
+ return r.start == addr && resource_size(&r) == size ? 0 : -ERANGE;
+}
+
+static u32 pdstate(u32 off)
+{
+ return readl(map_sysmem(0x23b700000ULL + off, 4));
+}
+
+/* Probe52 adds bounded reads only. No adapter writes or altered start value.
+ * Validate generated DT data before powering anything; only read adapter MMIO
+ * after firmware-ready and active-domain checks. Print saved values at exit.
+ */
+static struct {
+ bool enabled, start_valid, adapter_valid[2];
+ u32 start_before, adapter[2];
+} probe52;
+
+static int probe52_policy(void)
+{
+ ofnode node = ofnode_path(ACIO_NODE);
+ const fdt32_t *flag, *tuple;
+ const char *alias;
+ int len, ret;
+
+ flag = ofnode_get_property(node, "u-boot,probe-acio-readonly", &len);
+ if (!flag) return 0;
+ if (len != 4 || fdt32_to_cpu(flag[0]) != 52 ||
+     !ofnode_device_is_compatible(ofnode_root(), "apple,j274") ||
+     !ofnode_device_is_compatible(node, "apple,t8103-usb4-acio"))
+  return -EINVAL;
+ alias = ofnode_get_property(ofnode_path("/aliases"), "usb4_1_pcie_adapter", &len);
+ if (!alias || len != sizeof(ACIO_NODE) || memcmp(alias, ACIO_NODE, sizeof(ACIO_NODE)))
+  return -EINVAL;
+ ret = resource(node, "pcie-adapter", 0x501e44000ULL, 0x4000);
+ if (ret) return ret;
+ tuple = ofnode_get_property(node, "apple,tunable-pcie-adapter", &len);
+ if (!tuple || len != 12 || fdt32_to_cpu(tuple[0]) != 0x1008 ||
+     fdt32_to_cpu(tuple[1]) != 6 || fdt32_to_cpu(tuple[2]) != 6)
+  return -EINVAL;
+ return 1;
+}
+
+static int probe52_adapter_read(void *rc, unsigned int slot)
+{
+ unsigned int i;
+ u32 state;
+
+ if (!probe52.enabled) return 0;
+ if (slot >= ARRAY_SIZE(probe52.adapter)) return -EINVAL;
+ for (i = 0; i < ARRAY_SIZE(domains); i++) {
+  state = pdstate(domains[i]);
+  if ((state & 0xff) != 0xff || (state & (BIT(31) | BIT(10))))
+   return -EBUSY;
+ }
+ state = readl(rc + 0xa8);
+ if (state == 0xffffffff || !(state & GENMASK(30, 24)) || (state & BIT(31)))
+  return -EBUSY;
+ state = readl(map_sysmem(0x501e45008ULL, 4));
+ if (state == 0xffffffff) return -EIO;
+ probe52.adapter[slot] = state;
+ probe52.adapter_valid[slot] = true;
+ return 0;
+}
+
+/* Probe53: apply only the already validated adapter tuple (0x1008,6,6),
+ * at Aurora's position after RC tunables and before NHI. RC start unchanged. */
+static struct { bool enabled, applied; u32 written, readback; } probe53;
+static int probe53_policy(bool snapshot_enabled)
+{
+ int len;
+ const fdt32_t *flag = ofnode_get_property(ofnode_path(ACIO_NODE),
+                          "u-boot,probe-apply-pcie-adapter", &len);
+ if (!flag) return 0;
+ if (!snapshot_enabled || len != 4 || fdt32_to_cpu(flag[0]) != 53)
+  return -EINVAL;
+ return 1;
+}
+
+static int probe53_apply_adapter(void)
+{
+ void *reg;
+ if (!probe53.enabled) return 0;
+ /* Called immediately after the powered/ready guarded pre-NHI snapshot. */
+ if (!probe52.enabled || !probe52.adapter_valid[0] ||
+     probe52.adapter[0] == 0xffffffff || probe53.applied)
+  return -EINVAL;
+ reg = map_sysmem(0x501e45008ULL, 4);
+ probe53.written = (probe52.adapter[0] & ~6U) | 6U;
+ writel(probe53.written, reg);
+ probe53.applied = true;
+ probe53.readback = readl(reg);
+ if (probe53.readback == 0xffffffff || (probe53.readback & 6U) != 6U)
+  return -EIO;
+ return 0;
+}
+
+/* Probe56 isolates the T8103 RC start read-modify-write used by Aurora.
+ * The Probe52 policy validates the M1 target and requires a valid start read.
+ * The property is absent in normal DTs, leaving the existing write unchanged.
+ */
+static struct { bool enabled, applied; u32 written; } probe56;
+static int probe56_policy(bool snapshot_enabled)
+{
+ int len;
+ const fdt32_t *flag = ofnode_get_property(ofnode_path(ACIO_NODE),
+                          "u-boot,probe-preserve-acio-start", &len);
+ if (!flag) return 0;
+ if (!snapshot_enabled || len != 4 || fdt32_to_cpu(flag[0]) != 56)
+  return -EINVAL;
+ return 1;
+}
+
+static int probe56_start_value(u32 *value)
+{
+ if (probe56.enabled && (!probe52.enabled || !probe52.start_valid ||
+                         probe52.start_before == 0xffffffff))
+  return -EINVAL;
+ *value = probe56.enabled ? probe52.start_before | BIT(1) : BIT(1);
+ return 0;
+}
+
+/* Probe57: Linux T8103 DT assigns ACIO1 to AOP PIN41/periph1. The
+ * diagnostic owner is bound but not probed, so default pinctrl is not applied.
+ * Match Linux apple_gpio_pinmux_set's mask, preserving GPIO mode/data bits.
+ * Explicit M1/DT guards restrict this to one always-on pin; no other GPIO IO.
+ */
+#define PROBE57_PINCTRL "/soc/pinctrl@24a820000"
+#define PROBE57_GROUP PROBE57_PINCTRL "/acio1-pins"
+static struct { bool enabled, applied, changed; u32 before, written, readback; } probe57;
+static int probe57_policy(bool snapshot_enabled)
+{
+ const fdt32_t *flag, *pins, *ref, *handle;
+ int len, ret;
+ ofnode acio = ofnode_path(ACIO_NODE), bank = ofnode_path(PROBE57_PINCTRL);
+ flag = ofnode_get_property(acio, "u-boot,probe-acio-pinctrl", &len);
+ if (!flag) return 0;
+ if (!snapshot_enabled || len != 4 || fdt32_to_cpu(flag[0]) != 57 ||
+     !ofnode_device_is_compatible(bank, "apple,t8103-pinctrl")) return -EINVAL;
+ ret = resource(bank, NULL, 0x24a820000ULL, 0x4000);
+ if (ret) return ret;
+ pins = ofnode_get_property(ofnode_path(PROBE57_GROUP), "pinmux", &len);
+ if (!pins || len != 4 || fdt32_to_cpu(pins[0]) != 0x10029) return -EINVAL;
+ handle = ofnode_get_property(ofnode_path(PROBE57_GROUP), "phandle", &len);
+ if (!handle || len != 4 || !fdt32_to_cpu(handle[0])) return -EINVAL;
+ ref = ofnode_get_property(acio, "pinctrl-0", &len);
+ if (!ref || len != 4 || ref[0] != handle[0]) return -EINVAL;
+ return 1;
+}
+
+static int probe57_apply(void)
+{
+ void *reg;
+ u32 mask = GENMASK(6, 5) | BIT(9), desired = BIT(5) | BIT(9);
+ if (!probe57.enabled) return 0;
+ if (probe57.applied) return -EINVAL;
+ reg = map_sysmem(0x24a8200a4ULL, 4);
+ probe57.before = readl(reg);
+ if (probe57.before == 0xffffffff) return -EIO;
+ probe57.written = (probe57.before & ~mask) | desired;
+ probe57.changed = probe57.before != probe57.written;
+ if (probe57.changed) writel(probe57.written, reg);
+ probe57.applied = true;
+ probe57.readback = readl(reg);
+ if (probe57.readback == 0xffffffff ||
+     (probe57.readback & mask) != desired) return -EIO;
+ return 0;
+}
+
+static void probe52_dump(void)
+{
+ unsigned int i;
+ if (!probe52.enabled) return;
+ printf("ACIO-PROBE52 start-before valid=%u rc0c=%08x original-write=00000002 aurora-write=%08x\n",
+        probe52.start_valid, probe52.start_before, probe52.start_before | BIT(1));
+ for (i = 0; i < ARRAY_SIZE(probe52.adapter); i++)
+  printf("ACIO-PROBE52 adapter slot=%u valid=%u reg1008=%08x mask=00000006 expected=00000006 masked=%08x\n",
+         i, probe52.adapter_valid[i], probe52.adapter[i], probe52.adapter[i] & 6);
+ if (!probe53.enabled)
+  puts("ACIO-PROBE52 read-only; startup writes unchanged; no adapter write\n");
+}
+
+int apple_acio_m1_check(void)
+{
+ ofnode acio = ofnode_path(ACIO_NODE), mbox = ofnode_path(MBOX_NODE);
+ struct ofnode_phandle_args args;
+ int i, ret;
+ u32 off, state;
+
+ if (used) return -EALREADY;
+ if (!ofnode_device_is_compatible(ofnode_root(), "apple,j274") ||
+     !ofnode_device_is_compatible(acio, "apple,t8103-usb4-acio") ||
+     !ofnode_device_is_compatible(mbox, "apple,m3-mailbox-v2") ||
+     !ofnode_device_is_compatible(ofnode_path(RESET_NODE), "apple,t8103-cio-reset"))
+  return -ENODEV;
+ if (ofnode_is_enabled(acio) || ofnode_is_enabled(mbox)) return -EBUSY;
+ if (ofnode_is_enabled(ofnode_path(NHI_NODE)) ||
+     !ofnode_device_is_compatible(ofnode_path(NHI_NODE), "apple,t8103-usb4-nhi"))
+  return -ENODEV;
+ ret = resource(ofnode_path(NHI_NODE), "nhi", 0x501f00000, 0x100000);
+ if (ret) return ret;
+ if ((ret = resource(acio, "rc", 0x501ac0000, 0xc000)) ||
+     (ret = resource(acio, "sram", 0x501080000, 0x20000)) ||
+     (ret = resource(mbox, NULL, 0x501100000, 0x4000)) ||
+     (ret = resource(ofnode_path(RESET_NODE), NULL, 0x23b784000, 0x8000)) ||
+     (ret = resource(ofnode_path(PMGR_NODE), NULL, 0x23b700000, 0x14000)))
+  return ret;
+ ret = ofnode_parse_phandle_with_args(acio, "mboxes", "#mbox-cells", 0, 0, &args);
+ if (ret || args.args_count || !ofnode_equal(args.node, mbox)) return -EINVAL;
+ for (i = 0; i < ARRAY_SIZE(domains); i++) {
+  ofnode node = pdnode(domains[i]);
+  if (!ofnode_device_is_compatible(node, "apple,pmgr-pwrstate") ||
+      ofnode_read_u32(node, "reg", &off) || off != domains[i]) return -EINVAL;
+  ret = ofnode_parse_phandle_with_args(node, "power-domains", "#power-domain-cells", 0, 0, &args);
+  if (ret || args.args_count ||
+      !ofnode_equal(args.node, pdnode(i == 1 || i == 2 ? 0x458 : 0x448)))
+   return -EINVAL;
+ }
+ if (!ofnode_device_is_compatible(pdnode(0x448), "apple,pmgr-pwrstate") ||
+     ofnode_read_u32(pdnode(0x448), "reg", &off) || off != 0x448) return -EINVAL;
+ /* Only always-on PMGR registers are read during preflight. */
+ for (i = 0; i < ARRAY_SIZE(domains); i++) {
+  state = pdstate(domains[i]);
+  printf("ACIO preflight PD %#x=%#x\n", domains[i], state);
+  if (state == 0xffffffff || (state & (BIT(31) | BIT(10)))) return -EBUSY;
+  /* ACIO must be cold. PCIe-C may have an inherited idle clock vote. */
+  if (i < 3 && (state & 0xff)) return -EBUSY;
+  if (i == 3 && (state & 0xff) != 0 && (state & 0xff) != 0xff) return -EBUSY;
+ }
+ return 0;
+}
+
+static int domain_on(u32 off)
+{
+ struct power_domain pd = {};
+ int ret;
+ u32 state;
+ /* Every parent is activated and checked before its child is probed. */
+ ret = uclass_get_device_by_ofnode(UCLASS_POWER_DOMAIN, pdnode(off), &pd.dev);
+ if (ret) return ret;
+ ret = power_domain_on(&pd);
+ if (ret) return ret;
+ state = pdstate(off);
+ printf("ACIO power PD %#x=%#x\n", off, state);
+ return (state & 0xff) == 0xff && !(state & (BIT(31) | BIT(10))) ? 0 : -EIO;
+}
+
+static int reset_write(void *ctx, u32 off, u32 value)
+{
+ writel(value, ctx + off);
+ return 0;
+}
+static int reset_read(void *ctx, u32 off, u32 *value)
+{
+ *value = readl(ctx + off);
+ return 0;
+}
+static void delay(void *ctx, unsigned int us) { udelay(us); }
+static const struct acio_reset_io reset_io = { reset_write, reset_read, delay };
+
+static int shmem_setup(void *cookie, struct apple_rtkit_buffer *buf)
+{
+ u64 physical;
+ int ret = acio_sram_translate(0x501080000, 0x20000, buf->dva, buf->size, &physical);
+ printf("ACIO SRAM ep=%d iova=%llx size=%zx ret=%d\n", buf->endpoint,
+        buf->dva, buf->size, ret);
+ if (ret) return ret;
+ buf->buffer = map_sysmem(physical, buf->size);
+ return 0;
+}
+static void shmem_destroy(void *cookie, struct apple_rtkit_buffer *buf)
+{
+ /* Reserved device SRAM is not heap memory. No access while shutting down. */
+ buf->buffer = NULL;
+}
+
+/* Bound explicitly by the diagnostic; never matched or auto-probed from DT. */
+U_BOOT_DRIVER(apple_acio_diagnostic) = {
+ .name = "apple-acio-diagnostic", .id = UCLASS_MISC,
+ .flags = DM_FLAG_DEFAULT_PD_CTRL_OFF,
+};
+
+int apple_acio_m1_start(unsigned int stage)
+{
+ struct udevice *pd, *rstdev, *owner, *mbox;
+ struct reset_ctl rst = {};
+ struct mbox_chan chan = {};
+ struct apple_rtkit *rtk = NULL;
+ void *rc = map_sysmem(0x501ac0000ULL, 0xc000);
+ u32 state = 0, start_value;
+ int i, ret, shutdown;
+
+ ret = apple_acio_m1_check();
+ if (ret) return ret;
+ ret = probe52_policy();
+ if (ret < 0) return ret;
+ probe52.enabled = ret == 1;
+ ret = probe53_policy(probe52.enabled);
+ if (ret < 0) return ret;
+ probe53.enabled = ret == 1;
+ ret = probe56_policy(probe52.enabled);
+ if (ret < 0) return ret;
+ probe56.enabled = ret == 1;
+ ret = probe57_policy(probe52.enabled);
+ if (ret < 0) return ret;
+ probe57.enabled = ret == 1;
+ apple_boot_trace("acio-preflight-complete");
+ used = true; /* Any partial start requires a whole-machine reset, no retry. */
+ ret = probe57_apply();
+ if (ret) goto out;
+ ret = domain_on(0x448);
+ if (ret) goto out;
+ ret = uclass_get_device_by_ofnode(UCLASS_POWER_DOMAIN, pdnode(0x450), &pd);
+ if (ret) goto out;
+ ret = uclass_get_device_by_ofnode(UCLASS_RESET, pdnode(0x450), &rstdev);
+ if (ret) goto out;
+ rst.dev = rstdev;
+ ret = reset_request(&rst);
+ if (!ret) ret = reset_assert(&rst);
+ if (ret) goto out;
+ state = pdstate(0x450);
+ if ((state & (BIT(31) | BIT(10))) != (BIT(31) | BIT(10))) { ret = -EIO; goto out; }
+ udelay(2);
+ ret = reset_deassert(&rst);
+ if (ret) goto out;
+ state = pdstate(0x450);
+ if (state & (BIT(31) | BIT(10))) { ret = -EIO; goto out; }
+ puts("ACIO PCIe-C reset-before-power PASS\n");
+ for (i = 0; i < ARRAY_SIZE(domains); i++) {
+  ret = domain_on(domains[i]);
+  if (ret) goto out;
+ }
+ apple_boot_trace("acio-domains-on");
+ ret = acio_m1_deassert(&reset_io, map_sysmem(0x23b784000ULL, 0x8000),
+                       1, 0x8000, &state);
+ printf("ACIO reset status=%#x ret=%d\n", state, ret);
+ if (ret) goto out;
+ ret = device_bind_driver_to_node(gd->dm_root, "apple-acio-diagnostic",
+                                  "acio-port1-diagnostic", ofnode_path(ACIO_NODE), &owner);
+ if (ret) goto out;
+ ret = lists_bind_fdt(gd->dm_root, ofnode_path(MBOX_NODE), &mbox,
+                      lists_driver_lookup_name("apple-mbox"), false);
+ if (!ret && !mbox) ret = -ENODEV;
+ if (ret) goto out;
+ /* Explicit binding must set the same compatible match-data as normal scan. */
+ ret = mbox_get_by_index(owner, 0, &chan);
+ if (ret) goto out;
+ apple_boot_trace("acio-reset-ready");
+ puts("ACIO M3 start\n");
+ apple_boot_trace("m3-start-write");
+ if (probe52.enabled) {
+  probe52.start_before = readl(rc + 0xc);
+  if (probe52.start_before == 0xffffffff) { ret = -EIO; goto out; }
+  probe52.start_valid = true;
+ }
+ ret = probe56_start_value(&start_value);
+ if (ret) goto out;
+ writel(start_value, rc + 0xc);
+ probe56.written = start_value;
+ probe56.applied = true;
+ rtk = apple_rtkit_init(&chan, NULL, shmem_setup, shmem_destroy);
+ if (!rtk) { ret = -ENOMEM; goto out; }
+ apple_rtkit_enable_syslog_diagnostic(rtk);
+ ret = apple_rtkit_boot(rtk);
+ apple_boot_trace("rtkit-boot-return");
+ printf("ACIO RTKit boot ret=%d\n", ret);
+ if (ret) goto out;
+ ret = apple_rtkit_set_ap_power(rtk, APPLE_RTKIT_PWR_STATE_ON);
+ apple_boot_trace("rtkit-ap-on-return");
+ printf("ACIO RTKit AP-on ret=%d\n", ret);
+ if (ret) goto out;
+ ret = readl_poll_sleep_timeout(rc + 0xa8, state, state != 0xffffffff && (state & GENMASK(30,24)), 100, 500000);
+ apple_boot_trace("firmware-state-poll-return");
+ printf("ACIO firmware state=%#x ret=%d\n", state, ret);
+ if (!ret) puts("ACIO M3 READY PASS; no NHI/tunnel/DMA\n");
+ if (!ret && stage >= 1) {
+  u32 cap = readl(map_sysmem(0x501f00000ULL, 4));
+  printf("ACIO NHI HOP_COUNT raw=%#x count=%u\n", cap, cap & 0x3ff);
+  /* J274 NHI has 12 TX/RX ring pairs in the tested Linux DT. No writes. */
+  if (cap == 0xffffffff || (cap & 0x3ff) != 12)
+   ret = -EPROTO;
+  else
+   puts("NHI-READONLY PASS; no configuration, rings or DMA\n");
+ }
+ if (!ret && stage >= 3) {
+  apple_boot_trace("rc-tunables-begin");
+  ret = apple_nhi_m1_tunables_apply(false);
+  apple_boot_trace("rc-tunables-return");
+ }
+ if (!ret) ret = probe52_adapter_read(rc, 0);
+ if (!ret) ret = probe53_apply_adapter();
+ if (!ret && stage >= 2) {
+  void *mbox_regs = map_sysmem(0x501100000ULL, 0x4000);
+  /* Status only: do not pop or acknowledge queued firmware messages. */
+  printf("ACIO-MBOX before-nhi tx=%#x rx=%#x\n", readl(mbox_regs + 0x50), readl(mbox_regs + 0x80));
+  diagnostic_rtk = rtk;
+  diagnostic_rtk_slept = false;
+  ret = apple_nhi_m1_dart_test(stage);
+  diagnostic_rtk = NULL;
+  printf("ACIO-SYSLOG service messages=%u ret=%d\n", diagnostic_messages, ret);
+  printf("ACIO-MBOX after-nhi tx=%#x rx=%#x\n", readl(mbox_regs + 0x50), readl(mbox_regs + 0x80));
+ }
+ if (probe52.enabled && probe52.adapter_valid[0]) {
+  int sample_ret = probe52_adapter_read(rc, 1);
+  if (!ret) ret = sample_ret;
+ }
+ apple_boot_trace("rtkit-shutdown-begin");
+ shutdown = diagnostic_rtk_slept ? 0 : apple_rtkit_shutdown(rtk, APPLE_RTKIT_PWR_STATE_SLEEP);
+ apple_boot_trace("rtkit-shutdown-return");
+ printf("ACIO RTKit shutdown ret=%d\n", shutdown);
+ if (!ret) ret = shutdown;
+out:
+ if (probe57.enabled)
+  printf("ACIO-PROBE57 pin41 applied=%u changed=%u before=%08x written=%08x readback=%08x\n",
+         probe57.applied, probe57.changed, probe57.before, probe57.written, probe57.readback);
+ if (probe56.enabled)
+  printf("ACIO-PROBE56 preserve-start applied=%u before=%08x written=%08x\n",
+         probe56.applied, probe52.start_before, probe56.written);
+ if (probe53.enabled)
+  printf("ACIO-PROBE53 adapter applied=%u written=%08x readback=%08x; adapter diagnostic\n",
+         probe53.applied, probe53.written, probe53.readback);
+ probe52_dump();
+ diagnostic_rtk = NULL;
+ if (rtk) apple_rtkit_free(rtk);
+ printf("ACIO diagnostic ret=%d; power held until mandatory full reset\n", ret);
+ return ret;
+}
+
+#else
+int apple_acio_m1_prepare_os(void) { return -ENOSYS; }
+int apple_acio_m1_service(void) { return -ENOSYS; }
+int apple_acio_m1_check(void) { return -ENOSYS; }
+void apple_boot_trace(const char *event) {}
+void apple_boot_trace_dump(void) {}
+int apple_acio_m1_start(unsigned int stage) { return -ENOSYS; }
+#endif
diff --git a/cmd/apple_atc_m1.c b/cmd/apple_atc_m1.c
new file mode 100644
index 00000000..028885cf
--- /dev/null
+++ b/cmd/apple_atc_m1.c
@@ -0,0 +1,610 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Explicit J274 port1 PHY diagnostic. Never used by boot_targets. */
+#include <apple_atc_m1.h>
+#include <apple_acio_m1.h>
+#include <apple_nhi_m1.h>
+#include <apple_cd321x.h>
+#include <apple_pciec_m1.h>
+#include <asm/io.h>
+#include <command.h>
+#include <dm.h>
+#include <dm/device-internal.h>
+#include <dm/ofnode.h>
+#include <dm/read.h>
+#include <dm/uclass-internal.h>
+#include <i2c.h>
+#include <linux/delay.h>
+#include <linux/ioport.h>
+#include <linux/iopoll.h>
+#include <mapmem.h>
+#include <power-domain.h>
+#include <time.h>
+#include <usb.h>
+#include <usb/xhci.h>
+#include <linux/usb/dwc3.h>
+
+struct atc_m1_hw {
+	void *base[ATC_REGIONS];
+	struct atc_m1_config cfg;
+	enum atc_m1_stage stage, printed_stage;
+	enum atc_m1_region last_region;
+	u32 last_offset, last_value;
+	void *xhci;
+	u32 cap;
+	bool hostrun;
+	struct udevice *usb;
+	struct xhci_ctrl *retained_xhci;
+};
+
+static void show_stage(struct atc_m1_hw *hw)
+{
+	if (hw->stage != hw->printed_stage) {
+		printf("ATC-M1 stage=%u\n", hw->stage);
+		hw->printed_stage = hw->stage;
+	}
+}
+
+static int hw_read(void *ctx, enum atc_m1_region r, u32 off, u32 *value)
+{
+	struct atc_m1_hw *hw = ctx;
+
+	if (r >= ATC_REGIONS || off % 4 || off > hw->cfg.size[r] - 4)
+		return -ERANGE;
+	show_stage(hw);
+	*value = readl(hw->base[r] + off);
+	hw->last_region = r;
+	hw->last_offset = off;
+	hw->last_value = *value;
+	return 0;
+}
+
+static int hw_write(void *ctx, enum atc_m1_region r, u32 off, u32 value)
+{
+	struct atc_m1_hw *hw = ctx;
+
+	if (r >= ATC_REGIONS || off % 4 || off > hw->cfg.size[r] - 4)
+		return -ERANGE;
+	show_stage(hw);
+	if (r == ATC_USB2 && off == 8 && hw->last_region == r &&
+	    hw->last_offset == off)
+		printf("USB2-ROLE signal old=%#x new=%#x\n", hw->last_value, value);
+	writel(value, hw->base[r] + off);
+	return 0;
+}
+
+static void hw_delay(void *ctx, unsigned int us)
+{
+	udelay(us);
+}
+
+static int hw_verify_halted(void *ctx)
+{
+	struct atc_m1_hw *hw = ctx;
+	u32 cap = readl(hw->xhci) & 0xff;
+	u32 command, status;
+	int ret;
+
+	show_stage(hw);
+	if (cap != hw->cap)
+		return -EPROTO;
+	ret = readl_poll_timeout(hw->xhci + cap + 4, status,
+				status != 0xffffffff && (status & BIT(0)), 100000);
+	command = readl(hw->xhci + cap);
+	printf("ATC-M1 released DWC3: command=%#x status=%#x\n", command, status);
+	if (ret)
+		return ret;
+	if (command == 0xffffffff || (command & BIT(0)))
+		return -EBUSY;
+	return 0;
+}
+
+/* Known powered PHY control/status registers only; no FIFO or clear-on-read. */
+static void snapshot_phy(struct atc_m1_hw *hw, const char *phase)
+{
+ static const u32 core[] = { 8, 0x48, 0x4c, 0x1b0, 0x2a00,
+                            0x20000, 0x20004, 0x20008, 0x9010, 0x10010 };
+ static const u32 pipe[] = { 0, 4, 0xc, 0x10, 0x14, 0x1c, 0x20 };
+ unsigned int i;
+ for (i = 0; i < ARRAY_SIZE(core); i++)
+  printf("ATC-SNAPSHOT %s core[%#x]=%#x\n", phase, core[i], readl(hw->base[ATC_CORE] + core[i]));
+ for (i = 0; i < ARRAY_SIZE(pipe); i++)
+  printf("ATC-SNAPSHOT %s pipe[%#x]=%#x\n", phase, pipe[i], readl(hw->base[ATC_PIPE] + pipe[i]));
+ printf("USB2-SNAPSHOT %s control=%#x reset=%#x signal=%#x misc=%#x\n",
+        phase, readl(hw->base[ATC_USB2]), readl(hw->base[ATC_USB2] + 4),
+        readl(hw->base[ATC_USB2] + 8), readl(hw->base[ATC_USB2] + 0x1c));
+}
+
+/* Linux atc.c control registers already accessed using read/modify/write,
+ * plus status registers read by the driver. No FIFO, event or read-clear bank.
+ * Observed only after link polling, while PHY and ACIO remain powered.
+ */
+static void snapshot_phy_extended(void *context)
+{
+ struct atc_m1_hw *hw = context;
+ static const u32 core[] = { 0x8, 0x48, 0x4c, 0x1b0, 0x804, 0xa00, 0xa04, 0xa20, 0xa74, 0x1014, 0x1028, 0x2000, 0x2200, 0x2208, 0x2214, 0x2220, 0x2224, 0x2a00, 0x2a20, 0x2a38, 0x2aa4, 0x9010, 0x90f0, 0xb000, 0xb004, 0xb02c, 0xb030, 0xb034, 0xb048, 0xb054, 0xb060, 0xd000, 0xd004, 0xd008, 0x10010, 0x100f0, 0x12000, 0x12004, 0x1202c, 0x12030, 0x12034, 0x12048, 0x12054, 0x12060, 0x14000, 0x14004, 0x14008, 0x20000, 0x20004, 0x20008 };
+ static const u32 pipe[] = { 0x0, 0x4, 0xc, 0x10, 0x14, 0x1c, 0x20 };
+ static const u32 usb2[] = { 0x0, 0x4, 0x8, 0x1c };
+ unsigned int i;
+ for (i = 0; i < ARRAY_SIZE(core); i++)
+  printf("ATC-EXTENDED core[%#x]=%#x\n", core[i], readl(hw->base[ATC_CORE] + core[i]));
+ for (i = 0; i < ARRAY_SIZE(pipe); i++)
+  printf("ATC-EXTENDED pipe[%#x]=%#x\n", pipe[i], readl(hw->base[ATC_PIPE] + pipe[i]));
+ for (i = 0; i < ARRAY_SIZE(usb2); i++)
+  printf("ATC-EXTENDED usb2[%#x]=%#x\n", usb2[i], readl(hw->base[ATC_USB2] + usb2[i]));
+}
+
+/* Read-only allowlist: no FIFO, event ring, W1C writes or device registers. */
+static void snapshot_dwc3(struct atc_m1_hw *hw, const char *phase)
+{
+ static const u32 offsets[] = {
+  0xc110, 0xc11c, 0xc120, 0xc12c, 0xc140, 0xc144, 0xc14c,
+  0xc200, 0xc2c0, 0xc630, 0xcd38, 0xcd3c, 0xcd40,
+ };
+ unsigned int i;
+
+ for (i = 0; i < ARRAY_SIZE(offsets); i++)
+  printf("DWC3-SNAPSHOT %s reg[%#x]=%#x\n", phase, offsets[i],
+         readl(hw->xhci + offsets[i]));
+ printf("DWC3-SNAPSHOT %s command=%#x status=%#x\n", phase,
+        readl(hw->xhci + hw->cap), readl(hw->xhci + hw->cap + 4));
+}
+
+static const struct atc_m1_io hw_io = {
+	.read = hw_read, .write = hw_write, .delay = hw_delay,
+	.verify_halted = hw_verify_halted,
+};
+
+/* Linux dwc3-apple.c host/CIO sequence; selected, powered, halted port only.
+ * This diagnostic does not initialize xHCI rings or enable its RUN bit.
+ */
+static int dwc3_update_checked(struct atc_m1_hw *hw, u32 off,
+                              u32 mask, u32 value)
+{
+ u32 old = readl(hw->xhci + off), next, observed;
+
+ if (old == 0xffffffff || (value & ~mask))
+  return -EIO;
+ next = (old & ~mask) | value;
+ writel(next, hw->xhci + off);
+ observed = readl(hw->xhci + off);
+ if (observed == 0xffffffff || observed != next)
+  return -EIO;
+ return 0;
+}
+
+static int check_usb_darts(struct atc_m1_hw *hw)
+{
+ static const u64 bases[] = { 0x502f00000ULL, 0x502f80000ULL };
+ struct ofnode_phandle_args args;
+ struct udevice *dart;
+ void *regs;
+ u32 control, error;
+ int i, ret;
+ if (dev_count_phandle_with_args(hw->usb, "iommus", "#iommu-cells", 0) != 2)
+  return -EINVAL;
+ for (i = 0; i < 2; i++) {
+  ret = dev_read_phandle_with_args(hw->usb, "iommus", "#iommu-cells", 0, i, &args);
+  if (ret) return ret;
+  if (args.args_count != 1 || args.args[0] != (unsigned int)i ||
+      ofnode_get_addr(args.node) != bases[i]) return -EINVAL;
+  ret = uclass_find_device_by_ofnode(UCLASS_IOMMU, args.node, &dart);
+  if (ret || !device_active(dart)) return -ENODEV;
+  ret = dev_power_domain_on(dart);
+  if (ret) return ret;
+  regs = map_sysmem(bases[i], 0x4000);
+  control = readl(regs + 0x100 + 4 * i);
+  error = readl(regs + 0x40);
+  printf("M1-XHCI DART%u sid=%u tcr=%#x error=%#x\n", i, i, control, error);
+  if (!(readl(regs + 4) & BIT(0)) || control != (BIT(8) | BIT(12)) ||
+      (error & BIT(31))) return -EPERM;
+  if (i == 1 && hw->usb->iommu != dart) return -EINVAL;
+ }
+ return 0;
+}
+
+static int prepare_dwc3_host(struct atc_m1_hw *hw)
+{
+ u32 id, params, ctl;
+ int ret;
+
+ if (hw->stage != ATC_CORE_READY)
+  return -EPERM;
+ ret = hw_verify_halted(hw);
+ if (ret)
+  return ret;
+ id = readl(hw->xhci + 0xc120);
+ params = readl(hw->xhci + 0xc140);
+ ctl = readl(hw->xhci + 0xc110);
+ /* The measured M1 DWC3.1 core is DRD; reject an unexpected core/reset. */
+ if (id != 0x33313130 || params == 0xffffffff || (params & 3) != 2 ||
+     ctl == 0xffffffff || (ctl & BIT(11)))
+  return -ENODEV;
+#define DWC3_UPDATE(off, mask, val) do { \
+ ret = dwc3_update_checked(hw, off, mask, val); \
+ if (ret) return ret; \
+} while (0)
+ if (hw->hostrun) {
+#if CONFIG_IS_ENABLED(USB_XHCI_DWC3)
+  ret = check_usb_darts(hw);
+  if (ret) return ret;
+  apple_boot_trace("dwc3-core-init-begin");
+  ret = dwc3_m1_diag_init_preserve_phy((struct dwc3 *)(hw->xhci + DWC3_REG_OFFSET));
+  apple_boot_trace("dwc3-core-init-return");
+  printf("M1-DWC3 core-init preserve-phy ret=%d\n", ret);
+  if (ret) return ret;
+  ret = hw_verify_halted(hw);
+  if (ret) return ret;
+#else
+  return -ENOSYS;
+#endif
+ }
+ /* Apple CIO controls from dwc3_apple_setup_cio(), preserve upper timer bits. */
+ DWC3_UPDATE(0xcd38, 0xffffffff, 0x0f800f80);
+ DWC3_UPDATE(0xcd3c, 0xffffffff, 0x0fc00fc0);
+ DWC3_UPDATE(0xcd40, 0x00ffffff, 0x00140a10);
+ /* DRD role switching requires SUSPHY clear before selecting HOST. */
+ DWC3_UPDATE(0xc2c0, BIT(17), 0);
+ DWC3_UPDATE(0xc200, BIT(6), 0);
+ DWC3_UPDATE(0xc110, 3 << 12, 1 << 12);
+ /* Core USB2 LPM setup, followed by Apple-required SUSPHY before PIPE. */
+ DWC3_UPDATE(0xc200, BIT(8) | BIT(6), BIT(8) | BIT(6));
+ DWC3_UPDATE(0xc2c0, BIT(17), BIT(17));
+#undef DWC3_UPDATE
+ return hw_verify_halted(hw);
+}
+
+static int start_late_pipe(void *context)
+{
+ struct atc_m1_hw *hw = context;
+ int ret;
+
+ apple_boot_trace("dwc3-host-begin");
+ ret = prepare_dwc3_host(hw);
+ apple_boot_trace("dwc3-host-return");
+ printf("DWC3-HOST ret=%d; xHCI not started\n", ret);
+ if (ret)
+  return ret;
+ snapshot_dwc3(hw, "host-configured");
+ apple_boot_trace("late-pipe-begin");
+ ret = atc_m1_start_pipe(&hw->cfg, &hw_io, hw, &hw->stage);
+ apple_boot_trace("late-pipe-return");
+ printf("ATC-M1 late PIPE ret=%d stage=%u\n", ret, hw->stage);
+ if (!ret && hw->hostrun) {
+#if CONFIG_IS_ENABLED(USB_XHCI_HCD)
+  ret = check_usb_darts(hw);
+  if (ret) return ret;
+  apple_boot_trace("xhci-start-begin");
+  ret = xhci_m1_diag_start(hw->usb, hw->xhci, hw->xhci + hw->cap,
+                           &hw->retained_xhci);
+  apple_boot_trace("xhci-start-return");
+  if (!ret) ret = check_usb_darts(hw);
+#else
+  ret = -ENOSYS;
+#endif
+ }
+ return ret;
+}
+
+static int status_read(void *ctx, u8 reg, u8 *buf, size_t size)
+{
+	return dm_i2c_read(ctx, reg, buf, size);
+}
+
+/* Fixed chip on the selected J274 port; no scan or mode command. */
+static void snapshot_cable_power(void *unused)
+{
+ struct udevice *bus, *chip;
+ struct apple_cd321x_power p;
+ int ret;
+ ret = uclass_get_device_by_seq(UCLASS_I2C, 0, &bus);
+ if (!ret) ret = i2c_get_chip(bus, 0x3f, 1, &chip);
+ if (!ret) ret = i2c_set_chip_offset_len(chip, 1);
+ if (!ret) ret = apple_cd321x_power_snapshot(status_read, chip, &p);
+ if (ret) {
+  printf("CD321X-POWER-SAMPLE ms=%lu error=%d\n", get_timer(0), ret);
+  /* A failed diagnostic read must not invent a power state or retry. */
+  apple_nhi_m1_set_link_sample(NULL, NULL);
+  return;
+ }
+ printf("CD321X-POWER-SAMPLE ms=%lu status=%08x power=%04x system=%02x plug=%u connection=%u source_sink=%u opmode=%u\n",
+        get_timer(0), p.status, p.power_status, p.system_power_state,
+        !!(p.status & BIT(0)), p.power_status & 1,
+        (p.power_status >> 1) & 1, (p.power_status >> 2) & 3);
+}
+
+static int load_config(ofnode node, struct atc_m1_hw *hw,
+		       struct apple_cd321x_status *status)
+{
+	static const char *const names[] = {
+		"core", "axi2af", "usb2phy", "pipehandler", "lpdptx",
+	};
+	static const u64 addresses[] = {
+		0x503000000, 0x500000000, 0x502a90000, 0x502a84000, 0x503050000,
+	};
+	static const size_t sizes[] = { 0x4c000, 0x4000, 0x4000, 0x4000, 0x8000 };
+	static const char *const props[] = {
+		"apple,tunable-common-a", "apple,tunable-axi2af",
+		"apple,tunable-common-b", "apple,tunable-lane0-cio",
+		"apple,tunable-lane1-cio",
+	};
+	struct udevice *bus, *chip;
+	struct resource res;
+	int i, len, ret;
+
+	if (!ofnode_device_is_compatible(ofnode_root(), "apple,j274") ||
+	    !ofnode_device_is_compatible(node, "apple,t8103-atcphy"))
+		return -ENODEV;
+	for (i = 0; i < ATC_REGIONS; i++) {
+		ret = ofnode_read_resource_byname(node, names[i], &res);
+		if (ret)
+			return ret;
+		if (res.start != addresses[i] || resource_size(&res) != sizes[i])
+			return -ERANGE;
+		hw->cfg.size[i] = sizes[i];
+	}
+	for (i = 0; i < 5; i++) {
+		hw->cfg.tunable[i].data = ofnode_get_property(node, props[i], &len);
+		if (!hw->cfg.tunable[i].data || len <= 0)
+			return -ENOENT;
+		hw->cfg.tunable[i].bytes = len;
+	}
+	/* Validate every offset before even talking to the Type-C controller. */
+	ret = atc_m1_validate(&hw->cfg);
+	if (ret)
+		return ret;
+	ret = uclass_get_device_by_seq(UCLASS_I2C, 0, &bus);
+	if (!ret)
+		ret = i2c_get_chip(bus, 0x3f, 1, &chip);
+	if (!ret)
+		ret = i2c_set_chip_offset_len(chip, 1);
+	if (!ret)
+		ret = apple_cd321x_snapshot(status_read, chip, status);
+	if (ret)
+		return ret;
+	if (!(status->data_status & BIT(0)))
+		return -ENOTCONN;
+	if (!!(status->data_status & BIT(23)) == !!(status->data_status & BIT(16)))
+		return -EPROTONOSUPPORT;
+	hw->cfg.mode = status->data_status & BIT(23) ? ATC_USB4 : ATC_TBT;
+	hw->cfg.swapped = !!(status->data_status & BIT(1));
+	return 0;
+}
+
+/* Explicit fresh-cable diagnostic, after selected xHCI is halted and before
+ * PHY/ACIO start. Only bounded read-only PD snapshots during the user window.
+ */
+static int wait_fresh_cable(struct apple_cd321x_status *result)
+{
+ struct udevice *bus, *chip;
+ struct apple_cd321x_status status;
+ ulong started;
+ bool detached = false;
+ int ret;
+ ret = uclass_get_device_by_seq(UCLASS_I2C, 0, &bus);
+ if (!ret) ret = i2c_get_chip(bus, 0x3f, 1, &chip);
+ if (!ret) ret = i2c_set_chip_offset_len(chip, 1);
+ if (ret) return ret;
+ puts("ATC-FRESH-CABLE WAIT detach then reconnect same OWC; 120-second limit\n");
+ started = get_timer(0);
+ while (get_timer(started) < 120000) {
+  ret = apple_cd321x_snapshot(status_read, chip, &status);
+  /* A changing read-only snapshot can be retried within this window. */
+  if (ret && ret != -EAGAIN) return ret;
+  if (!ret) {
+   if (!(status.data_status & BIT(0))) {
+    if (!detached) puts("ATC-FRESH-CABLE DETACHED\n");
+    detached = true;
+   } else if (detached &&
+              (!!(status.data_status & BIT(23)) != !!(status.data_status & BIT(16)))) {
+    *result = status;
+    printf("ATC-FRESH-CABLE CONNECTED data=%#x eudo=%#x\n", status.data_status, status.eudo);
+    return 0;
+   }
+  }
+  /* U-Boot udelay services schedule/watchdog in bounded chunks. */
+  udelay(50000);
+ }
+ return -ETIMEDOUT;
+}
+
+static int do_atcm1(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	struct atc_m1_hw hw = {};
+	struct apple_cd321x_status before, after;
+	struct udevice *usb, *reset;
+	ofnode node, usbnode;
+	struct resource res;
+	void *xhci;
+	u32 cap, halted;
+	int ret, i;
+	unsigned int stage;
+	bool acio, fresh, tb_only, usb4_host, queries, extended, power_trace, pciec, tb_pciec;
+
+	if (argc != 3 || strcmp(argv[1], "1") ||
+	    (strcmp(argv[2], "check") && strcmp(argv[2], "start") &&
+	     strcmp(argv[2], "acio") && strcmp(argv[2], "nhi") && strcmp(argv[2], "dart") && strcmp(argv[2], "tune") && strcmp(argv[2], "host") && strcmp(argv[2], "hostrun") && strcmp(argv[2], "fresh") && strcmp(argv[2], "tbonly") && strcmp(argv[2], "usb4host") && strcmp(argv[2], "usb4query") && strcmp(argv[2], "usb4snapshot") && strcmp(argv[2], "usb4power") && strcmp(argv[2], "usb4pciec") && strcmp(argv[2], "tbtpciec")))
+		return CMD_RET_USAGE;
+	tb_pciec = !strcmp(argv[2], "tbtpciec");
+	fresh = !strcmp(argv[2], "fresh");
+	tb_only = !strcmp(argv[2], "tbonly") || tb_pciec;
+	pciec = !strcmp(argv[2], "usb4pciec") || tb_pciec;
+	power_trace = !strcmp(argv[2], "usb4power") || pciec;
+	extended = !strcmp(argv[2], "usb4snapshot") || power_trace;
+	queries = !strcmp(argv[2], "usb4query") || extended;
+	usb4_host = (!strcmp(argv[2], "usb4host") || queries) && !tb_pciec;
+	hw.hostrun = !strcmp(argv[2], "hostrun") || usb4_host;
+	stage = (!strcmp(argv[2], "host") || hw.hostrun || fresh || tb_only) ? 4 : !strcmp(argv[2], "tune") ? 3 : !strcmp(argv[2], "dart") ? 2 : !strcmp(argv[2], "nhi");
+	acio = !strcmp(argv[2], "acio") || stage;
+	if (stage >= 4) {
+		ret = apple_nhi_m1_control_check();
+		if (ret) goto fail;
+	}
+	if (stage >= 3) {
+		ret = apple_nhi_m1_tunables_check();
+		if (ret) goto fail;
+	}
+	if (stage >= 2) {
+		ret = apple_nhi_m1_check();
+		if (ret) goto fail;
+	}
+	if (acio) {
+		ret = apple_acio_m1_check();
+		if (ret) goto fail;
+	}
+	if (pciec) {
+		ret = apple_pciec_m1_check();
+		if (ret) goto fail;
+	}
+	node = ofnode_path("/soc/phy@503000000");
+	usbnode = ofnode_path("/soc/usb@502280000");
+	ret = load_config(node, &hw, &before);
+	if (ret)
+		goto fail;
+	printf("ATC-M1 port=1 mode=%s swapped=%u validated=5 groups\n",
+	       hw.cfg.mode == ATC_USB4 ? "USB4" : "TBT", hw.cfg.swapped);
+	if (usb4_host) {
+		ret = atc_m1_usb4_host_check(hw.cfg.mode, before.data_status);
+		if (ret)
+			goto fail;
+		puts("USB4-HOST policy validated; native USB role present\n");
+	}
+	/* TIPD leaves USB_ROLE_NONE when neither native USB connection bit is set. */
+	if (tb_only && (hw.cfg.mode != ATC_TBT ||
+		       (before.data_status & (BIT(4) | BIT(5))))) {
+		ret = -EPROTONOSUPPORT;
+		goto fail;
+	}
+	if (!strcmp(argv[2], "check"))
+		return CMD_RET_SUCCESS;
+
+	/* Do not probe or stop any other USB controller, especially debug port0. */
+	ret = uclass_find_device_by_ofnode(UCLASS_USB, usbnode, &usb);
+	if (ret || !device_active(usb)) {
+		ret = -EBUSY;
+		goto fail;
+	}
+	if (!ofnode_device_is_compatible(usbnode, "apple,t8103-dwc3") ||
+	    dev_read_addr(usb) != 0x502280000ULL) {
+		ret = -ENODEV;
+		goto fail;
+	}
+	ret = uclass_get_device_by_ofnode(UCLASS_RESET, node, &reset);
+	if (ret)
+		goto fail;
+	ret = dev_power_domain_on(reset);
+	if (ret)
+		goto fail;
+	xhci = map_sysmem(0x502280000ULL, 0x10000);
+	cap = readl(xhci) & 0xff;
+	if (cap < 0x20 || cap > 0x100 || cap % 4) {
+		ret = -EPROTO;
+		goto fail;
+	}
+	hw.xhci = xhci;
+	hw.cap = cap;
+	hw.usb = usb;
+	if (power_trace) snapshot_cable_power(NULL);
+	snapshot_dwc3(&hw, "before-remove");
+	ret = device_remove(usb, DM_REMOVE_NORMAL | DM_REMOVE_NO_PD);
+	if (ret)
+		goto fail;
+	/* xhci_deregister() discards the low-level stop result; verify HALTED. */
+	ret = readl_poll_timeout(xhci + cap + 4, halted,
+				halted != 0xffffffff && (halted & BIT(0)), 100000);
+	if (ret)
+		goto fail;
+	puts("ATC-M1 selected DWC3 halted; other USB hosts untouched\n");
+	if (fresh) {
+		ret = wait_fresh_cable(&before);
+		if (ret) goto fail;
+	}
+	ret = load_config(node, &hw, &after);
+	if (ret)
+		goto fail;
+	if (before.data_status != after.data_status || before.eudo != after.eudo ||
+	    before.tbt_device_mode != after.tbt_device_mode ||
+	    before.tbt_enter_vdo != after.tbt_enter_vdo) {
+		ret = -EAGAIN;
+		goto fail;
+	}
+	if (stage >= 4) {
+		ret = apple_nhi_m1_set_cable(&after);
+		if (ret) goto fail;
+	}
+	for (i = 0; i < ATC_REGIONS; i++) {
+		static const char *const resource_names[] = {
+			"core", "axi2af", "usb2phy", "pipehandler", "lpdptx",
+		};
+
+		ret = ofnode_read_resource_byname(node, resource_names[i], &res);
+		if (ret)
+			goto fail;
+		hw.base[i] = map_sysmem(res.start, resource_size(&res));
+	}
+	hw.cfg.retain_dwc3 = acio;
+	hw.cfg.hold_dwc3_reset = tb_only;
+	hw.xhci = xhci;
+	hw.cap = cap;
+	hw.printed_stage = ATC_DONE;
+	apple_boot_trace("phy-sequence-begin");
+	/* Test Linux ordering only in full host mode; earlier diagnostics unchanged. */
+	ret = stage >= 4 ?
+		atc_m1_start_core(&hw.cfg, &hw_io, &hw, true, &hw.stage) :
+		atc_m1_start(&hw.cfg, &hw_io, &hw, true, &hw.stage);
+	apple_boot_trace("phy-sequence-return");
+	if (ret) {
+		printf("ATC-M1 stopped at stage=%u; reset required\n", hw.stage);
+		printf("ATC-M1 last read region=%u offset=%#x value=%#x\n",
+		       hw.last_region, hw.last_offset, hw.last_value);
+		goto fail;
+	}
+	if (acio) {
+		puts("ATC-M1 PHY retained for ACIO; xHCI remains halted\n");
+		snapshot_phy(&hw, "before-acio");
+		if (!tb_only)
+			snapshot_dwc3(&hw, "before-acio");
+		else
+			puts("TBT-ONLY DWC3 remains reset; no late PIPE, xHCI or USB DMA\n");
+		if (stage >= 4 && !tb_only)
+			apple_nhi_m1_set_post_cable(start_late_pipe, &hw);
+		if (extended)
+			apple_nhi_m1_set_post_link(snapshot_phy_extended, &hw);
+		if (power_trace) apple_nhi_m1_set_link_sample(snapshot_cable_power, NULL);
+		if (pciec) apple_nhi_m1_set_pre_link(apple_pciec_m1_prepare, NULL);
+		apple_nhi_m1_set_queries(queries);
+		ret = apple_acio_m1_start(stage);
+		apple_nhi_m1_set_pre_link(NULL, NULL);
+		apple_nhi_m1_set_link_sample(NULL, NULL);
+		if (power_trace) snapshot_cable_power(NULL);
+		apple_nhi_m1_set_queries(false);
+		apple_nhi_m1_set_post_link(NULL, NULL);
+		apple_nhi_m1_set_post_cable(NULL, NULL);
+#if CONFIG_IS_ENABLED(USB_XHCI_HCD)
+        if (hw.retained_xhci) {
+         int stop;
+         apple_boot_trace("xhci-stop-begin");
+         stop = xhci_m1_diag_stop(hw.retained_xhci);
+         apple_boot_trace("xhci-stop-return");
+         printf("M1-XHCI stop ret=%d; buffers retained\n", stop);
+         if (stop) ret = stop;
+        }
+#endif
+		snapshot_phy(&hw, "after-acio");
+		if (!tb_only)
+			snapshot_dwc3(&hw, "after-acio");
+		if (ret) goto fail;
+	} else {
+		puts("ATC-M1 PHY SEQUENCE PASS; DWC3 held reset, no ACIO/NHI/tunnel/DMA\n");
+	}
+	apple_boot_trace_dump();
+	puts("Diagnostic state only: reset before any OS handover\n");
+	return CMD_RET_SUCCESS;
+fail:
+	apple_boot_trace_dump();
+	printf("ATC-M1 diagnostic error=%d; no automatic retry\n", ret);
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(atcm1, 3, 0, do_atcm1,
+	   "explicit M1 port1 PHY diagnostic, requires reset afterwards",
+	   "1 check|start|acio|nhi|dart|tune|host|hostrun|fresh|tbonly|usb4host|usb4query|usb4snapshot|usb4power|usb4pciec|tbtpciec - bounded diagnostic; hostrun/usb4host also enable xHCI DMA");
diff --git a/cmd/apple_cd321x.c b/cmd/apple_cd321x.c
