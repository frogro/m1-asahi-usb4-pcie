+	int (*write)(void *ctx, enum atc_m1_region region, u32 offset, u32 value);
+	void (*delay)(void *ctx, unsigned int us);
+	int (*verify_halted)(void *ctx);
+};
+
+int atc_m1_validate(const struct atc_m1_config *cfg);
