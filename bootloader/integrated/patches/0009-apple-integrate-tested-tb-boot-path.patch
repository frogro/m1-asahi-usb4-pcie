+static int tb_prepare_memory(void)
+{
+ struct resource resource; struct udevice *dart = NULL;
+ ofnode node = ofnode_path("/soc/iommu@521008000");
+ unsigned sid, i, residual=0; u32 value, tcr[64], ttbr[256], rid[64]; int ret;
+ if (!ofnode_device_is_compatible(node,"apple,t8103-usb4-dart") || ofnode_is_enabled(node)) return -ENODEV;
+ ret = ofnode_read_resource(node, 0, &resource);
+ if (ret || resource.start != 0x521008000ULL || resource_size(&resource) != 0x4000) return -ERANGE;
+ tb.dart_regs = map_sysmem(resource.start, 0x4000);
+ printf("TB-DART preflight config=%#x error=%#x enable=%#x/%#x\n",readl(tb.dart_regs+0x60),readl(tb.dart_regs+0x40),readl(tb.dart_regs+0xf8),readl(tb.dart_regs+0xfc));
+ if (readl(tb.dart_regs + 0x60) & BIT(15)) { puts("TB-DART locked\n"); return -EBUSY; }
+ if (readl(tb.dart_regs + 0x40) & BIT(31)) return -EFAULT;
