+static int tb_grub_boot_probe(void)
+{
+ const void *payload;
+ void *image = NULL;
+ struct efi_event *event = NULL;
+ efi_status_t status;
+ ulong dest = env_get_hex("fdt_addr_r", 0);
+ u8 digest[32]; char printed[65], command[128];
+ int length, ret; unsigned i;
+ if (!IS_ENABLED(CONFIG_EFI_VARIABLE_NO_STORE) || !tb.live || !tb.dma ||
+     tb.failed || !tb.files_loaded || !dest) return -EPERM;
+ if (ofnode_read_u32_default(ofnode_path("/config"),
+                             "u-boot,probe-grub-from-disk", 0) == 89) {
+  ret = tb_read_grub_disk(&image, &length);
+  if (ret) return ret;
+  payload = image;
+ } else {
+  payload = ofnode_get_property(ofnode_path("/config"), "u-boot,probe-grub-image", &length);
+ }
+ if (!payload || length != 1519616) { free(image); return -EINVAL; }
+ sha256_csum_wd(payload, length, digest, CHUNKSZ_SHA256);
+ for (i = 0; i < 32; i++) sprintf(printed + i * 2, "%02x", digest[i]);
+ if (strcmp(printed, "0a3863fd94e75ad999d2f4be13a23cb50a21edfaf5f33404b612bc0ae0eb633f")) {
+  free(image); return -EBADMSG;
+ }
+ tb_efi_check_dart = ofnode_read_u32_default(ofnode_path("/config"),
+                                          "u-boot,probe-checked-dart", 0) == 85;
+ ret = tb_linux_fdt((void *)dest, gd->fdt_blob, 0x200000);
+ if (ret) { free(image); return ret; }
+ if (!image) {
+  image = memalign(4096, ALIGN(length, 4096));
+  if (!image) return -ENOMEM;
+  memcpy(image, payload, length);
+ }
+ status = efi_create_event(EVT_SIGNAL_EXIT_BOOT_SERVICES, TPL_NOTIFY,
+                          tb_efi_exit_notify, NULL, NULL, &event);
+ if (status != EFI_SUCCESS) { free(image); return -EIO; }
+ snprintf(command, sizeof(command), "bootefi %lx:%x %lx", (ulong)image, length, dest);
+ puts("TB-GRUB81 ENTER; GRUB loads Linux from TB, cleanup at ExitBootServices\n");
+ ret = run_command(command, 0);
+ printf("TB-GRUB81 UNEXPECTED RETURN ret=%d exited=%u\n", ret, tb_efi_exit_done);
+ if (tb_efi_exit_done) { do_reset(NULL, 0, 0, NULL); hang(); }
+ EFI_CALL(efi_close_event(event));
+ free(image);
+ return -EIO;
+}
