+  return -EPERM;
+ cap = HC_LENGTH(xhci_readl(&hccr->cr_capbase));
+ slots_ports = xhci_readl(&hccr->cr_hcsparams1);
+ scratch = xhci_readl(&hccr->cr_hcsparams2);
+ dboff = xhci_readl(&hccr->cr_dboff);
+ rtsoff = xhci_readl(&hccr->cr_rtsoff);
+ pages = xhci_readl(&hcor->or_pagesize);
+ printf("M1-XHCI caps length=%#x slots_ports=%#x scratch=%#x dboff=%#x rtsoff=%#x pages=%#x\n",
+        cap, slots_ports, scratch, dboff, rtsoff, pages);
+ if (!xhci_m1_caps_valid(cap, slots_ports, scratch, dboff, rtsoff, pages))
+  return -EPROTO;
