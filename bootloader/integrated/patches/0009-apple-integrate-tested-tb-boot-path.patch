+/* Diagnostic only. Use the normal allocator/reset/start path with a fresh,
+ * separately owned context. Do not restore the freed device private context,
+ * enumerate USB children, ring transfer doorbells or free uncertain DMA.
+ */
+static bool m1_diag_attempted;
+
+static bool xhci_m1_caps_valid(u32 cap, u32 slots_ports, u32 scratch,
+                              u32 dboff, u32 rtsoff, u32 pages)
+{
+ unsigned int nsp = HCS_MAX_SCRATCHPAD(scratch);
+ unsigned int nports = HCS_MAX_PORTS(slots_ports);
+ unsigned int slots = slots_ports & HCS_SLOTS_MASK;
+ unsigned int intrs = HCS_MAX_INTRS(slots_ports);
+ u32 op_end, runtime_size, doorbell_size;
+
+ if (cap < 0x20 || cap > 0x100 || (cap & 3) || !slots ||
+     !nports || nports > 16 || !intrs || intrs > 128 ||
+     nsp > 64 || !(pages & 0xffff) || (dboff & 3) || (rtsoff & 31))
+  return false;
+ /* Operational ports start at 0x400; each PORT/IR register set is 16/32
+  * bytes. Use capability-provided offsets, like xhci_mem_init(), rather
+  * than assuming a minimum of 0x1000. Keep complete register regions
+  * within the diagnostic's original 0xa000 aperture bound.
+  */
+ op_end = cap + 0x400 + nports * 0x10;
+ runtime_size = 0x20 + intrs * 0x20;
+ doorbell_size = (slots + 1) * 4;
+ return rtsoff >= op_end && rtsoff <= 0xa000 - runtime_size &&
+        dboff >= op_end && dboff <= 0xa000 - doorbell_size &&
+        (rtsoff + runtime_size <= dboff ||
+         dboff + doorbell_size <= rtsoff);
+}
+
+static int xhci_m1_diag_port_power(struct xhci_ctrl *ctrl)
+{
+ unsigned int i, ports = HCS_MAX_PORTS(xhci_readl(&ctrl->hccr->cr_hcsparams1));
+ bool ppc = HCC_PPC(xhci_readl(&ctrl->hccr->cr_hccparams));
+ u32 state;
+ if (!ports || ports > 16) return -EPROTO;
+ for (i = 0; i < ports; i++) {
+  state = xhci_readl(&ctrl->hcor->portregs[i].or_portsc);
+  if (state == ~0U) return -ENODEV;
+  if (ppc && !(state & PORT_POWER)) {
+   /* Same neutral RWS mask as USB_PORT_FEAT_POWER; no reset/W1C writes. */
+   xhci_writel(&ctrl->hcor->portregs[i].or_portsc,
+               xhci_port_state_to_neutral(state) | PORT_POWER);
+   state = xhci_readl(&ctrl->hcor->portregs[i].or_portsc);
+   if (state == ~0U || !(state & PORT_POWER)) return -EIO;
+  }
+  printf("M1-XHCI port%u power-control=%u status=%#x\n", i + 1, ppc, state);
