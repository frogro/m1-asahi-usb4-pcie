+  tcr[sid]=readl(tb.dart_regs+0x100+sid*4);
+  for(i=0;i<4;i++){ttbr[sid*4+i]=readl(tb.dart_regs+0x400+sid*16+i*4);if(ttbr[sid*4+i])residual++;}
