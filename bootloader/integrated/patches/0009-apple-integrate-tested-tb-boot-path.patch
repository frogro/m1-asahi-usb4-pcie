-	u8 first_data[5];
+	u8 first_data[5], first_tbt[9];
 	int ret;
 
 	if (!read || !status)
@@ -63,6 +74,21 @@ int apple_cd321x_snapshot(apple_cd321x_read read, void *ctx,
 		result.usb4_mode = buf[0];
 		result.eudo = get_unaligned_le32(buf + 1);
 	}
+	if (result.data_status & BIT(16)) {
+		if (result.data_status & BIT(23))
+			return -EPROTONOSUPPORT;
+		/* Intel VID status layout matches Linux tipd: 1+4+2+2 bytes. */
+		ret = read_block(read, ctx, 0x59, first_tbt, 9);
