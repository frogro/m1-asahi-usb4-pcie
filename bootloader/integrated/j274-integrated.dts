		power-management@23b738000 {
			reg = <0x02 0x3b738000 0x00 0x1000 0x02 0x3bc3c000 0x00 0x1000>;
			reg-names = "dcp-bw-scratch", "dcp-bw-doorbell";
			#apple,bw-scratch-cells = <0x03>;
			#apple,bw-doorbell-cells = <0x02>;
			phandle = <0x22>;
		};

		reset-controller@23b784000 {
			status = "disabled";
			compatible = "apple,t8103-cio-reset";
			reg = <0x02 0x3b784000 0x00 0x8000>;
			#reset-cells = <0x01>;
			phandle = <0xa4>;
		};

		pinctrl@23c100000 {
			compatible = "apple,t8103-pinctrl", "apple,pinctrl";
			reg = <0x02 0x3c100000 0x00 0x100000>;
			power-domains = <0x84>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x3f 0x00 0x00 0xd4>;
			apple,npins = <0xd4>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0xbe 0x04 0x00 0xbf 0x04 0x00 0xc0 0x04 0x00 0xc1 0x04 0x00 0xc2 0x04 0x00 0xc3 0x04 0x00 0xc4 0x04>;
			phandle = <0x3f>;

			i2c0-pins {
				pinmux = <0x100c0 0x100bc>;
				phandle = <0x3d>;
			};

			i2c1-pins {
				pinmux = <0x100c9 0x100c7>;
				phandle = <0x46>;
			};

			i2c2-pins {
				pinmux = <0x100a3 0x100a2>;
				phandle = <0x48>;
			};

			i2c3-pins {
				pinmux = <0x10049 0x10048>;
				phandle = <0x4b>;
			};

			i2c4-pins {
				pinmux = <0x10087 0x10086>;
				phandle = <0x4d>;
			};

			spi0-pins {
				pinmux = <0x10043 0x10044 0x10045>;
				phandle = <0x51>;
			};

			spi1-pins {
				pinmux = <0x1002a 0x1002b 0x1002c 0x1002d>;
				phandle = <0x53>;
			};

			spi3-pins {
				pinmux = <0x1002e 0x1002f 0x10030 0x10031>;
				phandle = <0x56>;
			};

			pcie-pins {
				pinmux = <0x10096 0x10097 0x10020>;
				phandle = <0xd2>;
			};
		};

		spmi@23d0d9300 {
			compatible = "apple,t8103-spmi", "apple,spmi";
			reg = <0x02 0x3d0d9300 0x00 0x100>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;

			pmic@f {
				compatible = "apple,sera-pmic", "apple,spmi-nvmem";
				reg = <0x0f 0x00>;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					boot-stage@9f01 {
						reg = <0x9f01 0x01>;
						phandle = <0x8b>;
					};

					boot-error-count@9f02,0 {
						reg = <0x9f02 0x01>;
						bits = <0x00 0x04>;
						phandle = <0x8c>;
					};

					panic-count@9f02,4 {
						reg = <0x9f02 0x01>;
						bits = <0x04 0x04>;
						phandle = <0x8d>;
					};

					boot-error-stage@9f03 {
						reg = <0x9f03 0x01>;
					};

					shutdown-flag@9f0f,3 {
						reg = <0x9f0f 0x01>;
						bits = <0x03 0x01>;
						phandle = <0x8a>;
					};

					fault-shadow@a67b {
						reg = <0xa67b 0x10>;
					};

					socd@ab00 {
						reg = <0xab00 0x400>;
					};

					pm-setting@d001 {
						reg = <0xd001 0x01>;
						phandle = <0x8e>;
