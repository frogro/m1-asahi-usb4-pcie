				status = "okay";
				bus-range = <0x02 0x02>;
				phandle = <0xd5>;
			};

			pci@2,0 {
				device_type = "pci";
				reg = <0x1000 0x00 0x00 0x00 0x00>;
				reset-gpios = <0x3f 0x21 0x01>;
				#address-cells = <0x03>;
				#size-cells = <0x02>;
				ranges;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				interrupt-map-mask = <0x00 0x00 0x00 0x07>;
				interrupt-map = <0x00 0x00 0x00 0x01 0xd6 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0xd6 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x03 0xd6 0x00 0x00 0x00 0x02 0x00 0x00 0x00 0x04 0xd6 0x00 0x00 0x00 0x03>;
				status = "okay";
				bus-range = <0x03 0x03>;
				phandle = <0xd6>;

				ethernet@0,0 {
					reg = <0x30000 0x00 0x00 0x00 0x00>;
					local-mac-address = [00 10 18 00 00 00];
				};
			};
		};
	};

	chosen {
		u-boot,integration = "20261101-usb4-integrated-rc3";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			power-domains = <0x1f>;
			status = "disabled";
		};
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x08 0x00 0x02 0x00>;
	};

	sound {
		compatible = "apple,j274-macaudio", "apple,macaudio";
		model = "Mac mini J274";

		dai-link@0 {
			link-name = "Speaker";

			cpu {
				sound-dai = <0xd7 0x00>;
			};

			codec {
				sound-dai = <0xd8>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <0xd7 0x02>;
			};

			codec {
				sound-dai = <0xd9>;
			};
		};
	};
};
