/dts-v1/;

/ {
	compatible = "apple,j274", "apple,t8103", "apple,arm-platform";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Apple Mac mini (M1, 2020)";
	chassis-type = "desktop";

	config {
		u-boot,tb-efi-boot;
		u-boot,tb-linux-tree = <0x48>;
		bootcmd = "echo Asahi Linux integrated U-Boot EFI boot; tbboot";
		bootdelay = <0x03>;
		u-boot,probe-pciec-debug = <0x1000 0x01 0x00>;
		u-boot,probe-pciec-fabric = <0x04 0x1f001f 0x180018 0x08 0x01 0x01 0x0c 0x01 0x01 0x10 0x801f 0x04 0x18 0x3ff 0x280 0x44 0x01 0x01 0x94 0x801f 0x04 0x9c 0x801f 0x04 0x20 0x801f 0x04 0x28 0x3f 0x20 0x2c 0x801f 0x04 0x34 0x3f 0x20 0x38 0x801f 0x04 0x40 0x10001 0x10001 0x48 0x01 0x01 0x4c 0x801f 0x04 0x54 0x7f007f 0x4b004b 0x58 0x801f 0x04 0x60 0x801f 0x04 0x68 0x01 0x01 0x6c 0x801f 0x04 0x74 0x01 0x01 0x78 0x801f 0x04 0x84 0x801f 0x04 0x8c 0x01 0x01 0x90 0x01 0x01 0xa4 0x801f 0x04>;
		u-boot,probe-pciec-port0 = <0x140 0x01 0x01>;
		u-boot,probe-pciec-oe-fabric = <0x04 0x70007 0x40004 0x08 0x01 0x01 0x0c 0x01 0x01 0x10 0x801f 0x04 0x18 0x7f007f 0x450045 0x1c 0x801f 0x04 0x24 0x801f 0x04 0x2c 0x01 0x01 0x30 0x01 0x01 0x34 0x801f 0x04>;
		u-boot,probe-pciec-config = <0x718 0x7c000 0x00 0x8bc 0x01 0x00 0x78 0x7000 0x00 0x814 0xffffffff 0xf060>;
	};

	aliases {
		gpu = "/soc/gpu@206400000";
		usb4_1_pcie_adapter = "/soc/cio@501ac0000";
		usb4_1_pcie = "/soc/pcie@530000000";
		bluetooth0 = "/soc/pcie@690000000/pci@0,0/bluetooth@0,1";
		dcp = "/soc/dcp@231c00000";
		disp0 = "/soc/display-subsystem";
		disp0_piodma = "/soc/dcp@231c00000/piodma";
		disp0-piodma = "/soc/dcp@231c00000/piodma";
		serial0 = "/soc/serial@235200000";
		serial2 = "/soc/serial@235208000";
		wifi0 = "/soc/pcie@690000000/pci@0,0/wifi@0,0";
		atcphy0 = "/soc/phy@383000000";
		atcphy1 = "/soc/phy@503000000";
		usb4-0-acio = "/soc/cio@381ac0000";
		usb4-0-nhi = "/soc/cio@381ac0000/nhi@f00000";
		usb4-1-acio = "/soc/cio@501ac0000";
		usb4-1-nhi = "/soc/cio@501ac0000/nhi@f00000";
		usb4_0_rc = "/soc/cio@381ac0000";
		usb4_0_nhi = "/soc/cio@381ac0000/nhi@f00000";
		usb4_1_rc = "/soc/cio@501ac0000";
		usb4_1_nhi = "/soc/cio@501ac0000/nhi@f00000";
		nvram = "/soc/spi@235104000/flash@0/partitions/partition@700000";
		ethernet0 = "/soc/pcie@690000000/pci@2,0/ethernet@0,0";
		sio = "/soc/sio@236400000";
		dcpext = "/soc/dcp@271c00000";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x01>;
				};

				core1 {
					cpu = <0x02>;
				};

				core2 {
					cpu = <0x03>;
				};

				core3 {
					cpu = <0x04>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x05>;
				};

				core1 {
					cpu = <0x06>;
				};

				core2 {
					cpu = <0x07>;
				};

				core3 {
					cpu = <0x08>;
				};
			};
		};

		cpu@0 {
			compatible = "apple,icestorm";
			device_type = "cpu";
			reg = <0x00 0x00>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x09>;
			capacity-dmips-mhz = <0x2ca>;
			performance-domains = <0x0a>;
			next-level-cache = <0x0b>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			phandle = <0x01>;
		};

		cpu@1 {
			compatible = "apple,icestorm";
			device_type = "cpu";
			reg = <0x00 0x01>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x09>;
			capacity-dmips-mhz = <0x2ca>;
			performance-domains = <0x0a>;
			next-level-cache = <0x0b>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			phandle = <0x02>;
		};

		cpu@2 {
			compatible = "apple,icestorm";
			device_type = "cpu";
			reg = <0x00 0x02>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x09>;
			capacity-dmips-mhz = <0x2ca>;
			performance-domains = <0x0a>;
			next-level-cache = <0x0b>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			phandle = <0x03>;
		};

		cpu@3 {
			compatible = "apple,icestorm";
			device_type = "cpu";
			reg = <0x00 0x03>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x09>;
			capacity-dmips-mhz = <0x2ca>;
			performance-domains = <0x0a>;
			next-level-cache = <0x0b>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			phandle = <0x04>;
		};

		cpu@10100 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10100>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x0c>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x0d>;
			next-level-cache = <0x0e>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			phandle = <0x05>;
		};

		cpu@10101 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10101>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x0c>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x0d>;
			next-level-cache = <0x0e>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			phandle = <0x06>;
		};

		cpu@10102 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10102>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x0c>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x0d>;
			next-level-cache = <0x0e>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			phandle = <0x07>;
		};

		cpu@10103 {
			compatible = "apple,firestorm";
			device_type = "cpu";
			reg = <0x00 0x10103>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x0c>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x0d>;
			next-level-cache = <0x0e>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			phandle = <0x08>;
		};

		l2-cache-0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x400000>;
			phandle = <0x0b>;
		};

		l2-cache-1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0xc00000>;
			phandle = <0x0e>;
		};
	};

	opp-table-0 {
		compatible = "operating-points-v2";
		phandle = <0x09>;

		opp01 {
			opp-hz = <0x00 0x23c34600>;
			opp-level = <0x01>;
			clock-latency-ns = <0x1d4c>;
			opp-microwatt = <0xb8c0>;
		};

		opp02 {
			opp-hz = <0x00 0x39ef8b00>;
			opp-level = <0x02>;
			clock-latency-ns = <0x55f0>;
			opp-microwatt = <0x18583>;
		};

		opp03 {
			opp-hz = <0x00 0x4f64b500>;
			opp-level = <0x03>;
			clock-latency-ns = <0x6978>;
			opp-microwatt = <0x2e1bc>;
		};

		opp04 {
			opp-hz = <0x00 0x6590fa00>;
			opp-level = <0x04>;
			clock-latency-ns = <0x80e8>;
			opp-microwatt = <0x4687b>;
		};

		opp05 {
			opp-hz = <0x00 0x7b062400>;
			opp-level = <0x05>;
			clock-latency-ns = <0xc350>;
			opp-microwatt = <0x64d33>;
		};
	};

	opp-table-1 {
		compatible = "operating-points-v2";
		phandle = <0x0c>;

		opp01 {
			opp-hz = <0x00 0x23c34600>;
			opp-level = <0x01>;
			clock-latency-ns = <0x1f40>;
			opp-microwatt = <0x46db6>;
		};

		opp02 {
			opp-hz = <0x00 0x315a4700>;
			opp-level = <0x02>;
			clock-latency-ns = <0x4a38>;
			opp-microwatt = <0x6d9f5>;
		};

		opp03 {
			opp-hz = <0x00 0x3ef14800>;
			opp-level = <0x03>;
			clock-latency-ns = <0x5208>;
			opp-microwatt = <0x9dfb9>;
		};

		opp04 {
			opp-hz = <0x00 0x4c884900>;
			opp-level = <0x04>;
			clock-latency-ns = <0x59d8>;
			opp-microwatt = <0xd3554>;
		};

		opp05 {
			opp-hz = <0x00 0x59682f00>;
			opp-level = <0x05>;
			clock-latency-ns = <0x5dc0>;
			opp-microwatt = <0x10fb06>;
		};

		opp06 {
			opp-hz = <0x00 0x66ff3000>;
			opp-level = <0x06>;
			clock-latency-ns = <0x7148>;
			opp-microwatt = <0x162cd7>;
		};

		opp07 {
			opp-hz = <0x00 0x74963100>;
			opp-level = <0x07>;
			clock-latency-ns = <0x7918>;
			opp-microwatt = <0x1b1c1b>;
		};

		opp08 {
			opp-hz = <0x00 0x822d3200>;
			opp-level = <0x08>;
			clock-latency-ns = <0x84d0>;
			opp-microwatt = <0x241ce2>;
		};

		opp09 {
			opp-hz = <0x00 0x8e55fd00>;
			opp-level = <0x09>;
			clock-latency-ns = <0x8ca0>;
			opp-microwatt = <0x2c21a1>;
		};

		opp10 {
			opp-hz = <0x00 0x9a7ec800>;
			opp-level = <0x0a>;
			clock-latency-ns = <0xc738>;
			opp-microwatt = <0x3507d9>;
		};

		opp11 {
			opp-hz = <0x00 0xa5395d00>;
			opp-level = <0x0b>;
			clock-latency-ns = <0xd2f0>;
			opp-microwatt = <0x3c6a72>;
		};

		opp12 {
			opp-hz = <0x00 0xb2194300>;
			opp-level = <0x0c>;
			clock-latency-ns = <0xd6d8>;
			opp-microwatt = <0x4548cc>;
		};

		opp13 {
			opp-hz = <0x00 0xb8893600>;
			opp-level = <0x0d>;
			clock-latency-ns = <0xd6d8>;
			opp-microwatt = <0x486747>;
			turbo-mode;
		};

		opp14 {
			opp-hz = <0x00 0xbb65a200>;
			opp-level = <0x0e>;
			clock-latency-ns = <0xdac0>;
			opp-microwatt = <0x499576>;
			turbo-mode;
		};

		opp15 {
			opp-hz = <0x00 0xbef92900>;
			opp-level = <0x0f>;
			clock-latency-ns = <0xdac0>;
			opp-microwatt = <0x4b8d1c>;
			turbo-mode;
		};
	};

	opp-table-gpu {
		compatible = "operating-points-v2";
		phandle = <0x18>;

		opp00 {
			opp-hz = <0x00 0x00>;
			opp-microvolt = <0x61a80>;
			opp-microwatt = <0x00>;
		};

		opp01 {
			opp-hz = <0x00 0x179a7b00>;
			opp-microvolt = <0x93378>;
			opp-microwatt = <0x38ae82>;
		};

		opp02 {
			opp-hz = <0x00 0x1f78a400>;
			opp-microvolt = <0x9c400>;
			opp-microwatt = <0x4d907c>;
		};

		opp03 {
			opp-hz = <0x00 0x2aea5400>;
			opp-microvolt = <0xa8750>;
			opp-microwatt = <0x715d04>;
		};

		opp04 {
			opp-hz = <0x00 0x37131f00>;
			opp-microvolt = <0xbf680>;
			opp-microwatt = <0xb2fea8>;
		};

		opp05 {
			opp-hz = <0x00 0x433bea00>;
			opp-microvolt = <0xd2730>;
			opp-microwatt = <0x1038ada>;
		};

		opp06 {
			opp-hz = <0x00 0x4c2cbb80>;
			opp-microvolt = <0xe34b8>;
			opp-microwatt = <0x12a5318>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x0f>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <0x01 0x02 0x04 0x01 0x03 0x04 0x01 0x00 0x04 0x01 0x01 0x04>;
	};

	pmu-e {
		compatible = "apple,icestorm-pmu";
		interrupt-parent = <0x0f>;
		interrupts = <0x01 0x04 0x04>;
	};

	pmu-p {
		compatible = "apple,firestorm-pmu";
		interrupt-parent = <0x0f>;
		interrupts = <0x01 0x05 0x04>;
	};

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x3c>;
	};

	clock-120m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x7270e00>;
		clock-output-names = "clk_120m";
		phandle = <0x55>;
	};

	clock-200m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbebc200>;
		clock-output-names = "clk_200m";
		phandle = <0x50>;
	};

	clock-disp0 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x1fca0550>;
		clock-output-names = "clk_disp0";
		phandle = <0x23>;
	};

	clock-dispext0 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "clk_dispext0";
		phandle = <0x9d>;
	};

	clock-ref-nco {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-output-names = "nco_ref";
		clock-frequency = <0x35a4e900>;
		phandle = <0x6c>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		globals {
			status = "disabled";
			phandle = <0x17>;
		};

		hw-cal-a {
			status = "disabled";
			phandle = <0x15>;
		};

		hw-cal-b {
			status = "disabled";
			phandle = <0x16>;
		};

		uat-handoff@10 {
			reg = <0x00 0x10 0x00 0x00>;
			phandle = <0x14>;
		};

		uat-pagetables@20 {
			reg = <0x00 0x20 0x00 0x00>;
			phandle = <0x13>;
		};

		uat-ttbs@30 {
			reg = <0x00 0x30 0x00 0x00>;
			phandle = <0x12>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		nonposted-mmio;
		dma-ranges = <0x00 0x00 0x00 0x00 0xffffffff 0xffffc000>;

		iommu@521008000 {
			compatible = "apple,t8103-usb4-dart";
			reg = <0x05 0x21008000 0x00 0x4000>;
			status = "disabled";
			#iommu-cells = <0x01>;
		};

		pcie@530000000 {
			status = "disabled";
			compatible = "apple,t8103-pciec";
			reg = <0x05 0x30000000 0x00 0x10000000 0x05 0x20000000 0x00 0x4000 0x05 0x21000000 0x00 0x8000 0x05 0x20004000 0x00 0x4000 0x05 0x20200000 0x00 0x4000 0x05 0x21010000 0x00 0x4000 0x05 0x20008000 0x00 0x4000>;
			reg-names = "config", "rc", "port0", "fabric", "debug", "ltssm", "oe-fabric";
			#address-cells = <0x03>;
			#size-cells = <0x02>;

			pci@0,0 {
				status = "disabled";
				reg = <0x00 0x00 0x00 0x00 0x00>;
			};
		};

		gpu@206400000 {
			compatible = "apple,agx-t8103", "apple,agx-g13g";
			reg = <0x02 0x6400000 0x00 0x40000 0x02 0x4000000 0x00 0x1000000>;
			reg-names = "asc", "sgx";
			mboxes = <0x10>;
			power-domains = <0x11>;
			memory-region = <0x12 0x13 0x14 0x15 0x16 0x17>;
			memory-region-names = "ttbs", "pagetables", "handoff", "hw-cal-a", "hw-cal-b", "globals";
			apple,firmware-abi = <0x00 0x00 0x00>;
			apple,firmware-version = <0x0c 0x03 0x00>;
			apple,firmware-compat = <0x0c 0x03 0x00>;
			operating-points-v2 = <0x18>;
			apple,perf-base-pstate = <0x03>;
			apple,min-sram-microvolt = <0xcf850>;
			apple,avg-power-filter-tc-ms = <0x3e8>;
			apple,avg-power-ki-only = <0x40f00000>;
			apple,avg-power-kp = <0x40800000>;
			apple,avg-power-min-duty-cycle = <0x28>;
			apple,avg-power-target-filter-tc = <0x7d>;
			apple,fast-die0-integral-gain = "CH", "";
			apple,fast-die0-proportional-gain = <0x40a00000>;
			apple,perf-filter-drop-threshold = <0x00>;
			apple,perf-filter-time-constant = <0x05>;
			apple,perf-filter-time-constant2 = <0x32>;
			apple,perf-integral-gain2 = <0x3e4a2121>;
			apple,perf-integral-min-clamp = <0x00>;
			apple,perf-proportional-gain2 = <0x40db53d0>;
			apple,perf-tgt-utilization = <0x55>;
			apple,power-sample-period = <0x08>;
			apple,power-zones = <0x7530 0x64 0x1adb>;
			apple,ppm-filter-time-constant-ms = <0x64>;
			apple,ppm-ki = <0x42b70000>;
			apple,ppm-kp = <0x40dccccd>;
			apple,pwr-filter-time-constant = <0x139>;
			apple,pwr-integral-gain = <0x3ca59586>;
			apple,pwr-integral-min-clamp = <0x00>;
			apple,pwr-min-duty-cycle = <0x28>;
			apple,pwr-proportional-gain = <0x40a90fdb>;
			apple,core-leak-coef = "Dz", "";
			apple,sram-leak-coef = "B4", "";
		};

		mbox@206408000 {
			compatible = "apple,t8103-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x02 0x6408000 0x00 0x4000>;
			interrupt-parent = <0x0f>;
			interrupts = <0x00 0x23f 0x04 0x00 0x240 0x04 0x00 0x241 0x04 0x00 0x242 0x04>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			#mbox-cells = <0x00>;
			phandle = <0x10>;
		};

		performance-controller@210e20000 {
			compatible = "apple,t8103-cluster-cpufreq", "apple,cluster-cpufreq";
			reg = <0x02 0x10e20000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x0a>;
		};

		performance-controller@211e20000 {
			compatible = "apple,t8103-cluster-cpufreq", "apple,cluster-cpufreq";
			reg = <0x02 0x11e20000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x0d>;
		};

		display-pipe@228200000 {
			compatible = "apple,t8103-display-pipe", "apple,h7-display-pipe";
			reg = <0x02 0x28200000 0x00 0xc000 0x02 0x28400000 0x00 0x4000>;
