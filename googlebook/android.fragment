# Android additions to the pinned Ubuntu-Asahi kernel config.
# Kconfig and build validated; native Android boot validation is ongoing.
# Preserve all Apple/Rust/IOMMU/firmware requirements from the distro config.
CONFIG_ARM64_16K_PAGES=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf"
CONFIG_EROFS_FS=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_VERITY=y
# Load GPU/display/USB modules from a matching early initramfs initially.
# Do not copy OP-TEE or Rockchip options from android-crypto.config.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DM_BOW=y
CONFIG_DM_USER=y
CONFIG_INCREMENTAL_FS=y
CONFIG_MEMFD_ASHMEM_SHIM=y
CONFIG_UID_SYS_STATS=y
CONFIG_CPU_FREQ_TIMES=y
CONFIG_CRYPTO_CTS=y
# Distro certificate paths are absent in this local development build.

# Android AVB hashtrees include forward-error-correction arguments.
CONFIG_DM_VERITY_FEC=y
# Googlebook init mounts the legacy cpuset controller.
CONFIG_CPUSETS_V1=y
# ext4 quota format required by Android userdata
CONFIG_QFMT_V2=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_DM=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_QUOTA=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_PSI=y
CONFIG_MEMFD_CREATE=y
CONFIG_ANON_VMA_NAME=y
CONFIG_FUSE_FS=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_KVM=y
CONFIG_LOCALVERSION="-googlebook-usb4-egpu1"
CONFIG_VERSION_SIGNATURE="Googlebook Asahi 7.2.12 usb4-egpu1 experimental"
CONFIG_IKCONFIG=m
CONFIG_IKCONFIG_PROC=y
