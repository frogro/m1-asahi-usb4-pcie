+struct file_system_type incfs_fs_type = {
+	.owner			= THIS_MODULE,
+	.name			= INCFS_NAME,
+	.init_fs_context	= incfs_init_fs_context,
+	.parameters		= incfs_param_specs,
+	.kill_sb		= incfs_kill_sb,
