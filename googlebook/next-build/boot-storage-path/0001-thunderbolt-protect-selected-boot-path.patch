--- a/drivers/thunderbolt/switch.c
+++ b/drivers/thunderbolt/switch.c
@@ -18,6 +18,11 @@
 #include <linux/string_helpers.h>
 
 #include "tb.h"
+
+/* Opt-in: retain the selected boot router and its live ancestor path. */
+static char boot_protect_uuid[UUID_STRING_LEN + 1];
+module_param_string(boot_protect_uuid, boot_protect_uuid, sizeof(boot_protect_uuid), 0400);
+MODULE_PARM_DESC(boot_protect_uuid, "Prevent deauthorization of the selected boot router UUID and its live ancestors");
 
 /* Switch NVM support */
 
@@ -1824,6 +1829,34 @@
 	return 0;
 }
 
+/* Called with the domain lock held, before recursive deauthorization. */
+static bool tb_switch_on_protected_boot_path(struct tb_switch *sw)
+{
+	struct tb_switch *boot, *ancestor;
+	uuid_t protected;
+	bool found = false;
+
+	if (!boot_protect_uuid[0] || !tb_route(sw) ||
+	    uuid_parse(boot_protect_uuid, &protected))
+		return false;
+
+	boot = tb_switch_find_by_uuid(sw->tb, &protected);
+	if (!boot)
+		return false;
+
+	/* A present, authorized boot router proves its live ancestor chain. */
+	if (boot->authorized) {
+		for (ancestor = boot; ancestor; ancestor = tb_switch_parent(ancestor)) {
+			if (ancestor == sw) {
+				found = true;
+				break;
+			}
+		}
+	}
+	tb_switch_put(boot);
+	return found;
+}
+
 static int tb_switch_set_authorized(struct tb_switch *sw, unsigned int val)
 {
 	char envp_string[13];
@@ -1832,6 +1865,14 @@
 
 	if (!mutex_trylock(&sw->tb->lock))
 		return restart_syscall();
+
+	if (!val && sw->authorized && tb_switch_on_protected_boot_path(sw)) {
+		dev_warn_ratelimited(&sw->dev,
+		    "BOOT_STORAGE_GUARD: deauthorization denied route=%llx boot_uuid=%s pid=%d comm=%s\n",
+		    tb_route(sw), boot_protect_uuid, current->pid, current->comm);
+		ret = -EBUSY;
+		goto unlock;
+	}
 
 	if (!!sw->authorized == !!val)
 		goto unlock;
