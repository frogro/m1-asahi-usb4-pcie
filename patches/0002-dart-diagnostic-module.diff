+
+/* Test-only validation of the actual DART private stream map. */
+int apple_apciec_dart_validate(struct device *dev, u32 sid);
+int apple_apciec_dart_validate(struct device *dev, u32 sid)
+{
+ struct iommu_fwspec *spec = dev_iommu_fwspec_get(dev);
+ struct apple_dart_master_cfg *cfg;
+ struct device_node *np;
+ int i, maps = 0;
+ if (!spec) return -ENODEV;
+ np = to_of_node(spec->iommu_fwnode);
+ if (!of_device_is_compatible(np, "codex,t8103-apciec-dart-test"))
+  return -ENODEV;
+ cfg = dev_iommu_priv_get(dev);
+ if (!cfg) return -ENODEV;
+ for (i = 0; i < MAX_DARTS_PER_DEVICE; i++) {
+  struct apple_dart_stream_map *map = &cfg->stream_maps[i];
+  if (!map->dart) continue;
+  if (sid >= map->dart->num_streams ||
+      !test_bit(sid, map->sidmap) ||
+      bitmap_weight(map->sidmap, map->dart->num_streams) != 1)
+   return -EINVAL;
+  maps++;
+ }
+ return maps == 1 ? 0 : -EINVAL;
+}
+EXPORT_SYMBOL_GPL(apple_apciec_dart_validate);
 
