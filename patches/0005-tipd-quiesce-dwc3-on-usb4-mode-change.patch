@@ -2353,6 +2353,9 @@
 		target_mode = APPLE_ATCPHY_MODE_OFF;
 	}
 
+	dev_info(atcphy->dev, "USB4TEST mux state=%#lx mode=%d->%d pipehandler=%d\n",
+		 state->mode, atcphy->mode, target_mode, atcphy->pipehandler_up);
+
 	if (atcphy->mode == target_mode)
 		return 0;
 
