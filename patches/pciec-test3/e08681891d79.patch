From e08681891d79057164916dc4a076c1b21f5f14f7 Mon Sep 17 00:00:00 2001
From: Chris Kearney <303316+iconidentify@users.noreply.github.com>
Date: Wed, 23 Sep 2026 10:56:26 -0700
Subject: [PATCH] arm64: dts: apple: t8103: describe Thunderbolt PCIe
 enumeration resources
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

t8103 boots with the Thunderbolt PCIe port held in reset. Bring the
port up when the tunnel activates, and do it before the port's IOMMU
probes: that IOMMU's invalidate command does not finish while the port
clock is still gated.

Program the port tunables and the reset table, release PERST, enable
the port clock, then program the root-port configuration tunables.
Link training stays in the host driver. If the port is already
running, the host does not replay the reset table. Endpoint memory on
t8103 is left posted.

The PCIe-C IOMMU uses the 64-stream USB4 register block: 16 KiB pages,
a 32-bit IOVA and a 36-bit physical address. The 42-bit four-level
geometry remains on T8110, which is the hardware that walks it.

An xHCI early handoff no longer faults when the capability length read
from a BAR is shorter than 16 bytes or not dword-aligned.

Tested on a MacBook Pro 13" M1 (j293) with a CalDigit TS3 Plus on
USB-1. The tunnel enumerated the dock bridges, four USB host
controllers and an I210. The USB devices and a gigabit link came up,
and the display on the same port still comes up.

[ryan: adapted to 7.2.10 — split: DT part only; the PCI, DART, thunderbolt and xhci parts go with 080-radio and 170-usb]
Signed-off-by: Chris Kearney <303316+iconidentify@users.noreply.github.com>
---
 .../boot/dts/apple/t8103-pciec-tunables.dtsi  | 50 +++++++++++++++++++
 arch/arm64/boot/dts/apple/t8103.dtsi          | 32 ++++++++----
 2 files changed, 72 insertions(+), 10 deletions(-)
 create mode 100644 arch/arm64/boot/dts/apple/t8103-pciec-tunables.dtsi

diff --git a/arch/arm64/boot/dts/apple/t8103-pciec-tunables.dtsi b/arch/arm64/boot/dts/apple/t8103-pciec-tunables.dtsi
new file mode 100644
index 00000000000000..2265bdab1cba3c
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8103-pciec-tunables.dtsi
@@ -0,0 +1,50 @@
+/* t8103 Thunderbolt PCIe configuration, shared by both ports.
+ * Offsets are relative to the region named by each property.
+ */
+apple,pciec-kernel-init;
+apple,tunable-rc =
+	<0x718 0x7c000 0x0>,
+	<0x8bc 0x1 0x0>,
+	<0x78 0x7000 0x0>,
+	<0x814 0xffffffff 0xf060>;
+apple,tunable-fabric =
+	<0x4 0x1f001f 0x180018>,
+	<0x8 0x1 0x1>,
+	<0xc 0x1 0x1>,
+	<0x10 0x801f 0x4>,
+	<0x18 0x3ff 0x280>,
+	<0x44 0x1 0x1>,
+	<0x94 0x801f 0x4>,
+	<0x9c 0x801f 0x4>,
+	<0x20 0x801f 0x4>,
+	<0x28 0x3f 0x20>,
+	<0x2c 0x801f 0x4>,
+	<0x34 0x3f 0x20>,
+	<0x38 0x801f 0x4>,
+	<0x40 0x10001 0x10001>,
+	<0x48 0x1 0x1>,
+	<0x4c 0x801f 0x4>,
+	<0x54 0x7f007f 0x4b004b>,
+	<0x58 0x801f 0x4>,
+	<0x60 0x801f 0x4>,
+	<0x68 0x1 0x1>,
+	<0x6c 0x801f 0x4>,
+	<0x74 0x1 0x1>,
+	<0x78 0x801f 0x4>,
+	<0x84 0x801f 0x4>,
+	<0x8c 0x1 0x1>,
+	<0x90 0x1 0x1>,
+	<0xa4 0x801f 0x4>;
+apple,tunable-debug =
+	<0x1000 0x1 0x0>;
+apple,tunable-oe-fabric =
+	<0x4 0x70007 0x40004>,
+	<0x8 0x1 0x1>,
+	<0xc 0x1 0x1>,
+	<0x10 0x801f 0x4>,
+	<0x18 0x7f007f 0x450045>,
+	<0x1c 0x801f 0x4>,
+	<0x24 0x801f 0x4>,
+	<0x2c 0x1 0x1>,
+	<0x30 0x1 0x1>,
+	<0x34 0x801f 0x4>;
diff --git a/arch/arm64/boot/dts/apple/t8103.dtsi b/arch/arm64/boot/dts/apple/t8103.dtsi
index daa23f4ab489e5..ba13c756900c55 100644
--- a/arch/arm64/boot/dts/apple/t8103.dtsi
+++ b/arch/arm64/boot/dts/apple/t8103.dtsi
@@ -1572,8 +1572,11 @@
 		usb4_0_acio: cio@381ac0000 {
 			compatible = "apple,t8103-usb4-acio";
 			reg = <0x3 0x81ac0000 0x0 0xc000>,
-				<0x3 0x81080000 0x0 0x20000>;
-			reg-names = "rc", "sram";
+				<0x3 0x81080000 0x0 0x20000>,
+				<0x3 0x81e44000 0x0 0x4000>;
+			reg-names = "rc", "sram", "pcie-adapter";
+			/* PCIe adapter configuration. One record, bits [2:1] at +0x1008. */
+			apple,tunable-pcie-adapter = <0x1008 0x6 0x6>;
 
 			mboxes = <&usb4_0_mbox>;
 			resets = <&cio_reset 0>;
@@ -1653,7 +1656,7 @@
 			ranges;
 
 			apciec0_dart: iommu@3a1008000 {
-				compatible = "apple,t8103-dart";
+				compatible = "apple,t8103-usb4-dart";
 				reg = <0x3 0xa1008000 0x0 0x4000>;
 				interrupt-parent = <&aic>;
 				interrupts = <AIC_IRQ 771 IRQ_TYPE_LEVEL_HIGH>;
@@ -1670,9 +1673,10 @@
 					<0x3 0xa0004000 0x0 0x4000>,
 					<0x3 0xa0200000 0x0 0x4000>,
 					<0x3 0xa1010000 0x0 0x4000>,
-					<0x3 0xa100c000 0x0 0x4000>;
+					<0x3 0xa0008000 0x0 0x4000>;
 				reg-names = "config", "rc", "port0", "fabric",
-					    "debug", "ltssm", "intr2axi";
+					    "debug", "ltssm", "oe-fabric";
+#include "t8103-pciec-tunables.dtsi"
 
 				interrupt-parent = <&aic>;
 				interrupts = <AIC_IRQ 770 IRQ_TYPE_LEVEL_HIGH>;
@@ -1699,6 +1703,8 @@
 					device_type = "pci";
 					reg = <0x0 0x0 0x0 0x0 0x0>;
 					external-facing;
+					/* Port configuration. One record at +0x140. */
+					apple,tunable = <0x140 0x1 0x1>;
 
 					#address-cells = <3>;
 					#size-cells = <2>;
@@ -1791,8 +1797,11 @@
 		usb4_1_acio: cio@501ac0000 {
 			compatible = "apple,t8103-usb4-acio";
 			reg = <0x5 0x01ac0000 0x0 0xc000>,
-				<0x5 0x01080000 0x0 0x20000>;
-			reg-names = "rc", "sram";
+				<0x5 0x01080000 0x0 0x20000>,
+				<0x5 0x01e44000 0x0 0x4000>;
+			reg-names = "rc", "sram", "pcie-adapter";
+			/* PCIe adapter configuration. One record, bits [2:1] at +0x1008. */
+			apple,tunable-pcie-adapter = <0x1008 0x6 0x6>;
 
 			mboxes = <&usb4_1_mbox>;
 			resets = <&cio_reset 1>;
@@ -1872,7 +1881,7 @@
 			ranges;
 
 			apciec1_dart: iommu@521008000 {
-				compatible = "apple,t8103-dart";
+				compatible = "apple,t8103-usb4-dart";
 				reg = <0x5 0x21008000 0x0 0x4000>;
 				interrupt-parent = <&aic>;
 				interrupts = <AIC_IRQ 851 IRQ_TYPE_LEVEL_HIGH>;
@@ -1889,9 +1898,10 @@
 					<0x5 0x20004000 0x0 0x4000>,
 					<0x5 0x20200000 0x0 0x4000>,
 					<0x5 0x21010000 0x0 0x4000>,
-					<0x5 0x2100c000 0x0 0x4000>;
+					<0x5 0x20008000 0x0 0x4000>;
 				reg-names = "config", "rc", "port0", "fabric",
-					    "debug", "ltssm", "intr2axi";
+					    "debug", "ltssm", "oe-fabric";
+#include "t8103-pciec-tunables.dtsi"
 
 				interrupt-parent = <&aic>;
 				interrupts = <AIC_IRQ 850 IRQ_TYPE_LEVEL_HIGH>;
@@ -1918,6 +1928,8 @@
 					device_type = "pci";
 					reg = <0x0 0x0 0x0 0x0 0x0>;
 					external-facing;
+					/* Port configuration. One record at +0x140. */
+					apple,tunable = <0x140 0x1 0x1>;
 
 					#address-cells = <3>;
 					#size-cells = <2>;
