+	if (port->irq) {
+		irq_set_chained_handler_and_data(port->irq, NULL, NULL);
+		irq_dispose_mapping(port->irq);
+		port->irq = 0;
+	}
+
+	if (port->domain) {
+		irq_domain_remove(port->domain);
+		port->domain = NULL;
+	}
+
+	if (!list_empty(&port->entry))
+		list_del_init(&port->entry);
+
+	if (port->np) {
+		of_node_put(port->np);
+		port->np = NULL;
+	}
