+				bus-range = <0x0 0x7f>;
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges = <0x43000000 0x4 0x0
+					  0x4 0x0 0x0 0x80000000>,
+					 <0x02000000 0x0 0x80000000
+					  0x4 0x80000000 0x0 0x40000000>,
+					 <0x42000000 0x0 0xc0000000
+					  0x4 0xc0000000 0x0 0x40000000>;
