+					<0x3 0xa0004000 0x0 0x4000>,
+					<0x3 0xa0200000 0x0 0x4000>,
+					<0x3 0xa1010000 0x0 0x4000>,
+					<0x3 0xa100c000 0x0 0x4000>;
+				reg-names = "config", "rc", "port0", "common",
+					    "fabric", "debug", "intr2axi";
+
+				interrupt-parent = <&aic>;
+				interrupts = <AIC_IRQ 1024 IRQ_TYPE_LEVEL_HIGH>;
+
+				msi-controller;
