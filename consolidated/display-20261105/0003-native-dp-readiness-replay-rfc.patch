diff --git a/drivers/usb/typec/tipd/native-dp.inc b/drivers/usb/typec/tipd/native-dp.inc
new file mode 100644
--- /dev/null
+++ b/drivers/usb/typec/tipd/native-dp.inc
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Native DP state replay; physical routing remains an exclusive DT choice. */
+static bool cd321x_native_dp_high(const struct cd321x_status *st)
+{
+	return (st->status & TPS_STATUS_PLUG_PRESENT) &&
+	       (st->data_status & TPS_DATA_STATUS_DATA_CONNECTION) &&
+	       (st->data_status & TPS_DATA_STATUS_DP_CONNECTION) &&
+	       !(st->data_status & (TPS_DATA_STATUS_TBT_CONNECTION |
+				   CD321X_DATA_STATUS_USB4_CONNECTION)) &&
+	       (st->data_status & CD321X_DATA_STATUS_HPD_LEVEL);
+}
+
+static int cd321x_native_dp_set_locked(struct cd321x *cd, bool high)
+{
+	struct tps6598x *tps = &cd->tps;
+	int ret = 0;
+
+	lockdep_assert_held(&cd->dp_lock);
+	lockdep_assert_held(&tps->lock);
+	if (cd->dp_fault || cd->dp_stopping)
+		return -ESHUTDOWN;
+	if (cd->dp_hpd == high)
+		return 0;
+
+	/* The update worker owns dp_lock; IRQs may update the pending snapshot. */
+	mutex_unlock(&tps->lock);
+	if (cd->dp_sink)
+		ret = cd->dp_sink->set_hpd(cd->dp_sink->data, high);
+	mutex_lock(&tps->lock);
+	if (ret)
+		cd->dp_fault = true; /* A failed callback may have changed firmware state. */
+	else
+		cd->dp_hpd = high;
+	return ret;
+}
+
+int apple_cd321x_dp_attach(struct device *provider, struct apple_cd321x_dp_sink *sink)
+{
+	struct tps6598x *tps = dev_get_drvdata(provider);
+	struct cd321x *cd;
+	int ret = 0;
+
+	/* This initial implementation is for the I2C CD321x, not arbitrary tipd. */
+	if (!device_is_compatible(provider, "apple,cd321x") || !tps)
+		return -ENODEV;
+	if (!sink || !sink->set_hpd)
+		return -EINVAL;
+	cd = container_of(tps, struct cd321x, tps);
+	guard(mutex)(&cd->dp_lock);
+	if (cd->dp_stopping || cd->dp_fault)
+		return -ESHUTDOWN;
+	if (cd->dp_sink)
+		return -EBUSY;
+
+	/* A queued transition owns the next report; do not replay its old level. */
+	mutex_lock(&tps->lock);
+	if (cd->update_status.status != cd->dp_applied_status ||
+	    cd->update_status.data_status != cd->dp_applied_data)
+		cd->dp_hpd = false;
+	mutex_unlock(&tps->lock);
+
+	/* Replay while serialized with every physical transition, outside PD lock. */
+	if (cd->dp_hpd)
+		ret = sink->set_hpd(sink->data, true);
+	if (ret) {
+		/* The failed consumer may have partially acquired the hardware. */
+		cd->dp_fault = true;
+		return ret;
+	}
+	cd->dp_sink = sink;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_cd321x_dp_attach);
+
+int apple_cd321x_dp_detach(struct device *provider, struct apple_cd321x_dp_sink *sink)
+{
+	struct tps6598x *tps = dev_get_drvdata(provider);
+	struct cd321x *cd;
+	int ret = 0;
+
+	if (!device_is_compatible(provider, "apple,cd321x") || !tps)
+		return -ENODEV;
+	cd = container_of(tps, struct cd321x, tps);
+	guard(mutex)(&cd->dp_lock);
+	if (cd->dp_sink != sink)
+		return -ENOENT;
+	if (cd->dp_hpd)
+		ret = sink->set_hpd(sink->data, false);
+	/* Never retain a callback into an unbinding consumer. */
+	cd->dp_sink = NULL;
+	if (ret)
+		cd->dp_fault = true;
+	/* dp_hpd is the cable state; a future consumer must replay it. */
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_cd321x_dp_detach);
diff --git a/include/linux/apple-cd321x-dp.h b/include/linux/apple-cd321x-dp.h
new file mode 100644
--- /dev/null
+++ b/include/linux/apple-cd321x-dp.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_APPLE_CD321X_DP_H
+#define _LINUX_APPLE_CD321X_DP_H
+
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+struct device;
+
+/*
+ * Exclusive native-DP consumer. Calls are serialized by the provider, in
+ * sleepable context, without its PD status mutex. A failed withdrawal vetoes
+ * physical route changes. Callbacks must not re-enter this registration API.
+ * The consumer must have a device link to the bound provider before attaching.
+ */
+struct apple_cd321x_dp_sink {
+	int (*set_hpd)(void *data, bool high);
+	void *data;
+};
+
+#if IS_REACHABLE(CONFIG_TYPEC_TPS6598X_CORE)
+int apple_cd321x_dp_attach(struct device *provider, struct apple_cd321x_dp_sink *sink);
+int apple_cd321x_dp_detach(struct device *provider, struct apple_cd321x_dp_sink *sink);
+#else
+static inline int apple_cd321x_dp_attach(struct device *provider,
+					struct apple_cd321x_dp_sink *sink)
+{
+	return -EOPNOTSUPP;
+}
+static inline int apple_cd321x_dp_detach(struct device *provider,
+					struct apple_cd321x_dp_sink *sink)
+{
+	return -EOPNOTSUPP;
+}
+#endif
+#endif
