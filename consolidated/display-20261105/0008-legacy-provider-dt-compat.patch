Subject: [PATCH] apple: distinguish multi-provider opt-in from legacy singleton

Use a separate property for the additional provider. Older Googlebook
kernels ignore it and retain their single registered legacy provider.
The multi-provider driver accepts both names. Controller sequencing
is unchanged.

---
diff --git a/drivers/thunderbolt/dpin-provider.inc b/drivers/thunderbolt/dpin-provider.inc
--- a/drivers/thunderbolt/dpin-provider.inc
+++ b/drivers/thunderbolt/dpin-provider.inc
@@ -303,7 +303,8 @@
 {
 	struct device_node *np;
 	int ret;
-	if (!of_property_read_bool(acio->np, "codex,dpin-callback-test"))
+	if (!of_property_read_bool(acio->np, "codex,dpin-callback-test") &&
+	    !of_property_read_bool(acio->np, "apple,auto-dpin-provider"))
 		return 0;
 	if (!of_machine_is_compatible("apple,t8103"))
 		return -EOPNOTSUPP;
diff --git a/drivers/gpu/drm/apple/auto-dp.inc b/drivers/gpu/drm/apple/auto-dp.inc
--- a/drivers/gpu/drm/apple/auto-dp.inc
+++ b/drivers/gpu/drm/apple/auto-dp.inc
@@ -334,7 +334,8 @@
 			route->provider = client ? &client->dev : NULL;
 		} else {
 			if (!of_device_is_compatible(np, "apple,t8103-usb4-acio") ||
-			    !of_property_read_bool(np, "codex,dpin-callback-test")) {
+			    (!of_property_read_bool(np, "codex,dpin-callback-test") &&
+			     !of_property_read_bool(np, "apple,auto-dpin-provider"))) {
 				of_node_put(np);
 				return -EINVAL;
 			}
