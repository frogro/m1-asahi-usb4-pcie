Subject: [PATCH] usb: typec: cd321x: commit modes only after provider success

Keep the last successful mode separate from a pending transition. Stop
before activating the USB role on provider failure and invalidate the
shortcut cache so an identical later event retries the providers.
Preserve successful provider ordering and the existing USB4 host-role
quiesce safeguard.

Development candidate only: no HPD replay or shared-DCP route
arbitration yet.

---
diff --git a/drivers/usb/typec/tipd/core.c b/drivers/usb/typec/tipd/core.c
index dcb1f409a..96289b0a3 100644
--- a/drivers/usb/typec/tipd/core.c
+++ b/drivers/usb/typec/tipd/core.c
@@ -540,21 +540,28 @@ static void tps6598x_handle_plug_event(struct tps6598x *tps, u32 status)
 	}
 }
 
-static void cd321x_typec_update_mode(struct tps6598x *tps, struct cd321x_status *st)
+static int cd321x_typec_update_mode(struct tps6598x *tps, struct cd321x_status *st)
 {
 	struct cd321x *cd321x = container_of(tps, struct cd321x, tps);
 	struct typec_thunderbolt_switch_data tbt_switch_data = {
 		.state = TYPEC_THUNDERBOLT_SWITCH_OFF,
 	};
 
+	struct typec_mux_state next = cd321x->state;
+	int ret;
+
 	if (!(st->data_status & TPS_DATA_STATUS_DATA_CONNECTION)) {
-		if (cd321x->state.mode == TYPEC_STATE_SAFE)
-			return;
-		cd321x->state.alt = NULL;
-		cd321x->state.mode = TYPEC_STATE_SAFE;
-		cd321x->state.data = NULL;
-		typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
-		typec_mux_set(cd321x->mux, &cd321x->state);
+		if (cd321x->mode_valid && next.mode == TYPEC_STATE_SAFE)
+			return 0;
+		next.alt = NULL;
+		next.mode = TYPEC_STATE_SAFE;
+		next.data = NULL;
+		ret = typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
+		if (ret)
+			goto err_invalidate;
+		ret = typec_mux_set(cd321x->mux, &next);
+		if (ret)
+			goto err_invalidate;
 	} else if (st->data_status & TPS_DATA_STATUS_DP_CONNECTION) {
 		struct typec_displayport_data dp_data;
 		unsigned long mode;
@@ -580,27 +587,31 @@ static void cd321x_typec_update_mode(struct tps6598x *tps, struct cd321x_status
 			break;
 		default:
 			dev_err(tps->dev, "Invalid DP pin assignment\n");
-			return;
+			return -EINVAL;
 		}
 
-		if (cd321x->state.alt == cd321x->port_altmode_dp &&
-		   cd321x->state.mode == mode) {
-			return;
+		if (cd321x->mode_valid && next.alt == cd321x->port_altmode_dp &&
+		   next.mode == mode) {
+			return 0;
 		}
 
 		dp_data.status = le32_to_cpu(st->dp_sid_status.status_rx);
 		dp_data.conf = le32_to_cpu(st->dp_sid_status.configure);
-		cd321x->state.alt = cd321x->port_altmode_dp;
-		cd321x->state.data = &dp_data;
-		cd321x->state.mode = mode;
-		typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
-		typec_mux_set(cd321x->mux, &cd321x->state);
+		next.alt = cd321x->port_altmode_dp;
+		next.data = &dp_data;
+		next.mode = mode;
+		ret = typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
+		if (ret)
+			goto err_invalidate;
+		ret = typec_mux_set(cd321x->mux, &next);
+		if (ret)
+			goto err_invalidate;
 	} else if (st->data_status & TPS_DATA_STATUS_TBT_CONNECTION) {
 		struct typec_thunderbolt_data tbt_data;
 
-		if (cd321x->state.alt == cd321x->port_altmode_tbt &&
-		   cd321x->state.mode == TYPEC_TBT_MODE)
-			return;
+		if (cd321x->mode_valid && next.alt == cd321x->port_altmode_tbt &&
+		   next.mode == TYPEC_TBT_MODE)
+			return 0;
 
 		tbt_data.cable_mode = TBT_MODE |
 			TBT_SET_CABLE_SPEED(TPS_DATA_STATUS_TBT_CABLE_SPEED(st->data_status)) |
@@ -615,50 +626,70 @@ static void cd321x_typec_update_mode(struct tps6598x *tps, struct cd321x_status
 			(u32)le16_to_cpu(st->intel_vid_status.device_mode) << 16;
 		tbt_data.enter_vdo =
 			(u32)le16_to_cpu(st->intel_vid_status.enter_vdo) << 16;
-		cd321x->state.alt = cd321x->port_altmode_tbt;
-		cd321x->state.mode = TYPEC_TBT_MODE;
-		cd321x->state.data = &tbt_data;
-		typec_mux_set(cd321x->mux, &cd321x->state);
+		next.alt = cd321x->port_altmode_tbt;
+		next.mode = TYPEC_TBT_MODE;
+		next.data = &tbt_data;
+		ret = typec_mux_set(cd321x->mux, &next);
+		if (ret)
+			goto err_invalidate;
 
 		tbt_switch_data.state = TYPEC_THUNDERBOLT_SWITCH_TBT;
 		tbt_switch_data.tbt = tbt_data;
 		tbt_switch_data.orientation = TPS_STATUS_TO_UPSIDE_DOWN(st->status) ?
 						      TYPEC_ORIENTATION_REVERSE :
 						      TYPEC_ORIENTATION_NORMAL;
-		typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
+		ret = typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
+		if (ret)
+			goto err_invalidate;
 	} else if (st->data_status & CD321X_DATA_STATUS_USB4_CONNECTION) {
 		struct enter_usb_data eusb_data;
 
-		if (cd321x->state.alt == NULL && cd321x->state.mode == TYPEC_MODE_USB4)
-			return;
+		if (cd321x->mode_valid && next.alt == NULL && next.mode == TYPEC_MODE_USB4)
+			return 0;
 
 		eusb_data.eudo = le32_to_cpu(st->usb4_status.eudo);
 		eusb_data.active_link_training =
 			!!(st->data_status & TPS_DATA_STATUS_ACTIVE_LINK_TRAIN);
 
-		cd321x->state.alt = NULL;
-		cd321x->state.data = &eusb_data;
-		cd321x->state.mode = TYPEC_MODE_USB4;
-		typec_mux_set(cd321x->mux, &cd321x->state);
+		next.alt = NULL;
+		next.data = &eusb_data;
+		next.mode = TYPEC_MODE_USB4;
+		ret = typec_mux_set(cd321x->mux, &next);
+		if (ret)
+			goto err_invalidate;
 
 		tbt_switch_data.state = TYPEC_THUNDERBOLT_SWITCH_USB4;
 		tbt_switch_data.usb4 = eusb_data;
 		tbt_switch_data.orientation = TPS_STATUS_TO_UPSIDE_DOWN(st->status) ?
 						      TYPEC_ORIENTATION_REVERSE :
 						      TYPEC_ORIENTATION_NORMAL;
-		typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
+		ret = typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
+		if (ret)
+			goto err_invalidate;
 	} else {
-		if (cd321x->state.alt == NULL && cd321x->state.mode == TYPEC_STATE_USB)
-			return;
-		cd321x->state.alt = NULL;
-		cd321x->state.mode = TYPEC_STATE_USB;
-		cd321x->state.data = NULL;
-		typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
-		typec_mux_set(cd321x->mux, &cd321x->state);
+		if (cd321x->mode_valid && next.alt == NULL && next.mode == TYPEC_STATE_USB)
+			return 0;
+		next.alt = NULL;
+		next.mode = TYPEC_STATE_USB;
+		next.data = NULL;
+		ret = typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
+		if (ret)
+			goto err_invalidate;
+		ret = typec_mux_set(cd321x->mux, &next);
+		if (ret)
+			goto err_invalidate;
 	}
 
-	/* Clear data since it's no longer used after typec_mux_set and points to the stack */
-	cd321x->state.data = NULL;
+	/* Commit only after both providers accepted the requested mode. */
+	next.data = NULL;
+	cd321x->state = next;
+	cd321x->mode_valid = true;
+	return 0;
+
+err_invalidate:
+	/* A provider may already have changed hardware before returning an error. */
+	cd321x->mode_valid = false;
+	return ret;
 }
 
 static void cd321x_update_work(struct work_struct *work)
@@ -667,6 +698,7 @@ static void cd321x_update_work(struct work_struct *work)
 					    struct cd321x, update_work);
 	struct tps6598x *tps = &cd321x->tps;
 	struct cd321x_status st;
+	int ret;
 	struct typec_thunderbolt_switch_data tbt_switch_data = {
 		.state = TYPEC_THUNDERBOLT_SWITCH_OFF,
 	};
@@ -726,7 +758,8 @@ static void cd321x_update_work(struct work_struct *work)
 		 st.data_status, was_disconnected);
 
 	if (old_role != USB_ROLE_NONE &&
-	    (new_role != old_role || was_disconnected || usb4_changed)) {
+	    (new_role != old_role || was_disconnected || usb4_changed ||
+	     !cd321x->mode_valid)) {
 		int ret = usb_role_switch_set_role(tps->role_sw, USB_ROLE_NONE);
 
 		dev_info(tps->dev, "USB4TEST DWC3 quiesce ret=%d\n", ret);
@@ -743,7 +776,13 @@ static void cd321x_update_work(struct work_struct *work)
 
 	/* If there was a disconnection, set PHY to off */
 	if (!new_connected || was_disconnected) {
-		typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
+		/* Force the next connection to configure the PHY again. */
+		cd321x->mode_valid = false;
+		ret = typec_thunderbolt_switch_set(cd321x->tbt_switch, &tbt_switch_data);
+		if (ret) {
+			dev_err(tps->dev, "failed to disable Thunderbolt switch: %d\n", ret);
+			return;
+		}
 		cd321x->state.alt = NULL;
 		cd321x->state.mode = TYPEC_STATE_SAFE;
 		cd321x->state.data = NULL;
@@ -785,10 +824,19 @@ static void cd321x_update_work(struct work_struct *work)
 	}
 
 	/* Update the TypeC MUX/PHY state */
-	cd321x_typec_update_mode(tps, &st);
+	ret = cd321x_typec_update_mode(tps, &st);
+	if (ret) {
+		dev_err(tps->dev, "failed to configure Type-C mode: %d\n", ret);
+		return;
+	}
 
-	/* Launch the USB role switch */
-	usb_role_switch_set_role(tps->role_sw, new_role);
+	/* Launch USB only after the mux and Thunderbolt switch succeeded. */
+	ret = usb_role_switch_set_role(tps->role_sw, new_role);
+	if (ret) {
+		cd321x->mode_valid = false;
+		dev_err(tps->dev, "failed to activate USB role: %d\n", ret);
+		return;
+	}
 
 	power_supply_changed(tps->psy);
 }
diff --git a/drivers/usb/typec/tipd/tps6598x.h b/drivers/usb/typec/tipd/tps6598x.h
index 7f6d050e4..91c461329 100644
--- a/drivers/usb/typec/tipd/tps6598x.h
+++ b/drivers/usb/typec/tipd/tps6598x.h
@@ -377,6 +377,7 @@ struct cd321x {
 
 	struct typec_mux *mux;
 	struct typec_mux_state state;
+	bool mode_valid; /* Last mode was accepted by both providers. */
 
 	struct typec_thunderbolt_switch *tbt_switch;
 
