index ddf79641917f0f801b2c388c55714bfe3b71f741..7c54257b0329a01b9ca2684ecd8c961e721a981c 100644
--- a/include/linux/pci_hotplug.h
+++ b/include/linux/pci_hotplug.h
@@ -102,6 +102,15 @@ static inline bool pciehp_is_native(struct pci_dev *bridge) { return true; }
 static inline bool shpchp_is_native(struct pci_dev *bridge) { return true; }
 #endif
 
+#if IS_REACHABLE(CONFIG_HOTPLUG_PCI_PCIE)
+int pciehp_notify_presence_change(struct pci_dev *port);
+#else
+static inline int pciehp_notify_presence_change(struct pci_dev *port)
+{
+	return -EOPNOTSUPP;
+}
+#endif
+
 static inline bool hotplug_is_native(struct pci_dev *bridge)
 {
 	return (bridge->is_pciehp && pciehp_is_native(bridge)) ||
