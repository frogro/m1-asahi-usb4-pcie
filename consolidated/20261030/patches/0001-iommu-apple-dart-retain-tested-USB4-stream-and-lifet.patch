From b1f5b6e4492d374486be4f7340b268b3657b901a Mon Sep 17 00:00:00 2001
From: frogro <frank.grootens@gmail.com>
Date: Fri, 30 Oct 2026 02:32:08 +0100
Subject: [PATCH RFC 01/22] iommu: apple-dart: retain tested USB4 stream and
 lifetime fixes

Includes the early bitmap_to_arr32 and 0xf8 enable-register fixes that were already in the archived initial tree. Also retains the subsequent tested guard/lifecycle changes. Original hardware definitions and copyright remain. Source: 2026-10-29 storage preparation.

Consolidation is AI-assisted. No new upstream endorsement or Signed-off-by is asserted.
---
 drivers/iommu/apple-dart.c | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 9d1f6cd6649ac7c7a2fe8b2e274c8f28d5937e7c..203c01c798a0a420982b60a2d872e5389352b882 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -76,6 +76,7 @@
 #define DART_T8020_ERROR_ADDR_LO 0x50
 
 #define DART_T8020_STREAMS_ENABLE 0xfc
+#define DART_T8103_USB4_STREAMS_ENABLE 0xf8
 
 #define DART_T8020_REMAP       	0x80
 
@@ -505,11 +506,13 @@ apple_dart_t8020_hw_stream_command(struct apple_dart_stream_map *stream_map,
 	unsigned long flags;
 	int ret, i;
 	u32 command_reg;
+	u32 select[BITS_TO_U32(DART_MAX_STREAMS)];
 
 	spin_lock_irqsave(&stream_map->dart->lock, flags);
 
+	bitmap_to_arr32(select, stream_map->sidmap, stream_map->dart->num_streams);
 	for (i = 0; i < BITS_TO_U32(stream_map->dart->num_streams); i++)
-		writel(stream_map->sidmap[i],
+		writel(select[i],
 		       stream_map->dart->regs + DART_T8020_STREAM_SELECT + 4 * i);
 	writel(command, stream_map->dart->regs + DART_T8020_STREAM_COMMAND);
 
@@ -628,9 +631,9 @@ static int apple_dart_hw_reset(struct apple_dart *dart)
 	return dart->hw->invalidate_tlb(&stream_map);
 }
 
-static void apple_dart_domain_flush_tlb(struct apple_dart_domain *domain)
+static int apple_dart_domain_flush_tlb(struct apple_dart_domain *domain)
 {
-	int i, j;
+	int i, j, ret = 0;
 	struct apple_dart_atomic_stream_map *domain_stream_map;
 	struct apple_dart_stream_map stream_map;
 	struct io_pgtable_cfg *pgtbl_cfg =
@@ -647,9 +650,12 @@ static void apple_dart_domain_flush_tlb(struct apple_dart_domain *domain)
 		if (stream_map.dart->locked)
 			apple_dart_hw_sync_locked(pgtbl_cfg, &stream_map);
 
-		stream_map.dart->hw->invalidate_tlb(&stream_map);
+		/* Flush every DART even if one of them fails. */
+		ret = stream_map.dart->hw->invalidate_tlb(&stream_map) ?: ret;
 		pm_runtime_put(stream_map.dart->dev);
 	}
+
+	return ret;
 }
 
 static void apple_dart_flush_iotlb_all(struct iommu_domain *domain)
@@ -666,8 +672,7 @@ static void apple_dart_iotlb_sync(struct iommu_domain *domain,
 static int apple_dart_iotlb_sync_map(struct iommu_domain *domain,
 				     unsigned long iova, size_t size)
 {
-	apple_dart_domain_flush_tlb(to_dart_domain(domain));
-	return 0;
+	return apple_dart_domain_flush_tlb(to_dart_domain(domain));
 }
 
 static phys_addr_t apple_dart_iova_to_phys(struct iommu_domain *domain,
@@ -1617,7 +1622,7 @@ static const struct apple_dart_hw apple_dart_hw_t8103_usb4 = {
 	.fmt = APPLE_DART,
 	.max_sid_count = 64,
 
-	.enable_streams = DART_T8020_STREAMS_ENABLE,
+	.enable_streams = DART_T8103_USB4_STREAMS_ENABLE,
 	.lock = DART_T8020_CONFIG,
 	.lock_bit = DART_T8020_CONFIG_LOCK,
 
