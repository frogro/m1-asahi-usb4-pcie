index 65d0eca3c9a80bc7096534b62abe40d2d5785242..39f4110313f08bd9d326808f7e4236cc6e36c4f3 100644
--- a/drivers/thunderbolt/domain.c
+++ b/drivers/thunderbolt/domain.c
@@ -503,12 +503,14 @@ EXPORT_SYMBOL_FOR_MODULES(tb_domain_add, "thunderbolt_apple");
  */
 void tb_domain_remove(struct tb *tb)
 {
+	tb_dp118_stop_begin(tb);
 	mutex_lock(&tb->lock);
 	if (tb->cm_ops->stop)
 		tb->cm_ops->stop(tb);
 	/* Stop the domain control traffic */
 	tb_ctl_stop(tb->ctl);
 	mutex_unlock(&tb->lock);
+	tb_dp118_stop_end(tb);
 
 	flush_workqueue(tb->wq);
 
diff --git a/drivers/thunderbolt/dp118-ready.inc b/drivers/thunderbolt/dp118-ready.inc
new file mode 100644
index 0000000000000000000000000000000000000000..c4ca84df86396a67520a737b334fa1255f58600e
--- /dev/null
+++ b/drivers/thunderbolt/dp118-ready.inc
@@ -0,0 +1,178 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Experimental early DP notification. No firmware calls under tb->lock. */
+struct dp118_ready_work {
+	struct work_struct work;
+	struct tb_tunnel *tunnel;
+	struct tb_switch *root;
+	struct tb_switch *sink;
+	struct codex_dp110_event event;
+};
+
+static bool dp118_adapter_ready(struct tb_port *port)
+{
+	u32 val;
+
+	if (!port->cap_adap || tb_port_read(port, &val, TB_CFG_PORT,
+					 port->cap_adap + ADP_DP_CS_0, 1))
+		return false;
+	return (val & (ADP_DP_CS_0_AE | ADP_DP_CS_0_VE)) ==
+		(ADP_DP_CS_0_AE | ADP_DP_CS_0_VE);
+}
+
+static bool dp118_ready_valid(struct dp118_ready_work *ready)
+{
+	struct tb_tunnel *tunnel = ready->tunnel;
+	struct tb *tb = tunnel->tb;
+	struct tb_cm *tcm = tb_priv(tb);
+
+	lockdep_assert_held(&tb->lock);
+	/* The pinned tunnel prevents pointer reuse, pinned switches keep ports
+	 * alive. Check membership before touching configuration space.
+	 */
+	if (!tcm->hotplug_active || tb->root_switch != ready->root ||
+	    ready->root->is_unplugged || ready->sink->is_unplugged ||
+	    tb_find_tunnel(tb, TB_TUNNEL_DP, tunnel->src_port,
+			   tunnel->dst_port) != tunnel || tunnel->dprx_canceled)
+		return false;
+	return dp118_adapter_ready(tunnel->src_port) &&
+		dp118_adapter_ready(tunnel->dst_port) &&
+		tb_dp_port_hpd_is_active(tunnel->src_port) > 0 &&
+		tb_dp_port_hpd_is_active(tunnel->dst_port) > 0;
+}
+
+static void dp118_paths_ready_work(struct work_struct *work)
+{
+	struct dp118_ready_work *ready = container_of(work,
+					struct dp118_ready_work, work);
+	struct tb *tb = ready->tunnel->tb;
+	struct tb_cm *tcm = tb_priv(tb);
+	bool valid;
+	int ret;
+
+	/* Physical DP hotplug and DPRX completion use this same ordered queue.
+	 * Domain removal additionally takes this gate BEFORE the domain mutex.
+	 * No TB/CIO lock is held over the listener's firmware transaction.
+	 */
+	mutex_lock(&tcm->dp118_callback_lock);
+	mutex_lock(&tb->lock);
+	valid = dp118_ready_valid(ready);
+	mutex_unlock(&tb->lock);
+	if (!valid)
+		goto out;
+	/* Preserve the tested admission: two enabled-adapter/HPD samples.
+	 * This is bounded debounce for one event, not recurring status polling.
+	 */
+	msleep(100);
+	mutex_lock(&tb->lock);
+	valid = dp118_ready_valid(ready);
+	mutex_unlock(&tb->lock);
+	if (!valid)
+		goto out;
+	ret = notifier_to_errno(blocking_notifier_call_chain(&dp110_retirement,
+				CODEX_DP_PATHS_READY, &ready->event));
+	tb_info(tb, "DP118 paths-ready seq=%llu sink=%llx:%u callback=%d\n",
+		ready->event.sequence, ready->event.output_route,
+		ready->event.output_port, ret);
+out:
+	if (!valid)
+		tb_info(tb, "DP118 stale/unready seq=%llu skipped\n",
+			ready->event.sequence);
+	mutex_unlock(&tcm->dp118_callback_lock);
+	tb_tunnel_put(ready->tunnel);
+	tb_switch_put(ready->sink);
+	tb_switch_put(ready->root);
+	put_device(ready->event.controller);
+	kfree(ready);
+	tb_domain_put(tb);
+}
+
+static void dp118_queue_paths_ready(struct tb_tunnel *tunnel)
+{
+	struct tb *tb = tunnel->tb;
+	struct dp118_ready_work *ready;
+	struct tb_port *port;
+	unsigned int index = 0;
+
+	lockdep_assert_held(&tb->lock);
+	if (!rcu_access_pointer(dp110_retirement.head) ||
+	    tunnel->src_port->sw != tb->root_switch)
+		return;
+	tb_switch_for_each_port(tb->root_switch, port) {
+		if (!tb_port_is_dpin(port))
+			continue;
+		if (port == tunnel->src_port)
+			break;
+		index++;
+	}
+	if (port != tunnel->src_port || index > U8_MAX)
+		return;
+	ready = kzalloc(sizeof(*ready), GFP_KERNEL);
+	if (!ready) {
+		tb_warn(tb, "DP118 cannot allocate paths-ready event\n");
+		return;
+	}
+	ready->tunnel = tunnel;
+	ready->root = tb_switch_get(tunnel->src_port->sw);
+	ready->sink = tb_switch_get(tunnel->dst_port->sw);
+	ready->event.controller = get_device(tb->nhi->dev);
+	ready->event.input_index = index;
+	ready->event.output_route = tb_route(tunnel->dst_port->sw);
+	ready->event.output_port = tunnel->dst_port->port;
+	ready->event.sequence = atomic64_inc_return(&dp110_sequence);
+	tb_tunnel_get(tunnel);
+	tb_domain_get(tb);
+	INIT_WORK(&ready->work, dp118_paths_ready_work);
+	queue_work(tb->wq, &ready->work);
+}
+
+/* Called only by domain removal, before taking tb->lock and after releasing
+ * it respectively. Firmware-managed connection managers have no private gate.
+ */
+void tb_dp118_stop_begin(struct tb *tb)
+{
+	struct tb_cm *tcm = tb_priv(tb);
+
+	if (tb->cm_ops == &tb_cm_ops)
+		mutex_lock(&tcm->dp118_callback_lock);
+}
+
+void tb_dp118_stop_end(struct tb *tb)
+{
+	struct tb_cm *tcm = tb_priv(tb);
+
+	if (tb->cm_ops == &tb_cm_ops)
+		mutex_unlock(&tcm->dp118_callback_lock);
+}
+
+/* Replay existing routes for a late-registering display consumer. This only
+ * queues the same pinned, revalidated ready event; no firmware call here.
+ * The bus iterator pins the domain device. Taking tb->lock excludes stop,
+ * whose hotplug_active=false prevents queues after domain shutdown.
+ */
+static int dp121_replay_domain(struct device *dev, void *data)
+{
+ struct device *provider = data;
+ struct tb *tb;
+ struct tb_cm *tcm;
+ struct tb_tunnel *tunnel;
+ if (dev->type != &tb_domain_type)
+  return 0;
+ tb = container_of(dev, struct tb, dev);
+ if (tb->cm_ops != &tb_cm_ops || tb->nhi->dev->parent != provider)
+  return 0;
+ tcm = tb_priv(tb);
+ mutex_lock(&tb->lock);
+ if (tcm->hotplug_active && tb->root_switch)
+  list_for_each_entry(tunnel, &tcm->tunnel_list, list)
+   if (tunnel->type == TB_TUNNEL_DP)
+    dp118_queue_paths_ready(tunnel);
+ mutex_unlock(&tb->lock);
+ return 0;
+}
+int codex_dp121_replay_ready(struct device *provider)
+{
+ if (!provider)
+  return -EINVAL;
+ return bus_for_each_dev(&tb_bus_type, NULL, provider, dp121_replay_domain);
+}
+EXPORT_SYMBOL_GPL(codex_dp121_replay_ready);
