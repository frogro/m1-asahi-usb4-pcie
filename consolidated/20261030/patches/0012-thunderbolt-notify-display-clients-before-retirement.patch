+static BLOCKING_NOTIFIER_HEAD(dp110_retirement);
+static atomic64_t dp110_sequence = ATOMIC64_INIT(0);
+static const struct tb_cm_ops tb_cm_ops;
+
 struct tb_cm {
+	struct mutex dp118_callback_lock;
 	struct list_head tunnel_list;
 	struct list_head dp_resources;
 	bool hotplug_active;
@@ -1953,6 +1959,9 @@ static struct tb_port *tb_find_dp_out(struct tb *tb, struct tb_port *in)
 	return NULL;
 }
 
+/* Queue callbacks outside the DP-resource iteration and its domain lock. */
+#include "dp118-ready.inc"
+
 static void tb_dp_tunnel_active(struct tb_tunnel *tunnel)
 {
 	struct tb_port *in = tunnel->src_port;
@@ -2101,6 +2110,29 @@ static void tb_tunnel_one_dp(struct tb *tb, struct tb_port *in,
 		goto err_free;
 	}
 
+	dp118_queue_paths_ready(tunnel);
+
+	/* DP115 diagnostic: notify after all paths and DP adapters are
+	 * enabled, before asynchronous DPRX completion. A graphics driver
+	 * must participate in that completion; TB_TUNNEL_ACTIVATED is late.
+	 * This emits an observation only: no firmware callback or lock drop.
+	 * Not a proposed userspace ABI or complete driver lifecycle API.
+	 */
+	{
+		char source[64], sink[64];
+		char *env[] = { "DP115_EVENT=paths-ready", source, sink, NULL };
+		int notify_ret;
+
+		snprintf(source, sizeof(source), "DP115_SOURCE=%llx:%u",
+			 tb_route(in->sw), in->port);
+		snprintf(sink, sizeof(sink), "DP115_SINK=%llx:%u",
+			 tb_route(out->sw), out->port);
+		notify_ret = kobject_uevent_env(&tb->dev.kobj, KOBJ_CHANGE, env);
+		tb_info(tb, "DP115 paths ready %llx:%u -> %llx:%u notify=%d\n",
+			tb_route(in->sw), in->port, tb_route(out->sw), out->port,
+			notify_ret);
+	}
+
 	return;
 
 err_free:
@@ -2509,6 +2541,74 @@ static int tb_disconnect_xdomain_paths(struct tb *tb, struct tb_xdomain *xd,
  *
  * Executes on tb->wq.
  */
+/* DP110: one bounded pre-retirement call for physical DP OUT removal.
+ * This is not the whole-dock, suspend or negotiation-error teardown path.
+ */
+
+
+int codex_dp110_register(struct notifier_block *nb)
+{
+	return blocking_notifier_chain_register(&dp110_retirement, nb);
+}
+EXPORT_SYMBOL_GPL(codex_dp110_register);
+int codex_dp110_unregister(struct notifier_block *nb)
+{
+	return blocking_notifier_chain_unregister(&dp110_retirement, nb);
+}
+EXPORT_SYMBOL_GPL(codex_dp110_unregister);
+
+/* False means the captured tunnel disappeared/replaced while unlocked.
+ * Its reference prevents pointer reuse; switch references retain ports.
+ */
+static bool dp110_before_unplug(struct tb *tb, struct tb_port *port)
+{
+	struct tb_tunnel *tunnel, *observed;
+	struct tb_switch *root;
+	struct tb_port *in;
+	struct codex_dp110_event event = { .controller = tb->nhi->dev };
+	unsigned int index = 0;
+	int ret;
+	bool valid;
+
+	lockdep_assert_held(&tb->lock);
+	if (!tb_port_is_dpout(port) || !rcu_access_pointer(dp110_retirement.head))
+		return true;
+	tunnel = tb_find_tunnel(tb, TB_TUNNEL_DP, NULL, port);
+	if (!tunnel || tunnel->src_port->sw != tb->root_switch)
+		return true;
+	root = tb_switch_get(tb->root_switch);
+	tb_switch_for_each_port(root, in) {
+		if (!tb_port_is_dpin(in))
+			continue;
+		if (in == tunnel->src_port)
+			break;
+		index++;
+	}
+	if (in != tunnel->src_port || index > 255) {
+		tb_switch_put(root);
+		return true;
+	}
+	event.input_index = index;
+	event.sequence = atomic64_inc_return(&dp110_sequence);
+	event.output_route = tb_route(port->sw);
+	event.output_port = port->port;
+	tb_tunnel_get(tunnel);
+	tb_info(tb, "DP110 pre-retirement seq=%llu input=%u output=%llx:%u begin\n",
+         event.sequence, event.input_index, event.output_route, event.output_port);
+	mutex_unlock(&tb->lock);
+	ret = notifier_to_errno(blocking_notifier_call_chain(&dp110_retirement, 0, &event));
+	mutex_lock(&tb->lock);
+	observed = tb_find_tunnel(tb, TB_TUNNEL_DP, NULL, port);
+	valid = ((struct tb_cm *)tb_priv(tb))->hotplug_active && !port->sw->is_unplugged &&
+         root == tb->root_switch && observed == tunnel;
+	tb_info(tb, "DP110 pre-retirement seq=%llu ret=%d same_tunnel=%d\n",
+         event.sequence, ret, valid);
+	tb_tunnel_put(tunnel);
+	tb_switch_put(root);
+	/* Failure remains visible. Never hide physical removal or retry AFK. */
+	return valid;
+}
+
 static void tb_handle_hotplug(struct work_struct *work)
 {
 	struct tb_hotplug_event *ev = container_of(work, typeof(*ev), work.work);
@@ -2547,6 +2647,8 @@ static void tb_handle_hotplug(struct work_struct *work)
 	pm_runtime_get_sync(&sw->dev);
 
 	if (ev->unplug) {
+		if (!dp110_before_unplug(tb, port))
+			goto put_pm;
 		tb_retimer_remove_all(port);
 
 		if (tb_port_has_remote(port)) {
@@ -2607,6 +2709,7 @@ static void tb_handle_hotplug(struct work_struct *work)
 		}
 	}
 
+put_pm:
 	pm_runtime_mark_last_busy(&sw->dev);
 	pm_runtime_put_autosuspend(&sw->dev);
 
@@ -3497,6 +3600,7 @@ struct tb *tb_probe(struct tb_nhi *nhi)
 	tb->cm_ops = &tb_cm_ops;
 
 	tcm = tb_priv(tb);
+	mutex_init(&tcm->dp118_callback_lock);
 	INIT_LIST_HEAD(&tcm->tunnel_list);
 	INIT_LIST_HEAD(&tcm->dp_resources);
 	INIT_DELAYED_WORK(&tcm->remove_work, tb_remove_work);
