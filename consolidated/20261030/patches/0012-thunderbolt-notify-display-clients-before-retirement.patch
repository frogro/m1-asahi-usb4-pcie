--- /dev/null
+++ b/include/linux/apple-usb4-dp.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef CODEX_DP110_API_H
+#define CODEX_DP110_API_H
+#include <linux/device.h>
+#include <linux/notifier.h>
+
+#define CODEX_DP_BEFORE_RETIREMENT 0
+#define CODEX_DP_PATHS_READY 1
+
+/* Experimental display lifecycle notifications, not a complete hotplug API.
+ * The domain mutex is NOT held. Event data is valid only in the call.
+ * PATHS_READY runs on the ordered domain queue after adapter enablement,
+ * before DPRX completion. Listeners must not wait for work on that queue.
+ */
+struct codex_dp110_event {
+	struct device *controller;
+	u64 sequence;
+	u64 output_route;
+	u8 output_port;
+	u8 input_index;
+};
+int codex_dp121_replay_ready(struct device *provider);
+int codex_dp110_register(struct notifier_block *nb);
+int codex_dp110_unregister(struct notifier_block *nb);
+#endif
