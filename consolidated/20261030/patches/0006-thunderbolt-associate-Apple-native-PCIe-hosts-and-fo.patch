+	void (*pci_tunnel_topology_changed)(struct tb_nhi *nhi);
 };
 
 /*
diff --git a/drivers/thunderbolt/tb.c b/drivers/thunderbolt/tb.c
index 1d6e0e75d043f4768baefff4c1a898fb1cbf5883..343eddf929e445c259b042bfc0f85fa97ccf5597 100644
--- a/drivers/thunderbolt/tb.c
+++ b/drivers/thunderbolt/tb.c
@@ -1742,6 +1742,30 @@ static void tb_discover_tunnels(struct tb *tb)
 	}
 }
 
+/* Root tunnels reach a native host; nested tunnels do not own that host. */
+static int tb_native_pci_tunnel_changed(struct tb_tunnel *tunnel, bool active,
+				      bool surprise)
+{
+	struct tb *tb = tunnel->tb;
+
+	if (!tb_tunnel_is_pci(tunnel) ||
+	    tunnel->src_port->sw != tb->root_switch ||
+	    !tb->nhi->ops || !tb->nhi->ops->pci_tunnel_changed)
+		return 0;
+
+	return tb->nhi->ops->pci_tunnel_changed(tb->nhi, active, surprise);
+}
+
+/* Nested tunnels notify presence, but never reset their native root host. */
+static void tb_native_pci_topology_changed(struct tb_tunnel *tunnel)
+{
+	struct tb_nhi *nhi = tunnel->tb->nhi;
+
+	if (tb_tunnel_is_pci(tunnel) && nhi->ops &&
+	    nhi->ops->pci_tunnel_topology_changed)
+		nhi->ops->pci_tunnel_topology_changed(nhi);
+}
+
 static void tb_deactivate_and_free_tunnel(struct tb_tunnel *tunnel)
 {
 	struct tb_port *src_port, *dst_port;
@@ -1750,7 +1774,10 @@ static void tb_deactivate_and_free_tunnel(struct tb_tunnel *tunnel)
 	if (!tunnel)
 		return;
 
+	tb_native_pci_tunnel_changed(tunnel, false,
+				     tunnel->dst_port->sw->is_unplugged);
 	tb_tunnel_deactivate(tunnel);
+	tb_native_pci_topology_changed(tunnel);
 	list_del(&tunnel->list);
 
 	tb = tunnel->tb;
@@ -2285,6 +2312,7 @@ static void tb_disconnect_and_release_dp(struct tb *tb)
 static int tb_disconnect_pci(struct tb *tb, struct tb_switch *sw)
 {
 	struct tb_tunnel *tunnel;
+	int ret;
 	struct tb_port *up;
 
 	up = tb_switch_find_port(sw, TB_TYPE_PCIE_UP);
@@ -2295,9 +2323,14 @@ static int tb_disconnect_pci(struct tb *tb, struct tb_switch *sw)
 	if (WARN_ON(!tunnel))
 		return -ENODEV;
 
+	ret = tb_native_pci_tunnel_changed(tunnel, false, false);
+	if (ret)
+		return ret;
+
 	tb_switch_xhci_disconnect(sw);
 
 	tb_tunnel_deactivate(tunnel);
+	tb_native_pci_topology_changed(tunnel);
 	list_del(&tunnel->list);
 	tb_tunnel_put(tunnel);
 	return 0;
@@ -2305,6 +2338,7 @@ static int tb_disconnect_pci(struct tb *tb, struct tb_switch *sw)
 
 static int tb_tunnel_pci(struct tb *tb, struct tb_switch *sw)
 {
+	int ret;
 	struct tb_port *up, *down, *port;
 	struct tb_cm *tcm = tb_priv(tb);
 	struct tb_tunnel *tunnel;
@@ -2333,6 +2367,13 @@ static int tb_tunnel_pci(struct tb *tb, struct tb_switch *sw)
 		return -EIO;
 	}
 
+	ret = tb_native_pci_tunnel_changed(tunnel, true, false);
+	if (ret) {
+		tb_tunnel_deactivate(tunnel);
+		tb_tunnel_put(tunnel);
+		return ret;
+	}
+
 	/*
 	 * PCIe L1 is needed to enable CL0s for Titan Ridge so enable it
 	 * here.
@@ -2345,8 +2386,11 @@ static int tb_tunnel_pci(struct tb *tb, struct tb_switch *sw)
 
 	list_add_tail(&tunnel->list, &tcm->tunnel_list);
 
+	tb_native_pci_topology_changed(tunnel);
+
 	/* Schedule a delayed PCIe bus rescan in case pciehp misses devices */
-	if (tb->nhi && tb->nhi->dev && to_pci_dev(tb->nhi->dev)->bus) {
+	if (tb->nhi && tb->nhi->dev && dev_is_pci(tb->nhi->dev) &&
+	    to_pci_dev(tb->nhi->dev)->bus) {
 		struct pci_bus *bus = to_pci_dev(tb->nhi->dev)->bus;
 		struct tb_pci_rescan_work *rescan_work;
 
@@ -3465,7 +3509,8 @@ struct tb *tb_probe(struct tb_nhi *nhi)
 	 * before the PCIe/USB stack is resumed so complain here if we
 	 * found them missing.
 	 */
