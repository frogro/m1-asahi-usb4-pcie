 drivers/thunderbolt/nhi.h    |   6 +
 drivers/thunderbolt/tb.c     |  49 +++++++-
 drivers/thunderbolt/tb.h     |   2 +
 6 files changed, 370 insertions(+), 3 deletions(-)
 create mode 100644 drivers/thunderbolt/fwnode.c

