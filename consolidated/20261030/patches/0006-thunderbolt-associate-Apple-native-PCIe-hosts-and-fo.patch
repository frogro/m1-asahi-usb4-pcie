diff --git a/drivers/thunderbolt/apple.c b/drivers/thunderbolt/apple.c
index 530008cc8ec5d8cf003f9944e2204ae9b804cd23..8b3a7fab21f2e87e83a24d5b7f4f80740cf12838 100644
--- a/drivers/thunderbolt/apple.c
+++ b/drivers/thunderbolt/apple.c
@@ -86,6 +86,7 @@
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_platform.h>
+#include <linux/pci-apple.h>
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
 #include <linux/reset.h>
@@ -162,6 +163,7 @@
 struct apple_cio {
 	struct device *dev;
 	struct device_node *np;
+	struct device_node *pcie_tunnel_np;
 	struct apple_rtkit *rtk;
 
 	void __iomem *rc_base;
@@ -172,6 +174,7 @@ struct apple_cio {
 	void __iomem *sram_base;
 
 	struct reset_control *reset;
+	struct reset_control *pcie_reset;
 
 	struct dev_pm_domain_list *pd_list;
 
@@ -185,6 +188,53 @@ struct apple_cio {
 	struct typec_thunderbolt_switch_dev *tbt_switch;
 };
 
+/* Isolated test interface, disabled unless explicitly requested at load time. */
+static bool diagnostic_cycle;
+module_param(diagnostic_cycle, bool, 0400);
+MODULE_PARM_DESC(diagnostic_cycle, "Enable root-only ACIO power-cycle diagnostic");
+
+static void apple_cio_of_node_put(void *data)
+{
+	of_node_put(data);
+}
+
+static void apple_cio_reset_control_put(void *data)
+{
+	reset_control_put(data);
+}
+
+/*
+ * PCIe-C and its DART share this reset.  Acquire it while the tunneled host
+ * is still absent, then release ownership until the cable-start sequence.
+ */
+static int apple_cio_get_pcie_reset(struct apple_cio *acio)
+{
+	struct reset_control *rst = NULL;
+	struct device_node *child;
+	int ret;
+
+	for_each_available_child_of_node(acio->pcie_tunnel_np, child) {
+		if (!of_device_is_compatible(child, "apple,t8103-pciec"))
+			continue;
+		if (!of_property_read_bool(child, "apple,pciec-kernel-init"))
+			break;
+		rst = of_reset_control_get_optional_exclusive(child, NULL);
+		break;
+	}
+	of_node_put(child);
+	if (IS_ERR(rst))
+		return dev_err_probe(acio->dev, PTR_ERR(rst),
+				     "Unable to get PCIe-C reset\n");
+	if (!rst)
+		return 0;
+
+	reset_control_release(rst);
+	acio->pcie_reset = rst;
+	ret = devm_add_action_or_reset(acio->dev,
+				       apple_cio_reset_control_put, rst);
+	return ret;
+}
+
 /**
  * struct apple_nhi - Apple Native Host Interface
  * @dev: NHI device
@@ -460,7 +510,58 @@ static void apple_nhi_ring_configure(struct tb_ring *ring, u32 flags, u32 e2e_fl
 	writel(flags | e2e_flags, options);
 }
 
+/* Each ACIO instance describes its own native PCIe host in the DT. */
+static int apple_nhi_pci_tunnel_changed(struct tb_nhi *nhi, bool active,
+				      bool surprise)
+{
+	struct apple_cio *acio = dev_get_drvdata(nhi->dev->parent);
+	struct device_node *np;
+	struct platform_device *host;
+	int ret = 0;
+
+	if (!acio->pcie_tunnel_np)
+		return 0;
+
+	for_each_available_child_of_node(acio->pcie_tunnel_np, np) {
+		if (!of_device_is_compatible(np, "apple,t8103-pciec"))
+			continue;
+		host = of_find_device_by_node(np);
+		/* Initial authorization can precede asynchronous host probe. */
+		if (host) {
+			ret = apple_pcie_tunnel_set_active(&host->dev, active,
+						   surprise);
+			put_device(&host->dev);
+		}
+		of_node_put(np);
+		return ret;
+	}
+	return 0;
+}
+
+static void apple_nhi_pci_topology_changed(struct tb_nhi *nhi)
+{
+	struct apple_cio *acio = dev_get_drvdata(nhi->dev->parent);
+	struct device_node *np;
+	struct platform_device *host;
+
+	if (!acio->pcie_tunnel_np)
+		return;
+	for_each_available_child_of_node(acio->pcie_tunnel_np, np) {
+		if (!of_device_is_compatible(np, "apple,t8103-pciec"))
+			continue;
+		host = of_find_device_by_node(np);
+		if (host) {
+			apple_pcie_tunnel_notify_hotplug(&host->dev);
+			put_device(&host->dev);
+		}
+		of_node_put(np);
+		return;
+	}
+}
+
 static const struct tb_nhi_ops apple_nhi_ops = {
+	.pci_tunnel_changed = apple_nhi_pci_tunnel_changed,
+	.pci_tunnel_topology_changed = apple_nhi_pci_topology_changed,
 	.request_ring_irq = apple_nhi_request_irq,
 	.release_ring_irq = apple_nhi_release_irq,
 	.ring_interrupt_active = apple_nhi_ring_interrupt_active,
@@ -487,6 +588,14 @@ static int apple_nhi_probe(struct platform_device *pdev)
 	int cap_apple;
 	int ret = 0;
 
+	/* ACIO recreates NHI and DART children on every cable transition.
+	 * Never start DMA if the generic deferred-probe timeout skipped DART.
+	 * Return directly: the parent's boot completion must await a real probe.
+	 */
+	if (!device_iommu_mapped(&pdev->dev))
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "waiting for NHI DART attachment\n");
+
 	anhi = devm_kzalloc(&pdev->dev, sizeof(*anhi), GFP_KERNEL);
 	if (!anhi) {
 		ret = -ENOMEM;
@@ -670,6 +779,13 @@ static void apple_cio_stop(struct apple_cio *acio)
 	 */
 	of_platform_depopulate(acio->dev);
 
+	/* DART and PCIe teardown must finish before their register clock stops. */
+	if (acio->pcie_tunnel_np) {
+		ret = apple_pcie_tunnel_unprepare(acio->dev, acio->pcie_tunnel_np);
+		if (ret)
+			dev_warn(acio->dev, "PCIe-C late shutdown incomplete: %d\n", ret);
+	}
+
 	/* Try to shut down and power off the co-processor gracefully */
 	ret = apple_rtkit_poweroff(acio->rtk);
 	if (ret)
@@ -706,6 +822,24 @@ static int apple_cio_start(struct apple_cio *acio)
 
 	lockdep_assert_held(&acio->lock);
 
+	/*
+	 * Reset PCIe-C while its domain is still off.  macOS performs this
+	 * before enabling the ACIO/PCIe power set; without it a stale DART or
+	 * non-posted fabric transaction can surface as an asynchronous SError.
+	 */
+	if (acio->pcie_reset) {
+		ret = reset_control_acquire(acio->pcie_reset);
+		if (ret)
+			return dev_err_probe(acio->dev, ret,
+					     "PCIe-C reset is still in use\n");
+		ret = reset_control_reset(acio->pcie_reset);
+		reset_control_release(acio->pcie_reset);
+		if (ret)
+			return dev_err_probe(acio->dev, ret,
+					     "failed to reset PCIe-C\n");
+		dev_info(acio->dev, "PCIe-C reset before ACIO start\n");
+	}
+
 	/* Create device links to the power domains in order to power them on */
 	for (i = 0; i < acio->pd_list->num_pds; i++) {
 		link = device_link_add(acio->dev, acio->pd_list->pd_devs[i],
@@ -773,6 +907,36 @@ static int apple_cio_start(struct apple_cio *acio)
 		goto err_depopulate;
 	}
 
+	/*
+	 * The PCIe-C root complex is outside the ACIO MMIO window but shares
+	 * its cable-controlled power lifetime. Instantiate it only after the
+	 * router and NHI are live; parenting it to ACIO makes depopulation tear
+	 * it down before the co-processor and power domains disappear.
+	 */
+	if (acio->pcie_tunnel_np) {
+		/*
+		 * Clock PCIe-C and open its non-posted fabric before creating the
+		 * DART child.  Otherwise the DART's first MMIO access can surface a
+		 * pending fabric write as an asynchronous SError on T8103.
+		 */
+		ret = apple_pcie_tunnel_prepare(acio->dev, acio->pcie_tunnel_np);
+		if (ret) {
+			dev_err(acio->dev,
+				"failed to prepare tunneled PCIe controller: %d\n",
+				ret);
+			goto err_depopulate;
+		}
+
+		ret = of_platform_populate(acio->pcie_tunnel_np, NULL, NULL,
+					   acio->dev);
+		if (ret) {
+			dev_err(acio->dev,
+				"failed to populate tunneled PCIe controller: %d\n",
+				ret);
+			goto err_depopulate;
+		}
+	}
+
 	acio->current_cable_info = acio->target_cable_info;
 	return 0;
 
@@ -880,6 +1044,44 @@ static int apple_cio_tbt_switch_set(struct typec_thunderbolt_switch_dev *sw,
 	return 0;
 }
 
+/*
+ * Test only, with downstream filesystems unmounted. Keep the Type-C switch
+ * registered and the PHY configured; removing the ACIO driver itself would
+ * leave the PD driver's switch reference without a state replay on rebind.
+ * This is not a system-suspend implementation.
+ */
+static ssize_t diagnostic_cycle_store(struct device *dev,
+				     struct device_attribute *attr,
+				     const char *buf, size_t count)
+{
+	struct apple_cio *acio = dev_get_drvdata(dev);
+	int ret;
+
+	if (!diagnostic_cycle)
+		return -EOPNOTSUPP;
+	if (!sysfs_streq(buf, "cycle"))
+		return -EINVAL;
+
+	guard(mutex)(&acio->lock);
+	if (!acio->current_cable_info ||
+	    acio->current_cable_info != acio->target_cable_info)
+		return -ENOTCONN;
+
+	dev_info(dev, "diagnostic ACIO cycle begin, cable info %#x\n",
+		 acio->current_cable_info);
+	apple_cio_stop(acio);
+	ret = apple_cio_start(acio);
+	dev_info(dev, "diagnostic ACIO cycle restart returned %d\n", ret);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(diagnostic_cycle);
+
+static struct attribute *apple_cio_diag_attrs[] = {
+	&dev_attr_diagnostic_cycle.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(apple_cio_diag);
+
 static int apple_cio_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -897,6 +1099,17 @@ static int apple_cio_probe(struct platform_device *pdev)
 	init_completion(&acio->nhi_boot_completion);
 	acio->dev = &pdev->dev;
 	acio->np = dev->of_node;
+	acio->pcie_tunnel_np =
+		of_parse_phandle(dev->of_node, "apple,pcie-tunnel", 0);
+	if (acio->pcie_tunnel_np) {
+		ret = devm_add_action_or_reset(dev, apple_cio_of_node_put,
+					       acio->pcie_tunnel_np);
+		if (ret)
+			return ret;
+		ret = apple_cio_get_pcie_reset(acio);
+		if (ret)
+			return ret;
+	}
 
 	acio->sram_res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sram");
 	if (!acio->sram_res)
@@ -996,6 +1209,7 @@ MODULE_DEVICE_TABLE(of, apple_acio_match);
 static struct platform_driver apple_cio_driver = {
 	.driver = {
 		.name = "thunderbolt-apple-acio",
+		.dev_groups = apple_cio_diag_groups,
 		.of_match_table = apple_acio_match,
 		.pm = pm_sleep_ptr(&apple_cio_pm_ops),
 	},
diff --git a/drivers/thunderbolt/fwnode.c b/drivers/thunderbolt/fwnode.c
new file mode 100644
index 0000000000000000000000000000000000000000..2da4c2eb58eb38fd73aa737544d061f06487e662
--- /dev/null
+++ b/drivers/thunderbolt/fwnode.c
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Firmware-described native PCIe port dependencies, including late ports. */
+
+#include <linux/device.h>
+#include <linux/notifier.h>
+#include <linux/pci.h>
+#include <linux/property.h>
+
+#include "tb.h"
+
+struct tb_fwnode_links {
+	struct notifier_block notifier;
+	struct device *nhi;
+};
+
+static int tb_fwnode_add_link(struct device *dev, void *data)
+{
+	struct tb_fwnode_links *links = data;
+	struct fwnode_handle *reference;
+	struct device_link *link;
+	struct pci_dev *pdev;
+	u32 port = 0;
+	bool matches;
+
+	if (!dev_is_pci(dev) || !dev_fwnode(dev))
+		return 0;
+	pdev = to_pci_dev(dev);
+	if (!pci_is_pcie(pdev) ||
+	    (pci_pcie_type(pdev) != PCI_EXP_TYPE_ROOT_PORT &&
+	     pci_pcie_type(pdev) != PCI_EXP_TYPE_DOWNSTREAM))
+		return 0;
+
+	reference = fwnode_find_reference(dev_fwnode(dev), "usb4-host-interface", 0);
+	if (IS_ERR(reference))
+		return 0;
+	matches = device_match_fwnode(links->nhi, reference);
+	fwnode_handle_put(reference);
+	if (!matches)
+		return 0;
+
+	/* The property identifies the connector within this NHI, not the BDF. */
+	device_property_read_u32(dev, "usb4-port-number", &port);
+	/*
+	 * The consumer must suspend before and resume after its NHI. Managed
+	 * links are purged on consumer deletion or supplier unbind. No extra
+	 * runtime-PM reference is taken here, so a scan racing a PCI add event
+	 * can safely encounter the same consumer twice.
+	 */
+	link = device_link_add(dev, links->nhi,
+			       DL_FLAG_AUTOREMOVE_SUPPLIER | DL_FLAG_PM_RUNTIME);
+	if (!link)
+		dev_warn(links->nhi, "native PCIe link from %s failed\n", dev_name(dev));
+	else
+		dev_info(links->nhi, "native PCIe link from %s (USB4 port %u)\n",
+			 dev_name(dev), port);
+	return 0;
+}
+
+static int tb_fwnode_pci_event(struct notifier_block *notifier,
+			       unsigned long event, void *dev)
+{
+	struct tb_fwnode_links *links =
+		container_of(notifier, struct tb_fwnode_links, notifier);
+
+	/* Device initialization and its firmware-node assignment are complete. */
+	if (event == BUS_NOTIFY_ADD_DEVICE)
+		tb_fwnode_add_link(dev, links);
+	return NOTIFY_DONE;
+}
+
+static void tb_fwnode_remove_notifier(void *data)
+{
+	struct tb_fwnode_links *links = data;
+
+	bus_unregister_notifier(&pci_bus_type, &links->notifier);
+}
+
+bool tb_fwnode_add_links(struct tb_nhi *nhi)
+{
+	struct tb_fwnode_links *links;
+	int ret;
+
+	if (!dev_fwnode(nhi->dev))
+		return false;
+	links = devm_kzalloc(nhi->dev, sizeof(*links), GFP_KERNEL);
+	if (!links)
+		return false;
+	links->nhi = nhi->dev;
+	links->notifier.notifier_call = tb_fwnode_pci_event;
+	/* Watch first, then scan, so a port appearing during setup is not lost. */
+	ret = bus_register_notifier(&pci_bus_type, &links->notifier);
+	if (ret)
+		return false;
+	ret = devm_add_action_or_reset(nhi->dev, tb_fwnode_remove_notifier, links);
+	if (ret)
+		return false;
+	bus_for_each_dev(&pci_bus_type, NULL, links, tb_fwnode_add_link);
+	dev_info(nhi->dev, "watching firmware-described native PCIe ports\n");
+	return true;
+}
diff --git a/drivers/thunderbolt/nhi.h b/drivers/thunderbolt/nhi.h
