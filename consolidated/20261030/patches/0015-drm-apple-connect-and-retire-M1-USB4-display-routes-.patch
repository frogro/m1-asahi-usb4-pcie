+	 * clock and route still exist. dcp_comp_unbind then retires DP-IN.
+	 */
 	component_del(&pdev->dev, &dcp_comp_ops);
 }
 
 static void dcp_platform_shutdown(struct platform_device *pdev)
 {
+	device_remove_file(&pdev->dev, &dev_attr_dpin_connect);
+	/* component_del first performs DRM atomic shutdown while the DP-IN
+	 * clock and route still exist. dcp_comp_unbind then retires DP-IN.
+	 */
