diff --git a/drivers/gpu/drm/apple/dpin-binding.inc b/drivers/gpu/drm/apple/dpin-binding.inc
new file mode 100644
index 0000000000000000000000000000000000000000..c740c68e88a59296a601b9329c9f3d43963cd3c2
--- /dev/null
+++ b/drivers/gpu/drm/apple/dpin-binding.inc
@@ -0,0 +1,368 @@
+#include <linux/apple-usb4-dp.h>
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Explicit initial connection; subsequent DP reconnects use early kernel
+ * tunnel notifications. A failed/ambiguous transaction is never retried.
+ * Provider calls never hold a lock across an AFK firmware transaction.
+ */
+static bool dpin_autostart;
+module_param(dpin_autostart, bool, 0444);
+MODULE_PARM_DESC(dpin_autostart, "Enable event-driven initial USB4 DP connection");
+static int dp118_connect_locked(struct apple_dcp *dcp, bool reconnect);
+
+static void dp91_put_provider(void *data)
+{
+	put_device(data);
+}
+
+static int dp91_binding_init(struct apple_dcp *dcp)
+{
+	struct device_node *np;
+	struct platform_device *provider;
+	int ret;
+	mutex_init(&dcp->dp91_mutex);
+	np = of_parse_phandle(dcp->dev->of_node, "codex,dpin-provider", 0);
+	if (!np)
+		return 0;
+	if (!of_machine_is_compatible("apple,t8103")) {
+		of_node_put(np);
+		return -EOPNOTSUPP;
+	}
+	provider = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!provider)
+		return -EPROBE_DEFER;
+	ret = devm_add_action_or_reset(dcp->dev, dp91_put_provider, &provider->dev);
+	if (ret)
+		return ret;
+	if (!device_link_add(dcp->dev, &provider->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+		return -ENODEV;
+	dcp->dptxport[0].route_type = DPTX_ROUTE_USB4;
+	dcp->dptxport[0].dpin_provider = &provider->dev;
+	return 0;
+}
+
+static void dp91_binding_stop(struct apple_dcp *dcp)
+{
+	struct dptx_port *port = &dcp->dptxport[0];
+	u64 token;
+	int ret;
+	if (!port->dpin_provider)
+		return;
+	token = READ_ONCE(port->dpin_token);
+	if (!token)
+		return;
+	/* Called from component unbind AFTER drm_atomic_helper_shutdown.
+	 * Retain the callback token until firmware has withdrawn the display.
+	 */
+	if (port->enabled && port->connected && !port->dpin_withdraw_attempted &&
+	    !codex_dpin_call(port->dpin_provider, token, CODEX_DPIN_CHECK, 0)) {
+		ret = dptxport_set_hpd(port->service, false);
+		dev_info(dcp->dev, "DP93 shutdown HPD withdrawal ret=%d\n", ret);
+		ret = dptxport_release_display(port->service);
+		dev_info(dcp->dev, "DP93 shutdown display release ret=%d\n", ret);
+	}
+	token = xchg(&port->dpin_token, 0);
+	ret = codex_dpin_call(port->dpin_provider, token, CODEX_DPIN_END, 0);
+	if (ret && ret != -ESTALE && ret != -ENODEV)
+		dev_err(dcp->dev, "DP93 provider cleanup failed: %d\n", ret);
+	port->connected = false;
+	dev_info(dcp->dev, "DP93 provider retirement ret=%d\n", ret);
+}
+
+/* DP107: exercise the existing out-of-band disconnect ordering with a
+ * healthy tunnel before adding asynchronous tunnel notifications. This is
+ * followed only by the guarded DP108 experiment, never timeout retries.
+ * The provider token stays valid for firmware callbacks until final unbind.
+ */
+static int dp107_withdraw(struct apple_dcp *dcp)
+{
+	struct dptx_port *port = &dcp->dptxport[0];
+	int ret;
+
+	lockdep_assert_held(&dcp->dp91_mutex);
+	if (!port->enabled || !port->dpin_provider || !port->connected)
+		return -ENOTCONN;
+	if (port->dpin_withdraw_attempted)
+		return -EALREADY;
+	ret = codex_dpin_call(port->dpin_provider,
+			READ_ONCE(port->dpin_token), CODEX_DPIN_CHECK, 0);
+	if (ret)
+		return ret;
+	port->dpin_withdraw_attempted = true;
+
+	/* Match dcp_dptx_disconnect_oob: disable the DRM connection first.
+	 * No CIO/TB lock is held while sending firmware commands.
+	 */
+	disconnected_hpd_event(dcp->connector);
+	if (dcp->avep)
+		av_service_disconnect(dcp);
+	ret = dptxport_set_hpd(port->service, false);
+	dev_info(dcp->dev, "DP107 explicit HPD withdrawal ret=%d\n", ret);
+	if (ret)
+		return ret; /* Do not reuse an ambiguous, timed-out transaction. */
+	ret = dptxport_release_display(port->service);
+	dev_info(dcp->dev, "DP107 explicit display release ret=%d\n", ret);
+	if (ret)
+		return ret;
+	port->connected = false;
+	port->dpin_withdrawn = true;
+	/* One new attempt is allowed only after this acknowledged withdrawal. */
+	port->dpin_reconnect_attempted = false;
+	dev_info(dcp->dev, "DP107 withdrawal completed; provider retained until unbind\n");
+	return 0;
+}
+
+/* Callback runs without the TB domain/CIO locks. AFK callbacks use
+ * independent workqueues and can take the provider's lock normally.
+ */
+static int dp110_before_retirement(struct notifier_block *nb,
+                                  unsigned long action, void *data)
+{
+	struct apple_dcp *dcp = container_of(nb, struct apple_dcp, dp110_notifier);
+	struct codex_dp110_event *event = data;
+	struct dptx_port *port = &dcp->dptxport[0];
+	int ret;
+
+	if (!event->controller || event->controller->parent != port->dpin_provider ||
+     event->input_index != 0)
+		return NOTIFY_DONE;
+	mutex_lock(&dcp->dp91_mutex);
+	if (dcp->dp118_stopping) {
+		ret = -ESHUTDOWN;
+		goto out;
+	}
+	if (event->sequence <= dcp->dp110_last_event) {
+		ret = -ESTALE;
+		goto out;
+	}
+	dcp->dp110_last_event = event->sequence;
+	if (action == CODEX_DP_PATHS_READY) {
+		if (dpin_autostart && !port->dpin_attempted) {
+			dev_info(dcp->dev, "DP121 initial paths-ready seq=%llu begin\n", event->sequence);
+			ret = dp118_connect_locked(dcp, false);
+			dev_info(dcp->dev, "DP121 initial paths-ready seq=%llu ret=%d\n", event->sequence, ret);
+			goto out;
+		}
+		if (!port->dpin_withdrawn || port->connected) {
+			ret = 0;
+			goto out;
+		}
+		dev_info(dcp->dev, "DP118 automatic reconnect seq=%llu sink=%llx:%u begin\n",
+			 event->sequence, event->output_route, event->output_port);
+		ret = dp118_connect_locked(dcp, true);
+		dev_info(dcp->dev, "DP118 automatic reconnect seq=%llu ret=%d\n",
+			 event->sequence, ret);
+		goto out;
+	}
+	if (action != CODEX_DP_BEFORE_RETIREMENT) {
+		ret = -EINVAL;
+		goto out;
+	}
+	if (!port->dpin_attempted && !port->connected) {
+		ret = 0; /* No firmware display was requested yet. */
+		goto out;
+	}
+	dev_info(dcp->dev, "DP110 display withdrawal seq=%llu begin\n", event->sequence);
+	ret = dp107_withdraw(dcp);
+	dev_info(dcp->dev, "DP110 display withdrawal seq=%llu ret=%d\n", event->sequence, ret);
+out:
+	mutex_unlock(&dcp->dp91_mutex);
+	return notifier_from_errno(ret);
+}
+
+void dcp_dpin_stop_events(struct platform_device *pdev)
+{
+	struct apple_dcp *dcp = platform_get_drvdata(pdev);
+
+	bool registered;
+
+	if (!dcp)
+		return;
+	mutex_lock(&dcp->dp91_mutex);
+	dcp->dp118_stopping = true;
+	registered = xchg(&dcp->dp110_registered, false);
+	mutex_unlock(&dcp->dp91_mutex);
+	/* Drain callbacks before modeset locks / firmware teardown. */
+	if (registered)
+		codex_dp110_unregister(&dcp->dp110_notifier);
+}
+
+static int dp118_connect_locked(struct apple_dcp *dcp, bool reconnect)
+{
+	struct device *dev = dcp->dev;
+	struct dptx_port *port = &dcp->dptxport[0];
+	u64 token = 0;
+	bool requested = false, hpd_requested = false;
+	int ret, cleanup;
+	lockdep_assert_held(&dcp->dp91_mutex);
+	if (dcp->dp118_stopping)
+		return -ESHUTDOWN;
+	if (!port->enabled || !port->dpin_provider) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (reconnect) {
+		struct apple_epic_service *service = port->service;
+		unsigned long flags;
+		bool idle;
+
+		if (!port->dpin_withdrawn || port->connected ||
+		    port->dpin_reconnect_attempted) {
+			ret = -EALREADY;
+			goto out;
+		}
+		port->dpin_reconnect_attempted = true;
+		/* Only acknowledged withdrawal can reach here. Drain already
+		 * queued DPTX callbacks and reject outstanding commands. The
+		 * live CIO lease is retained across this display-only cycle.
+		 * This does not permit recovery of an ambiguous timeout.
+		 */
+		flush_workqueue(service->ep->wq);
+		spin_lock_irqsave(&service->lock, flags);
+		idle = bitmap_empty(service->cmd_map, MAX_PENDING_CMDS);
+		spin_unlock_irqrestore(&service->lock, flags);
+		if (!idle) {
+			ret = -EBUSY;
+			goto out;
+		}
+		token = READ_ONCE(port->dpin_token);
+		ret = codex_dpin_call(port->dpin_provider, token, CODEX_DPIN_CHECK, 0);
+		if (ret)
+			goto out;
+		port->dpin_withdrawn = false;
+		port->dpin_withdraw_attempted = false;
+		dev_info(dev, "DP108 acknowledged withdrawal and empty command queue; reconnect token=%llu\n", token);
+	} else {
+		if (port->dpin_attempted) {
+			ret = -EALREADY;
+			goto out;
+		}
+		port->dpin_attempted = true;
+		ret = codex_dpin_begin(port->dpin_provider, &token);
+		if (ret)
+			goto out;
+		WRITE_ONCE(port->dpin_token, token);
+	}
+	reinit_completion(&port->linkcfg_completion);
+	/* DP-IN0 is remote core 1. Mapping comes from macOS capture, not
+	 * validate_connection (which accepted every tested core number).
+	 */
+	ret = dptxport_connect(port->service, 1, dcp->dptx_phy, dcp->dptx_die);
+	dev_info(dev, "DP92 stage connect ret=%d\n", ret);
+	if (ret)
+		goto fail;
+	requested = true; /* even a timed-out request may have reached firmware */
+	ret = dptxport_request_display(port->service);
+	dev_info(dev, "DP92 stage request_display ret=%d\n", ret);
+	if (ret)
+		goto fail;
+	/* DP92: let firmware observe the attached sink before waiting for
+	 * training. DP91 never asserted HPD and never received link config.
+	 */
+	ret = codex_dpin_call(port->dpin_provider, token, CODEX_DPIN_CHECK, 0);
+	if (ret)
+		goto fail;
+	hpd_requested = true;
+	ret = dptxport_set_hpd(port->service, true);
+	dev_info(dev, "DP92 stage early_hpd ret=%d\n", ret);
+	if (ret)
+		goto fail;
+	if (!wait_for_completion_timeout(&port->linkcfg_completion, DPTX_CONNECT_TIMEOUT)) {
+		ret = -ETIMEDOUT;
+		goto fail;
+	}
+	ret = codex_dpin_call(port->dpin_provider, token, CODEX_DPIN_CHECK, 0);
+	if (ret)
+		goto fail;
+	port->connected = true;
+	if (!dcp->dp110_registered) {
+		dcp->dp110_notifier.notifier_call = dp110_before_retirement;
+		ret = codex_dp110_register(&dcp->dp110_notifier);
+		if (ret)
+			goto fail;
+		dcp->dp110_registered = true;
+		dev_info(dev, "DP110 pre-retirement listener armed\n");
+	}
+	dev_info(dev, "DP92 firmware connection completed; image still needs verification\n");
+	goto out;
+fail:
+	if (reconnect) {
+		port->dpin_withdraw_attempted = true;
+		dev_err(dev, "DP108 reconnect failed: %d; no retry\n", ret);
+		goto out;
+	}
+	if (hpd_requested) {
+		cleanup = dptxport_set_hpd(port->service, false);
+		dev_info(dev, "DP92 stage withdraw_hpd ret=%d\n", cleanup);
+	}
+	if (requested) {
+		cleanup = dptxport_release_display(port->service);
+		if (cleanup)
+			dev_warn(dev, "DP92 firmware release failed: %d\n", cleanup);
+	}
+	dp91_binding_stop(dcp);
+out:
+	dev_info(dev, "DP92 explicit connect result=%d\n", ret);
+	return ret;
+}
+
+static ssize_t dpin_connect_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct apple_dcp *dcp = dev_get_drvdata(dev);
+	int ret;
+
+	if (dpin_autostart)
+		return -EOPNOTSUPP;
+	/* Reconnect is now exclusively event driven, never initiated by userspace. */
+	if (!sysfs_streq(buf, "connect") && !sysfs_streq(buf, "withdraw"))
+		return -EINVAL;
+	mutex_lock(&dcp->dp91_mutex);
+	if (dcp->dp118_stopping)
+		ret = -ESHUTDOWN;
+	else if (sysfs_streq(buf, "withdraw"))
+		ret = dp107_withdraw(dcp);
+	else
+		ret = dp118_connect_locked(dcp, false);
+	mutex_unlock(&dcp->dp91_mutex);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR(dpin_connect, 0200, NULL, dpin_connect_store);
+
+/* Called after DRM registration/client setup, with no modeset/domain locks.
+ * Register before replay so either ordering (tunnel first or DCP first)
+ * converges on the existing ordered, validated paths-ready notification.
+ */
+int dcp_dpin_autostart(struct platform_device *pdev)
+{
+ struct apple_dcp *dcp = platform_get_drvdata(pdev);
+ struct dptx_port *port = &dcp->dptxport[0];
+ int ret;
+ if (!dpin_autostart || !port->dpin_provider)
+  return 0;
+ mutex_lock(&dcp->dp91_mutex);
+ if (dcp->dp118_stopping || !dcp->active || !port->enabled || !port->service) {
+  mutex_unlock(&dcp->dp91_mutex);
+  return -ENODEV;
+ }
+ if (dcp->dp110_registered) {
+  mutex_unlock(&dcp->dp91_mutex);
+  return 0;
+ }
+ /* Publish before registration: a concurrent ready callback must not
+  * attempt to register recursively from inside the blocking chain.
+  * Component bind/remove serializes this initial registration with stop.
+  */
+ dcp->dp110_registered = true;
+ dcp->dp110_notifier.notifier_call = dp110_before_retirement;
+ mutex_unlock(&dcp->dp91_mutex);
+ ret = codex_dp110_register(&dcp->dp110_notifier);
+ if (ret) {
+  mutex_lock(&dcp->dp91_mutex);
+  dcp->dp110_registered = false;
+  mutex_unlock(&dcp->dp91_mutex);
+  return ret;
+ }
+ dev_info(dcp->dev, "DP121 lifecycle listener armed; replay existing paths\n");
+ return codex_dp121_replay_ready(port->dpin_provider);
+}
