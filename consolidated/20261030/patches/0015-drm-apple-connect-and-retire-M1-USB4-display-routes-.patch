@@ -526,6 +526,14 @@ static int apple_drm_init(struct device *dev)
 
 	drm_client_setup_with_fourcc(&apple->drm, DRM_FORMAT_XRGB8888);
 
+	{
+		struct drm_crtc *crtc;
+		drm_for_each_crtc(crtc, &apple->drm) {
+			ret = dcp_dpin_autostart(to_apple_crtc(crtc)->dcp);
+			if (ret)
+				dev_warn(dev, "DP121 initial listener unavailable: %d\n", ret);
+		}
+	}
 	return 0;
 
 err_unbind:
@@ -536,11 +544,18 @@ err_unbind:
 static void apple_drm_uninit(struct device *dev)
 {
 	struct apple_drm_private *apple = dev_get_drvdata(dev);
+	struct drm_crtc *crtc;
 
+	/* Drain external callbacks before acquiring modeset locks in shutdown. */
+	drm_for_each_crtc(crtc, &apple->drm)
+		dcp_dpin_stop_events(to_apple_crtc(crtc)->dcp);
