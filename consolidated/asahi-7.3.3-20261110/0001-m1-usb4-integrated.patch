+
+struct apple_pcie_port {
+	raw_spinlock_t		lock;
+	struct apple_pcie	*pcie;
+	struct device_node	*np;
+	void __iomem		*base;
+	void __iomem		*phy;
+	struct irq_domain	*domain;
+	struct list_head	entry;
+	unsigned long		*sid_map;
+	unsigned int		irq;
+	unsigned int		link_irqs[2];
+	int			sid_map_sz;
+	int			idx;
