@@ -147,3 +147,125 @@
 };
 
 #include "hwmon-mini.dtsi"
+
+/* Measured J274 external DCP -> port 1 USB4 DP-IN0 route.
+ * m1n1 supplies firmware and reserved-memory data on each boot.
+ * Keep the diagnostic property names until binding/API review is complete.
+ */
+/ {
+	aliases {
+		dcpext = &dcpext;
+	};
+};
+
+&dcpext {
+	/* Enabled by m1n1 only after firmware and memory fixups. */
+	apple,connector-type = "DP";
+	apple,dcp-index = <0>;
+	apple,dptx-die = <0>;
+	apple,dptx-phy = <1>;
+	codex,dpin-provider = <&usb4_1_acio>;
+};
+
+&dcpext_dart {
+	status = "okay";
+};
+
+&dispext0_dart {
+	status = "okay";
+};
+
+&dcpext_mbox {
+	status = "okay";
+};
+
+&{/soc/display-subsystem} {
+	iommus = <&disp0_dart 0 0 0 0 0xfc000000>,
+		 <&dispext0_dart 0 0 0 0 0xfc000000>;
+};
+
+&usb4_1_acio {
+	codex,atcphy = <&atcphy1>;
+	codex,dpin-callback-test;
+	mux-controls = <&atcphy1_xbar 1>;
+	mux-control-names = "dp-xbar";
+};
+
+&atcphy1 {
+	codex,dpin-clock-test;
+};
+
+&atcphy1_xbar {
+	codex,dpin-staged-test;
+};
+
+/* Static form of the measured storage overlay, using native NHI labels. */
+&usb4_0_acio {
+	apple,pcie-tunnel = <&usb4_0_pcie_tunnel>;
+};
+
+&usb4_0_pcie_tunnel {
+	nonposted-mmio;
+};
+
+&apciec0 {
+	apple,pciec-kernel-init;
+	status = "okay";
+};
+
+&apciec0_port {
+	usb4-host-interface = <&usb4_0_nhi>;
+	usb4-port-number = <0>;
+};
+
+&usb4_1_acio {
+	apple,pcie-tunnel = <&usb4_1_pcie_tunnel>;
+};
+
+&usb4_1_pcie_tunnel {
+	nonposted-mmio;
+};
+
+&apciec1 {
+	apple,pciec-kernel-init;
+	status = "okay";
+};
+
+&apciec1_port {
+	usb4-host-interface = <&usb4_1_nhi>;
+	usb4-port-number = <0>;
+};
+
+/* External DCP audio, tested through the Dynabook DP tunnel in DP128. */
+&dpaudio1 {
+	status = "okay";
+};
+
+/* Opt-in shared display routing, equivalent to the validated runtime bindings.
+ * Keep the legacy port1 provider for kernels which ignore the added routes.
+ * m1n1 still owns firmware and reserved-memory fixups.
+ */
+&dcpext {
+	apple,auto-dp-routing;
+	apple,native-dp-ports = <&hpm0>, <&hpm1>;
+	apple,dpin-ports = <&usb4_0_acio>, <&usb4_1_acio>;
+	phys = <&atcphy0 PHY_TYPE_DP>, <&atcphy1 PHY_TYPE_DP>;
+	phy-names = "dp0-phy", "dp1-phy";
+	mux-controls = <&atcphy0_xbar 0>, <&atcphy1_xbar 0>;
+	mux-control-names = "dp0-xbar", "dp1-xbar";
+};
+
+&usb4_0_acio {
+	apple,auto-dpin-provider;
+	codex,atcphy = <&atcphy0>;
+	mux-controls = <&atcphy0_xbar 1>;
+	mux-control-names = "dp-xbar";
+};
+
+&atcphy0 {
+	codex,dpin-clock-test;
+};
+
+&atcphy0_xbar {
+	codex,dpin-staged-test;
+};
