+/**
+ * pciehp_notify_presence_change - inspect a port after an out-of-band event
+ * @port: referenced PCIe port; caller must keep its host accessible
+ *
+ * Sleepable. Do not hold the PCI rescan/remove lock: service removal may wait
+ * for an IRQ thread taking that lock. The service device reference and device
+ * lock protect controller lifetime against unbind and surprise removal.
+ */
+int pciehp_notify_presence_change(struct pci_dev *port)
+{
+	struct device *dev;
+	struct controller *ctrl;
+	int ret = -ENODEV;
+
+	dev = device_find_child(&port->dev, NULL, pciehp_match_service);
+	if (!dev)
+		return ret;
+
+	device_lock(dev);
+	if (dev->driver != &hpdriver_portdrv.driver ||
+	    !device_is_bound(dev) || pci_dev_is_disconnected(port))
+		goto out;
+	ctrl = get_service_data(to_pcie_device(dev));
+	if (!ctrl)
+		goto out;
+	ret = pm_runtime_resume_and_get(&port->dev);
+	if (ret < 0)
+		goto out;
+	pciehp_check_presence(ctrl);
+	pm_runtime_put(&port->dev);
+	ret = 0;
