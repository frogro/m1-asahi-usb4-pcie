+	struct tb_switch *root;
+	struct tb_switch *sink;
+	struct codex_dp110_event event;
+};
+
+static bool dp118_adapter_ready(struct tb_port *port)
+{
+	u32 val;
+
+	if (!port->cap_adap || tb_port_read(port, &val, TB_CFG_PORT,
+					 port->cap_adap + ADP_DP_CS_0, 1))
+		return false;
+	return (val & (ADP_DP_CS_0_AE | ADP_DP_CS_0_VE)) ==
+		(ADP_DP_CS_0_AE | ADP_DP_CS_0_VE);
+}
+
+static bool dp118_ready_valid(struct dp118_ready_work *ready)
+{
+	struct tb_tunnel *tunnel = ready->tunnel;
+	struct tb *tb = tunnel->tb;
+	struct tb_cm *tcm = tb_priv(tb);
+
+	lockdep_assert_held(&tb->lock);
+	/* The pinned tunnel prevents pointer reuse, pinned switches keep ports
+	 * alive. Check membership before touching configuration space.
+	 */
+	if (!tcm->hotplug_active || tb->root_switch != ready->root ||
+	    ready->root->is_unplugged || ready->sink->is_unplugged ||
+	    tb_find_tunnel(tb, TB_TUNNEL_DP, tunnel->src_port,
+			   tunnel->dst_port) != tunnel || tunnel->dprx_canceled)
+		return false;
+	return dp118_adapter_ready(tunnel->src_port) &&
+		dp118_adapter_ready(tunnel->dst_port) &&
+		tb_dp_port_hpd_is_active(tunnel->src_port) > 0 &&
+		tb_dp_port_hpd_is_active(tunnel->dst_port) > 0;
+}
+
+static void dp118_paths_ready_work(struct work_struct *work)
+{
+	struct dp118_ready_work *ready = container_of(work,
+					struct dp118_ready_work, work);
+	struct tb *tb = ready->tunnel->tb;
+	struct tb_cm *tcm = tb_priv(tb);
+	bool valid;
+	int ret;
+
+	/* Physical DP hotplug and DPRX completion use this same ordered queue.
+	 * Domain removal additionally takes this gate BEFORE the domain mutex.
+	 * No TB/CIO lock is held over the listener's firmware transaction.
+	 */
+	mutex_lock(&tcm->dp118_callback_lock);
+	mutex_lock(&tb->lock);
+	valid = dp118_ready_valid(ready);
+	mutex_unlock(&tb->lock);
+	if (!valid)
+		goto out;
+	/* Preserve the tested admission: two enabled-adapter/HPD samples.
+	 * This is bounded debounce for one event, not recurring status polling.
+	 */
+	msleep(100);
+	mutex_lock(&tb->lock);
+	valid = dp118_ready_valid(ready);
+	mutex_unlock(&tb->lock);
+	if (!valid)
+		goto out;
+	ret = notifier_to_errno(blocking_notifier_call_chain(&dp110_retirement,
+				CODEX_DP_PATHS_READY, &ready->event));
+	tb_info(tb, "DP118 paths-ready seq=%llu sink=%llx:%u callback=%d\n",
+		ready->event.sequence, ready->event.output_route,
+		ready->event.output_port, ret);
+out:
+	if (!valid)
+		tb_info(tb, "DP118 stale/unready seq=%llu skipped\n",
+			ready->event.sequence);
+	mutex_unlock(&tcm->dp118_callback_lock);
+	tb_tunnel_put(ready->tunnel);
+	tb_switch_put(ready->sink);
+	tb_switch_put(ready->root);
+	put_device(ready->event.controller);
+	kfree(ready);
+	tb_domain_put(tb);
+}
+
+static void dp118_queue_paths_ready(struct tb_tunnel *tunnel)
+{
+	struct tb *tb = tunnel->tb;
+	struct dp118_ready_work *ready;
+	struct tb_port *port;
+	unsigned int index = 0;
+
+	lockdep_assert_held(&tb->lock);
+	if (!rcu_access_pointer(dp110_retirement.head) ||
+	    tunnel->src_port->sw != tb->root_switch)
+		return;
+	tb_switch_for_each_port(tb->root_switch, port) {
+		if (!tb_port_is_dpin(port))
+			continue;
+		if (port == tunnel->src_port)
+			break;
+		index++;
+	}
+	if (port != tunnel->src_port || index > U8_MAX)
+		return;
+	ready = kzalloc(sizeof(*ready), GFP_KERNEL);
+	if (!ready) {
+		tb_warn(tb, "DP118 cannot allocate paths-ready event\n");
+		return;
+	}
+	ready->tunnel = tunnel;
+	ready->root = tb_switch_get(tunnel->src_port->sw);
+	ready->sink = tb_switch_get(tunnel->dst_port->sw);
+	ready->event.controller = get_device(tb->nhi->dev);
+	ready->event.input_index = index;
+	ready->event.output_route = tb_route(tunnel->dst_port->sw);
+	ready->event.output_port = tunnel->dst_port->port;
+	ready->event.sequence = atomic64_inc_return(&dp110_sequence);
+	tb_tunnel_get(tunnel);
+	tb_domain_get(tb);
+	INIT_WORK(&ready->work, dp118_paths_ready_work);
+	queue_work(tb->wq, &ready->work);
+}
+
+/* Called only by domain removal, before taking tb->lock and after releasing
+ * it respectively. Firmware-managed connection managers have no private gate.
+ */
+void tb_dp118_stop_begin(struct tb *tb)
+{
+	struct tb_cm *tcm = tb_priv(tb);
+
+	if (tb->cm_ops == &tb_cm_ops) {
+		spin_lock(&tcm->dp125_replay_lock);
+		tcm->dp125_replay_stopping = true;
+		spin_unlock(&tcm->dp125_replay_lock);
+		mutex_lock(&tcm->dp118_callback_lock);
+	}
+}
+
+void tb_dp118_stop_end(struct tb *tb)
+{
+	struct tb_cm *tcm = tb_priv(tb);
+
+	if (tb->cm_ops == &tb_cm_ops)
+		mutex_unlock(&tcm->dp118_callback_lock);
+}
+
+/* Component bind may hold component_mutex, while domain start holds
+ * tb->lock and adds USB4 components. Never take tb->lock in the caller.
+ * The embedded work runs on the domain's ordered queue. Queue admission
+ * closes before domain stop; domain removal/release drains this queue
+ * before freeing tcm, so no last device reference is dropped by this work.
+ */
+static void dp125_replay_work(struct work_struct *work)
+{
+	struct tb_cm *tcm = container_of(work, struct tb_cm, dp125_replay_work);
+	struct tb *tb = tcm_to_tb(tcm);
+	struct tb_tunnel *tunnel;
+
+	mutex_lock(&tb->lock);
+	if (tcm->hotplug_active && tb->root_switch)
+		list_for_each_entry(tunnel, &tcm->tunnel_list, list)
+			if (tunnel->type == TB_TUNNEL_DP)
+				dp118_queue_paths_ready(tunnel);
+	mutex_unlock(&tb->lock);
+	tb_dbg(tb, "DP125 asynchronous ready replay complete\n");
+}
+
+static int dp121_replay_domain(struct device *dev, void *data)
+{
+	struct device *provider = data;
+	struct tb *tb;
+	struct tb_cm *tcm;
+
+	if (dev->type != &tb_domain_type)
+		return 0;
+	tb = container_of(dev, struct tb, dev);
+	if (tb->cm_ops != &tb_cm_ops || tb->nhi->dev->parent != provider)
+		return 0;
+	tcm = tb_priv(tb);
+	/* bus_for_each_dev pins the device through queue admission. */
+	spin_lock(&tcm->dp125_replay_lock);
+	if (!tcm->dp125_replay_stopping)
+		queue_work(tb->wq, &tcm->dp125_replay_work);
+	spin_unlock(&tcm->dp125_replay_lock);
+	return 0;
+}
+
+int codex_dp121_replay_ready(struct device *provider)
+{
+	if (!provider)
+		return -EINVAL;
+	return bus_for_each_dev(&tb_bus_type, NULL, provider, dp121_replay_domain);
+}
+EXPORT_SYMBOL_GPL(codex_dp121_replay_ready);
+
+/* Stop admitting old-domain events BEFORE asking DCP to withdraw. The
+ * caller keeps CIO/PHY powered but holds neither CIO nor domain mutex.
+ * This is also used when the peripheral has already disappeared from the
+ * topology: the local DP-IN and its firmware owner still need retirement.
+ */
+static int dp127_prepare_domain_stop(struct device *dev, void *data)
+{
+	struct device *provider = data;
+	struct tb *tb;
+	struct tb_cm *tcm;
+	struct tb_port *port;
+	struct codex_dp110_event event = {};
+	unsigned int index = 0;
+	int ret = 0, err;
+	if (dev->type != &tb_domain_type)
+		return 0;
+	tb = container_of(dev, struct tb, dev);
+	if (tb->cm_ops != &tb_cm_ops || tb->nhi->dev->parent != provider)
+		return 0;
+	tcm = tb_priv(tb);
+	spin_lock(&tcm->dp125_replay_lock);
+	tcm->dp125_replay_stopping = true;
+	spin_unlock(&tcm->dp125_replay_lock);
+	mutex_lock(&tcm->dp118_callback_lock);
+	mutex_lock(&tb->lock);
+	tcm->hotplug_active = false;
+	mutex_unlock(&tb->lock);
+	event.controller = tb->nhi->dev;
+	if (tb->root_switch) {
+		tb_switch_for_each_port(tb->root_switch, port) {
+			if (!tb_port_is_dpin(port))
+				continue;
+			event.input_index = index++;
+			event.sequence = atomic64_inc_return(&dp110_sequence);
+			err = notifier_to_errno(blocking_notifier_call_chain(&dp110_retirement,
+                     CODEX_DP_CONTROLLER_RETIRING, &event));
+			tb_info(tb, "DP127 controller retirement seq=%llu input=%u ret=%d\n",
+           event.sequence, event.input_index, err);
+			if (err && !ret)
+				ret = err;
+		}
+	}
+	mutex_unlock(&tcm->dp118_callback_lock);
+	return ret;
+}
+int codex_dp127_prepare_stop(struct device *provider)
+{
+	if (!provider)
+		return -EINVAL;
+	return bus_for_each_dev(&tb_bus_type, NULL, provider, dp127_prepare_domain_stop);
+}
+EXPORT_SYMBOL_GPL(codex_dp127_prepare_stop);
diff --git a/drivers/thunderbolt/dpin-provider.inc b/drivers/thunderbolt/dpin-provider.inc
new file mode 100644
index 0000000..423edaa
--- /dev/null
+++ b/drivers/thunderbolt/dpin-provider.inc
@@ -0,0 +1,326 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* DP91 diagnostic M1/DP-IN0 provider, not a general multi-stream driver.
+ * Register sequence: DP88-90 and macOS/m1n1 captures; clock implementation
+ * attributed separately in the DP90 PHY source. No firmware calls here.
+ * Lock order: provider registry read lock -> CIO lock -> ATCPHY lock.
+ * Cable shutdown already holds CIO lock and revokes before power removal.
+ */
+#include <linux/apple-usb4-dpin.h>
+#include <linux/apple-display-crossbar.h>
+#include <linux/rwsem.h>
+static DECLARE_RWSEM(dp91_registry_lock);
+static LIST_HEAD(dp91_providers);
+
+/* The registry read lock pins provider lifetime until the caller is done.
+ * Tokens remain provider-specific; a token from the other port is invalid.
+ * This registry does not grant ownership of the shared display controller.
+ */
+static struct apple_cio *dp91_find_provider(struct device *dev)
+{
+	struct apple_cio *acio;
+
+	lockdep_assert_held(&dp91_registry_lock);
+	list_for_each_entry(acio, &dp91_providers, dp91_registry_node) {
+		if (acio->dev == dev)
+			return acio;
+	}
+	return NULL;
+}
+#if IS_REACHABLE(CONFIG_PHY_APPLE_ATC)
+extern int codex_m1_dpin_clock_acquire(struct device *, u8, u64 *);
+extern int codex_m1_dpin_clock_rate(struct device *, u64, u8);
+extern int codex_m1_dpin_clock_release(struct device *, u64);
+#else
+static inline int codex_m1_dpin_clock_acquire(struct device *dev, u8 rate, u64 *cookie)
+{
+	return -EOPNOTSUPP;
+}
+static inline int codex_m1_dpin_clock_rate(struct device *dev, u64 cookie, u8 rate)
+{
+	return -EOPNOTSUPP;
+}
+static inline int codex_m1_dpin_clock_release(struct device *dev, u64 cookie)
+{
+	return -EOPNOTSUPP;
+}
+#endif
+static atomic64_t dp91_sequence = ATOMIC64_INIT(0);
+
+/* DP97: bounded reads only while holding the validated live CIO lease.
+ * Offsets also read in the macOS DP74 reference; no new register writes.
+ */
+static void dp97_snapshot(struct apple_cio *acio, const char *phase)
+{
+	u32 status, event, config, control, ack;
+	lockdep_assert_held(&acio->lock);
+	status = readl(acio->dp91_regs);
+	event = readl(acio->dp91_regs + 0x4);
+	config = readl(acio->dp91_regs + 0x8);
+	control = readl(acio->dp91_regs + 0xc);
+	ack = readl(acio->dp91_regs + 0x10);
+	dev_info(acio->dev, "DP97 snapshot %s status=%08x event=%08x config=%08x ctrl=%08x ack=%08x\n",
+		 phase, status, event, config, control, ack);
+}
+
+static int dp91_inactive(struct apple_cio *acio)
+{
+	u32 ctrl, ack;
+	int ret;
+	lockdep_assert_held(&acio->lock);
+	ctrl = readl(acio->dp91_regs + 0xc);
+	if (ctrl == U32_MAX)
+		return -EIO;
+	writel(ctrl | 1, acio->dp91_regs + 0xc);
+	ret = readl_poll_timeout(acio->dp91_regs + 0x10, ack,
+				ack != U32_MAX && (ack & 1), 10, 100000);
+	if (ret)
+		return ret;
+	if (acio->dp91_routed) {
+		ret = codex_m1_dpxbar_link(acio->dp91_mux, false);
+		if (ret)
+			return ret;
+	}
+	acio->dp104_running = false;
+	return 0;
+}
+
+static int dp91_revoke(struct apple_cio *acio)
+{
+	int ret = 0;
+	lockdep_assert_held(&acio->lock);
+	/* Invalidate admission before touching hardware or dropping its power. */
+	acio->dp91_token = 0;
+	if (!acio->dp91_regs)
+		return 0;
+	/* Restore only while this provider still owns live, unpoisoned MMIO. */
+	if (!acio->dp91_poisoned && acio->dp98_irq_owned) {
+		writel(acio->dp98_irq_saved, acio->dp91_regs + 0x8);
+		readl(acio->dp91_regs + 0x8);
+		acio->dp98_irq_owned = false;
+	}
+	ret = acio->dp91_poisoned ? -EUCLEAN : dp91_inactive(acio);
+	if (!ret && acio->dp91_routed) {
+		ret = mux_control_deselect(acio->dp91_mux);
+		if (!ret)
+			acio->dp91_routed = false;
+	}
+	if (!ret && acio->dp91_clock)
+		ret = codex_m1_dpin_clock_release(&acio->dp91_phy->dev,
+						acio->dp91_clock);
+	if (ret) {
+		/* Fail closed: no new lease after an incomplete cleanup. */
+		acio->dp91_poisoned = true;
+		/* Keep ownership/power on failure; do not access poisoned MMIO. */
+		dev_err(acio->dev, "DP91 revoke incomplete: %d; new bindings blocked\n", ret);
+	} else {
+		acio->dp91_clock = 0;
+	}
+	/* Keep resources until remove if cleanup failed; never revisit this MMIO. */
+	if (!ret) {
+		iounmap(acio->dp91_regs);
+		acio->dp91_regs = NULL;
+	}
+	return ret;
+}
+
+int codex_dpin_begin(struct device *dev, u64 *token)
+{
+	struct apple_cio *acio;
+	u32 ctrl, ack, status;
+	int ret = -ENODEV;
+	if (!token)
+		return -EINVAL;
+	*token = 0;
+	down_read(&dp91_registry_lock);
+	acio = dp91_find_provider(dev);
+	if (!acio)
+		goto out;
+	mutex_lock(&acio->lock);
+	if (!acio->dp91_phy || acio->dp91_poisoned) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+	if (acio->dp127_stopping) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	if (!acio->current_cable_info || !acio->rtk || acio->nhi_boot_status) {
+		ret = -ENOLINK;
+		goto unlock;
+	}
+	if (acio->dp91_token || acio->dp91_regs) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	acio->dp91_regs = ioremap_np(acio->rc_res->start + 0x390000, 0x4000);
+	if (!acio->dp91_regs) {
+		ret = -ENOMEM;
+		goto unlock;
+	}
+	ctrl = readl(acio->dp91_regs + 0xc);
+	ack = readl(acio->dp91_regs + 0x10);
+	status = readl(acio->dp91_regs);
+	if (ctrl == U32_MAX || ack == U32_MAX || status == U32_MAX ||
+	    !(ctrl & 1) || !(ack & 1) || !(status & BIT(2))) {
+		ret = -EBUSY;
+		iounmap(acio->dp91_regs);
+		acio->dp91_regs = NULL;
+		goto unlock;
+	}
+	ret = codex_m1_dpin_clock_acquire(&acio->dp91_phy->dev, 0x14,
+					&acio->dp91_clock);
+	if (ret) {
+		int cleanup = dp91_revoke(acio);
+		if (cleanup)
+			ret = cleanup;
+		goto unlock;
+	}
+	/* DP98 bounded experiment. Register semantics checked against our macOS
+	 * DP74 capture and omacom/linux-aurora apple_dpin_up at
+	 * 2f725546d6ac6afe0bd5abfa1a844971519f0076. Not a complete IRQ handler.
+	 * Preserve the original enable mask for orderly lease retirement.
+	 */
+	{
+		u32 pending = readl(acio->dp91_regs + 0x4);
+		u32 mask = readl(acio->dp91_regs + 0x8);
+		if (pending == U32_MAX || mask == U32_MAX) {
+			ret = -EIO;
+			dp91_revoke(acio);
+			goto unlock;
+		}
+		acio->dp98_irq_saved = mask;
+		acio->dp98_irq_owned = true;
+		writel(pending, acio->dp91_regs + 0x4);
+		if (pending & BIT(0))
+			writel(readl(acio->dp91_regs), acio->dp91_regs);
+		writel(mask | 3, acio->dp91_regs + 0x8);
+		dp97_snapshot(acio, "DP98-events-enabled");
+	}
+	acio->dp91_token = atomic64_inc_return(&dp91_sequence);
+	if (!acio->dp91_token)
+		acio->dp91_token = atomic64_inc_return(&dp91_sequence);
+	*token = acio->dp91_token;
+unlock:
+	mutex_unlock(&acio->lock);
+out:
+	up_read(&dp91_registry_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(codex_dpin_begin);
+
+int codex_dpin_call(struct device *dev, u64 token, enum codex_dpin_op op, u8 rate)
+{
+	struct apple_cio *acio;
+	u32 ctrl, ack;
+	int ret = -ENODEV;
+	down_read(&dp91_registry_lock);
+	acio = dp91_find_provider(dev);
+	if (!acio)
+		goto out;
+	mutex_lock(&acio->lock);
+	/* No register access until both generation and power are validated. */
+	if (!token || token != acio->dp91_token || acio->dp91_poisoned) {
+		ret = -ESTALE;
+		goto unlock;
+	}
+	if (!acio->current_cable_info || !acio->rtk || acio->nhi_boot_status) {
+		ret = -ENOLINK;
+		goto unlock;
+	}
+	ret = 0;
+	switch (op) {
+	case CODEX_DPIN_CHECK:
+		break;
+	case CODEX_DPIN_RATE:
+		if (acio->dp104_running) {
+			ret = -EBUSY;
+			break;
+		}
+		ret = codex_m1_dpin_clock_rate(&acio->dp91_phy->dev,
+					     acio->dp91_clock, rate);
+		break;
+	case CODEX_DPIN_ACTIVE:
+		if (acio->dp104_running)
+			break;
+		dp97_snapshot(acio, "before-active");
+		if (!acio->dp91_routed) {
+			ret = mux_control_try_select(acio->dp91_mux, 0);
+			if (ret)
+				break;
+			acio->dp91_routed = true;
+		}
+		ctrl = readl(acio->dp91_regs + 0xc);
+		if (ctrl == U32_MAX) {
+			ret = -EIO;
+		} else {
+			writel(ctrl & ~1U, acio->dp91_regs + 0xc);
+			ret = readl_poll_timeout(acio->dp91_regs + 0x10, ack,
+				ack != U32_MAX && !(ack & 1), 10, 100000);
+		}
+		if (!ret) {
+			dev_info(dev, "DP104 handshake confirmed; enabling clocks\n");
+			ret = codex_m1_dpxbar_link(acio->dp91_mux, true);
+		}
+		if (!ret) {
+			acio->dp104_running = true;
+			dp97_snapshot(acio, "after-active");
+		}
+		if (ret) {
+			int cleanup = dp91_revoke(acio);
+			if (cleanup)
+				ret = cleanup;
+		}
+		break;
+	case CODEX_DPIN_INACTIVE:
+		ret = dp91_inactive(acio);
+		if (ret) {
+			acio->dp91_token = 0;
+			acio->dp91_poisoned = true;
+		}
+		break;
+	case CODEX_DPIN_END:
+		ret = dp91_revoke(acio);
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	dev_info(dev, "DP91 callback token=%llu op=%u rate=%02x ret=%d\n",
+		 token, op, rate, ret);
+unlock:
+	mutex_unlock(&acio->lock);
+out:
+	up_read(&dp91_registry_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(codex_dpin_call);
+
+static void dp91_put_phy(void *data)
+{
+	put_device(data);
+}
+
+static int dp91_provider_init(struct apple_cio *acio)
+{
+	struct device_node *np;
+	int ret;
+	if (!of_property_read_bool(acio->np, "codex,dpin-callback-test") &&
+	    !of_property_read_bool(acio->np, "apple,auto-dpin-provider"))
+		return 0;
+	if (!of_machine_is_compatible("apple,t8103"))
+		return -EOPNOTSUPP;
+	np = of_parse_phandle(acio->np, "codex,atcphy", 0);
+	if (!np)
+		return -EINVAL;
+	acio->dp91_phy = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!acio->dp91_phy)
+		return -EPROBE_DEFER;
+	ret = devm_add_action_or_reset(acio->dev, dp91_put_phy, &acio->dp91_phy->dev);
+	if (ret)
+		return ret;
+	if (!device_link_add(acio->dev, &acio->dp91_phy->dev,
+			     DL_FLAG_AUTOREMOVE_CONSUMER))
+		return -ENODEV;
+	acio->dp91_mux = devm_mux_control_get(acio->dev, "dp-xbar");
+	return PTR_ERR_OR_ZERO(acio->dp91_mux);
+}
diff --git a/drivers/thunderbolt/fwnode.c b/drivers/thunderbolt/fwnode.c
new file mode 100644
index 0000000..2da4c2e
--- /dev/null
+++ b/drivers/thunderbolt/fwnode.c
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Firmware-described native PCIe port dependencies, including late ports. */
+
+#include <linux/device.h>
+#include <linux/notifier.h>
+#include <linux/pci.h>
+#include <linux/property.h>
+
+#include "tb.h"
+
+struct tb_fwnode_links {
+	struct notifier_block notifier;
+	struct device *nhi;
+};
+
+static int tb_fwnode_add_link(struct device *dev, void *data)
+{
+	struct tb_fwnode_links *links = data;
+	struct fwnode_handle *reference;
+	struct device_link *link;
+	struct pci_dev *pdev;
+	u32 port = 0;
+	bool matches;
+
+	if (!dev_is_pci(dev) || !dev_fwnode(dev))
+		return 0;
+	pdev = to_pci_dev(dev);
+	if (!pci_is_pcie(pdev) ||
+	    (pci_pcie_type(pdev) != PCI_EXP_TYPE_ROOT_PORT &&
+	     pci_pcie_type(pdev) != PCI_EXP_TYPE_DOWNSTREAM))
+		return 0;
+
+	reference = fwnode_find_reference(dev_fwnode(dev), "usb4-host-interface", 0);
+	if (IS_ERR(reference))
+		return 0;
+	matches = device_match_fwnode(links->nhi, reference);
+	fwnode_handle_put(reference);
+	if (!matches)
+		return 0;
+
+	/* The property identifies the connector within this NHI, not the BDF. */
+	device_property_read_u32(dev, "usb4-port-number", &port);
+	/*
+	 * The consumer must suspend before and resume after its NHI. Managed
+	 * links are purged on consumer deletion or supplier unbind. No extra
+	 * runtime-PM reference is taken here, so a scan racing a PCI add event
+	 * can safely encounter the same consumer twice.
+	 */
+	link = device_link_add(dev, links->nhi,
+			       DL_FLAG_AUTOREMOVE_SUPPLIER | DL_FLAG_PM_RUNTIME);
+	if (!link)
+		dev_warn(links->nhi, "native PCIe link from %s failed\n", dev_name(dev));
+	else
+		dev_info(links->nhi, "native PCIe link from %s (USB4 port %u)\n",
+			 dev_name(dev), port);
+	return 0;
+}
+
+static int tb_fwnode_pci_event(struct notifier_block *notifier,
+			       unsigned long event, void *dev)
+{
+	struct tb_fwnode_links *links =
+		container_of(notifier, struct tb_fwnode_links, notifier);
+
+	/* Device initialization and its firmware-node assignment are complete. */
+	if (event == BUS_NOTIFY_ADD_DEVICE)
+		tb_fwnode_add_link(dev, links);
+	return NOTIFY_DONE;
+}
+
+static void tb_fwnode_remove_notifier(void *data)
+{
+	struct tb_fwnode_links *links = data;
+
+	bus_unregister_notifier(&pci_bus_type, &links->notifier);
+}
+
+bool tb_fwnode_add_links(struct tb_nhi *nhi)
+{
+	struct tb_fwnode_links *links;
+	int ret;
+
+	if (!dev_fwnode(nhi->dev))
+		return false;
+	links = devm_kzalloc(nhi->dev, sizeof(*links), GFP_KERNEL);
+	if (!links)
+		return false;
+	links->nhi = nhi->dev;
+	links->notifier.notifier_call = tb_fwnode_pci_event;
+	/* Watch first, then scan, so a port appearing during setup is not lost. */
+	ret = bus_register_notifier(&pci_bus_type, &links->notifier);
+	if (ret)
+		return false;
+	ret = devm_add_action_or_reset(nhi->dev, tb_fwnode_remove_notifier, links);
+	if (ret)
+		return false;
+	bus_for_each_dev(&pci_bus_type, NULL, links, tb_fwnode_add_link);
+	dev_info(nhi->dev, "watching firmware-described native PCIe ports\n");
+	return true;
+}
