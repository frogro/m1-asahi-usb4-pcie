diff --git a/drivers/gpu/drm/apple/native-dp.inc b/drivers/gpu/drm/apple/native-dp.inc
new file mode 100644
index 0000000..e44be5a
--- /dev/null
+++ b/drivers/gpu/drm/apple/native-dp.inc
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Opt-in exclusive native route, with initial HPD replay after DRM readiness.
+ * This does not implement dynamic native/DP-IN arbitration or HPD IRQ pulses.
+ */
+static void dcp_native_dp_put_provider(void *data)
+{
+	put_device(data);
+}
+
+static int dcp_native_dp_init(struct apple_dcp *dcp)
+{
+	struct device_node *np, *connector, *target;
+	struct i2c_client *client;
+	int ret;
+
+	np = of_parse_phandle(dcp->dev->of_node, "apple,native-dp-port", 0);
+	if (!np)
+		return 0;
+	/* Never take a controller away from the established DP-IN path. */
+	if (dcp->dptxport[0].dpin_provider || !dcp->phy || dcp->hdmi_hpd ||
+	    !of_device_is_compatible(dcp->dev->of_node, "apple,dcpext") ||
+	    !of_device_is_compatible(np, "apple,cd321x")) {
+		of_node_put(np);
+		return -EINVAL;
+	}
+	connector = of_get_child_by_name(np, "connector");
+	target = of_parse_phandle(connector, "displayport", 0);
+	of_node_put(connector);
+	if (target != dcp->dev->of_node) {
+		of_node_put(target);
+		of_node_put(np);
+		return -EINVAL;
+	}
+	of_node_put(target);
+	client = of_find_i2c_device_by_node(np);
+	of_node_put(np);
+	if (!client)
+		return -EPROBE_DEFER;
+	if (!device_is_bound(&client->dev)) {
+		put_device(&client->dev);
+		return -EPROBE_DEFER;
+	}
+	ret = devm_add_action_or_reset(dcp->dev, dcp_native_dp_put_provider, &client->dev);
+	if (ret)
+		return ret;
+	if (!device_link_add(dcp->dev, &client->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+		return -ENODEV;
+	dcp->native_dp_provider = &client->dev;
+	return 0;
+}
+
+static int dcp_native_dp_hpd(void *data, bool high)
+{
+	struct apple_dcp *dcp = data;
+	struct dptx_port *port = &dcp->dptxport[0];
+	int ret;
+
+	/* Provider serializes callbacks and drops its PD status lock for these. */
+	if (!dcp->native_dp_ready || dcp->native_dp_fault || dcp->crashed ||
+	    !dcp->active || !port->enabled || !port->service ||
+	    port->dpin_provider || !dcp->phy)
+		return -ENODEV;
+	if (port->connected == high)
+		return 0;
+
+	mutex_lock(&dcp->hpd_mutex);
+	if (high) {
+		reinit_completion(&port->linkcfg_completion);
+		port->atcphy = dcp->phy;
+		ret = dptxport_connect(port->service, 0, dcp->dptx_phy, dcp->dptx_die);
+		if (ret)
+			goto fault;
+		ret = dptxport_request_display(port->service);
+		if (ret)
+			goto fault;
+		mutex_unlock(&dcp->hpd_mutex);
+		/* Preserve the proven legacy sequence; a wait expiry is not link proof. */
+		if (!wait_for_completion_timeout(&port->linkcfg_completion, DPTX_CONNECT_TIMEOUT))
+			dev_dbg(dcp->dev, "native DP link configuration still pending at HPD\n");
+		ret = dptxport_set_hpd(port->service, true);
+		mutex_lock(&dcp->hpd_mutex);
+		if (ret)
+			goto fault;
+		port->connected = true;
+	} else {
+		mutex_unlock(&dcp->hpd_mutex);
+		/* The HPD-low reply follows display power-off. On M1 this took
+		 * about three seconds in the unplug trace, beyond the legacy
+		 * one-second EPIC deadline. Retain ownership while waiting for
+		 * the checked reply; a real timeout still quarantines the route.
+		 */
+		ret = dptxport_set_hpd_timeout(port->service, false, 5000);
+		mutex_lock(&dcp->hpd_mutex);
+		if (ret)
+			goto fault;
+		ret = dptxport_release_display(port->service);
+		if (ret)
+			goto fault;
+		port->connected = false;
+	}
+	mutex_unlock(&dcp->hpd_mutex);
+	if (!high)
+		disconnected_hpd_event(dcp->connector);
+	if (dcp->avep) {
+		if (high)
+			av_service_connect(dcp);
+		else
+			av_service_disconnect(dcp);
+	}
+	dev_info(dcp->dev, "native DP HPD=%u applied after DRM readiness\n", high);
+	return 0;
+
+fault:
+	/* Partial firmware transactions are uncertain; never retry automatically. */
+	dcp->native_dp_fault = true;
+	mutex_unlock(&dcp->hpd_mutex);
+	dev_err(dcp->dev, "native DP HPD=%u failed: %d; route remains reserved\n", high, ret);
+	return ret;
+}
+
+int dcp_native_dp_start(struct platform_device *pdev)
+{
+	struct apple_dcp *dcp = platform_get_drvdata(pdev);
+	int ret;
+
+	if (dcp->auto_dp)
+		return dcp_auto_dp_start(dcp);
+	if (!dcp->native_dp_provider || dcp->native_dp_registered)
+		return 0;
+	if (!dcp->active || !dcp->connector || !dcp->dptxport[0].enabled ||
+	    !dcp->dptxport[0].service)
+		return -ENODEV;
+	dcp->native_dp_sink.set_hpd = dcp_native_dp_hpd;
+	dcp->native_dp_sink.data = dcp;
+	dcp->native_dp_ready = true;
+	ret = apple_cd321x_dp_attach(dcp->native_dp_provider, &dcp->native_dp_sink);
+	if (ret) {
+		dcp->native_dp_ready = false;
+		return ret;
+	}
+	dcp->native_dp_registered = true;
+	return 0;
+}
+
+void dcp_native_dp_stop(struct platform_device *pdev)
+{
+	struct apple_dcp *dcp = platform_get_drvdata(pdev);
+	int ret;
+
+	if (dcp->auto_dp) {
+		dcp_auto_dp_stop(dcp);
+		return;
+	}
+	if (!dcp->native_dp_registered)
+		return;
+	/* detach drains callbacks before DRM/modeset/firmware teardown. */
+	ret = apple_cd321x_dp_detach(dcp->native_dp_provider, &dcp->native_dp_sink);
+	dcp->native_dp_registered = false;
+	dcp->native_dp_ready = false;
+	if (ret)
+		dev_err(dcp->dev, "native DP withdrawal on stop failed: %d\n", ret);
+}
