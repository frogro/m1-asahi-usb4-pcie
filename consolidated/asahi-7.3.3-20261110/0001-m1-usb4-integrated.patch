diff --git a/drivers/gpu/drm/apple/auto-dp.inc b/drivers/gpu/drm/apple/auto-dp.inc
new file mode 100644
index 0000000..b54175f
--- /dev/null
+++ b/drivers/gpu/drm/apple/auto-dp.inc
@@ -0,0 +1,374 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Experimental M1 shared-DCP routing. Inactive without an explicit DT opt-in.
+ * dp91_mutex serializes owner changes; no PD, CIO or TB domain lock may be
+ * held while calling firmware. Native withdrawal callbacks execute before
+ * the PD provider changes its pins. Dock withdrawal is acknowledged before
+ * the TB provider retires its token. A failure blocks all further selection.
+ */
+
+static int dcp_auto_dp_drain(struct apple_dcp *dcp)
+{
+	struct apple_epic_service *service = dcp->dptxport[0].service;
+	unsigned long flags;
+	bool idle;
+
+	flush_workqueue(service->ep->wq);
+	spin_lock_irqsave(&service->lock, flags);
+	idle = bitmap_empty(service->cmd_map, MAX_PENDING_CMDS);
+	spin_unlock_irqrestore(&service->lock, flags);
+	return idle ? 0 : -EBUSY;
+}
+
+static int dcp_auto_dp_acquire(struct apple_dcp *dcp, unsigned int id)
+{
+	struct dcp_auto_route *route = &dcp->auto_dp_routes[id];
+	struct dptx_port *port = &dcp->dptxport[0];
+	int ret;
+
+	lockdep_assert_held(&dcp->dp91_mutex);
+	/* Only an idle arbiter may reach here; the previous route was drained. */
+	if (port->connected || port->dpin_token)
+		return -EUCLEAN;
+	port->phy_ops = (union phy_configure_opts) {};
+	port->lane_count = 0;
+	port->link_rate = 0;
+	port->pending_link_rate = 0;
+	dcp->dptx_phy = route->phy_index;
+	if (route->native) {
+		ret = mux_control_try_select(route->mux, dcp->index);
+		if (ret)
+			return ret;
+		route->mux_owned = true;
+		port->dpin_provider = NULL;
+		port->route_type = DPTX_ROUTE_PHY;
+		dcp->phy = route->phy;
+		return dcp_native_dp_hpd(dcp, true);
+	}
+	dcp->phy = NULL;
+	port->atcphy = NULL;
+	port->route_type = DPTX_ROUTE_USB4;
+	port->dpin_provider = route->provider;
+	port->dpin_attempted = false;
+	port->dpin_withdraw_attempted = false;
+	port->dpin_withdrawn = false;
+	port->dpin_reconnect_attempted = false;
+	return dp118_connect_locked(dcp, false);
+}
+
+static int dcp_auto_dp_release(struct apple_dcp *dcp, unsigned int id)
+{
+	struct dcp_auto_route *route = &dcp->auto_dp_routes[id];
+	struct dptx_port *port = &dcp->dptxport[0];
+	int ret;
+
+	lockdep_assert_held(&dcp->dp91_mutex);
+	if (route->native) {
+		ret = dcp_native_dp_hpd(dcp, false);
+	} else {
+		ret = dp107_withdraw(dcp);
+	}
+	if (ret)
+		return ret;
+	/* Keep the old callback routing until every firmware callback is done. */
+	ret = dcp_auto_dp_drain(dcp);
+	if (ret)
+		return ret;
+	if (route->native) {
+		if (!route->mux_owned)
+			return -EUCLEAN;
+		ret = mux_control_deselect(route->mux);
+		if (ret)
+			return ret;
+		route->mux_owned = false;
+	} else {
+		ret = codex_dpin_call(route->provider, READ_ONCE(port->dpin_token),
+				      CODEX_DPIN_END, 0);
+		if (ret)
+			return ret;
+		WRITE_ONCE(port->dpin_token, 0);
+	}
+	dcp->phy = NULL;
+	port->atcphy = NULL;
+	port->dpin_provider = NULL;
+	return 0;
+}
+
+static int dcp_auto_dp_execute(struct apple_dcp *dcp,
+			       const struct apple_dp_command *cmd)
+{
+	int ret;
+
+	if (cmd->action == APPLE_DP_ACQUIRE)
+		ret = dcp_auto_dp_acquire(dcp, cmd->route);
+	else
+		ret = dcp_auto_dp_release(dcp, cmd->route);
+	apple_dp_policy_complete(&dcp->auto_dp_policy, cmd, ret);
+	dev_info(dcp->dev, "auto DP route=%u generation=%llu action=%u ret=%d\n",
+		 cmd->route, cmd->generation, cmd->action, ret);
+	return ret;
+}
+
+static void dcp_auto_dp_work(struct work_struct *work)
+{
+	struct apple_dcp *dcp = container_of(work, struct apple_dcp, auto_dp_work);
+	struct apple_dp_command cmd;
+
+	mutex_lock(&dcp->dp91_mutex);
+	while (dcp->auto_dp_ready &&
+	       apple_dp_policy_next(&dcp->auto_dp_policy, &cmd) == 1) {
+		if (dcp_auto_dp_execute(dcp, &cmd))
+			break;
+	}
+	mutex_unlock(&dcp->dp91_mutex);
+}
+
+/* Caller holds dp91_mutex. Withdraw this owner synchronously, but acquire
+ * any successor only on our worker, outside the provider's notification.
+ */
+static int dcp_auto_dp_request(struct dcp_auto_route *route, bool present)
+{
+	struct apple_dcp *dcp = route->dcp;
+	struct apple_dp_policy *policy = &dcp->auto_dp_policy;
+	struct apple_dp_command cmd;
+	int ret;
+
+	lockdep_assert_held(&dcp->dp91_mutex);
+	if (policy->phase == APPLE_DP_FAULT) {
+		/* Quarantine the uncertain display route, not an unrelated port's
+		 * storage/network teardown. No new acquisition is admitted.
+		 */
+		if (!present && policy->owner != (int)route->id &&
+		    policy->pending.route != route->id)
+			return 0;
+		return -EUCLEAN;
+	}
+	if (route->generation == ~(u64)0)
+		return -EOVERFLOW;
+	ret = apple_dp_policy_request(policy, route->id, ++route->generation, present);
+	if (ret)
+		return ret;
+	if (!present && policy->owner == (int)route->id) {
+		ret = apple_dp_policy_next(policy, &cmd);
+		if (ret != 1 || cmd.action != APPLE_DP_RELEASE)
+			return ret < 0 ? ret : -EUCLEAN;
+		ret = dcp_auto_dp_execute(dcp, &cmd);
+		if (ret)
+			return ret;
+	}
+	if (dcp->auto_dp_ready)
+		schedule_work(&dcp->auto_dp_work);
+	return 0;
+}
+
+static int dcp_auto_dp_native_hpd(void *data, bool high)
+{
+	struct dcp_auto_route *route = data;
+	int ret;
+
+	mutex_lock(&route->dcp->dp91_mutex);
+	ret = dcp_auto_dp_request(route, high);
+	mutex_unlock(&route->dcp->dp91_mutex);
+	return ret;
+}
+
+static int dcp_auto_dp_notify(struct notifier_block *nb,
+			      unsigned long action, void *data)
+{
+	struct apple_dcp *dcp = container_of(nb, struct apple_dcp, auto_dp_notifier);
+	struct codex_dp110_event *event = data;
+	struct dcp_auto_route *route = NULL;
+	int ret = 0;
+
+	if (!event->controller || event->input_index != 0)
+		return NOTIFY_DONE;
+	for (unsigned int i = 0; i < 2; i++) {
+		if (event->controller->parent == dcp->auto_dp_routes[i].provider) {
+			route = &dcp->auto_dp_routes[i];
+			break;
+		}
+	}
+	if (!route)
+		return NOTIFY_DONE;
+	mutex_lock(&dcp->dp91_mutex);
+	if (event->sequence <= route->event_sequence) {
+		ret = -ESTALE;
+		goto out;
+	}
+	route->event_sequence = event->sequence;
+	if (action == CODEX_DP_PATHS_READY) {
+		/* Replays of the same live path do not disconnect its owner. */
+		if (!dcp->auto_dp_policy.request[route->id].present) {
+			route->output_route = event->output_route;
+			route->output_port = event->output_port;
+			ret = dcp_auto_dp_request(route, true);
+		} else if (route->output_route != event->output_route ||
+			   route->output_port != event->output_port) {
+			/* A different sink requires the prior retirement handshake. */
+			dcp->auto_dp_policy.phase = APPLE_DP_FAULT;
+			ret = -EUCLEAN;
+		}
+	} else if (action == CODEX_DP_BEFORE_RETIREMENT ||
+		   action == CODEX_DP_CONTROLLER_RETIRING) {
+		ret = dcp_auto_dp_request(route, false);
+	} else {
+		ret = -EINVAL;
+	}
+out:
+	mutex_unlock(&dcp->dp91_mutex);
+	return notifier_from_errno(ret);
+}
+
+static int dcp_auto_dp_start(struct apple_dcp *dcp)
+{
+	int ret;
+
+	if (dcp->auto_dp_ready)
+		return 0;
+	if (dcp->auto_dp_policy.stopping)
+		return -ESHUTDOWN;
+	if (!dcp->active || !dcp->connector || !dcp->dptxport[0].enabled ||
+	    !dcp->dptxport[0].service)
+		return -ENODEV;
+	/* This flag prevents the legacy connection helper registering its own
+ * notifier. All owner changes use the shared arbiter in this opt-in mode.
+ */
+	dcp->dp110_registered = true;
+	dcp->auto_dp_notifier.notifier_call = dcp_auto_dp_notify;
+	ret = codex_dp110_register(&dcp->auto_dp_notifier);
+	if (ret)
+		goto fail;
+	dcp->auto_dp_registered = true;
+	for (unsigned int i = 2; i < APPLE_DP_ROUTES; i++) {
+		struct dcp_auto_route *route = &dcp->auto_dp_routes[i];
+
+		route->sink.set_hpd = dcp_auto_dp_native_hpd;
+		route->sink.data = route;
+		ret = apple_cd321x_dp_attach(route->provider, &route->sink);
+		if (ret)
+			goto fail;
+		route->registered = true;
+	}
+	for (unsigned int i = 0; i < 2; i++) {
+		ret = codex_dp121_replay_ready(dcp->auto_dp_routes[i].provider);
+		if (ret && ret != -ENODEV && ret != -ENOLINK)
+			goto fail;
+	}
+	mutex_lock(&dcp->dp91_mutex);
+	dcp->native_dp_ready = true;
+	dcp->auto_dp_ready = true;
+	mutex_unlock(&dcp->dp91_mutex);
+	schedule_work(&dcp->auto_dp_work);
+	return 0;
+fail:
+	dcp_auto_dp_stop(dcp);
+	return ret;
+}
+
+static void dcp_auto_dp_stop(struct apple_dcp *dcp)
+{
+	struct apple_dp_command cmd;
+	int ret;
+
+	mutex_lock(&dcp->dp91_mutex);
+	dcp->auto_dp_ready = false;
+	apple_dp_policy_stop(&dcp->auto_dp_policy);
+	if (apple_dp_policy_next(&dcp->auto_dp_policy, &cmd) == 1)
+		dcp_auto_dp_execute(dcp, &cmd);
+	mutex_unlock(&dcp->dp91_mutex);
+	cancel_work_sync(&dcp->auto_dp_work);
+	if (dcp->auto_dp_registered) {
+		codex_dp110_unregister(&dcp->auto_dp_notifier);
+		dcp->auto_dp_registered = false;
+	}
+	for (unsigned int i = 2; i < APPLE_DP_ROUTES; i++) {
+		struct dcp_auto_route *route = &dcp->auto_dp_routes[i];
+
+		if (!route->registered)
+			continue;
+		ret = apple_cd321x_dp_detach(route->provider, &route->sink);
+		if (ret)
+			dev_err(dcp->dev, "auto DP provider detach failed: %d\n", ret);
+		route->registered = false;
+	}
+	dcp->dp110_registered = false;
+	dcp->native_dp_ready = false;
+}
+
+static int dcp_auto_dp_init(struct apple_dcp *dcp)
+{
+	struct device *dev = dcp->dev;
+	struct device_node *np;
+	struct platform_device *pd;
+	struct i2c_client *client;
+	int ret;
+
+	if (!of_property_read_bool(dev->of_node, "apple,auto-dp-routing"))
+		return 0;
+	/* Explicit experimental hardware contract; do not infer port wiring. */
+	if (!dpin_autostart || !of_machine_is_compatible("apple,t8103") ||
+	    !of_device_is_compatible(dev->of_node, "apple,dcpext") ||
+	    dcp->phy || dcp->native_dp_provider ||
+	    !dcp->dptxport[0].dpin_provider ||
+	    of_property_present(dev->of_node, "apple,native-dp-port") ||
+	    of_count_phandle_with_args(dev->of_node, "apple,native-dp-ports", NULL) != 2 ||
+	    of_count_phandle_with_args(dev->of_node, "apple,dpin-ports", NULL) != 2)
+		return -EINVAL;
+	for (unsigned int i = 0; i < APPLE_DP_ROUTES; i++) {
+		struct dcp_auto_route *route = &dcp->auto_dp_routes[i];
+		char name[24];
+
+		route->dcp = dcp;
+		route->id = i;
+		route->phy_index = i % 2;
+		route->native = i >= 2;
+		np = of_parse_phandle(dev->of_node, route->native ?
+				      "apple,native-dp-ports" : "apple,dpin-ports", i % 2);
+		if (!np)
+			return -EINVAL;
+		if (route->native) {
+			if (!of_device_is_compatible(np, "apple,cd321x")) {
+				of_node_put(np);
+				return -EINVAL;
+			}
+			client = of_find_i2c_device_by_node(np);
+			route->provider = client ? &client->dev : NULL;
+		} else {
+			if (!of_device_is_compatible(np, "apple,t8103-usb4-acio") ||
+			    (!of_property_read_bool(np, "codex,dpin-callback-test") &&
+			     !of_property_read_bool(np, "apple,auto-dpin-provider"))) {
+				of_node_put(np);
+				return -EINVAL;
+			}
+			pd = of_find_device_by_node(np);
+			route->provider = pd ? &pd->dev : NULL;
+		}
+		of_node_put(np);
+		if (!route->provider)
+			return -EPROBE_DEFER;
+		ret = devm_add_action_or_reset(dev, dcp_native_dp_put_provider, route->provider);
+		if (ret)
+			return ret;
+		if (!device_is_bound(route->provider))
+			return -EPROBE_DEFER;
+		for (unsigned int j = 0; j < i; j++) {
+			if (route->provider == dcp->auto_dp_routes[j].provider)
+				return -EINVAL;
+		}
+		if (!device_link_add(dev, route->provider, DL_FLAG_AUTOREMOVE_CONSUMER))
+			return -ENODEV;
+		if (!route->native)
+			continue;
+		snprintf(name, sizeof(name), "dp%u-phy", i % 2);
+		route->phy = devm_phy_get(dev, name);
+		if (IS_ERR(route->phy))
