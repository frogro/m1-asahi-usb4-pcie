diff --git a/drivers/gpu/drm/ttm/ttm_nonposted_test64.h b/drivers/gpu/drm/ttm/ttm_nonposted_test64.h
new file mode 100644
index 0000000..6e24894
--- /dev/null
+++ b/drivers/gpu/drm/ttm/ttm_nonposted_test64.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0 OR MIT */
+#ifndef TTM_TEST64_NONPOSTED_H
+#define TTM_TEST64_NONPOSTED_H
+#include <linux/pci.h>
+#include <drm/ttm/ttm_device.h>
+#include <drm/ttm/ttm_resource.h>
+/* Test64: derive the mapping requirement from this device's owning BAR.
+ * No global override, device IDs, public structure changes, or BAR writes.
+ * Mapping policy follows Joshua Warren linux-aurora PR188 patch 2;
+ * resource lookup is a diagnostic alternative to its new placement field.
+ */
+static inline bool ttm_resource_is_nonposted(struct ttm_device *bdev,
+                                            const struct ttm_resource *mem)
+{
+    struct device *dev = bdev->pool.dev;
+    struct pci_dev *pdev;
+    int bar;
+
+    if (!mem->bus.is_iomem || !mem->size || !dev || !dev_is_pci(dev))
+        return false;
+    pdev = to_pci_dev(dev);
+    for (bar = 0; bar < PCI_STD_NUM_BARS; bar++) {
+        const struct resource *r = &pdev->resource[bar];
+        if ((r->flags & (IORESOURCE_MEM | IORESOURCE_MEM_NONPOSTED)) !=
+            (IORESOURCE_MEM | IORESOURCE_MEM_NONPOSTED))
+            continue;
+        if (r->end < r->start || mem->bus.offset < r->start ||
+            mem->bus.offset > r->end)
+            continue;
+        /* Subtraction avoids wrapping offset + size on malformed input. */
+        if (mem->size - 1 <= r->end - mem->bus.offset)
+            return true;
+    }
+    return false;
+}
+#endif
