 7 files changed, 98 insertions(+), 14 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c
index 8525c45..e2ad957 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c
@@ -132,7 +132,11 @@ static bool amdgpu_read_bios_from_vram(struct amdgpu_device *adev)
 			return false;
 		}
 	} else {
-		bios = ioremap_wc(vram_base, size);
+		/* Test51: BIOS reads use ordered I/O on non-posted hosts. */
+		if (pci_resource_flags(adev->pdev, 0) & IORESOURCE_MEM_NONPOSTED)
+			bios = ioremap_np(vram_base, size);
+		else
+			bios = ioremap_wc(vram_base, size);
 		if (!bios) {
 			amdgpu_bios_release(adev);
 			return false;
